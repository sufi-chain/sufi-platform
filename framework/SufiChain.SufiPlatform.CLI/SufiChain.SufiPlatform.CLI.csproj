<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiPlatform.CLI</RootNamespace>
    <AssemblyName>sufi</AssemblyName>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.CLI</PackageId>
    <Description>Command-line interface for Sufi Platform - scaffolds solution templates with EF Core or MongoDB, WebApp, layered, or tiered architecture.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sufi</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="$(SpectreConsoleVersion)" />
    <PackageReference Include="Spectre.Console.Cli" Version="$(SpectreConsoleVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SufiChain.SufiPlatform.CLI.Core\SufiChain.SufiPlatform.CLI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="nupkg\" />
  </ItemGroup>

</Project>
