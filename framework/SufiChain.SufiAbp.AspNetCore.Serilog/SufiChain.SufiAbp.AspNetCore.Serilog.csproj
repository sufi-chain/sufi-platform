<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>SufiChain.SufiAbp.AspNetCore.Serilog</RootNamespace>
        <AssemblyName>SufiChain.SufiAbp.AspNetCore.Serilog</AssemblyName>
        <IsPackable>true</IsPackable>
        <OutputType>Library</OutputType>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Thin wrapper: re-export ABP functionality -->
        <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="$(AbpVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SufiChain.SufiAbp.AspNetCore\SufiChain.SufiAbp.AspNetCore.csproj" />
        <ProjectReference Include="..\SufiChain.SufiAbp.MultiTenancy\SufiChain.SufiAbp.MultiTenancy.csproj" />
    </ItemGroup>

</Project>
