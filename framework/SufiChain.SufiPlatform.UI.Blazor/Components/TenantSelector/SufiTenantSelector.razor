@using SufiChain.SufiBlazor.Components
@using SufiChain.SufiBlazor.Components.Actions
@using SufiChain.SufiBlazor.Components.Common
@using SufiChain.SufiBlazor.Components.Data
@using SufiChain.SufiBlazor.Components.Feedback
@using SufiChain.SufiBlazor.Components.Forms
@using SufiChain.SufiBlazor.Components.Layout
@using SufiChain.SufiBlazor.Components.Overlays
@using SufiChain.SufiPlatform.UI.MultiTenancy
@inherits SufiComponentBase
@namespace SufiChain.SufiPlatform.UI.Blazor.Components.TenantSelector
@inject ITenantSwitchService TenantSwitchService

@if (RenderMode == TenantSelectorRenderMode.Dialog)
{
    <SbDialog Open="@Open" OpenChanged="@SetOpenAsync"
              Title="@L["SelectTenant"]"
              Size="SbDialogSize.Sm"
              AllowDropdownOverflow="true"
             >
        <ChildContent>
            @if (Mode is "SelectFromList" or "Search")
            {
                <SbStack Gap="3">
                    <SbButton Variant="SbButtonVariant.Outline"
                              Color="SbColor.Secondary"
                              FullWidth="true"
                              OnClick="SwitchToHostAsync"
                              Loading="@IsOperationLoading("switch")">
                        <StartIcon><SbIcon Name="server" /></StartIcon>
                        <ChildContent>@L["SwitchToHost"]</ChildContent>
                    </SbButton>

                    @if (Mode == "Search")
                    {
                        <SbAutocomplete TItem="TenantLookupItemDto"
                                        @bind-Value="_selectedTenantForSearch"
                                        @bind-Value:after="OnTenantSelectedFromSearchAsync"
                                        SearchFunc="SearchTenantsAsync"
                                        TextField="x => x.Name"
                                        ValueField="x => x.Id"
                                        Placeholder="@L["SearchTenantsPlaceholder"]"
                                        MinLength="0"
                                        MaxResults="50"
                                        Clearable="true" />
                    }
                    else
                    {
                        @* SelectFromList: grid with Switch button per row *@
                        @if (IsOperationLoading("load-tenants"))
                        {
                            <SbStack Justify="SbJustify.Center" Align="SbAlign.Center" Class="p-8">
                                <SbProgress Type="SbProgressType.Circular" />
                                <span>@L["Loading"]</span>
                            </SbStack>
                        }
                        else if (_tenantItems.Count == 0 && _totalCount == 0)
                        {
                            <SbStack Justify="SbJustify.Center" Align="SbAlign.Center" Class="p-8 text-muted">
                                <SbIcon Name="building" Size="SbSize.Xl" />
                                <span>@L["NoTenantsFound"]</span>
                            </SbStack>
                        }
                        else
                        {
                            <SbDataGrid TItem="TenantLookupItemDto"
                                       Items="_tenantItems"
                                       Striped="true"
                                       Hoverable="true"
                                       PageIndex="_pageIndex"
                                       PageSize="10"
                                       TotalCount="_totalCount"
                                       PageIndexChanged="OnPageIndexChangedAsync">
                                <SbColumn TItem="TenantLookupItemDto" Title="@L["Actions"]" Width="56px" Sortable="false">
                                    <CellTemplate Context="ctx">
                                        @{
                                            var tenant = ctx.Item;
                                        }
                                        <SbTooltip Text="@L["SwitchTenant"]">
                                            <SbIconButton Size="SbSize.Sm" Color="SbColor.Primary" AriaLabel="@L["SwitchTenant"]"
                                                          OnClick="@(() => SwitchToTenantAsync(tenant))"
                                                          Loading="@IsOperationLoading("switch")">
                                                <Icon><SbIcon Name="server" Size="SbSize.Sm" /></Icon>
                                            </SbIconButton>
                                        </SbTooltip>
                                    </CellTemplate>
                                </SbColumn>
                                <SbColumn TItem="TenantLookupItemDto" Field="Name" Title="@L["Name"]">
                                    <CellTemplate Context="cellContext">
                                        <span class="sb-typography sb-typography--body2">@cellContext.Item.Name</span>
                                    </CellTemplate>
                                </SbColumn>
                            </SbDataGrid>
                        }
                    }
                </SbStack>
            }
            else
            {
                <SbStack Gap="4">
                    <SbTextField @bind-Value="_tenantName"
                                Label="@L["TenantName"]"
                                Placeholder="@L["TenantName"]"
                                Disabled="@IsOperationLoading("switch")" />
                    <span class="sb-typography sb-typography--caption" style="color: var(--sb-color-text-muted);">@L["SwitchTenantHint"]</span>
                    <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
                        <SbButton Variant="SbButtonVariant.Outline" OnClick="Hide">
                            @L["Cancel"]
                        </SbButton>
                        <SbButton OnClick="SwitchByHostNameAsync"
                                 Loading="@IsOperationLoading("switch")">
                            @L["SwitchTenant"]
                        </SbButton>
                    </SbStack>
                </SbStack>
            }
        </ChildContent>
    </SbDialog>
}
else
{
    @if (Mode is "SelectFromList" or "Search")
    {
        <SbStack Gap="3">
            <SbButton Variant="SbButtonVariant.Outline"
                       Color="SbColor.Secondary"
                       FullWidth="true"
                       OnClick="SwitchToHostAsync"
                       Loading="@IsOperationLoading("switch")">
                <StartIcon><SbIcon Name="server" /></StartIcon>
                <ChildContent>@L["SwitchToHost"]</ChildContent>
            </SbButton>

            @if (Mode == "Search")
            {
                <SbAutocomplete TItem="TenantLookupItemDto"
                               @bind-Value="_selectedTenantForSearch"
                               @bind-Value:after="OnTenantSelectedFromSearchAsync"
                               SearchFunc="SearchTenantsAsync"
                               TextField="x => x.Name"
                               ValueField="x => x.Id"
                               Placeholder="@L["SearchTenantsPlaceholder"]"
                               MinLength="0"
                               MaxResults="50"
                               Clearable="true" />
            }
            else
            {
                @if (IsOperationLoading("load-tenants"))
                {
                    <SbStack Justify="SbJustify.Center" Align="SbAlign.Center" Class="p-8">
                        <SbProgress Type="SbProgressType.Circular" />
                        <span>@L["Loading"]</span>
                    </SbStack>
                }
                else if (_tenantItems.Count == 0 && _totalCount == 0)
                {
                    <SbStack Justify="SbJustify.Center" Align="SbAlign.Center" Class="p-8 text-muted">
                        <SbIcon Name="building" Size="SbSize.Xl" />
                        <span>@L["NoTenantsFound"]</span>
                    </SbStack>
                }
                else
                {
                    <SbDataGrid TItem="TenantLookupItemDto"
                               Items="_tenantItems"
                               Striped="true"
                               Hoverable="true"
                               PageIndex="_pageIndex"
                               PageSize="10"
                               TotalCount="_totalCount"
                               PageIndexChanged="OnPageIndexChangedAsync">
                        <SbColumn TItem="TenantLookupItemDto" Title="@L["Actions"]" Width="56px" Sortable="false">
                            <CellTemplate Context="ctx">
                                @{
                                    var tenant = ctx.Item;
                                }
                                <SbTooltip Text="@L["SwitchTenant"]">
                                    <SbIconButton Size="SbSize.Sm" Color="SbColor.Primary" AriaLabel="@L["SwitchTenant"]"
                                                  OnClick="@(() => SwitchToTenantAsync(tenant))"
                                                  Loading="@IsOperationLoading("switch")">
                                        <Icon><SbIcon Name="server" Size="SbSize.Sm" /></Icon>
                                    </SbIconButton>
                                </SbTooltip>
                            </CellTemplate>
                        </SbColumn>
                        <SbColumn TItem="TenantLookupItemDto" Field="Name" Title="@L["Name"]">
                            <CellTemplate Context="cellContext">
                                <span class="sb-typography sb-typography--body2">@cellContext.Item.Name</span>
                            </CellTemplate>
                        </SbColumn>
                    </SbDataGrid>
                }
            }
        </SbStack>
    }
    else
    {
        <SbStack Gap="4">
            <SbTextField @bind-Value="_tenantName"
                        Label="@L["TenantName"]"
                        Placeholder="@L["TenantName"]"
                        Disabled="@IsOperationLoading("switch")" />
            <span class="sb-typography sb-typography--caption" style="color: var(--sb-color-text-muted);">@L["SwitchTenantHint"]</span>
            <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
                <SbButton OnClick="SwitchByHostNameAsync"
                         Loading="@IsOperationLoading("switch")">
                    @L["SwitchTenant"]
                </SbButton>
            </SbStack>
        </SbStack>
    }
}
