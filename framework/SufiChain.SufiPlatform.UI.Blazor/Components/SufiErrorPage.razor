@namespace SufiChain.SufiPlatform.UI.Blazor.Components
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using SufiChain.SufiPlatform.UI.Localization
@using SufiChain.SufiBlazor.Components
@using SufiChain.SufiBlazor.Components.Actions
@using SufiChain.SufiBlazor.Components.Common
@using SufiChain.SufiBlazor.Components.Layout
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SufiFrameworkResource> L

<div class="sufi-error-page" role="alert">
    <div class="sufi-error-page__card">
        <div class="sufi-error-page__icon">
            <SbIcon Name="@GetIconName()" Size="SbSize.Xl" Color="@GetIconColor()" />
        </div>
        <h1 class="sufi-error-page__title" id="sufi-error-page-title">@Title</h1>
        <p class="sufi-error-page__message">@Message</p>
        <div class="sufi-error-page__actions">
            @if (_showGoBack)
            {
                <SbButton Variant="SbButtonVariant.Outline" Color="SbColor.Secondary" OnClick="GoBackAsync">
                    @L["GoBack"]
                </SbButton>
            }
            @if (_showReload)
            {
                <SbButton Variant="SbButtonVariant.Solid" Color="SbColor.Primary" OnClick="ReloadPage">
                    @L["Refresh"]
                </SbButton>
            }
            <SbButton Variant="@(_showReload ? SbButtonVariant.Outline : SbButtonVariant.Solid)"
                      Color="@(_showReload ? SbColor.Secondary : SbColor.Primary)"
                      OnClick="GoHome">
                @L["BackToHome"]
            </SbButton>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// HTTP status code (404, 403, 500). Affects icon and default behavior.
    /// </summary>
    [Parameter]
    public int StatusCode { get; set; } = 404;

    /// <summary>
    /// Error page title.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Error page message.
    /// </summary>
    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    /// <summary>
    /// Whether to show the Reload page button. Default: true for 500, false otherwise.
    /// </summary>
    [Parameter]
    public bool? ShowReload { get; set; }

    /// <summary>
    /// Whether to show the Go back button. Default: true for 404 only.
    /// </summary>
    [Parameter]
    public bool? ShowGoBack { get; set; }

    private bool _showReload => ShowReload ?? (StatusCode == 500);
    private bool _showGoBack => ShowGoBack ?? (StatusCode == 404);

    private string GetIconName() => StatusCode switch
    {
        404 => "search",
        403 => "lock",
        500 => "alert-triangle",
        _ => "alert-circle"
    };

    private SbColor GetIconColor() => StatusCode switch
    {
        404 => SbColor.Secondary,
        403 => SbColor.Warning,
        500 => SbColor.Danger,
        _ => SbColor.Secondary
    };

    private void GoHome()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private void ReloadPage()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task GoBackAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "history.back()");
        }
        catch (JSException)
        {
            GoHome();
        }
    }
}
