@using SufiChain.SufiPlatform.UI.Alerts
@using SufiChain.SufiPlatform.UI.Services.Alerts
@using SufiChain.SufiBlazor.Components.Feedback

@{
    // Get a single snapshot for both Any() check and iteration to ensure consistency
    var alerts = AlertManager.Alerts;
}

@if (alerts.Any())
{
    <div class="sabp-page-alerts">
        @foreach (var alert in alerts)
        {
            <SbAlert Severity="@GetAlertSeverity(alert.Type)" 
                     Dismissible="@alert.Dismissible"
                     OnDismiss="() => DismissAlert(alert)">
                @if (!string.IsNullOrEmpty(alert.Title))
                {
                    <strong>@alert.Title</strong>
                    <span> </span>
                }
                @alert.Message
            </SbAlert>
        }
    </div>
}
