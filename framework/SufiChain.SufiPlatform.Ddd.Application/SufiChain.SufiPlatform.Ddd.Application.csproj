<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiPlatform.Ddd</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.Ddd.Application</PackageId>
    <Description>Sufi Platform DDD application layer - application service implementations, CRUD services.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Application" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Authorization" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Features" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.GlobalFeatures" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Http.Abstractions" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Localization" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.ObjectMapping" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Security" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Settings" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Validation" Version="$(AbpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SufiChain.SufiPlatform.Ddd.Application.Contracts\SufiChain.SufiPlatform.Ddd.Application.Contracts.csproj" />
    <PackageReference Include="Volo.Abp.Ddd.Domain" Version="$(AbpVersion)" />
  </ItemGroup>

</Project>
