<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiAbp.AspNetCore.Authentication.OAuth</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiAbp.AspNetCore.Authentication.OAuth</PackageId>
    <Description>OAuth support for external logins (Google, Microsoft, Facebook) in Sufi Platform. Wraps Volo.Abp.AspNetCore.Authentication.OAuth for MapAbpClaimTypes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Authentication.OAuth" Version="$(AbpVersion)"/>
    <PackageReference Include="Volo.Abp.Security" Version="$(AbpVersion)"/>
  </ItemGroup>

</Project>
