<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiAbp.Ddd</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiAbp.Ddd.Domain</PackageId>
    <Description>Sufi Platform DDD domain layer - domain entities, repositories, domain services, specifications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Domain" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Guids" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Timing" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.MultiTenancy" Version="$(AbpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SufiChain.SufiAbp.Ddd.Domain.Shared\SufiChain.SufiAbp.Ddd.Domain.Shared.csproj" />
  </ItemGroup>

</Project>
