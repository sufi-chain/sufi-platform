<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiPlatform.SufiAI</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.SufiAI.Abstractions</PackageId>
    <Description>Sufi Platform AI abstractions - core interfaces for AI workspace management and Semantic Kernel integration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Core" Version="$(AbpVersion)" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.2" />
    <PackageReference Include="Microsoft.SemanticKernel.Abstractions" Version="$(MicrosoftSemanticKernelAbstractionsVersion)" />
  </ItemGroup>

</Project>
