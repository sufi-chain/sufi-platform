<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiPlatform.CLI</RootNamespace>
    <AssemblyName>SufiChain.SufiPlatform.CLI.Core</AssemblyName>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.CLI.Core</PackageId>
    <Description>Core template-building engine for Sufi Platform CLI. Reusable from CLI or web apps.</Description>
  </PropertyGroup>

</Project>
