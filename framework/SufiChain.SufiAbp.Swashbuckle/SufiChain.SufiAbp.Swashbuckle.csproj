<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>SufiChain.SufiAbp.Swashbuckle</RootNamespace>
        <AssemblyName>SufiChain.SufiAbp.Swashbuckle</AssemblyName>
        <PackageId>SufiChain.SufiAbp.Swashbuckle</PackageId>
        <Description>Swagger/Swashbuckle integration for SufiAbp applications.</Description>
    </PropertyGroup>

    <ItemGroup>
        <!-- Thin wrapper: re-export ABP functionality -->
        <PackageReference Include="Volo.Abp.Swashbuckle" Version="$(AbpVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SufiChain.SufiAbp.AspNetCore.Mvc\SufiChain.SufiAbp.AspNetCore.Mvc.csproj" />
        <ProjectReference Include="..\SufiChain.SufiAbp.VirtualFileSystem\SufiChain.SufiAbp.VirtualFileSystem.csproj" />
    </ItemGroup>

</Project>
