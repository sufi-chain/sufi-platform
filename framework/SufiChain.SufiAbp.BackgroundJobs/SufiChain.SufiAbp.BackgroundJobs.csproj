<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiAbp.BackgroundJobs</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiAbp.BackgroundJobs</PackageId>
    <Description>Sufi Platform background job abstractions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.BackgroundJobs" Version="$(AbpVersion)"/>
    <PackageReference Include="Volo.Abp.Threading" Version="$(AbpVersion)"/>
  </ItemGroup>

</Project>
