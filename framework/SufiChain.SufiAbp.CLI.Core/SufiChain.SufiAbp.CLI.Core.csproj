<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiAbp.CLI</RootNamespace>
    <AssemblyName>SufiChain.SufiAbp.CLI.Core</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiAbp.CLI.Core</PackageId>
    <Description>Core template-building engine for Sufi Platform CLI. Reusable from CLI or web apps.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\Embedded\**\*" />
  </ItemGroup>

</Project>
