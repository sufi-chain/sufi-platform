<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="liara-mirror" value="https://package-mirror.liara.ir/repository/nuget/index.json" />
        <add key="sufi-platform" value="https://nuget.sufichain.com/v3/index.json" />
    </packageSources>

    <packageSourceMapping>
        <!-- Microsoft runtime and SDK packages must come from nuget.org -->
        <packageSource key="nuget.org">
            <package pattern="Microsoft.*" />
            <package pattern="System.*" />
            <package pattern="runtime.*" />
        </packageSource>

        <!-- SufiChain packages from sufi-abp feed -->
        <packageSource key="sufi-abp">
            <package pattern="SufiChain.*" />
        </packageSource>

        <!-- Everything else can come from LiaraMirror or nuget.org -->
        <packageSource key="liara-mirror">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
