version: '3.8'

services:
  postgres:
    image: postgres:16-alpine
    container_name: mycompanyname-myprojectname-postgres
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: MyProjectName
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - mycompanyname-myprojectname-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  db-migrator:
    image: mycompanyname/myprojectname-dbmigrator:latest
    container_name: mycompanyname-myprojectname-dbmigrator
    build:
      context: .
      dockerfile: src/MyCompanyName.MyProjectName.DbMigrator/Dockerfile
    environment:
      - ConnectionStrings__Default=Host=postgres;Port=5432;Database=MyProjectName;Username=postgres;Password=postgres
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - mycompanyname-myprojectname-network
    restart: "no"


  # Optional slim public host. It is off unless you pass: docker compose --profile public up -d
  cms-public:
    profiles: ["public"]
    image: ghcr.io/sufi-chain/sufi-cms-public:${SUFI_CMS_PUBLIC_TAG:-dev}
    container_name: mycompanyname-myprojectname-cms-public
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ASPNETCORE_URLS: http://+:8080
      SufiCmsPublic__DeliveryBaseUrl: ${SUFI_CMS_PUBLIC_DELIVERY_URL:-http://host.docker.internal:8080}
      SufiCmsPublic__ConsoleBaseUrl: ${SUFI_CMS_PUBLIC_CONSOLE_URL:-http://host.docker.internal:8080}
      SufiCmsPublic__FormsApiBaseUrl: ${SUFI_CMS_PUBLIC_FORMS_URL:-http://host.docker.internal:8080}
      SufiCmsPublic__CanonicalOrigin: ${SUFI_CMS_PUBLIC_CANONICAL_ORIGIN:-}
      SufiCmsPublic__ReadToken: ${SUFI_CMS_PUBLIC_READ_TOKEN:-}
      SufiCmsPublic__WebhookSecret: ${SUFI_CMS_PUBLIC_WEBHOOK_SECRET:-}
    ports:
      - "8096:8080"
    networks:
      - mycompanyname-myprojectname-network
    restart: unless-stopped

volumes:
  postgres_data:
    name: mycompanyname_myprojectname_postgres_data
    driver: local

networks:
  mycompanyname-myprojectname-network:
    name: mycompanyname-myprojectname-network
    driver: bridge
