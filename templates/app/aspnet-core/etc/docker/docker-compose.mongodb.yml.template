version: '3.8'

services:
  mongodb:
    image: mongo:7
    container_name: mycompanyname-myprojectname-mongodb
    environment:
      MONGO_INITDB_ROOT_USERNAME: admin
      MONGO_INITDB_ROOT_PASSWORD: admin
      MONGO_INITDB_DATABASE: MyProjectName
    ports:
      - "27017:27017"
    volumes:
      - mongodb_data:/data/db
    networks:
      - mycompanyname-myprojectname-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5

  db-migrator:
    image: mycompanyname/myprojectname-dbmigrator:latest
    container_name: mycompanyname-myprojectname-dbmigrator
    build:
      context: .
      dockerfile: src/MyCompanyName.MyProjectName.DbMigrator/Dockerfile
    environment:
      - ConnectionStrings__Default=mongodb://admin:admin@mongodb:27017/MyProjectName?authSource=admin
    depends_on:
      mongodb:
        condition: service_healthy
    networks:
      - mycompanyname-myprojectname-network
    restart: "no"

volumes:
  mongodb_data:
    name: mycompanyname_myprojectname_mongodb_data
    driver: local

networks:
  mycompanyname-myprojectname-network:
    name: mycompanyname-myprojectname-network
    driver: bridge
