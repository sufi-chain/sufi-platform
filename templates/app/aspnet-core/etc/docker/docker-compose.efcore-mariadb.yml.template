version: '3.8'

services:
  mariadb:
    image: mariadb:11
    container_name: mycompanyname-myprojectname-mariadb
    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: MyProjectName
    ports:
      - "3306:3306"
    volumes:
      - mariadb_data:/var/lib/mysql
    networks:
      - mycompanyname-myprojectname-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5

  db-migrator:
    image: mycompanyname/myprojectname-dbmigrator:latest
    container_name: mycompanyname-myprojectname-dbmigrator
    build:
      context: .
      dockerfile: src/MyCompanyName.MyProjectName.DbMigrator/Dockerfile
    environment:
      - ConnectionStrings__Default=Server=mariadb;Port=3306;Database=MyProjectName;Uid=root;Pwd=root
    depends_on:
      mariadb:
        condition: service_healthy
    networks:
      - mycompanyname-myprojectname-network
    restart: "no"

volumes:
  mariadb_data:
    name: mycompanyname_myprojectname_mariadb_data
    driver: local

networks:
  mycompanyname-myprojectname-network:
    name: mycompanyname-myprojectname-network
    driver: bridge
