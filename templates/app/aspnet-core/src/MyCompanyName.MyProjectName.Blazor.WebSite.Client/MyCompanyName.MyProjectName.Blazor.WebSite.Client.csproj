		<PackageReference Include="SufiChain.SufiAbp.FileManager.Blazor.WebAssembly" Version="$(SufiVersion)" />
	</ItemGroup>
	</TEMPLATE-ONLY> -->
	
	<ItemGroup>
		<!-- Demo app project reference (always needed) -->
		<ProjectReference Include="..\MyCompanyName.MyProjectName.HttpApi.Client\MyCompanyName.MyProjectName.HttpApi.Client.csproj" />
	</ItemGroup>

</Project>
