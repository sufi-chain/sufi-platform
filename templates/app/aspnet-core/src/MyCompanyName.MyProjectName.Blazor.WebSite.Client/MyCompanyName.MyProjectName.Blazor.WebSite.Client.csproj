<?xml version="1.0" encoding="utf-16"?>
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftAspNetCoreComponentsWebVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftAspNetCoreComponentsWebAssemblyVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="$(MicrosoftAspNetCoreComponentsWebAssemblyVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="$(MicrosoftExtensionsConfigurationBinderVersion)" />
    <!-- ABP Core module system (NOT UI packages) -->
    <PackageReference Include="SufiChain.SufiPlatform.Core" Version="$(SufiVersion)" />
    <PackageReference Include="Volo.Abp.Autofac.WebAssembly" Version="$(AbpVersion)" />
  </ItemGroup>
  <!-- <TEMPLATE-REMOVE> -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\framework\SufiChain.SufiPlatform.Core\SufiChain.SufiPlatform.Core.csproj" />
    <PackageReference Include="Volo.Abp.Autofac.WebAssembly" Version="$(AbpVersion)" />
<!-- Sufi Platform Theme using SufiBlazor (replaces ABP Blazor UI packages) -->
    <ProjectReference Include="..\..\..\..\..\independent-projects\sufi-theme\src\SufiChain.SufiTheme.Blazor.WebAssembly\SufiChain.SufiTheme.Blazor.WebAssembly.csproj" />
    <!-- Sufi Platform UI Modules for Public Site -->
    <!-- NOTE: SufiChain.SufiPlatform.Account.Blazor is Server-only (uses SignInManager/AspNetCore.Identity) -->
    <!-- It is referenced from the Server project, not this WebAssembly client -->
    <!-- File Manager for public file access -->
    <ProjectReference Include="..\..\..\..\..\modules\file-manager\src\SufiChain.SufiPlatform.FileManager.Blazor\SufiChain.SufiPlatform.FileManager.Blazor.csproj" />
    <ProjectReference Include="..\..\..\..\..\modules\file-manager\src\SufiChain.SufiPlatform.FileManager.Blazor.WebAssembly\SufiChain.SufiPlatform.FileManager.Blazor.WebAssembly.csproj" />
    <!-- NOTE: Admin modules NOT included for WebSite -->
    <!-- NO: Identity.Blazor (admin), TenantManagement, AuditLogging, etc. -->
  </ItemGroup>
  <!-- </TEMPLATE-REMOVE> -->
  <!-- <TEMPLATE-ONLY>
	<ItemGroup>
		<PackageReference Include="SufiChain.SufiTheme.Blazor.WebAssembly" Version="$(SufiThemeVersion)" />
		<PackageReference Include="SufiChain.SufiPlatform.FileManager.Blazor" Version="$(SufiVersion)" />
		<PackageReference Include="SufiChain.SufiPlatform.FileManager.Blazor.WebAssembly" Version="$(SufiVersion)" />
	</ItemGroup>
	</TEMPLATE-ONLY> -->
  <ItemGroup>
    <!-- Demo app project reference (always needed) -->
    <ProjectReference Include="..\MyCompanyName.MyProjectName.HttpApi.Client\MyCompanyName.MyProjectName.HttpApi.Client.csproj" />
  </ItemGroup>
</Project>
