@using System.Globalization
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Hosting
@using Microsoft.Extensions.Localization
@using Volo.Abp.Localization
@using SufiChain.KomTheme.Blazor.Server.Bundling
@using SufiChain.SufiAbp.UI.Blazor.Server.Components
@using SufiChain.SufiAbp.UI.Localization
@inject IHostEnvironment Env
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SufiAbpFrameworkResource> L
@{
    var rtl = CultureHelper.IsRtl ? "rtl" : string.Empty;
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentCulture.Name" dir="@rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MyCompanyName.MyProjectName - Authentication</title>
    <base href="/" />

    <SufiAbpStyles BundleName="@BlazorKomThemeBundles.Styles.Global" />

    @* Scoped CSS bundle *@
    <link href="MyCompanyName.MyProjectName.AuthServer.styles.css" rel="stylesheet"/>

    @* Static SSR - no render mode needed for HeadOutlet *@
    <HeadOutlet />

</head>
<body class="wish-application-layout bg-light @rtl">

    @* Static SSR - cascade HttpContext for authentication pages that need direct cookie access *@
    <ErrorBoundary>
        <ChildContent>
            <CascadingValue Value="@HttpContextAccessor.HttpContext">
                <Routes />
            </CascadingValue>
        </ChildContent>
        <ErrorContent Context="exception">
            <div style="padding: 1rem; text-align: center;">
                <p>@L["ErrorLoadingPage"]</p>
                <a href="">@L["Refresh"]</a>
            </div>
        </ErrorContent>
    </ErrorBoundary>

    <div id="blazor-error-ui" style="display: none;">
        @if (Env.IsDevelopment())
        {
            <text>@L["UnhandledExceptionDev"]</text>
        }
        else
        {
            <text>@L["ApplicationErrorReload"]</text>
        }
        <a href="" class="reload">@L["Refresh"]</a>
        <a class="dismiss">🗙</a>
    </div>

    <SufiAbpScripts BundleName="@BlazorKomThemeBundles.Scripts.Global" />

    <script src="_framework/blazor.web.js"></script>

</body>
</html>
