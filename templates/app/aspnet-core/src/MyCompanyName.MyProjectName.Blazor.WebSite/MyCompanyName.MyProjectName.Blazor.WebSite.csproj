    <ProjectReference Include="..\..\..\..\..\modules\tenants\src\SufiChain.SufiPlatform.Tenants.HttpApi.Client\SufiChain.SufiPlatform.Tenants.HttpApi.Client.csproj" />
    <!-- NOTE: Admin modules NOT included for WebSite -->
    <!-- NO: AuditLogging, BackgroundJobs, FeatureManagement, SettingManagement -->
    <!-- NO: TenantManagement Blazor UI (managed via Admin panel only) -->
  </ItemGroup>
