@page "/"
@using Microsoft.Extensions.Localization
@using MyCompanyName.MyProjectName.Localization
@inject IStringLocalizer<DemoAppResource> L

<PageTitle>@L["Menu:Home"] - DemoApp Public</PageTitle>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 mb-4">Welcome to DemoApp Public</h1>
            <p class="lead text-muted">
                This is the public-facing Blazor Server site using the KomTheme.
            </p>
            <p class="text-muted">
                This host is designed for CMS content with dynamic layout rendering.
            </p>
            <hr class="my-4" />
            <div class="alert alert-info">
                <h5 class="alert-heading">WebPublic Host</h5>
                <p class="mb-0">
                    This is a placeholder for the CMS public website. In future versions, 
                    this will render CMS pages with dynamic layouts defined by content editors.
                </p>
            </div>
        </div>
    </div>
</div>
