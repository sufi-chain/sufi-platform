<Project>
  <Import Project="versions.props" />
  <Import Project="common.props" />

  <PropertyGroup>
    <!-- Package Metadata -->
    <Company>Sufi Chain Intelligent Solutions</Company>
    <Authors>Sufi Chain Team</Authors>
    <Product>Sufi Platform</Product>
    <Version>$(SufiVersion)</Version>
    <Copyright>Copyright © Sufi Chain Intelligent Solutions $([System.DateTime]::Now.Year)</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://sufichain.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sufi-chain/sufi-platform.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon Condition="Exists('$(MSBuildThisFileDirectory)icon.png')">icon.png</PackageIcon>
    <PackageReadmeFile Condition="Exists('$(MSBuildThisFileDirectory)README.md')">README.md</PackageReadmeFile>
    
    <!-- Local development hosts under .dev can opt into workspace project references. -->
    <UseLocalDevelopmentReferences Condition="'$(UseLocalDevelopmentReferences)' == '' And $([System.String]::Copy('$(MSBuildStartupDirectory)').Contains('.dev'))">true</UseLocalDevelopmentReferences>
    <UseLocalDevelopmentReferences Condition="'$(UseLocalDevelopmentReferences)' == '' And $([System.String]::Copy('$(SolutionDir)').Contains('.dev'))">true</UseLocalDevelopmentReferences>
    <UseLocalDevelopmentReferences Condition="'$(UseLocalDevelopmentReferences)' == ''">false</UseLocalDevelopmentReferences>

    <!-- Build Settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CS8601;CS8602;CS8603;CS8604;CS8613;CS8618;CS8619;CS8620;CS8625;CS8629;CS8632;CS8669;CS8609;CS8767</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)icon.png')">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
