@namespace SufiChain.Chat.Blazor.Toolbars
@inherits ChatComponentBase

@if (IsVisible)
{
    <AuthorizeView Policy="@ChatPermissions.Inbox.User">
        <Authorized>
            <SbButton Variant="SbButtonVariant.Ghost"
                      Size="SbSize.Sm"
                      Class="chat-inbox-toolbar-btn"
                      OnClick="OpenInbox"
                      title="@L["Menu:ChatInbox"]">
                <SbIcon Name="message-circle" Size="SbSize.Md" />
            </SbButton>
        </Authorized>
    </AuthorizeView>
}
