@page "/chat/inbox"
@page "/chat/inbox/{AssistantKey?}"
@attribute [Authorize(ChatPermissions.Inbox.User)]
@inherits ChatMessengerHostBase

<div class="chat-messenger-page">
    <ChatMessengerShell State="MessengerState"
                        SignInUrl="@GetSignInUrl()"
                        OnSessionSelected="OnSessionSelectedAsync"
                        OnSendMessage="OnSendMessageAsync">
        <ContextPanelHeader>
            <ChatInboxQuickActions CanCreateDirectMessages="CanCreateDirectMessages"
                                   CanCreateGroups="CanCreateGroups"
                                   ShowStartAiChat="ShowStartAiChat"
                                   AssistantOptions="AssistantPickerOptions"
                                   AssistantUnavailableMessageKey="AssistantUnavailableMessageKey"
                                   OnNewDirectMessage="OpenNewDirectMessageDialogAsync"
                                   OnNewGroup="OpenNewGroupDialogAsync"
                                   OnStartAiChat="StartAiChatAsync"
                                   OnStartAssistantChat="StartAssistantChatAsync" />
        </ContextPanelHeader>
        <ListHeader>
            <div class="chat-messenger-page__list-header">
                <SbHeading Level="6">@L["Messenger:Conversations"]</SbHeading>
                <div class="chat-messenger-page__mobile-actions">
                    <ChatInboxQuickActions CanCreateDirectMessages="CanCreateDirectMessages"
                                           CanCreateGroups="CanCreateGroups"
                                           ShowStartAiChat="ShowStartAiChat"
                                           AssistantOptions="AssistantPickerOptions"
                                           AssistantUnavailableMessageKey="AssistantUnavailableMessageKey"
                                           OnNewDirectMessage="OpenNewDirectMessageDialogAsync"
                                           OnNewGroup="OpenNewGroupDialogAsync"
                                           OnStartAiChat="StartAiChatAsync"
                                           OnStartAssistantChat="StartAssistantChatAsync" />
                </div>
            </div>
        </ListHeader>
        <HeaderActions>
            @if (CanManageGroupMembers)
            {
                <SbButton Variant="SbButtonVariant.Outline" OnClick="OpenAddGroupMembersDialogAsync">
                    @L["AddGroupMembers"]
                </SbButton>
            }
        </HeaderActions>
    </ChatMessengerShell>
</div>

<NewDirectMessageDialog Open="IsNewDirectMessageDialogOpen"
                        OpenChanged="@(value => IsNewDirectMessageDialogOpen = value)"
                        OnCreated="OnDirectMessageCreatedAsync" />

<NewGroupChatDialog Open="IsNewGroupDialogOpen"
                    OpenChanged="@(value => IsNewGroupDialogOpen = value)"
                    OnCreated="OnGroupCreatedAsync" />

<AddGroupMembersDialog Open="IsAddGroupMembersDialogOpen"
                       OpenChanged="@(value => IsAddGroupMembersDialogOpen = value)"
                       SessionId="MessengerState.SelectedSessionId"
                       ExistingMemberUserIds="GetExistingGroupMemberUserIds()"
                       OnMembersAdded="OnGroupMembersAddedAsync" />
