@page "/chat/inbox"
@attribute [Authorize(ChatPermissions.Inbox.User)]
@inherits ChatMessengerHostBase

<div class="chat-messenger-page">
    <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End" Class="chat-messenger-page__actions">
        @if (CanCreateDirectMessages)
        {
            <SbButton Variant="SbButtonVariant.Outline" OnClick="OpenNewDirectMessageDialogAsync">
                @L["Menu:NewDirectMessage"]
            </SbButton>
        }

        @if (CanCreateGroups)
        {
            <SbButton Variant="SbButtonVariant.Outline" OnClick="OpenNewGroupDialogAsync">
                @L["Menu:NewGroupChat"]
            </SbButton>
        }

        @if (ShowStartAiChat)
        {
            <SbButton Color="SbColor.Primary" OnClick="StartAiChatAsync">
                @L["Menu:StartAiChat"]
            </SbButton>
        }
        else if (!string.IsNullOrWhiteSpace(AssistantUnavailableMessageKey))
        {
            <SbTooltip Text="@L[AssistantUnavailableMessageKey]">
                <SbButton Color="SbColor.Primary" Disabled="true">
                    @L["Menu:StartAiChat"]
                </SbButton>
            </SbTooltip>
        }
    </SbStack>

    <ChatMessengerShell State="MessengerState"
                        SignInUrl="@GetSignInUrl()"
                        OnSessionSelected="OnSessionSelectedAsync"
                        OnSendMessage="OnSendMessageAsync">
        <ListHeader>
            <SbHeading Level="6">@L["Messenger:Conversations"]</SbHeading>
        </ListHeader>
    </ChatMessengerShell>
</div>

<NewDirectMessageDialog Open="IsNewDirectMessageDialogOpen"
                        OpenChanged="@(value => IsNewDirectMessageDialogOpen = value)"
                        OnCreated="OnDirectMessageCreatedAsync" />

<NewGroupChatDialog Open="IsNewGroupDialogOpen"
                    OpenChanged="@(value => IsNewGroupDialogOpen = value)"
                    OnCreated="OnGroupCreatedAsync" />
