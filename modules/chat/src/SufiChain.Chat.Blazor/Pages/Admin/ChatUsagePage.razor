@page "/admin/chat/usage"
@attribute [Authorize(ChatPermissions.Usage.View)]
@inherits ChatComponentBase

<SufiAbpPageToolbar>
    <SbButton Variant="SbButtonVariant.Outline"
              Size="SbSize.Sm"
              OnClick="RefreshAsync"
              Disabled="IsLoading">
        <StartIcon><SbIcon Name="refresh" Size="SbSize.Sm" /></StartIcon>
        <ChildContent>@L["Refresh"]</ChildContent>
    </SbButton>
    <AuthorizeView Policy="@ChatPermissions.Settings.Manage">
        <Authorized>
            <SbButton Color="SbColor.Primary"
                      Size="SbSize.Sm"
                      OnClick="OpenSettings">
                <StartIcon><SbIcon Name="settings" Size="SbSize.Sm" /></StartIcon>
                <ChildContent>@L["ManagePolicies"]</ChildContent>
            </SbButton>
        </Authorized>
    </AuthorizeView>
</SufiAbpPageToolbar>

@if (IsLoading)
{
    <SbProgress Type="SbProgressType.Circular" />
}
else
{
    <SbStack Gap="4">
        <SbAlert Severity="SbAlertSeverity.Info">
            @L["Usage:InfoBanner"]
        </SbAlert>

        @* ---- Feature toggle KPI cards ---- *@
        <SbStack Direction="SbStackDirection.Row" Gap="3" Wrap="true">
            <SbCard Style="flex: 1; min-width: 240px;">
                <ChildContent>
                    <SbStack Gap="2">
                        <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
                            <SbIcon Name="message-circle" Size="SbSize.Sm" />
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                @L["Feature:Chat.Enable"]
                            </SbText>
                        </SbStack>
                        <SbHeading Level="4">@(ChatEnabled ? L["Enabled"] : L["Disabled"])</SbHeading>
                        <SbChip Size="SbSize.Sm" Color="@(ChatEnabled ? SbColor.Success : SbColor.Muted)">
                            @L[ChatEnabled ? "Enabled" : "Disabled"]
                        </SbChip>
                    </SbStack>
                </ChildContent>
            </SbCard>
            <SbCard Style="flex: 1; min-width: 240px;">
                <ChildContent>
                    <SbStack Gap="2">
                        <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
                            <SbIcon Name="shield" Size="SbSize.Sm" />
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                @L["UsageGuard"]
                            </SbText>
                        </SbStack>
                        <SbHeading Level="4">@(UsageGuardEnabled ? L["Enabled"] : L["Disabled"])</SbHeading>
                        <SbChip Size="SbSize.Sm" Color="@(UsageGuardEnabled ? SbColor.Success : SbColor.Muted)">
                            @L[UsageGuardEnabled ? "Enabled" : "Disabled"]
                        </SbChip>
                    </SbStack>
                </ChildContent>
            </SbCard>
            <SbCard Style="flex: 1; min-width: 240px;">
                <ChildContent>
                    <SbStack Gap="2">
                        <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
                            <SbIcon Name="sparkles" Size="SbSize.Sm" />
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                @L["Feature:Chat.Ai.UsageGuard"]
                            </SbText>
                        </SbStack>
                        <SbHeading Level="4">@(AiUsageGuardEnabled ? L["Enabled"] : L["Disabled"])</SbHeading>
                        <SbChip Size="SbSize.Sm" Color="@(AiUsageGuardEnabled ? SbColor.Success : SbColor.Muted)">
                            @L[AiUsageGuardEnabled ? "Enabled" : "Disabled"]
                        </SbChip>
                    </SbStack>
                </ChildContent>
            </SbCard>
        </SbStack>

        @* ---- Tenant ceilings ---- *@
        @if (Settings != null)
        {
            <SbCard>
                <ChildContent>
                    <SbStack Gap="3">
                        <SbHeading Level="6">@L["SettingsGroup:TenantWide"]</SbHeading>
                        <SbText Color="SbColor.Muted">@L["SettingsGroup:TenantWide:Hint"]</SbText>
                        <SbStack Direction="SbStackDirection.Row" Gap="4" Wrap="true">
                            <div>
                                <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                    @L["MaxConcurrentOpenSessions"]
                                </SbText>
                                <SbHeading Level="5">@Settings.MaxConcurrentOpenSessions</SbHeading>
                            </div>
                            <div>
                                <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                    @L["MaxMessagesPerTenantPerDay"]
                                </SbText>
                                <SbHeading Level="5">@Settings.MaxMessagesPerTenantPerDay</SbHeading>
                            </div>
                        </SbStack>
                    </SbStack>
                </ChildContent>
            </SbCard>

            @* ---- Effective limits per tier ---- *@
            <SbCard>
                <ChildContent>
                    <SbStack Gap="3">
                        <SbHeading Level="6">@L["EffectiveLimitsByTier"]</SbHeading>
                        <SbStack Direction="SbStackDirection.Row" Gap="3" Wrap="true">
                            @foreach (var tier in TierSummaries)
                            {
                                <SbCard Style="flex: 1; min-width: 280px;">
                                    <ChildContent>
                                        <SbStack Gap="2">
                                            <SbStack Direction="SbStackDirection.Row"
                                                     Gap="2"
                                                     Align="SbAlign.Center">
                                                <SbChip Size="SbSize.Sm"
                                                        Color="@tier.Color">
                                                    @L[tier.LabelKey]
                                                </SbChip>
                                            </SbStack>
                                            <SbText Color="SbColor.Muted">
                                                @L["MaxSessionsPerUserPerDay"]:
                                                <strong>@tier.Dto.MaxSessionsPerUserPerDay</strong>
                                            </SbText>
                                            <SbText Color="SbColor.Muted">
                                                @L["MaxMessagesPerSession"]:
                                                <strong>@tier.Dto.MaxMessagesPerSession</strong>
                                            </SbText>
                                            <SbText Color="SbColor.Muted">
                                                @L["MaxAttachmentsPerSession"]:
                                                <strong>@tier.Dto.MaxAttachmentsPerSession</strong>
                                            </SbText>
                                            <SbText Color="SbColor.Muted">
                                                @L["LimitExceededAction"]:
                                                <strong>@L[$"LimitExceededAction:{tier.Dto.LimitExceededAction}"]</strong>
                                            </SbText>
                                        </SbStack>
                                    </ChildContent>
                                </SbCard>
                            }
                        </SbStack>
                    </SbStack>
                </ChildContent>
            </SbCard>
        }

        <SbCard>
            <ChildContent>
                <SbStack Gap="2">
                    <SbHeading Level="6">@L["UsagePoliciesSummary"]</SbHeading>
                    <SbText Color="SbColor.Muted">@L["UsageDashboardHint"]</SbText>
                </SbStack>
            </ChildContent>
        </SbCard>

        @if (CanViewAiUsage)
        {
            <SbDivider />

            <SbHeading Level="5">@L["Permission:AiUsage"]</SbHeading>

            @if (IsOperationLoading(LoadingKeys.LoadAiDashboard))
            {
                <SbProgress Type="SbProgressType.Circular" />
            }
            else if (Dashboard != null && Policy != null)
            {
                @if (AssistantAvailability?.IsAvailable != true)
                {
                    <SbAlert Severity="SbAlertSeverity.Warning">
                        @L[AssistantAvailability?.MessageKey ?? "Chat:AiUnavailable"]
                    </SbAlert>
                }

                <SbStack Direction="SbStackDirection.Row" Gap="4" Wrap="true">
                    <SbCard Style="flex: 1; min-width: 180px;">
                        <ChildContent>
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["AiGuardEnabled"]</SbText>
                            <SbHeading Level="4">@(Policy.UsageGuardEnabled ? L["Enabled"] : L["Disabled"])</SbHeading>
                        </ChildContent>
                    </SbCard>
                    <SbCard Style="flex: 1; min-width: 180px;">
                        <ChildContent>
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["TokensUsedToday"]</SbText>
                            <SbHeading Level="4">@Dashboard.TotalTokens.ToString("N0")</SbHeading>
                        </ChildContent>
                    </SbCard>
                    <SbCard Style="flex: 1; min-width: 180px;">
                        <ChildContent>
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["OpenReservations"]</SbText>
                            <SbHeading Level="4">@Dashboard.ReservedCount.ToString("N0")</SbHeading>
                        </ChildContent>
                    </SbCard>
                    <SbCard Style="flex: 1; min-width: 180px;">
                        <ChildContent>
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["DeniedAiOperations"]</SbText>
                            <SbHeading Level="4">@Dashboard.DeniedCount.ToString("N0")</SbHeading>
                        </ChildContent>
                    </SbCard>
                    <SbCard Style="flex: 1; min-width: 180px;">
                        <ChildContent>
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["TenantDailyTokenQuota"]</SbText>
                            <SbHeading Level="4">@Policy.MaxTokensPerTenantPerDay.ToString("N0")</SbHeading>
                        </ChildContent>
                    </SbCard>
                </SbStack>

                @if (!string.IsNullOrWhiteSpace(Dashboard.AiManagementUsageAnalyticsUrl))
                {
                    <SbLink Href="@Dashboard.AiManagementUsageAnalyticsUrl" Target="_blank">@L["OpenAiManagementUsage"]</SbLink>
                }

                <SbCard>
                    <ChildContent>
                        <SbHeading Level="6">@L["AiReservations"]</SbHeading>
                        <SbDataGrid TItem="ChatAiUsageReservationDto"
                                    Items="Reservations"
                                    Loading="@IsOperationLoading(LoadingKeys.LoadReservations)"
                                    PageIndex="ReservationPageIndex"
                                    PageSize="ReservationPageSize"
                                    TotalCount="ReservationTotalCount"
                                    PageIndexChanged="OnReservationPageChangedAsync"
                                    KeySelector="@(item => item.Id.ToString())"
                                    Class="mt-3">
                            <ChildContent>
                                <SbColumn TItem="ChatAiUsageReservationDto" Field="SessionId" Title="@L["Session"]" />
                                <SbColumn TItem="ChatAiUsageReservationDto" Field="OperationKind" Title="@L["Operation"]" />
                                <SbColumn TItem="ChatAiUsageReservationDto" Field="TotalTokens" Title="@L["Tokens"]" Width="120px" />
                                <SbColumn TItem="ChatAiUsageReservationDto" Field="WorkspaceName" Title="@L["Workspace"]" />
                                <SbColumn TItem="ChatAiUsageReservationDto" Field="DenyReason" Title="@L["DenyReason"]" />
                                <SbColumn TItem="ChatAiUsageReservationDto" Field="ReservedAt" Title="@L["ReservedAt"]" Format="yyyy-MM-dd HH:mm" Width="180px" />
                            </ChildContent>
                        </SbDataGrid>
                    </ChildContent>
                </SbCard>
            }
        }
    </SbStack>
}
