@page "/admin/chat/sessions"
@attribute [Authorize(ChatPermissions.Sessions.Default)]
@inherits ChatComponentBase

<SufiAbpPageToolbar>
    <SbButton Variant="SbButtonVariant.Outline"
              Size="SbSize.Sm"
              OnClick="RefreshAsync"
              Disabled="IsLoading">
        <StartIcon><SbIcon Name="refresh" Size="SbSize.Sm" /></StartIcon>
        <ChildContent>@L["Refresh"]</ChildContent>
    </SbButton>
</SufiAbpPageToolbar>

<SbStack Gap="3">
    @* ---- Filter bar ---- *@
    <SbCard>
        <ChildContent>
            <SbStack Gap="3">
                <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
                    <SbIcon Name="filter" Size="SbSize.Sm" />
                    <SbHeading Level="6">@L["FilterSessions"]</SbHeading>
                </SbStack>
                <SbStack Direction="SbStackDirection.Row" Gap="3" Wrap="true">
                    <div style="flex: 1; min-width: 220px;">
                        <SbSimpleSelect TValue="ChatSessionStatus?"
                                        Value="StatusFilter"
                                        ValueChanged="OnStatusFilterChangedAsync"
                                        Label="@L["Status"]">
                            <SbSelectOption TValue="ChatSessionStatus?" Value="null">
                                @L["Filter:All"]
                            </SbSelectOption>
                            <SbSelectOption TValue="ChatSessionStatus?" Value="ChatSessionStatus.Open">
                                @L["SessionStatus:Open"]
                            </SbSelectOption>
                            <SbSelectOption TValue="ChatSessionStatus?" Value="ChatSessionStatus.Closed">
                                @L["SessionStatus:Closed"]
                            </SbSelectOption>
                        </SbSimpleSelect>
                    </div>
                    <div style="flex: 1; min-width: 220px;">
                        <SbSimpleSelect TValue="ConversationKind?"
                                        Value="ConversationKindFilter"
                                        ValueChanged="OnConversationKindFilterChangedAsync"
                                        Label="@L["ConversationKind"]">
                            <SbSelectOption TValue="ConversationKind?" Value="null">
                                @L["Filter:All"]
                            </SbSelectOption>
                            @foreach (var kind in AllConversationKinds)
                            {
                                <SbSelectOption TValue="ConversationKind?" Value="kind">
                                    @L[$"ConversationKind:{kind}"]
                                </SbSelectOption>
                            }
                        </SbSimpleSelect>
                    </div>
                    <div style="flex: 1; min-width: 220px;">
                        <SbSimpleSelect TValue="AccessMode?"
                                        Value="AccessModeFilter"
                                        ValueChanged="OnAccessModeFilterChangedAsync"
                                        Label="@L["AccessMode"]">
                            <SbSelectOption TValue="AccessMode?" Value="null">
                                @L["Filter:All"]
                            </SbSelectOption>
                            @foreach (var mode in AllAccessModes)
                            {
                                <SbSelectOption TValue="AccessMode?" Value="mode">
                                    @L[$"AccessMode:{mode}"]
                                </SbSelectOption>
                            }
                        </SbSimpleSelect>
                    </div>
                </SbStack>
            </SbStack>
        </ChildContent>
    </SbCard>

    @* ---- Sessions table ---- *@
    <SbCard>
        <ChildContent>
            <SbDataGrid TItem="ChatSessionListDto"
                        Items="Sessions"
                        Loading="IsLoading"
                        Striped="true"
                        Hoverable="true"
                        PageIndex="PageIndex"
                        PageSize="PageSize"
                        TotalCount="TotalCount"
                        PageIndexChanged="OnPageIndexChangedAsync"
                        OnSortChanged="OnSortChangedAsync"
                        KeySelector="@(item => item.Id.ToString())">
                <EmptyTemplate>
                    <SbEmptyState Title="@L["Menu:ChatSessions"]" Description="@L["NoSessionsFound"]" />
                </EmptyTemplate>
                <ChildContent>
                    <SbColumn TItem="ChatSessionListDto" Title="@L["Actions"]" Width="100px" Sortable="false">
                        <CellTemplate Context="cellContext">
                            <SbIconButton Size="SbSize.Sm"
                                          AriaLabel="@L["View"]"
                                          OnClick="@(() => OpenSession(cellContext.Item.Id))">
                                <Icon><SbIcon Name="eye" /></Icon>
                            </SbIconButton>
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="ChatSessionListDto" Field="Title" Title="@L["Title"]" Sortable="true">
                        <CellTemplate Context="cellContext">
                            @(string.IsNullOrWhiteSpace(cellContext.Item.Title)
                                ? (MarkupString)$"<span class=\"text-muted\">{L["Untitled"]}</span>"
                                : (MarkupString)System.Net.WebUtility.HtmlEncode(cellContext.Item.Title))
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="ChatSessionListDto" Field="ConversationKind" Title="@L["ConversationKind"]" Sortable="true" Width="140px">
                        <CellTemplate Context="cellContext">
                            <SbChip Size="SbSize.Sm" Variant="SbChipVariant.Outlined">
                                @L[$"ConversationKind:{cellContext.Item.ConversationKind}"]
                            </SbChip>
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="ChatSessionListDto" Field="AccessMode" Title="@L["AccessMode"]" Sortable="true" Width="160px">
                        <CellTemplate Context="cellContext">
                            <SbChip Size="SbSize.Sm"
                                    Variant="SbChipVariant.Outlined"
                                    Color="@GetAccessModeChipColor(cellContext.Item.AccessMode)">
                                @L[$"AccessMode:{cellContext.Item.AccessMode}"]
                            </SbChip>
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="ChatSessionListDto" Field="Status" Title="@L["Status"]" Sortable="true" Width="120px">
                        <CellTemplate Context="cellContext">
                            <SbChip Size="SbSize.Sm"
                                    Color="@GetStatusChipColor(cellContext.Item.Status)">
                                @L[$"SessionStatus:{cellContext.Item.Status}"]
                            </SbChip>
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="ChatSessionListDto" Field="ParticipantCount" Title="@L["Participants"]" Sortable="true" Width="120px" />
                    <SbColumn TItem="ChatSessionListDto" Field="LastMessageTime" Title="@L["LastMessageTime"]" Sortable="true" Width="180px" Format="yyyy-MM-dd HH:mm" />
                </ChildContent>
            </SbDataGrid>
        </ChildContent>
    </SbCard>
</SbStack>
