@page "/admin/chat/settings"
@attribute [Authorize(ChatPermissions.Settings.Manage)]
@inherits ChatComponentBase

<SufiAbpPageToolbar>
    <SbButton Color="SbColor.Primary" OnClick="SaveAsync" Disabled="@IsOperationLoading(LoadingKeys.Save)">
        @L["Save"]
    </SbButton>
</SufiAbpPageToolbar>

@if (IsOperationLoading(LoadingKeys.Load))
{
    <SbProgress Type="SbProgressType.Circular" />
}
else
{
    <SbTabs @bind-ActiveIndex="ActiveTabIndex">
        <SbTab Label="@L["SettingsTab:General"]">
            <SbCard Class="mt-3">
                <ChildContent>
                    <SbStack Gap="3">
                        <SbNumberField TValue="int" @bind-Value="Settings.MaxConcurrentOpenSessions" Label="@L["MaxConcurrentOpenSessions"]" Min="0" />
                        <SbNumberField TValue="int" @bind-Value="Settings.MaxMessagesPerTenantPerDay" Label="@L["MaxMessagesPerTenantPerDay"]" Min="0" />
                        <SbCheckbox @bind-Value="Settings.RealtimeEnabled" Label="@L["RealtimeEnabled"]" />
                    </SbStack>
                </ChildContent>
            </SbCard>
        </SbTab>

        <SbTab Label="@L["SettingsTab:UsagePolicies"]">
            <SbStack Gap="3" Class="mt-3">
                <SbCard>
                    <ChildContent>
                        <SbStack Gap="3">
                            <SbHeading Level="6">@L["Tier:PublicAnonymous"]</SbHeading>
                            <SbNumberField TValue="int" @bind-Value="Settings.PublicAnonymous.MaxSessionsPerUserPerDay" Label="@L["MaxSessionsPerUserPerDay"]" Min="0" />
                            <SbNumberField TValue="int" @bind-Value="Settings.PublicAnonymous.MaxMessagesPerSession" Label="@L["MaxMessagesPerSession"]" Min="0" />
                            <SbNumberField TValue="int" @bind-Value="Settings.PublicAnonymous.MaxAttachmentsPerSession" Label="@L["MaxAttachmentsPerSession"]" Min="0" />
                        </SbStack>
                    </ChildContent>
                </SbCard>

                <SbCard>
                    <ChildContent>
                        <SbStack Gap="3">
                            <SbHeading Level="6">@L["Tier:PublicAuthenticated"]</SbHeading>
                            <SbNumberField TValue="int" @bind-Value="Settings.PublicAuthenticated.MaxSessionsPerUserPerDay" Label="@L["MaxSessionsPerUserPerDay"]" Min="0" />
                            <SbNumberField TValue="int" @bind-Value="Settings.PublicAuthenticated.MaxMessagesPerSession" Label="@L["MaxMessagesPerSession"]" Min="0" />
                            <SbNumberField TValue="int" @bind-Value="Settings.PublicAuthenticated.MaxAttachmentsPerSession" Label="@L["MaxAttachmentsPerSession"]" Min="0" />
                        </SbStack>
                    </ChildContent>
                </SbCard>

                <SbCard>
                    <ChildContent>
                        <SbStack Gap="3">
                            <SbHeading Level="6">@L["Tier:Internal"]</SbHeading>
                            <SbNumberField TValue="int" @bind-Value="Settings.Internal.MaxSessionsPerUserPerDay" Label="@L["MaxSessionsPerUserPerDay"]" Min="0" />
                            <SbNumberField TValue="int" @bind-Value="Settings.Internal.MaxMessagesPerSession" Label="@L["MaxMessagesPerSession"]" Min="0" />
                            <SbNumberField TValue="int" @bind-Value="Settings.Internal.MaxAttachmentsPerSession" Label="@L["MaxAttachmentsPerSession"]" Min="0" />
                        </SbStack>
                    </ChildContent>
                </SbCard>
            </SbStack>
        </SbTab>

        <SbTab Label="@L["SettingsTab:RateLimits"]">
            <SbCard Class="mt-3">
                <ChildContent>
                    <SbStack Gap="3">
                        <SbHeading Level="6">@L["AnonymousRateLimitsTitle"]</SbHeading>
                        <SbText Color="SbColor.Muted">@L["AnonymousRateLimitsHint"]</SbText>
                        <SbCheckbox @bind-Value="Settings.PublicAnonymous.EnableIpGuard" Label="@L["EnableIpGuard"]" />
                        <SbNumberField TValue="int" @bind-Value="Settings.PublicAnonymous.MaxSessionsPerIpPerDay" Label="@L["MaxSessionsPerIpPerDay"]" Min="0" />
                        <SbNumberField TValue="int" @bind-Value="Settings.PublicAnonymous.MaxMessagesPerIpPerDay" Label="@L["MaxMessagesPerIpPerDay"]" Min="0" />
                        <SbNumberField TValue="int" @bind-Value="Settings.PublicAnonymous.MaxAiSessionsPerIpPerHour" Label="@L["MaxAiSessionsPerIpPerHour"]" Min="0" />
                        <SbNumberField TValue="int" @bind-Value="Settings.PublicAnonymous.MaxMessagesBeforeSignupRequired" Label="@L["MaxMessagesBeforeSignupRequired"]" Min="0" />
                        <SbNumberField TValue="int" @bind-Value="Settings.PublicAnonymous.MaxAiQuestionsBeforeSignupRequired" Label="@L["MaxAiQuestionsBeforeSignupRequired"]" Min="0" />
                    </SbStack>
                </ChildContent>
            </SbCard>
        </SbTab>

        <SbTab Label="@L["SettingsTab:AiQuotas"]">
            <SbCard Class="mt-3">
                <ChildContent>
                    <SbStack Gap="3">
                        <SbCheckbox @bind-Value="Settings.AiEnabled" Label="@L["AiEnabled"]" />
                        <SbCheckbox @bind-Value="Settings.AiUsageGuardEnabled" Label="@L["AiUsageGuardEnabled"]" />
                        <SbNumberField TValue="int" @bind-Value="Settings.MaxRepliesPerSession" Label="@L["MaxRepliesPerSession"]" Min="0" />
                        <SbNumberField TValue="int" @bind-Value="Settings.MaxTokensPerSession" Label="@L["MaxTokensPerSession"]" Min="0" />
                        <SbNumberField TValue="int" @bind-Value="Settings.MaxTokensPerTenantPerDay" Label="@L["MaxTokensPerTenantPerDay"]" Min="0" />
                        <SbNumberField TValue="int" @bind-Value="Settings.MaxAnonymousAiSessionsPerHour" Label="@L["MaxAnonymousAiSessionsPerHour"]" Min="0" />

                        @if (ShowWorkspaceSelector)
                        {
                            <SbSimpleSelect TValue="string"
                                            Value="@SelectedWorkspaceName"
                                            ValueChanged="@((string? value) => SelectedWorkspaceName = value)"
                                            Label="@L["DefaultWorkspaceName"]">
                                @foreach (var option in WorkspaceOptions)
                                {
                                    <SbSelectOption TValue="string" Value="@option.Name">@(option.DisplayName ?? option.Name)</SbSelectOption>
                                }
                            </SbSimpleSelect>
                            <SbButton Variant="SbButtonVariant.Outline" OnClick="SaveWorkspaceSelectionAsync">
                                @L["SaveWorkspaceSelection"]
                            </SbButton>
                        }
                        else
                        {
                            <SbAlert Severity="SbAlertSeverity.Warning">
                                @L[WorkspaceSelection?.MessageKey ?? "Chat:AiUnavailable"]
                            </SbAlert>
                        }

                        <SbButton Variant="SbButtonVariant.Outline" OnClick="OpenAiManagementWorkspaces">
                            @L["ManageAiWorkspaces"]
                        </SbButton>
                    </SbStack>
                </ChildContent>
            </SbCard>
        </SbTab>

        <SbTab Label="@L["SettingsTab:Retention"]">
            <SbCard Class="mt-3">
                <ChildContent>
                    <SbStack Gap="3">
                        <SbNumberField TValue="int" @bind-Value="Settings.MessageRetentionDays" Label="@L["MessageRetentionDays"]" Min="0" />
                        <SbNumberField TValue="int" @bind-Value="Settings.ClosedSessionRetentionDays" Label="@L["ClosedSessionRetentionDays"]" Min="0" />
                        <SbNumberField TValue="int" @bind-Value="Settings.UsageRecordRetentionDays" Label="@L["UsageRecordRetentionDays"]" Min="0" />
                    </SbStack>
                </ChildContent>
            </SbCard>
        </SbTab>

        @if (ShowEmailConnectorTab)
        {
            <SbTab Label="@L["SettingsTab:EmailConnector"]">
                <SbCard Class="mt-3">
                    <ChildContent>
                        <SbStack Gap="3">
                            <SbCheckbox @bind-Value="EmailSettings.Enabled" Label="@L["EmailConnector:Enabled"]" />
                            <SbTextField @bind-Value="EmailSettings.DefaultFromAddress" Label="@L["EmailConnector:DefaultFromAddress"]" />
                            <SbTextField @bind-Value="EmailSettings.ReplyToAddress" Label="@L["EmailConnector:ReplyToAddress"]" />

                            <SbHeading Level="6">@L["SettingsTab:EmailConnector"] — Inbound</SbHeading>
                            <SbSimpleSelect TValue="ChatInboundEmailProtocol"
                                            @bind-Value="EmailSettings.InboundProtocol"
                                            Label="@L["EmailConnector:InboundProtocol"]">
                                <SbSelectOption TValue="ChatInboundEmailProtocol" Value="ChatInboundEmailProtocol.None">None</SbSelectOption>
                                <SbSelectOption TValue="ChatInboundEmailProtocol" Value="ChatInboundEmailProtocol.Imap">IMAP</SbSelectOption>
                                <SbSelectOption TValue="ChatInboundEmailProtocol" Value="ChatInboundEmailProtocol.Pop3">POP3</SbSelectOption>
                            </SbSimpleSelect>
                            <SbTextField @bind-Value="EmailSettings.InboundHost" Label="@L["EmailConnector:InboundHost"]" />
                            <SbNumberField TValue="int" @bind-Value="EmailSettings.InboundPort" Label="@L["EmailConnector:InboundPort"]" Min="1" />
                            <SbCheckbox @bind-Value="EmailSettings.InboundUseSsl" Label="@L["EmailConnector:InboundUseSsl"]" />
                            <SbTextField @bind-Value="EmailSettings.InboundUserName" Label="@L["EmailConnector:InboundUserName"]" />
                            @if (EmailSettings.HasInboundPassword)
                            {
                                <SbText Color="SbColor.Muted">@L["EmailConnector:PasswordConfigured"]</SbText>
                            }
                            <SbTextField @bind-Value="InboundPassword" Label="@L["EmailConnector:InboundPassword"]" InputType="SbInputType.Password" Placeholder="@L["EmailConnector:InboundPasswordHint"]" />

                            <SbHeading Level="6">@L["SettingsTab:EmailConnector"] — SMTP</SbHeading>
                            <SbTextField @bind-Value="EmailSettings.SmtpHost" Label="@L["EmailConnector:SmtpHost"]" />
                            <SbNumberField TValue="int" @bind-Value="EmailSettings.SmtpPort" Label="@L["EmailConnector:SmtpPort"]" Min="1" />
                            <SbCheckbox @bind-Value="EmailSettings.SmtpUseSsl" Label="@L["EmailConnector:SmtpUseSsl"]" />
                            <SbTextField @bind-Value="EmailSettings.SmtpUserName" Label="@L["EmailConnector:SmtpUserName"]" />
                            @if (EmailSettings.HasSmtpPassword)
                            {
                                <SbText Color="SbColor.Muted">@L["EmailConnector:PasswordConfigured"]</SbText>
                            }
                            <SbTextField @bind-Value="SmtpPassword" Label="@L["EmailConnector:SmtpPassword"]" InputType="SbInputType.Password" Placeholder="@L["EmailConnector:SmtpPasswordHint"]" />
                        </SbStack>
                    </ChildContent>
                </SbCard>
            </SbTab>
        }
        else
        {
            <SbTab Label="@L["SettingsTab:EmailConnector"]">
                <SbCard Class="mt-3">
                    <ChildContent>
                        <SbAlert Severity="SbAlertSeverity.Info">@L["EmailConnector:FeatureDisabledHint"]</SbAlert>
                    </ChildContent>
                </SbCard>
            </SbTab>
        }
    </SbTabs>
}
