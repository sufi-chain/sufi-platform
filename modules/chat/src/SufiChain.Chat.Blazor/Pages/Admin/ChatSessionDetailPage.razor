@page "/admin/chat/sessions/{Id:guid}"
@attribute [Authorize(ChatPermissions.Sessions.Default)]
@inherits ChatComponentBase

@if (IsLoading)
{
    <SbProgress Type="SbProgressType.Circular" />
}
else if (Session != null)
{
    <SufiAbpPageToolbar>
        <SbButton Variant="SbButtonVariant.Outline"
                  Size="SbSize.Sm"
                  OnClick="BackToList">
            <StartIcon><SbIcon Name="arrow-left" Size="SbSize.Sm" /></StartIcon>
            <ChildContent>@L["Back"]</ChildContent>
        </SbButton>
        <SbButton Variant="SbButtonVariant.Outline"
                  Size="SbSize.Sm"
                  OnClick="ExportTranscriptAsync"
                  Disabled="IsExporting">
            <StartIcon><SbIcon Name="download" Size="SbSize.Sm" /></StartIcon>
            <ChildContent>@L["ExportTranscript"]</ChildContent>
        </SbButton>
        @if (CanClose && Session.Status == ChatSessionStatus.Open)
        {
            <AuthorizeView Policy="@ChatPermissions.Sessions.Close">
                <Authorized>
                    <SbButton Color="SbColor.Danger"
                              Size="SbSize.Sm"
                              OnClick="CloseSessionAsync"
                              Disabled="IsClosing">
                        <StartIcon><SbIcon Name="x" Size="SbSize.Sm" /></StartIcon>
                        <ChildContent>@L["CloseSession"]</ChildContent>
                    </SbButton>
                </Authorized>
            </AuthorizeView>
        }
    </SufiAbpPageToolbar>

    <SbStack Gap="4">
        @* ---- Header card ---- *@
        <SbCard>
            <ChildContent>
                <SbStack Gap="3">
                    <SbStack Direction="SbStackDirection.Row" Gap="3" Align="SbAlign.Center" Wrap="true">
                        <SbHeading Level="5">
                            @(string.IsNullOrWhiteSpace(Session.Title) ? L["Untitled"] : Session.Title)
                        </SbHeading>
                        <SbChip Size="SbSize.Sm" Color="@GetStatusChipColor(Session.Status)">
                            @L[$"SessionStatus:{Session.Status}"]
                        </SbChip>
                    </SbStack>

                    <SbStack Direction="SbStackDirection.Row" Gap="2" Wrap="true">
                        <SbChip Size="SbSize.Sm" Variant="SbChipVariant.Outlined">
                            @L[$"ConversationKind:{Session.ConversationKind}"]
                        </SbChip>
                        <SbChip Size="SbSize.Sm"
                                Variant="SbChipVariant.Outlined"
                                Color="@GetAccessModeChipColor(Session.AccessMode)">
                            @L[$"AccessMode:{Session.AccessMode}"]
                        </SbChip>
                        <SbChip Size="SbSize.Sm" Variant="SbChipVariant.Outlined">
                            @L[$"ChannelOrigin:{Session.ChannelOrigin}"]
                        </SbChip>
                    </SbStack>

                    <SbStack Direction="SbStackDirection.Row" Gap="4" Wrap="true">
                        <div>
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                @L["Participants"]
                            </SbText>
                            <SbText>@Session.Participants.Count</SbText>
                        </div>
                        <div>
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                @L["CreatedAt"]
                            </SbText>
                            <SbText>@Session.CreationTime.ToString("yyyy-MM-dd HH:mm")</SbText>
                        </div>
                        @if (Session.LastMessageTime.HasValue)
                        {
                            <div>
                                <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                    @L["LastMessageTime"]
                                </SbText>
                                <SbText>@Session.LastMessageTime.Value.ToString("yyyy-MM-dd HH:mm")</SbText>
                            </div>
                        }
                    </SbStack>
                </SbStack>
            </ChildContent>
        </SbCard>

        @* ---- Participants card ---- *@
        @if (Session.Participants.Any())
        {
            <SbCard>
                <ChildContent>
                    <SbStack Gap="3">
                        <SbHeading Level="6">@L["Participants"]</SbHeading>
                        <SbStack Direction="SbStackDirection.Row" Gap="2" Wrap="true">
                            @foreach (var participant in Session.Participants)
                            {
                                <SbChip Size="SbSize.Sm" Variant="SbChipVariant.Outlined">
                                    <StartIcon>
                                        <SbIcon Name="@GetParticipantIcon(participant.ParticipantKind)" Size="SbSize.Sm" />
                                    </StartIcon>
                                    <ChildContent>
                                        @(participant.DisplayName ?? L[$"ParticipantKind:{participant.ParticipantKind}"])
                                    </ChildContent>
                                </SbChip>
                            }
                        </SbStack>
                    </SbStack>
                </ChildContent>
            </SbCard>
        }

        @* ---- Messages card ---- *@
        <SbCard>
            <ChildContent>
                <SbStack Gap="3">
                    <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
                        <SbHeading Level="6">@L["Messages"]</SbHeading>
                        <SbChip Size="SbSize.Sm" Variant="SbChipVariant.Outlined">@Messages.Count</SbChip>
                    </SbStack>

                    @if (!Messages.Any())
                    {
                        <SbEmptyState Title="@L["Messages"]" Description="@L["Messenger:NoMessages"]" />
                    }
                    else
                    {
                        <SbStack Gap="2">
                            @foreach (var message in Messages)
                            {
                                <div class="chat-admin-message">
                                    <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
                                        <SbChip Size="SbSize.Sm" Variant="SbChipVariant.Outlined">
                                            @L[$"SenderKind:{message.SenderKind}"]
                                        </SbChip>
                                        <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                            @message.CreationTime.ToString("yyyy-MM-dd HH:mm")
                                        </SbText>
                                    </SbStack>
                                    <SbText Class="mt-1">@message.Body</SbText>
                                </div>
                            }
                        </SbStack>
                    }
                </SbStack>
            </ChildContent>
        </SbCard>

        @* ---- Conversation links ---- *@
        @if (Links.Any())
        {
            <SbCard>
                <ChildContent>
                    <SbStack Gap="3">
                        <SbHeading Level="6">@L["ConversationLinks"]</SbHeading>
                        <SbStack Gap="1">
                            @foreach (var link in Links)
                            {
                                <SbText>
                                    <SbIcon Name="link" Size="SbSize.Sm" />
                                    @link.LinkedEntityType · @link.LinkedEntityId
                                </SbText>
                            }
                        </SbStack>
                    </SbStack>
                </ChildContent>
            </SbCard>
        }

        @* ---- Transcript ---- *@
        @if (!string.IsNullOrWhiteSpace(TranscriptText))
        {
            <SbCard>
                <ChildContent>
                    <SbStack Gap="3">
                        <SbHeading Level="6">@L["Transcript"]</SbHeading>
                        <pre class="chat-transcript">@TranscriptText</pre>
                    </SbStack>
                </ChildContent>
            </SbCard>
        }
    </SbStack>
}
