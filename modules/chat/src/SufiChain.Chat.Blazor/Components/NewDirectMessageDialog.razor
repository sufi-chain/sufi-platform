@inherits ChatComponentBase

<SbDialog Open="@Open" OpenChanged="@OnOpenChangedAsync" Size="SbDialogSize.Md" Title="@L["Menu:NewDirectMessage"]">
    <ChildContent>
        <SbStack Gap="3">
            <SbTextField @bind-Value="FilterText"
                         @bind-Value:after="OnFilterTextChangedAsync"
                         Label="@L["Filter"]"
                         Placeholder="@L["SearchContacts"]"
                         Clearable="true" />

            @if (IsLoading)
            {
                <SbProgress Type="SbProgressType.Circular" />
            }
            else if (!CanSearch)
            {
                <SbText Color="SbColor.Muted">@L["SearchContactsMinLength"]</SbText>
            }
            else if (!Contacts.Any())
            {
                <SbText Color="SbColor.Muted">@L["NoContactsFound"]</SbText>
            }
            else
            {
                <SbStack Gap="1">
                    @foreach (var contact in Contacts)
                    {
                        <SbButton Variant="SbButtonVariant.Outline" OnClick="@(() => SelectContactAsync(contact))">
                            @(contact.DisplayName ?? contact.UserName ?? contact.Email)
                        </SbButton>
                    }
                </SbStack>
            }
        </SbStack>
    </ChildContent>
    <Footer>
        <SbButton Variant="SbButtonVariant.Outline" OnClick="CloseAsync">@L["Cancel"]</SbButton>
    </Footer>
</SbDialog>
