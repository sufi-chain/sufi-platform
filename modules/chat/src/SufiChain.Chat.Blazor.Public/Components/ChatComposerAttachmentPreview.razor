@inherits ChatPublicComponentBase

@if (Items.Any())
{
    <div class="chat-composer-preview">
        @foreach (var item in Items)
        {
            <div class="chat-composer-preview__chip">
                <span>@item.Label</span>
                <SbIconButton Size="SbSize.Xs"
                              Color="SbColor.Default"
                              Class="chat-composer-preview__remove"
                              AriaLabel="@L["Composer:RemoveAttachment"]"
                              OnClick="@(() => OnRemove.InvokeAsync(item))">
                    <Icon><SbIcon Name="x" Size="SbSize.Xs" /></Icon>
                </SbIconButton>
            </div>
        }
    </div>
}
