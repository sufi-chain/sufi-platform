@inherits ChatPublicComponentBase

<div class="chat-session-context-panel @Class">
    @if (PanelHeader != null)
    {
        <div class="chat-session-context-panel__actions @(Session != null ? "chat-session-context-panel__actions--with-details" : null)">
            @PanelHeader
        </div>
    }

    @if (Session != null)
    {
        <div class="chat-session-context-panel__details">
            <SbHeading Level="6">@L["Messenger:SessionDetails"]</SbHeading>

            @if (ContextPanel != null)
            {
                @ContextPanel
            }
            else
            {
                <SbStack Gap="2" Class="chat-session-context-panel__content">
                    <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">
                        @L[$"Messenger:Kind:{Session.ConversationKind}"] · @L[$"Messenger:AccessMode:{Session.AccessMode}"]
                    </SbText>
                    <SbText Weight="SbFontWeight.Medium">@L["Messenger:Participants"]</SbText>
                    @if (Session.Participants.Any(participant => participant.LeftAt == null))
                    {
                        <SbStack Gap="1">
                            @foreach (var participant in Session.Participants.Where(participant => participant.LeftAt == null))
                            {
                                <SbText Variant="SbTextVariant.BodySmall">
                                    @(participant.DisplayName ?? L["Messenger:Sender:Participant"])
                                </SbText>
                            }
                        </SbStack>
                    }
                    else
                    {
                        <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">0</SbText>
                    }
                </SbStack>
            }
        </div>
    }
</div>
