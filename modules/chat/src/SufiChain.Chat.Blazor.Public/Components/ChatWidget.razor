@inherits ChatPublicComponentBase

<div class="chat-widget @Class">
    @if (_isOpen)
    {
        <div class="chat-widget__panel">
            <SbStack Direction="SbStackDirection.Row"
                     Align="SbAlign.Center"
                     Justify="SbJustify.SpaceBetween"
                     Gap="2"
                     Class="chat-widget__panel-header">
                <SbHeading Level="6">@L["Widget:Title"]</SbHeading>
                <SbIconButton Size="SbSize.Sm"
                              Variant="SbButtonVariant.Ghost"
                              AriaLabel="@L["Widget:Close"]"
                              OnClick="CloseWidget">
                    <Icon><SbIcon Name="x" Size="SbSize.Sm" /></Icon>
                </SbIconButton>
            </SbStack>

            <div class="chat-widget__panel-body">
                <ChatMessengerShell State="@State"
                                      ShowContextPanel="false"
                                      SignInUrl="@SignInUrl"
                                      OnSessionSelected="@OnSessionSelected"
                                      OnSendMessage="@OnSendMessage"
                                      ConversationListSections="@ConversationListSections"
                                      ListHeader="@ListHeader"
                                      ListFooter="@ListFooter"
                                      ItemTemplate="@ItemTemplate"
                                      ItemTrailing="@ItemTrailing"
                                      HeaderActions="@HeaderActions"
                                      ComposerToolbar="@ComposerToolbar"
                                      MessageActions="@MessageActions"
                                      EmptySelection="@EmptySelection"
                                      EmptyTemplate="@EmptyTemplate" />
            </div>
        </div>
    }

    <SbIconButton Class="chat-widget__launcher"
                  Size="SbSize.Lg"
                  Variant="SbButtonVariant.Solid"
                  Color="SbColor.Primary"
                  AriaLabel="@(_isOpen ? L["Widget:Close"] : L["Widget:Open"])"
                  OnClick="ToggleWidget">
        <Icon><SbIcon Name="message-circle" Size="SbSize.Md" /></Icon>
    </SbIconButton>
</div>
