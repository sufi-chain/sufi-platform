@inherits ChatPublicComponentBase

<div class="chat-conversation-list @Class">
    @if (ListHeader != null)
    {
        <div class="chat-conversation-list__header">
            @ListHeader
        </div>
    }
    else
    {
        <div class="chat-conversation-list__header">
            <SbHeading Level="6">@L["Messenger:Conversations"]</SbHeading>
        </div>
    }

    @if (ConversationListSections != null)
    {
        <div class="chat-conversation-list__sections">
            @ConversationListSections
        </div>
    }

    @if (IsLoading)
    {
        <div class="chat-conversation-list__loading">
            <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@L["Messenger:Loading"]</SbText>
        </div>
    }
    else if (!Sessions.Any())
    {
        @if (EmptyTemplate != null)
        {
            @EmptyTemplate
        }
        else
        {
            <div class="chat-conversation-list__empty">
                <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@L["Messenger:SelectConversationDescription"]</SbText>
            </div>
        }
    }
    else
    {
        <ul class="chat-conversation-list__items">
            @foreach (var session in Sessions)
            {
                <li class="chat-conversation-list__item @(IsSelected(session) ? "chat-conversation-list__item--selected" : string.Empty)">
                    <SbButton Variant="SbButtonVariant.Ghost"
                              FullWidth="true"
                              Class="chat-conversation-list__item-button"
                              OnClick="@(() => SelectSessionAsync(session))">
                        @if (ItemTemplate != null)
                        {
                            @ItemTemplate(session)
                        }
                        else
                        {
                            <div class="chat-conversation-list__item-body">
                                <SbText Weight="SbFontWeight.Medium">@GetSessionTitle(session)</SbText>
                                @if (session.LastMessageTime.HasValue)
                                {
                                    <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                        @session.LastMessageTime.Value.ToLocalTime().ToString("g")
                                    </SbText>
                                }
                            </div>
                        }

                        @if (ItemTrailing != null)
                        {
                            <div class="chat-conversation-list__item-trailing">
                                @ItemTrailing(session)
                            </div>
                        }
                    </SbButton>
                </li>
            }
        </ul>
    }

    @if (ListFooter != null)
    {
        <div class="chat-conversation-list__footer">
            @ListFooter
        </div>
    }
</div>
