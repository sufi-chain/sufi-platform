@inherits ChatPublicComponentBase

<SbIconButton Size="SbSize.Sm"
              Color="@(IsRecording ? SbColor.Danger : SbColor.Default)"
              Class="@(IsRecording ? "chat-composer-icon-btn--recording" : string.Empty)"
              Disabled="@IsDisabled"
              Title="@L["Composer:VoiceMessage"]"
              AriaLabel="@L["Composer:VoiceMessage"]"
              @onpointerdown="StartAsync"
              @onpointerup="StopAsync"
              @onpointerleave="StopAsync">
    <Icon><SbIcon Name="microphone" /></Icon>
</SbIconButton>
