@inherits ChatPublicComponentBase

<div @ref="_anchorRef" class="chat-composer-popover-anchor">
    <SbIconButton Size="SbSize.Sm"
                  Color="SbColor.Default"
                  Title="@L["Composer:Attach"]"
                  AriaLabel="@L["Composer:Attach"]"
                  OnClick="ToggleMenuAsync">
        <Icon><SbIcon Name="paperclip" /></Icon>
    </SbIconButton>

    @if (_isOpen)
    {
        <div @ref="_popoverRef" class="chat-composer-popover chat-composer-popover--overlay">
            @if (Capabilities?.CanAttachFiles == true)
            {
                <label for="@PhotoInputId" class="chat-composer-popover__item chat-composer-popover__file" @onclick="CloseMenuAsync">
                    <SbIcon Name="image" />
                    <span>@L["Composer:PhotoOrVideo"]</span>
                </label>
                <label for="@DocumentInputId" class="chat-composer-popover__item chat-composer-popover__file" @onclick="CloseMenuAsync">
                    <SbIcon Name="file" />
                    <span>@L["Composer:Document"]</span>
                </label>
            }

            @if (Capabilities?.CanShareLocation == true)
            {
                <SbButton Variant="SbButtonVariant.Solid" Size="SbSize.Sm" OnClick="SelectLocationAsync" Class="chat-composer-popover__item">
                    <StartIcon><SbIcon Name="pin" /></StartIcon>
                    <ChildContent>@L["Composer:Location"]</ChildContent>
                </SbButton>
            }
        </div>
    }
</div>
