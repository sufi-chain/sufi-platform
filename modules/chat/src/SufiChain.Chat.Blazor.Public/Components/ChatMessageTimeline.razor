@inherits ChatPublicComponentBase

<div class="chat-message-timeline @GetTimelineClass()" dir="@DocumentDirection">
    @if (IsLoading)
    {
        <div class="chat-message-timeline__loading">
            <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@L["Messenger:Loading"]</SbText>
        </div>
    }
    else if (!Messages.Any())
    {
        <div class="chat-message-timeline__empty">
            <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@L["Messenger:NoMessages"]</SbText>
        </div>
    }
    else
    {
        <div class="chat-message-timeline__messages" dir="@GetMessagesDirection()">
            @foreach (var message in Messages)
            {
                var senderClass = GetSenderClass(message);

                <div class="chat-message-timeline__message chat-message-timeline__message--@senderClass" dir="@DocumentDirection">
                    @if (ShouldShowSenderHeader(message))
                    {
                        @if (UsePeerParticipantLayout)
                        {
                            <SbText Variant="SbTextVariant.Caption"
                                    Weight="SbFontWeight.Medium"
                                    Color="SbColor.Muted"
                                    Class="chat-message-timeline__sender-name">
                                @GetSenderLabel(message)
                            </SbText>
                        }
                        else
                        {
                            <div class="chat-message-timeline__meta">
                                <SbChip Size="SbSize.Sm"
                                        Variant="SbChipVariant.Outlined"
                                        Color="@GetSenderChipColor(message)">
                                    @GetSenderLabel(message)
                                </SbChip>
                                <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
                                    @message.CreationTime.ToLocalTime().ToString("g")
                                </SbText>
                            </div>
                        }
                    }

                    <div class="chat-message-timeline__bubble-row">
                        <SbSurface Elevation="0"
                                   Outlined="@IsSupportBubbleOutlined(message)"
                                   Background="@GetBubbleBackground(message)"
                                   Padding="10px 14px"
                                   Class="@GetBubbleClass(message)">
                            @if (!string.IsNullOrWhiteSpace(message.Body))
                            {
                                <SbText>@message.Body</SbText>
                            }

                            @{
                                var metadata = GetMessageMetadata(message);
                            }

                            @if (metadata?.ContentKind == ChatMessageContentKind.Location && metadata.Location != null)
                            {
                                <div class="chat-message-timeline__location-card">
                                    <a href="@GetLocationUrl(metadata.Location)" target="_blank" rel="noopener noreferrer">
                                        @L["Composer:ViewLocation"]
                                    </a>
                                </div>
                            }

                            @if (message.AttachmentFileIds.Any())
                            {
                                <div class="chat-message-timeline__attachments">
                                    @foreach (var fileId in message.AttachmentFileIds)
                                    {
                                        @if (metadata?.ContentKind == ChatMessageContentKind.Voice)
                                        {
                                            <div class="chat-message-timeline__voice">
                                                <audio controls src="@GetAttachmentStreamUrl(fileId)"></audio>
                                            </div>
                                        }
                                        else
                                        {
                                            <FileImage FileId="@fileId" />
                                            <FileDownloadLink FileId="@fileId" />
                                        }
                                    }
                                </div>
                            }
                        </SbSurface>
                        <SbText Variant="SbTextVariant.Caption"
                                Color="SbColor.Muted"
                                Class="chat-message-timeline__timestamp">
                            @message.CreationTime.ToLocalTime().ToString("t")
                        </SbText>
                    </div>

                    @if (MessageActions != null)
                    {
                        <div class="chat-message-timeline__actions">
                            @MessageActions(message)
                        </div>
                    }
                </div>
            }

            @* Show "Thinking..." indicator AFTER all messages, not inside the loop *@
            @if (IsWaitingForAiResponse)
            {
                <div class="chat-message-timeline__message chat-message-timeline__message--assistant" dir="@DocumentDirection">
                    <div class="chat-message-timeline__bubble-row">
                        <SbSurface Elevation="0"
                                   Outlined="true"
                                   Background="var(--sb-color-surface)"
                                   Padding="10px 14px"
                                   Class="chat-message-timeline__bubble">
                            <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
                                <SbProgress Indeterminate="true" Size="SbSize.Sm" style="width: 60px;" />
                                <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">
                                    @L["Messenger:AiThinking"]
                                </SbText>
                            </SbStack>
                        </SbSurface>
                    </div>
                </div>
            }
        </div>
    }
</div>
