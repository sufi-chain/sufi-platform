<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiPlatform.ShortLinks.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.ShortLinks.Blazor</PackageId>
    <Description>Short link generator module Blazor UI components for Sufi Platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resolve version conflict with SufiBlazor -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftAspNetCoreComponentsWebVersion)" />
    <!-- Blazor Authorization -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCoreVersion)" />
    <PackageReference Include="Volo.Abp.Mapperly" Version="$(AbpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sufi Framework (transitively provides SufiChain.SufiPlatform.UI.Abstractions and SufiChain.SufiBlazor) -->
    <ProjectReference Include="../../../../framework/SufiChain.SufiPlatform.UI.Blazor/SufiChain.SufiPlatform.UI.Blazor.csproj" />
    <!-- Short Link Generator Application.Contracts and Domain.Shared (localization) -->
    <ProjectReference Include="../SufiChain.SufiPlatform.ShortLinks.Application.Contracts/SufiChain.SufiPlatform.ShortLinks.Application.Contracts.csproj" />
    <ProjectReference Include="../../../settings/src/SufiChain.SufiPlatform.Settings.Blazor/SufiChain.SufiPlatform.Settings.Blazor.csproj" />
  </ItemGroup>

</Project>
