@page "/account/forgot-password"
@layout AccountLayout
@using SufiChain.SufiAbp.Account.Blazor.Components

<div class="account-page">
    <SbCard Class="account-card">
        <ChildContent>
            <SbStack Gap="4" Align="SbAlign.Center">
                <SbHeading Level="2">@L["ForgotPassword"]</SbHeading>
                <SbText Color="SbColor.Muted">@AccountL["ForgotPasswordInstructions"]</SbText>

                <form method="post" @onsubmit="OnSubmitAsync" @formname="forgot-password" class="w-full">
                    <AntiforgeryToken />
                    <SbStack Gap="3">
                        <SbFormField Label="@L["Email"]" InputId="Email" Required="true">
                            <SbTextField @bind-Value="Input.Email"
                                         Id="Email"
                                         Type="email"
                                         Placeholder="@L["EnterEmail"]"
                                         AutoComplete="email"
                                         name="Input.Email" />
                        </SbFormField>
                        <SufiAbpCaptcha @bind-CaptchaChallengeId="CaptchaChallengeId"
                                        @bind-CaptchaAnswer="CaptchaAnswer"
                                        @bind-CaptchaToken="CaptchaToken" />
                        @if (!string.IsNullOrEmpty(SuccessMessage))
                        {
                            <SbAlert Severity="SbAlertSeverity.Success">@SuccessMessage</SbAlert>
                        }
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <SbAlert Severity="SbAlertSeverity.Danger">@ErrorMessage</SbAlert>
                        }
                        <SbButton Type="submit" Color="SbColor.Primary" FullWidth="true" Loading="IsSubmitting">
                            @AccountL["SendResetLink"]
                        </SbButton>
                    </SbStack>
                </form>

                <SbLink Href="/account/login">@L["SignIn"]</SbLink>
            </SbStack>
        </ChildContent>
    </SbCard>
</div>
