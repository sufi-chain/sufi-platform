@page "/account/email-confirmation-sent"
@layout AccountLayout
@using SufiChain.SufiAbp.Account.Blazor.Components

<div class="account-page">
    <SbCard Class="account-card">
        <ChildContent>
            <SbStack Gap="4" Align="SbAlign.Center">
                <SbHeading Level="2">@AccountL["EmailConfirmationSentTitle"]</SbHeading>
                <SbText>@AccountL["EmailConfirmationSentMessage"]</SbText>

                @if (!string.IsNullOrWhiteSpace(Email))
                {
                    <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@Email</SbText>
                }

                <form method="post" @onsubmit="OnResendAsync" @formname="resend-confirmation" class="w-full">
                    <AntiforgeryToken />
                    <SbStack Gap="3">
                        <SbFormField Label="@L["Email"]" InputId="ResendEmail" Required="true">
                            <SbTextField @bind-Value="ResendEmail"
                                         Id="ResendEmail"
                                         Type="email"
                                         Placeholder="@L["EnterEmail"]"
                                         AutoComplete="email"
                                         name="ResendEmail" />
                        </SbFormField>
                        <SufiAbpCaptcha @bind-CaptchaChallengeId="CaptchaChallengeId"
                                        @bind-CaptchaAnswer="CaptchaAnswer"
                                        @bind-CaptchaToken="CaptchaToken" />
                        @if (!string.IsNullOrEmpty(SuccessMessage))
                        {
                            <SbAlert Severity="SbAlertSeverity.Success">@SuccessMessage</SbAlert>
                        }
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <SbAlert Severity="SbAlertSeverity.Danger">@ErrorMessage</SbAlert>
                        }
                        <SbButton Type="submit" Color="SbColor.Primary" FullWidth="true" Loading="IsSubmitting">
                            @AccountL["ResendConfirmationEmail"]
                        </SbButton>
                    </SbStack>
                </form>

                <SbLink Href="/account/login">@L["SignIn"]</SbLink>
            </SbStack>
        </ChildContent>
    </SbCard>
</div>
