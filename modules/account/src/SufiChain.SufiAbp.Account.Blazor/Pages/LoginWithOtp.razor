@page "/account/login-otp"
@layout AccountLayout
@using SufiChain.SufiAbp.Account.Blazor.Components

<div class="account-page">
    <SbCard Class="account-card">
        <ChildContent>
            <SbStack Gap="4" Align="SbAlign.Center">
                <SbHeading Level="2">@AccountL["LoginWithOtp"]</SbHeading>
                <SbText Color="SbColor.Muted">@AccountL["LoginWithOtpInstructions"]</SbText>

                @if (Options is { IsEnabled: false } or { AllowLogin: false })
                {
                    <SbAlert Severity="SbAlertSeverity.Warning">@(ErrorMessage ?? AccountL["OtpLoginDisabled"])</SbAlert>
                    <SbLink Href="/account/login">@L["SignIn"]</SbLink>
                }
                else
                {
                    <SbStack Gap="3" class="w-full">
                        @if (ShowChannelPicker)
                        {
                            <SbFormField Label="@AccountL["OtpDeliveryChannel"]" InputId="OtpChannel">
                                <SbSimpleSelect TValue="VerificationDeliveryChannel"
                                                @bind-Value="SelectedChannel"
                                                Id="OtpChannel">
                                    @foreach (var channel in Options!.AvailableChannels)
                                    {
                                        <SbSelectOption TValue="VerificationDeliveryChannel" Value="@channel">
                                            @GetChannelLabel(channel)
                                        </SbSelectOption>
                                    }
                                </SbSimpleSelect>
                            </SbFormField>
                        }

                        <SbFormField Label="@IdentifierLabel" InputId="Identifier" Required="true">
                            <SbTextField @bind-Value="Identifier"
                                         Id="Identifier"
                                         Type="@IdentifierInputType"
                                         Placeholder="@IdentifierPlaceholder"
                                         AutoComplete="@IdentifierAutoComplete" />
                        </SbFormField>

                        @if (!CodeSent)
                        {
                            <SufiAbpCaptcha @bind-CaptchaChallengeId="CaptchaChallengeId"
                                            @bind-CaptchaAnswer="CaptchaAnswer"
                                            @bind-CaptchaToken="CaptchaToken" />
                            <SbButton Type="button"
                                      Color="SbColor.Primary"
                                      FullWidth="true"
                                      Loading="IsBusy"
                                      OnClick="OnSendCodeAsync">
                                @AccountL["SendOtpCode"]
                            </SbButton>
                        }
                        else
                        {
                            <SbFormField Label="@AccountL["OtpCode"]" InputId="Code" Required="true">
                                <SbTextField @bind-Value="Code"
                                             Id="Code"
                                             Type="text"
                                             Placeholder="@AccountL["OtpCodePlaceholder"]"
                                             AutoComplete="one-time-code" />
                            </SbFormField>
                            <SbCheckbox @bind-Value="RememberMe" Label="@L["RememberMe"]" />
                            <SbButton Type="button"
                                      Color="SbColor.Primary"
                                      FullWidth="true"
                                      Loading="IsBusy"
                                      OnClick="OnVerifyAsync">
                                @L["SignIn"]
                            </SbButton>
                        }

                        @if (!string.IsNullOrEmpty(SuccessMessage))
                        {
                            <SbAlert Severity="SbAlertSeverity.Success">@SuccessMessage</SbAlert>
                        }
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <SbAlert Severity="SbAlertSeverity.Danger">@ErrorMessage</SbAlert>
                        }
                    </SbStack>

                    <SbLink Href="/account/login">@L["SignInWithPassword"]</SbLink>
                }
            </SbStack>
        </ChildContent>
    </SbCard>
</div>
