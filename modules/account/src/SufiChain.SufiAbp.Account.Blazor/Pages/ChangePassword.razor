@page "/account/change-password"
@attribute [Authorize]
@inject IProfileAppService ProfileAppService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SufiAbpIdentityResource> L

<SbCard>
    <ChildContent>
        <EditForm Model="_model" OnValidSubmit="OnChangePasswordAsync">
            <DataAnnotationsValidator />
            
            <SbStack Gap="3" class="p-4">
                <SbTextField @bind-Value="_model.CurrentPassword" 
                             Label="@L["CurrentPassword"]" 
                             Type="password"
                             Required="true"
                             AutoComplete="current-password" />
                
                <SbTextField @bind-Value="_model.NewPassword" 
                             Label="@L["NewPassword"]" 
                             Type="password"
                             Required="true"
                             AutoComplete="new-password" />
                
                <SbTextField @bind-Value="_model.ConfirmPassword" 
                             Label="@L["ConfirmPassword"]" 
                             Type="password"
                             Required="true"
                             AutoComplete="new-password" />

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <SbAlert Severity="SbAlertSeverity.Success">@_successMessage</SbAlert>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <SbAlert Severity="SbAlertSeverity.Danger">@_errorMessage</SbAlert>
                }

                <SbStack Direction="SbStackDirection.Row" Justify="SbJustify.End">
                    <SbButton Type="submit" Color="SbColor.Primary" Loading="_loading">
                        @L["Menu:ChangePassword"]
                    </SbButton>
                </SbStack>
            </SbStack>
        </EditForm>
    </ChildContent>
</SbCard>

@code {
    private ChangePasswordModel _model = new();
    private bool _loading;
    private string? _successMessage;
    private string? _errorMessage;

    private async Task OnChangePasswordAsync()
    {
        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errorMessage = L["PasswordsDoNotMatch"];
            return;
        }
        
        _loading = true;
        _successMessage = null;
        _errorMessage = null;
        
        try
        {
            await ProfileAppService.ChangePasswordAsync(new ChangePasswordInput
            {
                CurrentPassword = _model.CurrentPassword,
                NewPassword = _model.NewPassword
            });
            
            _successMessage = L["PasswordChangedSuccessfully"];
            _model = new ChangePasswordModel();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    public class ChangePasswordModel
    {
        [Required]
        public string CurrentPassword { get; set; } = "";
        
        [Required]
        [MinLength(6)]
        public string NewPassword { get; set; } = "";
        
        [Required]
        [Compare(nameof(NewPassword))]
        public string ConfirmPassword { get; set; } = "";
    }
}
