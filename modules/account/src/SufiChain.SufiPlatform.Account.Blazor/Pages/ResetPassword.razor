@namespace SufiChain.SufiPlatform.Account.Blazor.Pages
@page "/account/reset-password"
@layout AccountLayout

<div class="account-page">
    <SbCard Class="account-card">
        <ChildContent>
            <SbStack Gap="4" Align="SbAlign.Center">
                <SbHeading Level="2">@AccountL["ResetPassword"]</SbHeading>

                @if (IsCheckingToken)
                {
                    <SbText Color="SbColor.Muted">@AccountL["ResetPasswordValidating"]</SbText>
                }
                else if (!IsTokenValid)
                {
                    <SbAlert Severity="SbAlertSeverity.Danger">@(ErrorMessage ?? AccountL["ResetPasswordInvalidLink"])</SbAlert>
                    <SbLink Href="/account/forgot-password">@L["ForgotPassword"]</SbLink>
                }
                else
                {
                    <form method="post" @onsubmit="OnSubmitAsync" @formname="reset-password" class="w-full">
                        <AntiforgeryToken />
                        <SbStack Gap="3">
                            <SbFormField Label="@L["NewPassword"]" InputId="Password" Required="true">
                                <SbTextField @bind-Value="Input.Password"
                                             Id="Password"
                                             Type="password"
                                             Placeholder="@L["CreatePassword"]"
                                             AutoComplete="new-password"
                                             name="Input.Password" />
                            </SbFormField>
                            <SbFormField Label="@L["ConfirmPassword"]" InputId="ConfirmPassword" Required="true">
                                <SbTextField @bind-Value="Input.ConfirmPassword"
                                             Id="ConfirmPassword"
                                             Type="password"
                                             Placeholder="@L["ConfirmPassword"]"
                                             AutoComplete="new-password"
                                             name="Input.ConfirmPassword" />
                            </SbFormField>
                            @if (!string.IsNullOrEmpty(ErrorMessage))
                            {
                                <SbAlert Severity="SbAlertSeverity.Danger">@ErrorMessage</SbAlert>
                            }
                            <SbButton Type="submit" Color="SbColor.Primary" FullWidth="true" Loading="IsSubmitting">
                                @AccountL["ResetPassword"]
                            </SbButton>
                        </SbStack>
                    </form>
                }

                <SbLink Href="/account/login">@L["SignIn"]</SbLink>
            </SbStack>
        </ChildContent>
    </SbCard>
</div>
