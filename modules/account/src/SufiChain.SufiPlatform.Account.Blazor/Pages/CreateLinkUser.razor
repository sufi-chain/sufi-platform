@namespace SufiChain.SufiPlatform.Account.Blazor.Pages
@page "/account/link-user"
@attribute [Authorize]
@layout AccountLayout

<div class="account-page">
    <SbCard Class="account-card">
        <ChildContent>
            <SbStack Gap="4" Align="SbAlign.Center">
                <SbHeading Level="2">@AccountL["LinkedAccounts"]</SbHeading>

                @if (IsProcessing)
                {
                    <SbStack Align="SbAlign.Center" Gap="2">
                        <SbProgress Indeterminate="true"
                                    aria-label="@AccountL["LinkAccountProcessing"]"
                                    Type="SbProgressType.Circular" />
                        <SbText Color="SbColor.Muted">@AccountL["LinkAccountProcessing"]</SbText>
                    </SbStack>
                }
                else if (IsSuccess)
                {
                    <SbAlert Severity="SbAlertSeverity.Success">@AccountL["LinkAccountSucceeded"]</SbAlert>
                    <SbButton Color="SbColor.Primary" OnClick="GoToLinkedAccounts">
                        @AccountL["Menu:LinkedAccounts"]
                    </SbButton>
                }
                else if (IsSameUser)
                {
                    <SbAlert Severity="SbAlertSeverity.Warning">@AccountL["LinkAccountSameUser"]</SbAlert>
                    <SbButton Color="SbColor.Primary" OnClick="SignInAsOtherAccount">
                        @AccountL["LinkAccountSignInOther"]
                    </SbButton>
                }
                else
                {
                    <SbAlert Severity="SbAlertSeverity.Danger">@(ErrorMessage ?? AccountL["LinkAccountFailed"])</SbAlert>
                    <SbButton Color="SbColor.Primary" OnClick="GoToLinkedAccounts">
                        @AccountL["Menu:LinkedAccounts"]
                    </SbButton>
                }
            </SbStack>
        </ChildContent>
    </SbCard>
</div>
