@page "/account/login"
@layout AccountLayout
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using SufiChain.SufiPlatform.Identity
@using SufiChain.SufiPlatform.Identity.AspNetCore
@using SufiChain.SufiPlatform.Account.Localization
@using SufiChain.SufiPlatform.UI.Abstractions.Account
@inject SignInManager<SufiChain.SufiPlatform.Identity.IdentityUser> SignInManager
@inject IdentityUserManager UserManager
@inject IAccountSecurityLogAppService SecurityLogAppService
@inject IAuthenticationSchemeProvider SchemeProvider
@inject IStringLocalizer<SufiIdentityResource> L
@inject IStringLocalizer<SufiAccountResource> AccountL
@inject NavigationManager Navigation
@inject ILoginCompletionTokenStore TokenStore
@inject ITwoFactorPendingLoginStore TwoFactorPendingStore
@inject IAccountTwoFactorAppService TwoFactorAppService

@*
    Login page: works in Static SSR and Interactive Server hosts.
    Interactive Server: enhanced form (@onsubmit); on success we create a one-time token and
    full-page navigate to /account/complete-login so the cookie is set in an HTTP request.
    Static SSR / no token store: on success we use HttpContext.Response.Redirect.
*@

<div class="account-page">
	<SbStack Gap="4" Align="SbAlign.Center">
		<SbHeading Level="2">@L["SignIn"]</SbHeading>

		<form method="post" @onsubmit="HandleLogin" @formname="login" class="w-full">
			<AntiforgeryToken />
			<input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

			<SbStack Gap="3">
				<SbFormField Label="@L["UsernameOrEmail"]" InputId="UserNameOrEmail" Required="true">
					<SbTextField @bind-Value="Input.UserNameOrEmail"
								 Id="UserNameOrEmail"
								 Type="text"
								 Placeholder="@L["EnterUsernameOrEmail"]"
								 AutoComplete="username"
								 name="Input.UserNameOrEmail" />
				</SbFormField>

				<SbFormField Label="@L["Password"]" InputId="Password" Required="true">
					<SbTextField @bind-Value="Input.Password"
								 Id="Password"
								 Type="password"
								 Placeholder="@L["EnterPassword"]"
								 AutoComplete="current-password"
								 name="Input.Password" />
				</SbFormField>

				<SbStack Direction="SbStackDirection.Row" Justify="SbJustify.SpaceBetween" Gap="4" Align="SbAlign.Center">
					<SbCheckbox @bind-Value="Input.RememberMe"
								Label="@L["RememberMe"]"
								name="Input.RememberMe" />
					<SbLink Href="/account/forgot-password">@L["ForgotPassword"]</SbLink>
				</SbStack>

				@if (!string.IsNullOrEmpty(ErrorMessage))
				{
					<SbAlert Severity="SbAlertSeverity.Danger">@ErrorMessage</SbAlert>
				}

				<SbButton Type="submit" Color="SbColor.Primary" FullWidth="true">
					@L["SignIn"]
				</SbButton>
			</SbStack>
		</form>

		@* External auth: uses schemes configured in host (e.g. DemoAppModule) and POSTs to /Account/ExternalLogin *@
		<ExternalAuthButtons EnabledProviders="@_externalProviderNames"
		                       ReturnUrl="@(ReturnUrl ?? "/")" />

		<SbStack Gap="2" Align="SbAlign.Center">
			<SbLink Href="/account/login-otp">@AccountL["SignInWithCode"]</SbLink>
			<SbStack Direction="SbStackDirection.Row" Gap="1">
				<SbText>@L["DontHaveAccount"]</SbText>
				<SbLink Href="/account/register">@L["Register"]</SbLink>
			</SbStack>
		</SbStack>
	</SbStack>
</div>

@code {
	/// <summary>
	/// HttpContext is available in Static SSR mode, allowing direct cookie authentication.
	/// </summary>
	[CascadingParameter]
	public HttpContext? HttpContext { get; set; }

	/// <summary>
	/// Return URL passed from OAuth redirect or other sources.
	/// </summary>
	[SupplyParameterFromQuery]
	public string? ReturnUrl { get; set; }

	/// <summary>
	/// Error message from query string (for redirect-based errors).
	/// </summary>
	[SupplyParameterFromQuery(Name = "error")]
	public string? ErrorFromQuery { get; set; }

	/// <summary>
	/// Form input model bound from POST data.
	/// </summary>
	[SupplyParameterFromForm]
	public LoginInputModel Input { get; set; } = new();

	private string? ErrorMessage { get; set; }
	private IReadOnlyList<string> _externalProviderNames { get; set; } = Array.Empty<string>();

	private static readonly HashSet<string> _nonExternalSchemes = new(StringComparer.OrdinalIgnoreCase)
	{
		"Cookies", "Bearer", "Identity.Application", "Identity.External", "OpenIddict.Server.AspNetCore"
	};

	protected override async Task OnInitializedAsync()
	{
		// Show error from query string if present
		if (!string.IsNullOrEmpty(ErrorFromQuery))
		{
			ErrorMessage = ErrorFromQuery;
		}
		// Get external login schemes (Google, Microsoft, Facebook, etc.) from host configuration
		var allSchemes = await SchemeProvider.GetAllSchemesAsync();
		_externalProviderNames = allSchemes
			.Where(s => !string.IsNullOrEmpty(s.DisplayName) && !_nonExternalSchemes.Contains(s.Name))
			.Select(s => s.Name)
			.ToArray();
	}

	private async Task HandleLogin()
	{
		// Ensure Input is initialized (can be null on failed form binding)
		Input ??= new LoginInputModel();

		// Validate required fields
		if (string.IsNullOrWhiteSpace(Input.UserNameOrEmail) || string.IsNullOrWhiteSpace(Input.Password))
		{
			ErrorMessage = L["PleaseEnterUsernameAndPassword"];
			return;
		}

		// Find user by username or email
		var user = await UserManager.FindByNameAsync(Input.UserNameOrEmail)
				   ?? await UserManager.FindByEmailAsync(Input.UserNameOrEmail);

		if (user == null)
		{
			await SecurityLogAppService.SaveLoginEventAsync(IdentitySecurityLogIdentityConsts.Identity, IdentitySecurityLogActionConsts.LoginInvalidUserName, Input.UserNameOrEmail);
			ErrorMessage = L["InvalidCredentials"];
			return;
		}

		if (TokenStore.IsSupported)
		{
			// Blazor Interactive: response has already been sent; cannot set cookies here.
			// Validate password only, then create token and navigate to complete-login.
			if (await UserManager.IsLockedOutAsync(user))
			{
				await SecurityLogAppService.SaveLoginEventAsync(IdentitySecurityLogIdentityConsts.Identity, IdentitySecurityLogActionConsts.LoginLockedout, user.UserName);
				ErrorMessage = L["AccountLockedOut"];
				return;
			}
			if (!await UserManager.CheckPasswordAsync(user, Input.Password))
			{
				await UserManager.AccessFailedAsync(user);
				await SecurityLogAppService.SaveLoginEventAsync(IdentitySecurityLogIdentityConsts.Identity, IdentitySecurityLogActionConsts.LoginInvalidUserNameOrPassword, user.UserName);
				ErrorMessage = L["InvalidCredentials"];
				return;
			}
			await UserManager.ResetAccessFailedCountAsync(user);

			if (user.TwoFactorEnabled && TwoFactorPendingStore.IsSupported)
			{
				await SecurityLogAppService.SaveLoginEventAsync(
					IdentitySecurityLogIdentityConsts.Identity,
					IdentitySecurityLogActionConsts.LoginRequiresTwoFactor,
					user.UserName);
				var pendingToken = await TwoFactorPendingStore.CreateAsync(user.Id, ReturnUrl, Input.RememberMe);
				var returnUrlEnc = Uri.EscapeDataString(ReturnUrl ?? "/");
				Navigation.NavigateTo(
					$"/account/login-2fa?pendingToken={Uri.EscapeDataString(pendingToken)}&returnUrl={returnUrlEnc}",
					forceLoad: true);
				return;
			}

			// Do NOT log LoginSucceeded here: CompleteLogin will log it when the cookie is set
			var token = await TokenStore.CreateAsync(user.Id, ReturnUrl, Input.RememberMe);
			var completionReturnUrl = Uri.EscapeDataString(ReturnUrl ?? "/");
			Navigation.NavigateTo(
				$"/account/complete-login?token={Uri.EscapeDataString(token)}&returnUrl={completionReturnUrl}",
				forceLoad: true);
			return;
		}

		// Static SSR / form postback: SignInManager can set cookie in fresh HTTP response.
		var result = await SignInManager.PasswordSignInAsync(
			user,
			Input.Password,
			Input.RememberMe,
			lockoutOnFailure: true);

		if (result.Succeeded)
		{
			await SecurityLogAppService.SaveLoginEventAsync(IdentitySecurityLogIdentityConsts.Identity, IdentitySecurityLogActionConsts.LoginSucceeded, user.UserName);

			var enforceUrl = await TwoFactorAppService.GetPostLoginRedirectUrlAsync(user.Id, ReturnUrl);
			var redirectTarget = !string.IsNullOrEmpty(enforceUrl) ? enforceUrl : (ReturnUrl ?? "/");

			if (HttpContext != null)
			{
				HttpContext.Response.Redirect(redirectTarget);
				return;
			}
			ErrorMessage = L["AuthenticationNotAvailable"];
			return;
		}

		await SecurityLogAppService.SaveLoginEventAsync(IdentitySecurityLogIdentityConsts.Identity, result.ToIdentitySecurityLogAction(), user.UserName);

		if (result.IsLockedOut)
		{
			ErrorMessage = L["AccountLockedOut"];
		}
		else if (result.RequiresTwoFactor)
		{
			if (HttpContext != null)
			{
				var url = $"/account/login-2fa?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";
				HttpContext.Response.Redirect(url);
			}
			else
				ErrorMessage = L["AuthenticationNotAvailable"];
		}
		else if (result.IsNotAllowed)
		{
			ErrorMessage = L["AccountNotActive"];
		}
		else
		{
			ErrorMessage = L["InvalidCredentials"];
		}
	}

	/// <summary>
	/// Input model for the login form.
	/// </summary>
	public class LoginInputModel
	{
		public string UserNameOrEmail { get; set; } = "";
		public string Password { get; set; } = "";
		public bool RememberMe { get; set; }
	}
}
