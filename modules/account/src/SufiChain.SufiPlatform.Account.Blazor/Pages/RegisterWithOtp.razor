@namespace SufiChain.SufiPlatform.Account.Blazor.Pages
@page "/account/register-otp"
@layout AccountLayout
@using SufiChain.SufiPlatform.Account.Blazor.Components

<div class="account-page">
    <SbCard Class="account-card">
        <ChildContent>
            <SbStack Gap="4" Align="SbAlign.Center">
                <SbHeading Level="2">@AccountL["RegisterWithOtp"]</SbHeading>
                <SbText Color="SbColor.Muted">@AccountL["RegisterWithOtpInstructions"]</SbText>

                @if (Options is { IsEnabled: false } or { AllowRegistration: false })
                {
                    <SbAlert Severity="SbAlertSeverity.Warning">@(ErrorMessage ?? AccountL["OtpRegistrationDisabled"])</SbAlert>
                    <SbLink Href="/account/register">@L["Register"]</SbLink>
                }
                else
                {
                    <SbStack Gap="3" class="w-full">
                        @if (Step == 1)
                        {
                            @if (ShowChannelPicker)
                            {
                                <SbToggleGroup TValue="VerificationDeliveryChannel"
                                               Value="SelectedChannel"
                                               ValueChanged="OnChannelChangedAsync"
                                               Label="@AccountL["OtpDeliveryChannel"]"
                                               FullWidth="true"
                                               Color="SbColor.Primary">
                                    @foreach (var channel in Options!.AvailableChannels)
                                    {
                                        var option = channel;
                                        <SbToggleItem TValue="VerificationDeliveryChannel" Value="option">
                                            <ChildContent Context="selected">
                                                <span class="account-channel-option">
                                                    <SbIcon Name="@GetChannelIcon(option)" Size="SbSize.Sm" />
                                                    <span>@GetChannelLabel(option)</span>
                                                </span>
                                            </ChildContent>
                                        </SbToggleItem>
                                    }
                                </SbToggleGroup>
                            }

                            <SbFormField Label="@IdentifierLabel" InputId="Identifier" Required="true">
                                <SbTextField @bind-Value="Identifier"
                                             Id="Identifier"
                                             Type="@IdentifierInputType"
                                             Placeholder="@IdentifierPlaceholder"
                                             AutoComplete="@IdentifierAutoComplete" />
                            </SbFormField>
                            <SufiCaptcha @bind-CaptchaChallengeId="CaptchaChallengeId"
                                         @bind-CaptchaAnswer="CaptchaAnswer"
                                         @bind-CaptchaToken="CaptchaToken"
                                         Purpose="CaptchaPurpose.OtpSend" />
                            <OtpResendButton Variant="SbButtonVariant.Solid"
                                             FullWidth="true"
                                             Loading="IsBusy"
                                             AvailableAt="ResendAvailableAt"
                                             OnResend="OnSendCodeAsync">
                                @AccountL["SendOtpCode"]
                            </OtpResendButton>
                        }
                        else if (Step == 2)
                        {
                            <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@Identifier</SbText>
                            <SbFormField Label="@AccountL["OtpCode"]" InputId="Code" Required="true">
                                <SbTextField @bind-Value="Code"
                                             Id="Code"
                                             Type="text"
                                             Placeholder="@AccountL["OtpCodePlaceholder"]"
                                             AutoComplete="one-time-code" />
                            </SbFormField>
                            <SbButton Type="button"
                                      Color="SbColor.Primary"
                                      FullWidth="true"
                                      Loading="IsBusy"
                                      OnClick="OnVerifyCodeAsync">
                                @AccountL["VerifyOtpCode"]
                            </SbButton>
                            <OtpResendButton Disabled="IsBusy"
                                             AvailableAt="ResendAvailableAt"
                                             OnResend="OnRequestNewCodeAsync" />
                        }
                        else
                        {
                            @if (SelectedChannel.IsPhoneChannel())
                            {
                                <SbFormField Label="@L["Email"]" InputId="RegistrationEmail" Required="true">
                                    <SbTextField @bind-Value="EmailAddress"
                                                 Id="RegistrationEmail"
                                                 Type="email"
                                                 Placeholder="@L["EnterEmail"]"
                                                 AutoComplete="email" />
                                </SbFormField>
                            }
                            <SbFormField Label="@L["UserName"]" InputId="UserName" Required="true">
                                <SbTextField @bind-Value="UserName"
                                             Id="UserName"
                                             Type="text"
                                             Placeholder="@L["ChooseUsername"]"
                                             AutoComplete="username" />
                            </SbFormField>
                            <SbFormField Label="@L["Password"]" InputId="Password" Required="true">
                                <SbTextField @bind-Value="Password"
                                             Id="Password"
                                             Type="password"
                                             Placeholder="@L["CreatePassword"]"
                                             AutoComplete="new-password" />
                            </SbFormField>
                            <SbButton Type="button"
                                      Color="SbColor.Primary"
                                      FullWidth="true"
                                      Loading="IsBusy"
                                      OnClick="OnRegisterAsync">
                                @L["Register"]
                            </SbButton>
                        }

                        @if (!string.IsNullOrEmpty(SuccessMessage))
                        {
                            <SbAlert Severity="SbAlertSeverity.Success">@SuccessMessage</SbAlert>
                        }
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <SbAlert Severity="SbAlertSeverity.Danger">@ErrorMessage</SbAlert>
                        }
                    </SbStack>

                    <SbLink Href="/account/register">@AccountL["RegisterWithPassword"]</SbLink>
                }
            </SbStack>
        </ChildContent>
    </SbCard>
</div>
