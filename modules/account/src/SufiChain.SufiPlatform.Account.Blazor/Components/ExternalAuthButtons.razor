@namespace SufiChain.SufiPlatform.Account.Blazor.Components
@using Microsoft.AspNetCore.Components
@using SufiChain.SufiBlazor.Components
@using SufiChain.SufiBlazor.Components.Actions
@using SufiChain.SufiBlazor.Components.Common
@using SufiChain.SufiBlazor.Components.Typography

@inject IStringLocalizer<SufiIdentityResource> L

@*
    External/social login buttons. Renders vertically stacked buttons for OAuth providers.
    Pass EnabledProviders (e.g. from IAuthenticationSchemeProvider) and ReturnUrl for standard
    POST to /Account/ExternalLogin. Or pass OnProviderClick for custom handling.
*@

@if (EnabledProviders.Count > 0)
{
    <SbStack Gap="2" Align="SbAlign.Center" Class="w-full">
        <SbText Color="SbColor.Muted">@(string.IsNullOrWhiteSpace(IntroText) ? L["OrSignInWith"] : IntroText)</SbText>
        <SbStack Gap="2" Direction="SbStackDirection.Row" Justify="SbJustify.Center" Class="account-provider-list">
            @foreach (var provider in GetProvidersToRender())
            {
                @if (UseFormSubmit)
                {
                    <form method="post" action="/Account/ExternalLogin" class="w-full">
                        <AntiforgeryToken />
                        <input type="hidden" name="provider" value="@provider.Id" />
                        <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/")" />
                        <SbButton Type="submit"
                                  Color="SbColor.Secondary"
                                  Variant="SbButtonVariant.Outline"
                                  FullWidth="true">
                            @if (!string.IsNullOrEmpty(provider.IconName))
                            {
                                <SbIcon Name="@provider.IconName" Size="@SbSize.Sm" />
                                <span style="margin-inline-start: var(--sb-space-2);">@GetButtonText(provider)</span>
                            }
                            else
                            {
                                @GetButtonText(provider)
                            }
                        </SbButton>
                    </form>
                }
                else
                {
                    <SbButton Type="button"
                              Color="SbColor.Secondary"
                              Variant="SbButtonVariant.Outline"
                              FullWidth="true"
                              OnClick="() => OnProviderClickInternal(provider)">
                        @if (!string.IsNullOrEmpty(provider.IconName))
                        {
                            <SbIcon Name="@provider.IconName" Size="@SbSize.Sm" />
                            <span style="margin-inline-start: var(--sb-space-2);">@GetButtonText(provider)</span>
                        }
                        else
                        {
                            @GetButtonText(provider)
                        }
                    </SbButton>
                }
            }
        </SbStack>
    </SbStack>
}

@code {
    /// <summary>
    /// Provider IDs to display. Pass scheme names from IAuthenticationSchemeProvider for server-configured providers.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> EnabledProviders { get; set; } = Array.Empty<string>();

    /// <summary>
    /// Text shown above the provider buttons. Defaults to the sign-in wording.
    /// </summary>
    [Parameter]
    public string? IntroText { get; set; }

    /// <summary>
    /// Return URL after successful external login. When set, uses form POST to /Account/ExternalLogin.
    /// </summary>
    [Parameter]
    public string? ReturnUrl { get; set; }

    /// <summary>
    /// When true (default), each button submits a form to /Account/ExternalLogin. When false, uses OnProviderClick.
    /// </summary>
    [Parameter]
    public bool UseFormSubmit { get; set; } = true;

    /// <summary>
    /// Raised when a provider button is clicked. Used only when UseFormSubmit is false.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnProviderClick { get; set; }

    private static readonly IReadOnlyDictionary<string, ExternalAuthProviderInfo> ProviderRegistry = new Dictionary<string, ExternalAuthProviderInfo>(StringComparer.OrdinalIgnoreCase)
    {
        ["Google"] = new("Google", "Google", "google"),
        ["Microsoft"] = new("Microsoft", "Microsoft", "microsoft"),
        ["GitHub"] = new("GitHub", "GitHub", "github"),
        ["Facebook"] = new("Facebook", "Facebook", "facebook"),
        ["Apple"] = new("Apple", "Apple", "apple"),
        ["Twitter"] = new("Twitter", "Twitter / X", "twitter"),
        ["LinkedIn"] = new("LinkedIn", "LinkedIn", "linkedin"),
        ["Amazon"] = new("Amazon", "Amazon", "amazon"),
        ["Discord"] = new("Discord", "Discord", "discord"),
        ["Yahoo"] = new("Yahoo", "Yahoo", null),
    };

    private List<ExternalAuthProviderInfo> GetProvidersToRender()
    {
        var result = new List<ExternalAuthProviderInfo>();
        foreach (var id in EnabledProviders)
        {
            if (ProviderRegistry.TryGetValue(id.Trim(), out var info))
                result.Add(info);
        }
        return result;
    }

    private string GetButtonText(ExternalAuthProviderInfo provider) => $"{L["ContinueWith"]} {provider.DisplayName}";

    private async Task OnProviderClickInternal(ExternalAuthProviderInfo provider)
    {
        await OnProviderClick.InvokeAsync(provider.Id);
    }

    private sealed record ExternalAuthProviderInfo(string Id, string DisplayName, string? IconName);
}
