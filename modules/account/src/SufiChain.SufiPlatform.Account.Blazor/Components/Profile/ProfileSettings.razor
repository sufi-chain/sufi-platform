@namespace SufiChain.SufiPlatform.Account.Blazor.Components.Profile
@using Volo.Abp.ObjectExtending
@inject IProfileAppService ProfileAppService
@inject IStringLocalizer<SufiIdentityResource> L
@inject IStringLocalizer<SufiAccountResource> AccountL
@inject ILogger<ProfileSettings> Logger

@if (_loading)
{
    <SbStack Align="SbAlign.Center" class="p-4">
        <SbProgress Indeterminate="true" aria-label="@L["Loading"]" Type="SbProgressType.Circular" />
    </SbStack>
}
else if (Profile != null)
{
    <EditForm Model="Profile" FormName="@ProfileFormName" OnValidSubmit="OnSaveAsync">
        <DataAnnotationsValidator />

        <SbStack Gap="3">
            <SbTextField @bind-Value="Profile.UserName"
                         Label="@L["UserName"]"
                         Required="true" />

            <SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="3">
                <SbTextField @bind-Value="Profile.Name" Label="@L["Name"]" />
                <SbTextField @bind-Value="Profile.Surname" Label="@L["Surname"]" />
            </SbStack>

            <SbTextField @bind-Value="Profile.Email"
                         Label="@L["Email"]"
                         Type="email"
                         Required="true" />

            <SbTextField Type="tel" InputMode="tel" @bind-Value="Profile.PhoneNumber" Label="@L["PhoneNumber"]" />

            <InputText type="hidden" @bind-Value="Profile.ConcurrencyStamp" />

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <SbAlert Severity="SbAlertSeverity.Success">@_successMessage</SbAlert>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <SbAlert Severity="SbAlertSeverity.Danger">@_errorMessage</SbAlert>
            }

            <SbStack Wrap="true" Direction="SbStackDirection.Row" Justify="SbJustify.End">
                <SbButton Type="submit" Color="SbColor.Primary" Loading="_saving">
                    @L["Save"]
                </SbButton>
            </SbStack>
        </SbStack>
    </EditForm>
}
