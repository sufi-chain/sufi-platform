@namespace SufiChain.SufiPlatform.Account.Blazor.Components.Profile

<SbStack Gap="3">
    <SbStack Wrap="true" Direction="SbStackDirection.Row" Justify="SbJustify.End">
        <SbButton Color="SbColor.Primary"
                  Disabled="_loading"
                  Loading="_startingLink"
                  OnClick="StartLinkAsync">
            @AccountL["LinkNewAccount"]
        </SbButton>
    </SbStack>

    @if (_loading)
    {
        <SbStack Align="SbAlign.Center" class="p-4">
            <SbProgress Indeterminate="true" aria-label="@AccountL["Loading"]" Type="SbProgressType.Circular" />
        </SbStack>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <SbAlert Severity="SbAlertSeverity.Danger">@_errorMessage</SbAlert>
    }
    else if (_links.Count == 0)
    {
        <SbText>@AccountL["LinkedAccountsEmpty"]</SbText>
    }
    else
    {
        <SbStack Gap="2">
            @foreach (var link in _links)
            {
                <SbStack Wrap="true" Direction="SbStackDirection.Row"
                         Justify="SbJustify.SpaceBetween"
                         Align="SbAlign.Center"
                         Gap="3"
                         class="py-2">
                    <SbStack Gap="1">
                        <SbText>@GetTargetUserLabel(link)</SbText>
                        <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Secondary">
                            @GetTargetTenantLabel(link)
                        </SbText>
                    </SbStack>

                    @if (link.DirectlyLinked)
                    {
                        <SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="2">
                            <SbButton Color="SbColor.Primary"
                                      Variant="SbButtonVariant.Outline"
                                      Loading="_busyUserId == link.TargetUserId"
                                      OnClick="() => LoginAsAsync(link)">
                                @AccountL["LoginAsThisAccount"]
                            </SbButton>
                            <SbButton Color="SbColor.Danger"
                                      Variant="SbButtonVariant.Outline"
                                      Loading="_busyUserId == link.TargetUserId"
                                      OnClick="() => UnlinkAsync(link)">
                                @AccountL["UnlinkAccount"]
                            </SbButton>
                        </SbStack>
                    }
                </SbStack>
            }
        </SbStack>
    }
</SbStack>
