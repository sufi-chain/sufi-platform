<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SufiChain.SufiPlatform.Account</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.Account.Application</PackageId>
    <Description>Account module application services for Sufi Platform - wraps ABP Account application services.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../identity/src/SufiChain.SufiPlatform.Identity.Domain/SufiChain.SufiPlatform.Identity.Domain.csproj" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiPlatform.Captcha/SufiChain.SufiPlatform.Captcha.csproj" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiPlatform.Ddd.Application/SufiChain.SufiPlatform.Ddd.Application.csproj" />
    <PackageReference Include="Volo.Abp.Mapperly" Version="$(AbpVersion)" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiPlatform.SufiCom/SufiChain.SufiPlatform.SufiCom.csproj" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiPlatform.TextTemplating.Scriban/SufiChain.SufiPlatform.TextTemplating.Scriban.csproj" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiPlatform.UI.Abstractions/SufiChain.SufiPlatform.UI.Abstractions.csproj" />
    <ProjectReference Include="..\SufiChain.SufiPlatform.Account.Application.Contracts\SufiChain.SufiPlatform.Account.Application.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="$(MicrosoftExtensionsFileProvidersEmbeddedVersion)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*.tpl" />
    <Content Remove="Templates\**\*.tpl" />
  </ItemGroup>

</Project>
