@namespace SufiChain.SufiPlatform.Settings.Blazor.Pages
@page "/panel/admin/settings"
@attribute [Authorize]
@inherits SettingsComponentBase

<SufiPageToolbar />

@if (_groupsLoadFailed)
{
    <SbAlert Severity="SbAlertSeverity.Danger">
        <SbStack Direction="SbStackDirection.Row" Gap="3" Align="SbAlign.Center" Wrap="true">
            <span>@L["DataLoadFailed"]</span>
            <SbButton Size="SbSize.Sm" Variant="SbButtonVariant.Outline" OnClick="@LoadGroupsAsync">@L["Retry"]</SbButton>
        </SbStack>
    </SbAlert>
}

<SbLoadingSkeleton Preset="SbLoadingSkeletonPreset.Table" Count="5" Busy="@GroupsBusy">
    <ChildContent>
        @if (_groupsResolved && !_groupsLoadFailed)
        {
            <SbSettingsLayout AriaLabel="@L["Settings"]">
                <ChildContent>
                    @foreach (var group in _groups)
                    {
                        <SettingsSectionHost @key="group.Id" Group="group" />
                    }
                </ChildContent>
                <EmptyContent>
                    <SbEmptyState>
                        <SbIcon Name="settings" Size="SbSize.Xl" />
                        <p>@L["NoSettingsAvailable"]</p>
                    </SbEmptyState>
                </EmptyContent>
            </SbSettingsLayout>
        }
    </ChildContent>
</SbLoadingSkeleton>
