@namespace SufiChain.SufiPlatform.Settings.Blazor.Settings
@inherits SettingsComponentBase

<SbStack Gap="4">
    @if (IsOperationLoading(LoadingKeys.Load))
    {
        <SbProgress Indeterminate="true" aria-label="@L["LoadingSettings"]" Type="SbProgressType.Circular" />
    }
    else
    {
        <SbAlert Severity="SbAlertSeverity.Info">
            @L["ExternalAuthSettingsHint"]
        </SbAlert>

        <SbCard>
            <ChildContent>
                <SbStack Gap="3">
                    <h3>@L["ExternalAuth:Google"]</h3>
                    <SbSwitch @bind-Value="_settings.Google.Enabled" Label="@L["ExternalAuth:Enabled"]" />
                    <SbTextField @bind-Value="_settings.Google.ClientId"
                                 dir="ltr"
                                 Label="@L["ExternalAuth:ClientId"]"
                                 AutoComplete="off" />
                    <SbTextField @bind-Value="_settings.Google.ClientSecret"
                                 dir="ltr"
                                 Label="@(_settings.Google.HasClientSecret ? L["ExternalAuth:ClientSecretKeep"] : L["ExternalAuth:ClientSecret"])"
                                 Type="password"
                                 AutoComplete="new-password" />
                </SbStack>
            </ChildContent>
        </SbCard>

        <SbCard>
            <ChildContent>
                <SbStack Gap="3">
                    <h3>@L["ExternalAuth:Microsoft"]</h3>
                    <SbSwitch @bind-Value="_settings.Microsoft.Enabled" Label="@L["ExternalAuth:Enabled"]" />
                    <SbTextField @bind-Value="_settings.Microsoft.ClientId"
                                 dir="ltr"
                                 Label="@L["ExternalAuth:ClientId"]"
                                 AutoComplete="off" />
                    <SbTextField @bind-Value="_settings.Microsoft.ClientSecret"
                                 dir="ltr"
                                 Label="@(_settings.Microsoft.HasClientSecret ? L["ExternalAuth:ClientSecretKeep"] : L["ExternalAuth:ClientSecret"])"
                                 Type="password"
                                 AutoComplete="new-password" />
                </SbStack>
            </ChildContent>
        </SbCard>

        <SbCard>
            <ChildContent>
                <SbStack Gap="3">
                    <h3>@L["ExternalAuth:GitHub"]</h3>
                    <SbSwitch @bind-Value="_settings.GitHub.Enabled" Label="@L["ExternalAuth:Enabled"]" />
                    <SbTextField @bind-Value="_settings.GitHub.ClientId"
                                 dir="ltr"
                                 Label="@L["ExternalAuth:ClientId"]"
                                 AutoComplete="off" />
                    <SbTextField @bind-Value="_settings.GitHub.ClientSecret"
                                 dir="ltr"
                                 Label="@(_settings.GitHub.HasClientSecret ? L["ExternalAuth:ClientSecretKeep"] : L["ExternalAuth:ClientSecret"])"
                                 Type="password"
                                 AutoComplete="new-password" />
                </SbStack>
            </ChildContent>
        </SbCard>
    }
</SbStack>
