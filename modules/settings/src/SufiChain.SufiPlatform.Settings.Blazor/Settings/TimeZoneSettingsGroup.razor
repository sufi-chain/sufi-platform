@namespace SufiChain.SufiPlatform.Settings.Blazor.Settings
@inherits SettingsComponentBase

<CascadingValue Value="SaveFieldErrors" IsFixed="false">
<SbStack Gap="4">
    @if (IsOperationLoading(LoadingKeys.Load))
    {
        <div class="text-center py-4">
            <SbProgress Indeterminate="true" aria-label="@L["Loading"]" Type="SbProgressType.Circular" />
        </div>
    }
    else
    {
        <SbStack Gap="4">
            <div>
                <SbHeading Level="3" Size="6" Class="mb-3">@L["TimeZoneConfiguration"]</SbHeading>
                <SbStack Gap="3">
                    <SbSimpleSelect TValue="string" 
                              Value="@_selectedTimeZone"
                              ValueChanged="@((string? v) => _selectedTimeZone = v)"
                              Label="@((string)L["DefaultTimeZone"])"
                              Searchable="true"
                              SearchPlaceholder="@L["SearchTimeZone"]">
                        @foreach (var tz in _timeZones)
                        {
                            <SbSelectOption TValue="string" Value="@tz.Value">
                                @tz.Name
                            </SbSelectOption>
                        }
                    </SbSimpleSelect>
                    
                    @if (!string.IsNullOrEmpty(_selectedTimeZone))
                    {
                        <SbAlert Severity="SbAlertSeverity.Info">
                            <strong>@L["CurrentTimeZone"]:</strong> <bdi dir="ltr">@_selectedTimeZone</bdi>
                            <br />
                            <small>@L["CurrentTime"]: @GetCurrentTimeInSelectedTimeZone()</small>
                        </SbAlert>
                    }
                </SbStack>
            </div>
        </SbStack>
    }
</SbStack>
</CascadingValue>
