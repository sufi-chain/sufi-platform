@namespace SufiChain.SufiPlatform.Settings.Blazor.Settings
@inherits SettingsComponentBase

<CascadingValue Value="SaveFieldErrors" IsFixed="false">
<SbStack Gap="4">
    @if (IsOperationLoading(LoadingKeys.Load))
    {
        <SbLoadingSkeleton Preset="SbLoadingSkeletonPreset.Table" Count="5" />
    }
    else
    {
        <SbStack Gap="4">
            <!-- SMTP Server Settings -->
            <div>
                <SbHeading Level="3" Size="6" Class="mb-3">@L["SmtpServerSettings"]</SbHeading>
                <SbStack Gap="3">
                    <SbTextField @bind-Value="_settings.SmtpHost"
                                 dir="ltr"
                                 Label="@L["SmtpHost"]"
                                 Placeholder="@L["Placeholder:SmtpHost"]" />
                    <SbNumberField TValue="int"
                                   @bind-Value="_settings.SmtpPort"
                                   Label="@L["SmtpPort"]"
                                   Min="1"
                                   Max="65535" />
                    
                    <SbCheckbox @bind-Value="_settings.SmtpEnableSsl" 
                                Label="@L["EnableSsl"]" />
                    
                    <SbCheckbox @bind-Value="_settings.SmtpUseDefaultCredentials" 
                                Label="@L["UseDefaultCredentials"]" />
                </SbStack>
            </div>

            <!-- SMTP Credentials -->
            @if (!_settings.SmtpUseDefaultCredentials)
            {
                <div>
                    <SbHeading Level="3" Size="6" Class="mb-3">@L["SmtpCredentials"]</SbHeading>
                    <SbStack Gap="3">
                        <SbTextField @bind-Value="_settings.SmtpUserName" 
                                     Label="@L["SmtpUserName"]" />
                        <SbTextField @bind-Value="_settings.SmtpPassword" 
                                     Label="@L["SmtpPassword"]"
                                     Type="password"
                                     AutoComplete="new-password" />
                        <SbTextField @bind-Value="_settings.SmtpDomain"
                                     dir="ltr"
                                     Label="@L["SmtpDomain"]" />
                    </SbStack>
                </div>
            }

            <!-- Default Sender -->
            <div>
                <SbHeading Level="3" Size="6" Class="mb-3">@L["DefaultSender"]</SbHeading>
                <SbStack Gap="3">
                    <SbTextField @bind-Value="_settings.DefaultFromAddress"
                                 dir="ltr"
                                 Label="@L["DefaultFromAddress"]"
                                 Type="email"
                                 Placeholder="@L["Placeholder:DefaultFromAddress"]" />
                    <SbTextField @bind-Value="_settings.DefaultFromDisplayName" 
                                 Label="@L["DefaultFromDisplayName"]"
                                 HelperText="@L["DefaultFromDisplayName:Hint"]"
                                 Placeholder="@L["Placeholder:DefaultFromDisplayName"]" />
                </SbStack>
            </div>

            <div>
                <SbHeading Level="3" Size="6" Class="mb-3">@L["SendTestEmail"]</SbHeading>
                <SbStack Gap="3">
                    <SbTextField @bind-Value="_testEmailAddress"
                                 dir="ltr"
                                 Label="@L["TargetEmailAddress"]"
                                 Type="email"
                                 Placeholder="@L["Placeholder:TargetEmailAddress"]"
                                 Required="true" />
                    <SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
                        <SbButton Color="SbColor.Primary"
                                  OnClick="SendTestEmailAsync"
                                  Loading="IsOperationLoading(LoadingKeys.SendTest)"
                                  Disabled="@string.IsNullOrEmpty(_testEmailAddress)">
                            <StartIcon><SbIcon Name="mail" /></StartIcon>
                            <ChildContent>@L["Send"]</ChildContent>
                        </SbButton>
                    </SbStack>
                </SbStack>
            </div>
        </SbStack>
    }
</SbStack>
</CascadingValue>
