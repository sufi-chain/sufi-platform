@namespace SufiChain.SufiPlatform.Settings.Blazor.Settings
@inherits SettingsComponentBase
@using SufiChain.SufiPlatform.Account
@using SufiChain.SufiPlatform.Identity.Localization

<SbStack Gap="4" class="p-4">
    @if (IsOperationLoading(LoadingKeys.Load))
    {
        <div class="text-center py-4">
            <SbProgress Type="SbProgressType.Circular" />
        </div>
    }
    else
    {
        <SbTabs @bind-ActiveIndex="_activeTab">
            <SbTab Label="@L["IdentityTabSignup"]">
                <SbStack Gap="3" class="pt-3">
                    <div><SbCheckbox @bind-Value="_settings.EnableSelfRegistration" Label="@IdentityL["Setting:EnableSelfRegistration"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:EnableSelfRegistration"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.RequireEmailConfirmation" Label="@IdentityL["Setting:RequireEmailConfirmation"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:RequireEmailConfirmation"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.RequireConfirmedAccount" Label="@IdentityL["Setting:RequireConfirmedAccount"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:RequireConfirmedAccount"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.RequireConfirmedEmail" Label="@IdentityL["Setting:RequireConfirmedEmail"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:RequireConfirmedEmail"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.RequireConfirmedPhoneNumber" Label="@IdentityL["Setting:RequireConfirmedPhoneNumber"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:RequireConfirmedPhoneNumber"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.RequireUniqueEmail" Label="@IdentityL["Setting:RequireUniqueEmail"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:RequireUniqueEmail"]</SbText></div>
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabPassword"]">
                <SbStack Gap="3" class="pt-3">
                    <SbNumberField TValue="int" @bind-Value="_settings.PasswordRequiredLength" Label="@IdentityL["Setting:PasswordRequiredLength"]" HelperText="@IdentityL["SettingHint:PasswordRequiredLength"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.PasswordRequiredUniqueChars" Label="@IdentityL["Setting:PasswordRequiredUniqueChars"]" HelperText="@IdentityL["SettingHint:PasswordRequiredUniqueChars"]" />
                    <div><SbCheckbox @bind-Value="_settings.PasswordRequireDigit" Label="@IdentityL["Setting:PasswordRequireDigit"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:PasswordRequireDigit"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.PasswordRequireLowercase" Label="@IdentityL["Setting:PasswordRequireLowercase"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:PasswordRequireLowercase"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.PasswordRequireUppercase" Label="@IdentityL["Setting:PasswordRequireUppercase"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:PasswordRequireUppercase"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.PasswordRequireNonAlphanumeric" Label="@IdentityL["Setting:PasswordRequireNonAlphanumeric"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:PasswordRequireNonAlphanumeric"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.PasswordDisallowUsername" Label="@IdentityL["Setting:PasswordDisallowUsername"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:PasswordDisallowUsername"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.PasswordDisallowEmail" Label="@IdentityL["Setting:PasswordDisallowEmail"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:PasswordDisallowEmail"]</SbText></div>
                    <SbNumberField TValue="int" @bind-Value="_settings.PasswordMinimumAgeMinutes" Label="@IdentityL["Setting:PasswordMinimumAgeMinutes"]" HelperText="@IdentityL["SettingHint:PasswordMinimumAgeMinutes"]" />
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabLockout"]">
                <SbStack Gap="3" class="pt-3">
                    <div><SbCheckbox @bind-Value="_settings.LockoutAllowedForNewUsers" Label="@IdentityL["Setting:LockoutAllowedForNewUsers"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:LockoutAllowedForNewUsers"]</SbText></div>
                    <SbNumberField TValue="int" @bind-Value="_settings.LockoutMaxFailedAccessAttempts" Label="@IdentityL["Setting:LockoutMaxFailedAccessAttempts"]" HelperText="@IdentityL["SettingHint:LockoutMaxFailedAccessAttempts"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.LockoutDefaultLockoutTimeSpanMinutes" Label="@IdentityL["Setting:LockoutDefaultLockoutTimeSpanMinutes"]" HelperText="@IdentityL["SettingHint:LockoutDefaultLockoutTimeSpanMinutes"]" />
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabTokens"]">
                <SbStack Gap="3" class="pt-3">
                    <SbNumberField TValue="int" @bind-Value="_settings.EmailConfirmationTokenLifespanHours" Label="@IdentityL["Setting:EmailConfirmationTokenLifespanHours"]" HelperText="@IdentityL["SettingHint:EmailConfirmationTokenLifespanHours"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.PasswordResetTokenLifespanHours" Label="@IdentityL["Setting:PasswordResetTokenLifespanHours"]" HelperText="@IdentityL["SettingHint:PasswordResetTokenLifespanHours"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.OtpTokenLifespanMinutes" Label="@IdentityL["Setting:OtpTokenLifespanMinutes"]" HelperText="@IdentityL["SettingHint:OtpTokenLifespanMinutes"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.OtpLength" Label="@IdentityL["Setting:OtpLength"]" HelperText="@IdentityL["SettingHint:OtpLength"]" />
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabTwoFactor"]">
                <SbStack Gap="3" class="pt-3">
                    <div><SbCheckbox @bind-Value="_settings.TwoFactorEnabled" Label="@IdentityL["Setting:TwoFactorEnabled"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorEnabled"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.TwoFactorIsRequired" Label="@IdentityL["Setting:TwoFactorIsRequired"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorIsRequired"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.TwoFactorUsersCanChange" Label="@IdentityL["Setting:TwoFactorUsersCanChange"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorUsersCanChange"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.TwoFactorEnforceForNewUsers" Label="@IdentityL["Setting:TwoFactorEnforceForNewUsers"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorEnforceForNewUsers"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.TwoFactorEnforceForAdministrators" Label="@IdentityL["Setting:TwoFactorEnforceForAdministrators"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorEnforceForAdministrators"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.TwoFactorAllowAuthenticatorApp" Label="@IdentityL["Setting:TwoFactorAllowAuthenticatorApp"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorAllowAuthenticatorApp"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.TwoFactorAllowCodeDelivery" Label="@IdentityL["Setting:TwoFactorAllowCodeDelivery"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorAllowCodeDelivery"]</SbText></div>
                    <SbSimpleSelect TValue="VerificationDeliveryChannel"
                                    @bind-Value="TwoFactorDefaultChannel"
                                    Label="@IdentityL["Setting:TwoFactorCodeDeliveryChannel"]">
                        @foreach (var channel in DeliveryChannels)
                        {
                            <SbSelectOption TValue="VerificationDeliveryChannel"
                                            Value="@channel"
                                            Disabled="@(!IsChannelAvailable(channel))">
                                @GetChannelLabel(channel)
                            </SbSelectOption>
                        }
                    </SbSimpleSelect>
                    <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorCodeDeliveryChannel"]</SbText>
                    <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@L["IdentityAllowedChannels"]</SbText>
                    <div><SbCheckbox @bind-Value="_settings.TwoFactorAllowEmailChannel" Label="@GetChannelLabel(VerificationDeliveryChannel.Email)" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Email))" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorAllowEmailChannel"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.TwoFactorAllowSmsChannel" Label="@GetChannelLabel(VerificationDeliveryChannel.Sms)" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Sms))" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorAllowSmsChannel"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.TwoFactorAllowVoiceChannel" Label="@GetChannelLabel(VerificationDeliveryChannel.Voice)" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Voice))" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:TwoFactorAllowVoiceChannel"]</SbText></div>
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabOtp"]">
                <SbStack Gap="3" class="pt-3">
                    <div><SbCheckbox @bind-Value="_settings.OtpIsEnabled" Label="@IdentityL["Setting:OtpIsEnabled"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:OtpIsEnabled"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.OtpAllowLogin" Label="@IdentityL["Setting:OtpAllowLogin"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:OtpAllowLogin"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.OtpAllowRegistration" Label="@IdentityL["Setting:OtpAllowRegistration"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:OtpAllowRegistration"]</SbText></div>
                    <SbSimpleSelect TValue="VerificationDeliveryChannel"
                                    @bind-Value="OtpDefaultChannelValue"
                                    Label="@IdentityL["Setting:OtpDefaultChannel"]">
                        @foreach (var channel in DeliveryChannels)
                        {
                            <SbSelectOption TValue="VerificationDeliveryChannel"
                                            Value="@channel"
                                            Disabled="@(!IsChannelAvailable(channel))">
                                @GetChannelLabel(channel)
                            </SbSelectOption>
                        }
                    </SbSimpleSelect>
                    <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:OtpDefaultChannel"]</SbText>
                    <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@L["IdentityAllowedChannels"]</SbText>
                    <div><SbCheckbox @bind-Value="_settings.OtpAllowEmailChannel" Label="@GetChannelLabel(VerificationDeliveryChannel.Email)" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Email))" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:OtpAllowEmailChannel"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.OtpAllowSmsChannel" Label="@GetChannelLabel(VerificationDeliveryChannel.Sms)" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Sms))" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:OtpAllowSmsChannel"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.OtpAllowVoiceChannel" Label="@GetChannelLabel(VerificationDeliveryChannel.Voice)" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Voice))" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:OtpAllowVoiceChannel"]</SbText></div>
                    <SbNumberField TValue="int" @bind-Value="_settings.OtpMaxAttemptsPerCode" Label="@IdentityL["Setting:OtpMaxAttemptsPerCode"]" HelperText="@IdentityL["SettingHint:OtpMaxAttemptsPerCode"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.OtpRateLimitPerIdentifierPerHour" Label="@IdentityL["Setting:OtpRateLimitPerIdentifierPerHour"]" HelperText="@IdentityL["SettingHint:OtpRateLimitPerIdentifierPerHour"]" />
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabCaptcha"]">
                <SbStack Gap="3" class="pt-3">
                    <div><SbCheckbox @bind-Value="_settings.CaptchaIsEnabled" Label="@IdentityL["Setting:CaptchaIsEnabled"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:CaptchaIsEnabled"]</SbText></div>
                    <SbSimpleSelect TValue="string"
                                    @bind-Value="_settings.CaptchaProvider"
                                    Label="@IdentityL["Setting:CaptchaProvider"]">
                        <SbSelectOption TValue="string" Value="@SimpleCaptchaProvider">
                            @IdentityL["CaptchaProvider:Simple"]
                        </SbSelectOption>
                        <SbSelectOption TValue="string" Value="@TurnstileCaptchaProvider">
                            @IdentityL["CaptchaProvider:Turnstile"]
                        </SbSelectOption>
                        <SbSelectOption TValue="string" Value="@RecaptchaCaptchaProvider">
                            @IdentityL["CaptchaProvider:Recaptcha"]
                        </SbSelectOption>
                    </SbSimpleSelect>
                    <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:CaptchaProvider"]</SbText>
                    <div><SbCheckbox @bind-Value="_settings.CaptchaRequiredOnRegister" Label="@IdentityL["Setting:CaptchaRequiredOnRegister"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:CaptchaRequiredOnRegister"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.CaptchaRequiredOnForgotPassword" Label="@IdentityL["Setting:CaptchaRequiredOnForgotPassword"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:CaptchaRequiredOnForgotPassword"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.CaptchaRequiredOnOtpSend" Label="@IdentityL["Setting:CaptchaRequiredOnOtpSend"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:CaptchaRequiredOnOtpSend"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.CaptchaRequiredOnLogin" Label="@IdentityL["Setting:CaptchaRequiredOnLogin"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:CaptchaRequiredOnLogin"]</SbText></div>
                    <div><SbCheckbox @bind-Value="_settings.CaptchaRequiredOnEmailConfirmationResend" Label="@IdentityL["Setting:CaptchaRequiredOnEmailConfirmationResend"]" /><SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:CaptchaRequiredOnEmailConfirmationResend"]</SbText></div>
                    <SbNumberField TValue="int" @bind-Value="_settings.CaptchaChallengeExpirationMinutes" Label="@IdentityL["Setting:CaptchaChallengeExpirationMinutes"]" HelperText="@IdentityL["SettingHint:CaptchaChallengeExpirationMinutes"]" />
                    @if (IsTurnstileCaptchaProvider)
                    {
                        <SbTextField @bind-Value="_settings.CaptchaTurnstileSiteKey"
                                     Label="@IdentityL["Setting:CaptchaTurnstileSiteKey"]"
                                     HelperText="@IdentityL["SettingHint:CaptchaTurnstileSiteKey"]" />
                        <SbTextField @bind-Value="_settings.CaptchaTurnstileSecretKey"
                                     Label="@IdentityL["Setting:CaptchaTurnstileSecretKey"]"
                                     HelperText="@IdentityL["SettingHint:CaptchaTurnstileSecretKey"]"
                                     Type="password"
                                     AutoComplete="new-password" />
                    }
                    @if (IsRecaptchaCaptchaProvider)
                    {
                        <SbTextField @bind-Value="_settings.CaptchaRecaptchaSiteKey"
                                     Label="@IdentityL["Setting:CaptchaRecaptchaSiteKey"]"
                                     HelperText="@IdentityL["SettingHint:CaptchaRecaptchaSiteKey"]" />
                        <SbTextField @bind-Value="_settings.CaptchaRecaptchaSecretKey"
                                     Label="@IdentityL["Setting:CaptchaRecaptchaSecretKey"]"
                                     HelperText="@IdentityL["SettingHint:CaptchaRecaptchaSecretKey"]"
                                     Type="password"
                                     AutoComplete="new-password" />
                        <SbSimpleSelect TValue="string"
                                        @bind-Value="_settings.CaptchaRecaptchaVersion"
                                        Label="@IdentityL["Setting:CaptchaRecaptchaVersion"]">
                            <SbSelectOption TValue="string" Value="@("v2checkbox")">
                                @IdentityL["CaptchaRecaptchaVersion:v2checkbox"]
                            </SbSelectOption>
                            <SbSelectOption TValue="string" Value="@("v3")">
                                @IdentityL["CaptchaRecaptchaVersion:v3"]
                            </SbSelectOption>
                        </SbSimpleSelect>
                        <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@IdentityL["SettingHint:CaptchaRecaptchaVersion"]</SbText>
                    }
                </SbStack>
            </SbTab>
        </SbTabs>
    }
</SbStack>
