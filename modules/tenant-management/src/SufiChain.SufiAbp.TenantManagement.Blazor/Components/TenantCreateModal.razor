@inherits TenantManagementComponentBase

<SbDialog @bind-Open="Open" OnCloseButtonClick="Hide" Size="SbDialogSize.Md" Title="@L["CreateTenant"]">
    <ChildContent>
        <SbForm @ref="_formRef" Model="_model" OnValidSubmit="OnValidSubmitAsync">
            <ChildContent>
                <SbStack Gap="3" Class="pb-4">
                    <SbTextField @bind-Value="_model.Name" 
                                 Label="@L["TenantName"]" 
                                 Required="true" />

                    <SbTextField @bind-Value="_model.AdminEmailAddress" 
                                 Label="@L["AdminEmailAddress"]" 
                                 Type="email"
                                 Required="true" />

                    <SbTextField @bind-Value="_model.AdminPassword" 
                                 Label="@L["AdminPassword"]" 
                                 Type="password"
                                 AutoComplete="new-password"
                                 Required="true" />
                </SbStack>
            </ChildContent>
            <FooterContent>
                <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
                    <SbButton Variant="SbButtonVariant.Outline" OnClick="Hide">@L["Cancel"]</SbButton>
                    <SbButton Type="submit" Color="SbColor.Primary" Loading="IsOperationLoading(LoadingKeys.Create)">@L["Create"]</SbButton>
                </SbStack>
            </FooterContent>
        </SbForm>
    </ChildContent>
</SbDialog>
