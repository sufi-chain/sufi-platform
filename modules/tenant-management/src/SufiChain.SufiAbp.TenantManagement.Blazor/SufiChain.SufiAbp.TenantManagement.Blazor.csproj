<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiAbp.TenantManagement.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiAbp.TenantManagement.Blazor</PackageId>
    <Description>Tenant management module Blazor UI components for Sufi Platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resolve version conflict with SufiBlazor -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftAspNetCoreComponentsWebVersion)" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiAbp.Authorization/SufiChain.SufiAbp.Authorization.csproj" />
    <!-- Blazor Authorization -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCoreVersion)" />
  </ItemGroup>



  <ItemGroup>
    <ProjectReference Include="..\SufiChain.SufiAbp.TenantManagement.Application.Contracts\SufiChain.SufiAbp.TenantManagement.Application.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SufiAbp Framework (transitively provides SufiChain.SufiAbp.UI.Abstractions and SufiChain.SufiBlazor) -->
    <ProjectReference Include="..\..\..\..\framework\SufiChain.SufiAbp.UI.Blazor\SufiChain.SufiAbp.UI.Blazor.csproj" />
    <!-- Feature Management -->
    <ProjectReference Include="..\..\..\feature-management\src\SufiChain.SufiAbp.FeatureManagement.Blazor\SufiChain.SufiAbp.FeatureManagement.Blazor.csproj" />
    <!-- Setting Management -->
    <ProjectReference Include="..\..\..\setting-management\src\SufiChain.SufiAbp.SettingManagement.Blazor\SufiChain.SufiAbp.SettingManagement.Blazor.csproj" />
  </ItemGroup>

</Project>
