<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SufiChain.SufiAbp.TenantManagement</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiAbp.TenantManagement.HttpApi.Client</PackageId>
    <Description>Tenant management module HTTP API client proxies for Sufi Platform. Provides remote ITenantStore for tiered Blazor hosts.</Description>
  </PropertyGroup>

  <ItemGroup>
    
    <ProjectReference Include="..\..\..\..\framework\SufiChain.SufiAbp.Http.Client\SufiChain.SufiAbp.Http.Client.csproj" />
    
    <ProjectReference Include="..\SufiChain.SufiAbp.TenantManagement.Application.Contracts\SufiChain.SufiAbp.TenantManagement.Application.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*generate-proxy.json" />
    <Content Remove="**\*generate-proxy.json" />
  </ItemGroup>

</Project>
