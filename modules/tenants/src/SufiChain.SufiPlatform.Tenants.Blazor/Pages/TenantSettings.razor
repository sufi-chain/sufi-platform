@namespace SufiChain.SufiPlatform.Tenants.Blazor.Pages
@page "/panel/admin/tenant-management/tenants/{TenantId:guid}/settings"
@attribute [Authorize(Policy = TenantsPermissions.Tenants.Update)]
@using SufiChain.SufiPlatform.Settings.Blazor
@inherits SettingsComponentBase

@if (CurrentTenant.Id != null)
{
    <SufiErrorPage StatusCode="403"
                   Title="@TenantLocalizer["TenantManagementHostOnly"]"
                   Message="@TenantLocalizer["TenantManagementHostOnlyMessage"]" />
}
else if (_settingsTenantScope is { } settingsTenantScope)
{
    <SufiPageToolbar />

    <CascadingValue Value="settingsTenantScope">
        @if (_groupsLoadFailed)
        {
            <SbAlert Severity="SbAlertSeverity.Danger">
                <SbStack Direction="SbStackDirection.Row" Gap="3" Align="SbAlign.Center" Wrap="true">
                    <span>@L["DataLoadFailed"]</span>
                    <SbButton Size="SbSize.Sm" Variant="SbButtonVariant.Outline" OnClick="@LoadGroupsAsync">@L["Retry"]</SbButton>
                </SbStack>
            </SbAlert>
        }

        <SbLoadingSkeleton Preset="SbLoadingSkeletonPreset.Table" Count="5" Busy="@GroupsBusy">
            <ChildContent>
                @if (_groupsResolved && !_groupsLoadFailed)
                {
                    <SbSettingsLayout AriaLabel="@L["Settings"]">
                        <ChildContent>
                            @foreach (var group in _groups)
                            {
                                <SettingsSectionHost @key="group.Id" Group="group" />
                            }
                        </ChildContent>
                        <EmptyContent>
                            <SbEmptyState>
                                <SbIcon Name="settings" Size="SbSize.Xl" />
                                <p>@L["NoSettingsAvailable"]</p>
                            </SbEmptyState>
                        </EmptyContent>
                    </SbSettingsLayout>
                }
            </ChildContent>
        </SbLoadingSkeleton>
    </CascadingValue>
}
