<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiAbp.OpenIddict</RootNamespace>
    <PackageId>SufiChain.SufiAbp.OpenIddict.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for SufiAbp OpenIddict.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SufiChain.SufiAbp.OpenIddict.Domain\SufiChain.SufiAbp.OpenIddict.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.MultiTenancy" Version="$(AbpVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="$(OpenIddictVersion)"/>
    <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="$(OpenIddictVersion)"/>
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" Version="$(OpenIddictVersion)"/>
  </ItemGroup>
</Project>
