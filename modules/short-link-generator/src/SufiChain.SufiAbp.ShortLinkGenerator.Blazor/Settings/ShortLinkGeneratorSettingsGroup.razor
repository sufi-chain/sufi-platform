@inherits ShortLinkGeneratorComponentBase
@implements ISaveableSettingGroup

<SbStack Gap="4" class="p-4">
    @if (IsOperationLoading(LoadingKeys.Load))
    {
        <div class="text-center py-4">
            <SbProgress Type="SbProgressType.Circular" />
        </div>
    }
    else
    {
        <SbStack Gap="4">
            <SbFormField Label="@L["DisplayName:ShortLinkGenerator.BaseUrl"]"
                         HelperText="@L["Description:ShortLinkGenerator.BaseUrl"]">
                <SbTextField @bind-Value="_settings.BaseUrl" />
            </SbFormField>

            <SbFormField Label="@L["DisplayName:ShortLinkGenerator.ShortUrl.ShortCodeLength"]"
                         HelperText="@L["Description:ShortLinkGenerator.ShortUrl.ShortCodeLength"]">
                <SbNumberField TValue="int"
                               @bind-Value="_settings.ShortCodeLength"
                               Min="1"
                               Max="@ShortLinkGeneratorConsts.ShortUrl.MaxShortCodeLength" />
            </SbFormField>

            <SbFormField Label="@L["DisplayName:ShortLinkGenerator.ShortUrl.CacheExpirationMinutes"]"
                         HelperText="@L["Description:ShortLinkGenerator.ShortUrl.CacheExpirationMinutes"]">
                <SbNumberField TValue="int"
                               @bind-Value="_settings.CacheExpirationMinutes"
                               Min="1" />
            </SbFormField>

            <SbFormField Label="@L["DisplayName:ShortLinkGenerator.ShortUrl.DefaultExpirationDays"]"
                         HelperText="@L["Description:ShortLinkGenerator.ShortUrl.DefaultExpirationDays"]">
                <SbNumberField TValue="int"
                               @bind-Value="_settings.DefaultExpirationDays"
                               Min="1" />
            </SbFormField>
        </SbStack>
    }
</SbStack>
