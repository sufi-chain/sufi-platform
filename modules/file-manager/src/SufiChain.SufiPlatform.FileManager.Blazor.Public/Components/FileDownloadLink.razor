@namespace SufiChain.SufiPlatform.FileManager.Blazor.Public.Components
@using SufiChain.SufiBlazor.Components.Common

@if (_isLoading)
{
    <span class="file-download-link file-download-link--loading @Class">
        @if (LoadingTemplate != null)
        {
            @LoadingTemplate
        }
        else
        {
            <span class="file-download-link__spinner"></span>
            <span>Loading...</span>
        }
    </span>
}
else if (_hasError || _fileInfo == null)
{
    @if (ErrorTemplate != null)
    {
        @ErrorTemplate
    }
    else
    {
        <span class="file-download-link file-download-link--error @Class">
            File not available
        </span>
    }
}
else
{
    <a href="@_fileInfo.DownloadUrl"
       class="file-download-link @(AsButton ? "file-download-link--button" : "file-download-link--link") @Class"
       download="@_fileInfo.FileName"
       target="_blank"
       rel="noopener noreferrer">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            @if (ShowIcon)
            {
                <SbIcon Name="@GetFileIcon()"
                        Size="SbSize.Sm"
                        Class="file-download-link__icon" />
            }
            <span class="file-download-link__text">@(Text ?? _fileInfo.FileName)</span>
            @if (ShowSize)
            {
                <span class="file-download-link__size">(@FormatFileSize(_fileInfo.Size))</span>
            }
        }
    </a>
}
