@using SufiChain.SufiAbp.FileManager.FileItems
@using SufiChain.SufiAbp.FileManager.RichTextEditor.Toolbar
@implements IDisposable
@inherits FileManagerComponentBase
@inject FileGalleryDialogService DialogService

@* 
    FileGalleryHost - Host component for file gallery dialogs.
    
    Place this component in your layout or page that uses SbRichTextEditor with file manager toolbar.
    It provides the dialog UI for selecting files from the gallery.
    
    Usage:
    <FileGalleryHost />
*@

<FileGalleryDialog 
    @bind-IsOpen="_isImageGalleryOpen" 
    Title="Select Image"
    ImagesOnly="true"
    OnFileSelected="@OnImageSelected" />

<FileGalleryDialog 
    @bind-IsOpen="_isFileGalleryOpen" 
    Title="Select File"
    Description="@L["SelectFileToInsertAsLink"].Value"
    ImagesOnly="false"
    OnFileSelected="@OnFileSelected" />

@code {
    private bool _isImageGalleryOpen;
    private bool _isFileGalleryOpen;

    protected override void OnInitialized()
    {
        DialogService.RegisterHost();
        DialogService.OnShowImageGallery += ShowImageGallery;
        DialogService.OnShowFileGallery += ShowFileGallery;
    }

    private void ShowImageGallery()
    {
        _isImageGalleryOpen = true;
        InvokeAsync(StateHasChanged);
    }

    private void ShowFileGallery()
    {
        _isFileGalleryOpen = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnImageSelected(FileItemDto? fileItem)
    {
        _isImageGalleryOpen = false;
        DialogService.CompleteImageSelection(fileItem);
    }

    private void OnFileSelected(FileItemDto? fileItem)
    {
        _isFileGalleryOpen = false;
        DialogService.CompleteFileSelection(fileItem);
    }

    public void Dispose()
    {
        DialogService.OnShowImageGallery -= ShowImageGallery;
        DialogService.OnShowFileGallery -= ShowFileGallery;
        DialogService.UnregisterHost();
    }
}
