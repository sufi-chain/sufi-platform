@namespace SufiChain.SufiPlatform.FileManager.Blazor.Settings
@using SufiChain.SufiPlatform.Settings.Blazor.Settings
@inherits FileManagerComponentBase
@implements ISaveableSettingGroup

<SbStack Gap="4" class="p-4">
    @if (IsOperationLoading(LoadingKeys.Load))
    {
        <div class="text-center py-4">
            <SbProgress Type="SbProgressType.Circular" />
        </div>
    }
    else
    {
        <p class="text-muted">@L["FileManagerGeneralSettingsHint"]</p>

        <SbFormField Label="@L["StorageQuotaMB"]">
            <SbNumberField TNumber="long" @bind-Value="@_settings.StorageQuotaMB" Min="0" />
        </SbFormField>

        <SbFormField Label="@L["MaxFileSizeBytes"]">
            <SbNumberField TNumber="long" @bind-Value="@_settings.MaxFileSizeBytes" Min="1" />
        </SbFormField>

        <SbFormField Label="@L["AllowedImageExtensions"]">
            <SbTextField @bind-Value="_settings.AllowedImageExtensions" />
        </SbFormField>

        <SbFormField Label="@L["AllowedVideoExtensions"]">
            <SbTextField @bind-Value="_settings.AllowedVideoExtensions" />
        </SbFormField>

        <SbFormField Label="@L["AllowedDocumentExtensions"]">
            <SbTextField @bind-Value="_settings.AllowedDocumentExtensions" />
        </SbFormField>

        <SbFormField Label="@L["EnableWebPConversion"]">
            <SbSwitch @bind-Value="@_settings.EnableWebPConversion" />
        </SbFormField>

        <SbFormField Label="@L["WebPQuality"]">
            <SbNumberField TNumber="int" @bind-Value="@_settings.WebPQuality" Min="1" Max="100" />
        </SbFormField>

        <SbFormField Label="@L["ThumbnailWidth"]">
            <SbNumberField TNumber="int" @bind-Value="@_settings.ThumbnailWidth" Min="1" />
        </SbFormField>

        <SbFormField Label="@L["ThumbnailHeight"]">
            <SbNumberField TNumber="int" @bind-Value="@_settings.ThumbnailHeight" Min="1" />
        </SbFormField>

        <SbFormField Label="@L["MaxImageWidth"]">
            <SbNumberField TNumber="int" @bind-Value="@_settings.MaxImageWidth" Min="1" />
        </SbFormField>

        <SbFormField Label="@L["MaxImageHeight"]">
            <SbNumberField TNumber="int" @bind-Value="@_settings.MaxImageHeight" Min="1" />
        </SbFormField>

        <SbFormField Label="@L["AutoDeleteTempMediaAfterDays"]">
            <SbNumberField TNumber="int" @bind-Value="@_settings.AutoDeleteTempMediaAfterDays" Min="1" />
        </SbFormField>

        <SbFormField Label="@L["EnableDuplicateDetection"]">
            <SbSwitch @bind-Value="@_settings.EnableDuplicateDetection" />
        </SbFormField>
    }
</SbStack>
