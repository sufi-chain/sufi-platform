@namespace SufiChain.SufiPlatform.FileManager.Blazor.Settings
@using SufiChain.SufiPlatform.Settings.Blazor.Settings
@inherits FileManagerComponentBase
@implements ISaveableSettingGroup

<SbStack Gap="4" class="p-4">
    @if (IsOperationLoading(LoadingKeys.Load))
    {
        <div class="text-center py-4">
            <SbProgress Type="SbProgressType.Circular" />
        </div>
    }
    else
    {
        <p class="text-muted">@L["FileManagerArchivingSettingsHint"]</p>

        <SbFormField Label="@L["ArchivingEnabled"]">
            <SbSwitch @bind-Value="@_settings.Enabled" />
        </SbFormField>

        <SbFormField Label="@L["ArchivingRetentionDays"]">
            <SbNumberField TNumber="int" @bind-Value="@_settings.RetentionDays" Min="1" />
        </SbFormField>

        <SbFormField Label="@L["ArchivingBatchSize"]">
            <SbNumberField TNumber="int" @bind-Value="@_settings.BatchSize" Min="1" />
        </SbFormField>

        <SbFormField Label="@L["ArchivingSchedule"]" HelperText="@L["ArchivingScheduleHint"]">
            <SbTextField @bind-Value="_settings.Schedule" />
        </SbFormField>

        <SbFormField Label="@L["ArchiveAIFiles"]">
            <SbSwitch @bind-Value="@_settings.ArchiveAIFiles" />
        </SbFormField>

        <SbFormField Label="@L["AIFilesRetentionDays"]" HelperText="@L["AIFilesRetentionDaysHint"]">
            <SbTextField @bind-Value="@AIFilesRetentionDaysText" />
        </SbFormField>
    }
</SbStack>
