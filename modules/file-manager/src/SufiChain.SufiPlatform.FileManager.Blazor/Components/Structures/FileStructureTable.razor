@namespace SufiChain.SufiPlatform.FileManager.Blazor.Components.Structures
@inherits FileManagerComponentBase

<SbTable TItem="FileStructureDto" Items="@FileStructures" Hover>
    <HeaderContent>
        <tr>
            <th>@L["Key"]</th>
            <th>@L["DisplayName"]</th>
            <th>@L["FileTypes"]</th>
            <th>@L["MaxSize"]</th>
            <th>@L["Status"]</th>
            <th style="min-width: 180px;">@L["Actions"]</th>
        </tr>
    </HeaderContent>
    <RowTemplate Context="structure">
        <td>
            <code class="structure-key">@structure.Key</code>
        </td>
        <td>
            <strong>@ResolveStructureText(structure)</strong>
            @if (!string.IsNullOrEmpty(structure.Description))
            {
                <br />
                <small class="text-muted">@TruncateText(ResolveStructureDescription(structure), 50)</small>
            }
        </td>
        <td>
            @foreach (var type in GetFileTypes(structure.AllowedFileTypes))
            {
                <SbChip Color="@GetFileTypeColor(type)" Size="SbSize.Sm" Class="me-1">
                    @FormatFileType(type)
                </SbChip>
            }
        </td>
        <td>
            <strong>@FileManagerHelpers.FormatFileSize(structure.MaxFileSize)</strong>
        </td>
        <td>
            @if (!structure.HasDefaultConfig)
            {
                <SbChip Color="SbColor.Primary" Size="SbSize.Sm">@L["Custom"]</SbChip>
            }
            else if (structure.IsModifiedFromDefault)
            {
                <SbChip Color="SbColor.Warning" Size="SbSize.Sm">@L["Modified"]</SbChip>
            }
            else
            {
                <SbChip Color="SbColor.Success" Size="SbSize.Sm">@L["Default"]</SbChip>
            }
        </td>
        <td>
            <SbStack Direction="SbStackDirection.Row" Gap="1">
                <SbTooltip Text="@L["ViewDetails"]">
                    <SbIconButton Color="SbColor.Success" Size="SbSize.Sm" OnClick="@(() => OnView.InvokeAsync(structure))" AriaLabel="@L["ViewDetails"]">
                        <Icon><SbIcon Name="eye" /></Icon>
                    </SbIconButton>
                </SbTooltip>
                <SbTooltip Text="@L["Edit"]">
                    <SbIconButton Color="SbColor.Info" Size="SbSize.Sm" OnClick="@(() => OnEdit.InvokeAsync(structure))" AriaLabel="@L["Edit"]">
                        <Icon><SbIcon Name="edit" /></Icon>
                    </SbIconButton>
                </SbTooltip>
                @if (structure.HasDefaultConfig && structure.IsModifiedFromDefault)
                {
                    <SbTooltip Text="@L["ResetToDefault"]">
                        <SbIconButton Color="SbColor.Warning" Size="SbSize.Sm" OnClick="@(() => OnReset.InvokeAsync(structure))" AriaLabel="@L["ResetToDefault"]">
                            <Icon><SbIcon Name="refresh" /></Icon>
                        </SbIconButton>
                    </SbTooltip>
                }
                @if (!structure.IsStatic)
                {
                    <SbTooltip Text="@L["Delete"]">
                        <SbIconButton Color="SbColor.Danger" Size="SbSize.Sm" OnClick="@(() => OnDelete.InvokeAsync(structure))" AriaLabel="@L["Delete"]">
                            <Icon><SbIcon Name="trash" /></Icon>
                        </SbIconButton>
                    </SbTooltip>
                }
            </SbStack>
        </td>
    </RowTemplate>
</SbTable>
