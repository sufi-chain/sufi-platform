@namespace SufiChain.SufiPlatform.FileManager.Blazor.Components.Common
<div class="file-thumbnail @CssClass" style="@Style">
    @if (FileItem != null)
    {
        <div class="thumbnail-container position-relative">
            @if (FileItem.FileType == FileType.Image)
            {
                <img src="@GetThumbnailUrl()" 
                     alt="@(FileItem.Alt ?? FileItem.OriginalName)" 
                     class="thumbnail-image @(Rounded ? "rounded" : "")"
                     loading="lazy" />
            }
            else if (FileItem.FileType == FileType.Video)
            {
                <div class="video-thumbnail position-relative">
                    <img src="@GetThumbnailUrl()" 
                         alt="@(FileItem.Alt ?? FileItem.OriginalName)" 
                         class="thumbnail-image @(Rounded ? "rounded" : "")"
                         loading="lazy" />
                    <div class="video-overlay">
                        <SbIcon Name="eye" Size="SbSize.Lg" />
                    </div>
                </div>
            }
            else
            {
                <div class="document-thumbnail @(Rounded ? "rounded" : "")">
                    <SbIcon Name="file" Size="SbSize.Lg" />
                </div>
            }

            @if (ShowBadge && !string.IsNullOrEmpty(BadgeText))
            {
                <span class="position-absolute top-0 end-0 m-1">
                    <SbChip Color="SbColor.Primary" Size="SbSize.Sm">@BadgeText</SbChip>
                </span>
            }
        </div>

        @if (ShowTitle)
        {
            <div class="thumbnail-title mt-2">
                <small class="text-truncate d-block">@FileItem.OriginalName</small>
            </div>
        }
    }
    else
    {
        <div class="placeholder-thumbnail @(Rounded ? "rounded" : "")">
            <SbIcon Name="file" Size="SbSize.Lg" />
        </div>
    }
</div>
