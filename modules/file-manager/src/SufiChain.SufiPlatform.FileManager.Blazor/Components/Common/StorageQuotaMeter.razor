@namespace SufiChain.SufiPlatform.FileManager.Blazor.Components.Common
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SufiFileManagerResource> L
<div class="storage-quota-meter @CssClass">
    @if (Quota != null)
    {
        <SbStack Direction="SbStackDirection.Row" Justify="SbJustify.SpaceBetween" Align="SbAlign.Center" Class="mb-2">
            <span class="fw-bold">@L["StorageUsage"]</span>
            <span class="text-muted">
                @L["Megabytes", Quota.UsedMB.ToString("0.##")] /
                @(Quota.IsUnlimited ? L["Unlimited"] : L["Megabytes", Quota.LimitMB.ToString("0.##")])
            </span>
        </SbStack>

        <SbProgress Value="@((int)Quota.PercentageUsed)" Color="@GetQuotaColor()">
            @if (ShowPercentage)
            {
                <span>@Quota.PercentageUsed.ToString("0.#")%</span>
            }
        </SbProgress>

        @if (ShowDetails)
        {
            <div class="mt-2">
                <small class="text-muted">
                    <div>
                        @L["Available"]:
                        @(Quota.IsUnlimited ? L["Unlimited"] : L["Megabytes", Quota.AvailableMB.ToString("0.##")])
                    </div>
                    @if (Quota.PercentageUsed >= 90 && Quota.PercentageUsed < 100)
                    {
                        <SbAlert Severity="SbAlertSeverity.Warning" Class="mt-2 py-1 px-2">
                            @L["StorageAlmostFull"]
                        </SbAlert>
                    }
                    else if (Quota.PercentageUsed >= 100)
                    {
                        <SbAlert Severity="SbAlertSeverity.Danger" Class="mt-2 py-1 px-2">
                            @L["StorageQuotaExceededLabel"]
                        </SbAlert>
                    }
                </small>
            </div>
        }
    }
    else
    {
        <div class="text-center py-3">
            <SbProgress Type="SbProgressType.Circular" Size="SbSize.Sm" />
            <span class="ms-2 text-muted">@L["LoadingStorageInfo"]</span>
        </div>
    }
</div>
