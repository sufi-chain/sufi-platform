@implements IDisposable
@inject IFileItemAppService FileItemAppService
@inject IFileItemUrlProvider FileItemUrlProvider
@inject NavigationManager NavigationManager

@inherits FileManagerComponentBase

<div class="media-browser">
    <SbCard>
        <Header>
            <SbStack Direction="SbStackDirection.Row" Justify="SbJustify.SpaceBetween" Align="SbAlign.Center" Wrap="true" Gap="4">
                <SbStack Direction="SbStackDirection.Row" Gap="2">
                    <SbButton Color="SbColor.Primary" OnClick="@ShowUploadModal">
                        <StartIcon><SbIcon Name="upload" /></StartIcon>
                        <ChildContent>@L["Upload"]</ChildContent>
                    </SbButton>
                    <SbButton Color="SbColor.Default" OnClick="@RefreshFiles">
                        <StartIcon><SbIcon Name="refresh" /></StartIcon>
                        <ChildContent>@L["Refresh"]</ChildContent>
                    </SbButton>
                    <SbButton Color="SbColor.Danger" OnClick="@DeleteSelected" Disabled="@(!_selectedItems.Any())">
                        <StartIcon><SbIcon Name="trash" /></StartIcon>
                        <ChildContent>@L["DeleteSelectedCount", _selectedItems.Count]</ChildContent>
                    </SbButton>
                </SbStack>
                <SbStack Direction="SbStackDirection.Row" Gap="1" role="radiogroup" aria-label="View mode">
 
                </SbStack>
            </SbStack>
        </Header>
        <ChildContent>
            <!-- Filters -->
            <SbStack Direction="SbStackDirection.Row" Gap="4" Class="p-3" Wrap="true">
                <div style="flex: 2; min-width: 200px;">
                    <SbTextField Placeholder="@L["SearchPlaceholder"]" @bind-Value="@_searchKeyword" @onkeyup="@OnSearchKeyPress">
                        <StartAdornment><SbIcon Name="search" /></StartAdornment>
                    </SbTextField>
                </div>
                <div style="flex: 1; min-width: 150px;">
                    <SbSelect TItem="FileType?" 
                              TValue="FileType?" 
                              Items="@_fileTypeOptions"
                              @bind-Value="@_filterFileType"
                              @bind-Value:after="OnFileTypeFilterChanged"
                              TextField="@GetFileTypeLabel"
                              Placeholder="@L["AllTypes"]" />
                </div>
                <div style="flex: 1; min-width: 150px;">
                    <SbSelect TItem="SortOption" 
                              TValue="string" 
                              Items="@_sortOptions"
                              @bind-Value="@_sortBy"
                              @bind-Value:after="OnSortByChanged"
                              TextField="@(x => x.Label)"
                              ValueField="@(x => x.Value)"
                              Placeholder="@L["SortBy"]" />
                </div>
                <div>
                    <SbCheckbox @bind-Value="@_showOnlyPublic" @bind-Value:after="OnPublicFilterChanged" 
                                Label="@L["PublicOnly"]" />
                </div>
            </SbStack>

        <!-- Storage Quota -->
        @if (_storageQuota != null)
        {
            <div class="px-3 pb-3">
                <StorageQuotaMeter Quota="@_storageQuota" />
            </div>
        }

        <!-- Content -->
        @if (_isLoading)
        {
            <div class="text-center py-5">
                <SbProgress Type="SbProgressType.Circular" />
                <p class="mt-3 text-muted">@L["LoadingFiles"]</p>
            </div>
        }
        else if (!_fileItems.Any())
        {
            <SbEmptyState Class="py-5">
                <SbIcon Name="folder" Size="SbSize.Xl" />
                <p class="text-muted mt-3">@L["NoFilesFound"]</p>
                <SbButton Color="SbColor.Primary" OnClick="@ShowUploadModal">
                    <StartIcon><SbIcon Name="upload" /></StartIcon>
                    <ChildContent>@L["UploadFiles"]</ChildContent>
                </SbButton>
            </SbEmptyState>
        }
        else
        {
            @if (_viewMode == ViewMode.Grid)
            {
                <div class="media-grid p-3">
                    @foreach (var item in _fileItems)
                    {
                        <div @key="item.Id" class="@GetItemClass(item.Id)">
                            <SbCard Class="h-100" OnClick="@(() => OpenPreview(item))">
                                <ChildContent>
                                    <div class="media-item-select" @onclick:stopPropagation="true">
                                        <SbCheckbox Value="@_selectedItems.Contains(item.Id)" 
                                                   ValueChanged="@((val) => ToggleSelection(item.Id, val))" />
                                    </div>
                                    <div class="media-item-preview">
                                        @if (item.FileType == FileType.Image && !string.IsNullOrEmpty(item.ThumbnailBlobName))
                                        {
                                            <img src="@GetThumbnailUrl(item)" alt="@item.Alt" />
                                        }
                                        else
                                        {
                                            <div class="media-icon">
                                                <SbIcon Name="@GetFileIconName(item.FileType)" Size="SbSize.Xl" />
                                            </div>
                                        }
                                    </div>
                                    <div class="media-item-info">
                                        <small class="text-truncate d-block" title="@item.OriginalName">@item.OriginalName</small>
                                        <small class="text-muted">@FormatFileSize(item.Size)</small>
                                    </div>
                                </ChildContent>
                            </SbCard>
                        </div>
                    }
                </div>
            }
            else
            {
                <SbTable TItem="FileItemDto" Items="@_fileItems" Striped Hover>
                    <HeaderContent>
                        <tr>
                            <th style="width: 40px;">
                                <SbCheckbox Value="@_selectAll" ValueChanged="@ToggleSelectAll" />
                            </th>
                            <th>Preview</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Uploaded</th>
                            <th>Actions</th>
                        </tr>
                    </HeaderContent>
                    <RowTemplate Context="item">
                        <td>
                            <SbCheckbox Value="@_selectedItems.Contains(item.Id)" 
                                       ValueChanged="@((val) => ToggleSelection(item.Id, val))" />
                        </td>
                        <td style="width: 60px;">
                            @if (item.FileType == FileType.Image && !string.IsNullOrEmpty(item.ThumbnailBlobName))
                            {
                                <img src="@GetThumbnailUrl(item)" alt="@item.Alt" 
                                     style="max-width: 50px; max-height: 50px; border-radius: 4px;" />
                            }
                            else
                            {
                                <SbIcon Name="@GetFileIconName(item.FileType)" Size="SbSize.Lg" />
                            }
                        </td>
                        <td>@item.OriginalName</td>
                        <td>
                            <SbChip Color="@GetFileTypeColor(item.FileType)" Size="SbSize.Sm">
                                @item.FileType
                            </SbChip>
                        </td>
                        <td>@FormatFileSize(item.Size)</td>
                        <td>@item.CreationTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <SbStack Direction="SbStackDirection.Row" Gap="1">
                                <SbIconButton Color="SbColor.Info" Size="SbSize.Sm" OnClick="@(() => OpenPreview(item))" AriaLabel="Preview file">
                                    <Icon><SbIcon Name="eye" /></Icon>
                                </SbIconButton>
                                <SbIconButton Color="SbColor.Primary" Size="SbSize.Sm" OnClick="@(() => NavigationManager.NavigateTo(GetDownloadUrl(item)))" AriaLabel="Download file">
                                    <Icon><SbIcon Name="download" /></Icon>
                                </SbIconButton>
                                <SbIconButton Color="SbColor.Danger" Size="SbSize.Sm" OnClick="@(() => DeleteFile(item.Id))" AriaLabel="Delete file">
                                    <Icon><SbIcon Name="trash" /></Icon>
                                </SbIconButton>
                            </SbStack>
                        </td>
                    </RowTemplate>
                </SbTable>
            }

            <!-- Pagination -->
            @if (_totalCount > _pageSize)
            {
                <div class="p-3">
                    <SbPagination PageIndex="@(_currentPage - 1)"
                                  PageSize="@_pageSize"
                                  TotalCount="@_totalCount"
                                  PageIndexChanged="@(p => ChangePage(p + 1))" />
                    <p class="text-muted text-center mt-2">Showing @_fileItems.Count of @_totalCount items</p>
                </div>
            }
        }
        </ChildContent>
    </SbCard>
</div>

<style>
    .media-browser {
        width: 100%;
    }
    
    .media-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: var(--sb-space-3);
    }
    
    .media-browser-item {
        position: relative;
    }
    
    .media-browser-item.selected {
        outline: 2px solid var(--sb-color-primary);
        border-radius: var(--sb-radius-md);
    }
    
    .media-item-select {
        position: absolute;
        top: 8px;
        left: 8px;
        z-index: 1;
    }
    
    .media-item-preview {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: var(--sb-color-background);
        border-radius: var(--sb-radius-md) var(--sb-radius-md) 0 0;
        cursor: pointer;
    }
    
    .media-item-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .media-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        opacity: 0.5;
    }
    
    .media-item-info {
        padding: var(--sb-space-2);
        text-align: center;
    }
</style>

<!-- Upload Modal -->
<SbDialog @bind-Open="_uploadModalOpen" Title="Upload Files" Size="SbDialogSize.Lg">
    <ChildContent>
        <FileUploader 
            StructureKey="@StructureKey"
            EntityType="@EntityType"
            EntityId="@EntityId"
            OnUploadCompleted="@OnUploadCompleted" />
    </ChildContent>
</SbDialog>

<!-- Delete Confirmation Modal -->
<SbDialog @bind-Open="_deleteModalOpen" Title="@L["ConfirmDeleteTitle"]">
    <ChildContent>
        <p>@L["ConfirmDeleteSelectedFiles", _selectedItems.Count]</p>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Color="SbColor.Default" OnClick="@CancelDelete">@L["Cancel"]</SbButton>
            <SbButton Color="SbColor.Danger" OnClick="@ConfirmDeleteSelected">@L["Delete"]</SbButton>
        </SbStack>
    </Footer>
</SbDialog>

@code {
    [Parameter] public string? StructureKey { get; set; }
    [Parameter] public string? EntityType { get; set; }
    [Parameter] public Guid? EntityId { get; set; }
    [Parameter] public EventCallback<FileItemDto> OnFileSelected { get; set; }

    private record SortOption(string Label, string Value);

    private static readonly FileType?[] _fileTypeOptions = 
        new FileType?[] { null, FileType.Image, FileType.Video, FileType.Document, FileType.Audio };

    private string GetFileTypeLabel(FileType? type) => type?.ToString() ?? L["AllTypes"];

    private SortOption[] _sortOptions = Array.Empty<SortOption>();

    private List<FileItemDto> _fileItems = new();
    private HashSet<Guid> _selectedItems = new();
    private bool _isLoading = false;
    private string _searchKeyword = "";
    private FileType? _filterFileType = null;
    private bool _showOnlyPublic = false;
    private string _sortBy = "CreationTime DESC";
    private ViewMode _viewMode = ViewMode.Grid;
    private bool _selectAll = false;
    private StorageQuotaDto? _storageQuota;
    private bool _uploadModalOpen = false;
    private bool _deleteModalOpen = false;
    private readonly CancellationTokenSource _cts = new();


    private int _currentPage = 1;
    private int _pageSize = 24;
    private int _totalCount = 0;
    private int _totalPages => (_totalCount + _pageSize - 1) / _pageSize;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _sortOptions = new[]
        {
            new SortOption(L["SortNewestFirst"], "CreationTime DESC"),
            new SortOption(L["SortOldestFirst"], "CreationTime ASC"),
            new SortOption(L["SortNameAZ"], "OriginalName ASC"),
            new SortOption(L["SortNameZA"], "OriginalName DESC"),
            new SortOption(L["SortLargestFirst"], "Size DESC"),
            new SortOption(L["SortSmallestFirst"], "Size ASC")
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFiles();
        await LoadStorageQuota();
    }

    private async Task LoadFiles()
    {
        _isLoading = true;
        try
        {
            var input = new GetFileListInput
            {
                Keyword = _searchKeyword,
                FileType = _filterFileType,
                EntityType = EntityType,
                EntityId = EntityId,
                StructureKey = StructureKey,
                OnlyFromPublicStructures = _showOnlyPublic ? true : null,
                Sorting = _sortBy,
                SkipCount = (_currentPage - 1) * _pageSize,
                MaxResultCount = _pageSize
            };

            var result = await FileItemAppService.GetListAsync(input);
            _fileItems = result.Items.ToList();
            _totalCount = (int)result.TotalCount;
        }
        catch (Exception ex)
        {
            await Notify.ErrorAsync(L["FailedToLoadFiles", ex.Message]);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadStorageQuota()
    {
        try
        {
            _storageQuota = await FileItemAppService.GetStorageQuotaAsync();
        }
        catch
        {
            // Ignore quota errors
        }
    }

    private async Task RefreshFiles()
    {
        _selectedItems.Clear();
        _selectAll = false;
        await LoadFiles();
        await LoadStorageQuota();
    }

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadFiles();
        }
    }

    private async Task OnFileTypeFilterChanged()
    {
        _currentPage = 1;
        await LoadFiles();
    }

    private async Task OnPublicFilterChanged()
    {
        _currentPage = 1;
        await LoadFiles();
    }

    private async Task OnSortByChanged()
    {
        await LoadFiles();
    }

    private async Task ChangePage(int page)
    {
        _currentPage = page;
        await LoadFiles();
    }

    private void ToggleSelection(Guid id, bool selected)
    {
        if (selected)
            _selectedItems.Add(id);
        else
            _selectedItems.Remove(id);

        _selectAll = _selectedItems.Count == _fileItems.Count;
        StateHasChanged();
    }

    private void ToggleSelectAll(bool selected)
    {
        _selectAll = selected;
        if (selected)
        {
            foreach (var item in _fileItems)
                _selectedItems.Add(item.Id);
        }
        else
        {
            _selectedItems.Clear();
        }
        StateHasChanged();
    }

    private void DeleteSelected()
    {
        if (!_selectedItems.Any()) return;
        _deleteModalOpen = true;
    }

    private void CancelDelete()
    {
        _deleteModalOpen = false;
    }

    private async Task ConfirmDeleteSelected()
    {
        if (!_selectedItems.Any()) return;

        try
        {
            await FileItemAppService.DeleteManyAsync(_selectedItems.ToArray());
            await Notify.SuccessAsync("Files deleted successfully");
            _selectedItems.Clear();
            await RefreshFiles();
        }
        catch (Exception ex)
        {
            await Notify.ErrorAsync($"Failed to delete files: {ex.Message}");
        }
        finally
        {
            _deleteModalOpen = false;
        }
    }

    private void DeleteFile(Guid id)
    {
        _selectedItems.Clear();
        _selectedItems.Add(id);
        _deleteModalOpen = true;
    }

    private async Task ConfirmDeleteFile()
    {
        // This method is for single file delete, but we reuse the multi-delete flow
        await ConfirmDeleteSelected();
    }

    // Legacy method for backwards compatibility
    private async Task DeleteFileDirectly(Guid id)
    {
        try
        {
            await FileItemAppService.DeleteAsync(id);
            await Notify.SuccessAsync("File deleted successfully");
            await RefreshFiles();
        }
        catch (Exception ex)
        {
            await Notify.ErrorAsync($"Failed to delete file: {ex.Message}");
        }
    }

    private void ShowUploadModal()
    {
        _uploadModalOpen = true;
    }

    private async Task OnUploadCompleted(List<FileItemDto> uploadedFiles)
    {
        _uploadModalOpen = false;
        
        if (uploadedFiles.Count > 0)
        {
            await Notify.SuccessAsync($"Successfully uploaded {uploadedFiles.Count} file(s)");
        }
        
        await RefreshFiles();
    }

    private async Task OpenPreview(FileItemDto item)
    {
        await OnFileSelected.InvokeAsync(item);
    }

    private string GetThumbnailUrl(FileItemDto file)
    {
        return FileItemUrlProvider.GetThumbnailUrl(file.Id, (file.LastModificationTime ?? file.CreationTime).Ticks, file.StructureBaseUrl, file.StructureIsPublicAccess, file.ThumbnailBlobName, file.TenantId, file.StructureStorageProvider);
    }

    private string GetDownloadUrl(FileItemDto file)
    {
        return FileItemUrlProvider.GetDownloadUrl(file.Id, file.StructureBaseUrl, file.StructureIsPublicAccess, file.BlobName, file.TenantId, file.StructureStorageProvider);
    }

    private string GetFileIconName(FileType fileType)
    {
        return fileType switch
        {
            FileType.Image => "file",
            FileType.Video => "file",
            FileType.Document => "file",
            FileType.Audio => "file",
            _ => "file"
        };
    }

    private SbColor GetFileTypeColor(FileType fileType)
    {
        return fileType switch
        {
            FileType.Image => SbColor.Success,
            FileType.Video => SbColor.Info,
            FileType.Document => SbColor.Warning,
            FileType.Audio => SbColor.Primary,
            _ => SbColor.Default
        };
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes == 0) return "0 B";
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private string GetItemClass(Guid itemId)
    {
        return _selectedItems.Contains(itemId) ? "media-browser-item selected" : "media-browser-item";
    }


    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private enum ViewMode
    {
        Grid,
        List
    }
}
