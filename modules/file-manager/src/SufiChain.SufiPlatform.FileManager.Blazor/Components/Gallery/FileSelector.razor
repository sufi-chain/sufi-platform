@namespace SufiChain.SufiPlatform.FileManager.Blazor.Components.Gallery
@inherits FileManagerComponentBase

<SbDialog @bind-Open="_isOpen" Title="@L["SelectFile"]" Size="SbDialogSize.Xl" AllowDropdownOverflow="true">
    <ChildContent>
        <div class="p-3">
        <SbStack Direction="SbStackDirection.Row" Gap="4" Class="mb-3" Wrap="true">
            <div style="flex: 2; min-width: 200px;">
                <SbTextField Placeholder="@L["SearchPlaceholder"]" @bind-Value="@_searchKeyword">
                    <StartAdornment><SbIcon Name="search" /></StartAdornment>
                </SbTextField>
            </div>
            <div style="flex: 1; min-width: 150px;">
                <SbSelect TItem="StructureFilterOption"
                          TValue="string?"
                          Items="@_structureFilterOptions"
                          @bind-Value="@_filterStructureKey"
                          @bind-Value:after="OnStructureFilterChanged"
                          TextField="@(x => x.DisplayName)"
                          ValueField="@(x => x.Key)"
                          Placeholder="@L["AllStructures"]" />
            </div>
            <div style="flex: 1; min-width: 150px;">
                <SbSelect TItem="FileType?" 
                          TValue="FileType?" 
                          Items="@_fileTypeOptions"
                          @bind-Value="@_selectedFileType"
                          TextField="@GetFileTypeLabel"
                          Placeholder="@L["AllTypes"]" />
            </div>
            <SbButton Color="SbColor.Primary" OnClick="@LoadFileItems">
                <ChildContent>@L["Search"]</ChildContent>
            </SbButton>
        </SbStack>

        @if (_isLoading)
        {
            <div class="text-center py-5">
                <SbProgress Type="SbProgressType.Circular" />
                <p class="mt-3 text-muted">@L["LoadingFiles"]</p>
            </div>
        }
        else if (_fileItems.Any())
        {
            <div class="selector-grid">
                @foreach (var item in _fileItems)
                {
                    <div class="selector-item @(_selectedItems.Contains(item.Id) ? "selected" : "")"
                         @onclick="() => ToggleSelection(item)">
                        <FileThumbnail FileItem="@item" Width="150" Height="150" />
                        @if (_selectedItems.Contains(item.Id))
                        {
                            <div class="selection-indicator">
                                <SbIcon Name="check" Size="SbSize.Lg" Color="SbColor.Primary" />
                            </div>
                        }
                    </div>
                }
            </div>

            <SbStack Direction="SbStackDirection.Row" Justify="SbJustify.SpaceBetween" Align="SbAlign.Center" Class="mt-3">
                <span class="text-muted">@L["ShowingItemsCount", _fileItems.Count, _totalCount]</span>
                @if (_totalPages > 1)
                {
                    <SbPagination PageIndex="@(_currentPage - 1)" PageSize="@PageSize" TotalCount="@_totalCount" PageIndexChanged="@(p => LoadPage(p + 1))" />
                }
            </SbStack>
        }
        else
        {
            <SbEmptyState Class="py-5">
                <SbIcon Name="folder" Size="SbSize.Xl" />
                <p class="mt-3 text-muted">@L["NoFilesFound"]</p>
            </SbEmptyState>
        }
        </div>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Color="SbColor.Default" OnClick="@Hide">@L["Cancel"]</SbButton>
            <SbButton Color="SbColor.Primary" OnClick="@ConfirmSelection" Disabled="@(!_selectedItems.Any())">
                @L["SelectCount", _selectedItems.Count]
            </SbButton>
        </SbStack>
    </Footer>
</SbDialog>
