@inject IFileItemAppService FileItemAppService
@inherits FileManagerComponentBase

<SbDialog @bind-Open="_isOpen" Title="@L["SelectFile"]" Size="SbDialogSize.Xl">
    <ChildContent>
        <div class="p-3">
        <SbStack Direction="SbStackDirection.Row" Gap="4" Class="mb-3" Wrap="true">
            <div style="flex: 2; min-width: 200px;">
                <SbTextField Placeholder="@L["SearchPlaceholder"]" @bind-Value="@_searchKeyword">
                    <StartAdornment><SbIcon Name="search" /></StartAdornment>
                </SbTextField>
            </div>
            <div style="flex: 1; min-width: 150px;">
                <SbSelect TItem="FileType?" 
                          TValue="FileType?" 
                          Items="@_fileTypeOptions"
                          @bind-Value="@_selectedFileType"
                          TextField="@GetFileTypeLabel"
                          Placeholder="@L["AllTypes"]" />
            </div>
            <SbButton Color="SbColor.Primary" OnClick="@LoadFileItems">
                <ChildContent>@L["Search"]</ChildContent>
            </SbButton>
        </SbStack>

        @if (_isLoading)
        {
            <div class="text-center py-5">
                <SbProgress Type="SbProgressType.Circular" />
                <p class="mt-3 text-muted">@L["LoadingFiles"]</p>
            </div>
        }
        else if (_fileItems.Any())
        {
            <div class="selector-grid">
                @foreach (var item in _fileItems)
                {
                    <div class="selector-item @(_selectedItems.Contains(item.Id) ? "selected" : "")"
                         @onclick="() => ToggleSelection(item)">
                        <FileThumbnail FileItem="@item" Width="150" Height="150" />
                        @if (_selectedItems.Contains(item.Id))
                        {
                            <div class="selection-indicator">
                                <SbIcon Name="check" Size="SbSize.Lg" Color="SbColor.Primary" />
                            </div>
                        }
                    </div>
                }
            </div>

            <SbStack Direction="SbStackDirection.Row" Justify="SbJustify.SpaceBetween" Align="SbAlign.Center" Class="mt-3">
                <span class="text-muted">@L["ShowingItemsCount", _fileItems.Count, _totalCount]</span>
                @if (_totalPages > 1)
                {
                    <SbPagination PageIndex="@(_currentPage - 1)" PageSize="@PageSize" TotalCount="@_totalCount" PageIndexChanged="@(p => LoadPage(p + 1))" />
                }
            </SbStack>
        }
        else
        {
            <SbEmptyState Class="py-5">
                <SbIcon Name="folder" Size="SbSize.Xl" />
                <p class="mt-3 text-muted">@L["NoFilesFound"]</p>
            </SbEmptyState>
        }
        </div>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Color="SbColor.Default" OnClick="@Hide">@L["Cancel"]</SbButton>
            <SbButton Color="SbColor.Primary" OnClick="@ConfirmSelection" Disabled="@(!_selectedItems.Any())">
                @L["SelectCount", _selectedItems.Count]
            </SbButton>
        </SbStack>
    </Footer>
</SbDialog>

<style>
    .selector-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: var(--sb-space-3);
    }
    
    .selector-item {
        position: relative;
        cursor: pointer;
        border-radius: var(--sb-radius-md);
        overflow: hidden;
        border: 2px solid transparent;
        transition: border-color 0.2s;
    }
    
    .selector-item:hover {
        border-color: var(--sb-color-primary-100);
    }
    
    .selector-item.selected {
        border-color: var(--sb-color-primary);
    }
    
    .selection-indicator {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        padding: 8px;
    }
</style>

@code {
    [Parameter] public bool AllowMultiple { get; set; } = false;
    [Parameter] public FileType? FilterFileType { get; set; }
    [Parameter] public string? StructureKey { get; set; }
    [Parameter] public EventCallback<List<FileItemDto>> OnFileSelected { get; set; }

    private static readonly FileType?[] _fileTypeOptions = 
        new FileType?[] { null, FileType.Image, FileType.Video, FileType.Document };

    private string GetFileTypeLabel(FileType? type) => type?.ToString() ?? L["AllTypes"];

    private bool _isOpen = false;
    private List<FileItemDto> _fileItems = new();
    private HashSet<Guid> _selectedItems = new();
    private bool _isLoading = false;
    private string? _searchKeyword;
    private FileType? _selectedFileType;
    private int _currentPage = 1;
    private int _totalCount = 0;
    private int _totalPages = 0;
    private const int PageSize = 12;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _selectedFileType = FilterFileType;
    }

    public async Task ShowAsync()
    {
        _selectedItems.Clear();
        _isOpen = true;
        await LoadFileItems();
    }

    public void Hide()
    {
        _isOpen = false;
    }

    private async Task LoadFileItems()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var input = new GetFileListInput
            {
                Keyword = _searchKeyword,
                FileType = _selectedFileType,
                StructureKey = StructureKey,
                SkipCount = (_currentPage - 1) * PageSize,
                MaxResultCount = PageSize,
                Sorting = "CreationTime DESC"
            };

            var result = await FileItemAppService.GetListAsync(input);
            _fileItems = result.Items.ToList();
            _totalCount = (int)result.TotalCount;
            _totalPages = (int)Math.Ceiling((double)_totalCount / PageSize);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadPage(int page)
    {
        _currentPage = page;
        await LoadFileItems();
    }

    private void ToggleSelection(FileItemDto item)
    {
        if (AllowMultiple)
        {
            if (_selectedItems.Contains(item.Id))
                _selectedItems.Remove(item.Id);
            else
                _selectedItems.Add(item.Id);
        }
        else
        {
            _selectedItems.Clear();
            _selectedItems.Add(item.Id);
        }
    }

    private async Task ConfirmSelection()
    {
        var selectedFiles = _fileItems.Where(m => _selectedItems.Contains(m.Id)).ToList();
        await OnFileSelected.InvokeAsync(selectedFiles);
        Hide();
    }
}
