@namespace SufiChain.SufiPlatform.FileManager.Blazor.Pages
@page "/panel/admin/file-manager/stats"
@attribute [Authorize(FileManagerPermissions.FileItems.Default)]
@inherits FileManagerComponentBase

<SufiPageToolbar>
	<SbStack Direction="SbStackDirection.Row" Gap="2">
		<SbButton Color="SbColor.Primary" Variant="SbButtonVariant.Outline" OnClick="@RefreshStats">
			<StartIcon><SbIcon Name="refresh" /></StartIcon>
			<ChildContent>@L["Statistics"]</ChildContent>
		</SbButton>
	</SbStack>
</SufiPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">

	<!-- Statistics Dashboard -->
	<SbLoadingSkeleton Preset="SbLoadingSkeletonPreset.Kpi" Count="4" Busy="@(!_statsReady)">
		<ChildContent>
			@if (_statsFailed)
			{
				<SbAlert Severity="SbAlertSeverity.Danger">
					<SbStack Direction="SbStackDirection.Row" Gap="3" Align="SbAlign.Center" Wrap="true">
						<span>@L["DataLoadFailedGeneric"]</span>
						<SbButton Size="SbSize.Sm" Variant="SbButtonVariant.Outline" OnClick="@RefreshStats">@L["Retry"]</SbButton>
					</SbStack>
				</SbAlert>
			}
			else if (_statsReady)
			{
		<SbStack Direction="SbStackDirection.Row" Gap="4" Wrap="true">
			<SbStatCard Label="@L["TotalFiles"]" Value="@_statistics.TotalCount.ToString()" Class="flex-1">
				<Icon><SbIcon Name="folder" Size="SbSize.Lg" Color="SbColor.Primary" /></Icon>
			</SbStatCard>
			<SbStatCard Label="@L["Images"]" Value="@_statistics.ImageCount.ToString()" Class="flex-1">
				<Icon><SbIcon Name="file" Size="SbSize.Lg" Color="SbColor.Success" /></Icon>
			</SbStatCard>
			<SbStatCard Label="@L["Videos"]" Value="@_statistics.VideoCount.ToString()" Class="flex-1">
				<Icon><SbIcon Name="file" Size="SbSize.Lg" Color="SbColor.Info" /></Icon>
			</SbStatCard>
			<SbStatCard Label="@L["StorageUsed"]" Value="@FormatSize(_statistics.TotalSize)" Class="flex-1">
				<Icon><SbIcon Name="folder" Size="SbSize.Lg" Color="SbColor.Warning" /></Icon>
			</SbStatCard>
		</SbStack>
			}
		</ChildContent>
	</SbLoadingSkeleton>

	<!-- File Browser -->
	@* <FileBrowser @ref="_fileBrowserRef" /> *@

	<!-- File Structures -->
	<SbCard>
		<Header>
			<SbStack Direction="SbStackDirection.Row" Align="@SbAlign.Center" Justify="@SbJustify.SpaceBetween">
				<h5 class="m-0">@L["FileStructures"]</h5>
				<SbButton Href="/panel/admin/file-manager/structures">
					@L["AddStructure"]
				</SbButton>
			</SbStack>
		</Header>
		<ChildContent>
			@if (!_structuresReady)
			{
				<SbLoadingSkeleton Preset="SbLoadingSkeletonPreset.Table" Count="4" Announce="false" />
			}
			else if (_structuresFailed)
			{
				<SbAlert Severity="SbAlertSeverity.Danger">
					<SbStack Direction="SbStackDirection.Row" Gap="3" Align="SbAlign.Center" Wrap="true">
						<span>@L["DataLoadFailed"]</span>
						<SbButton Size="SbSize.Sm" Variant="SbButtonVariant.Outline" OnClick="@LoadStructures">@L["Retry"]</SbButton>
					</SbStack>
				</SbAlert>
			}
			else if (_structures.Any())
			{
				@* Desktop: table layout *@
				<div class="file-structures-desktop">
					<SbTable TItem="FileStructureDto" Items="@_structures" Hover>
						<HeaderContent>
							<tr>
								<th style="min-width: 10%;">@L["Key"]</th>
								<th style="min-width: 10%;">@L["DisplayName"]</th>
								<th style="min-width: 20%;">@L["Type"]</th>
								<th style="min-width: 10%;">@L["MaxSize"]</th>
								<th style="min-width: 50%;">@L["Extensions"]</th>
							</tr>
						</HeaderContent>
						<RowTemplate Context="structure">
							<td><code>@structure.Key</code></td>
							<td>@ResolveStructureText(structure)</td>
							<td>
								<SbStack Direction="SbStackDirection.Row" Gap="1" Wrap="true">
									@foreach (var type in GetFileTypes(structure.AllowedFileTypes))
									{
										<SbChip Color="@GetFileTypeColor(type)" Size="SbSize.Sm">@FormatFileType(type)</SbChip>
									}
								</SbStack>
							</td>
							<td>@FormatSize(structure.MaxFileSize)</td>
							<td>
								<SbStack Direction="SbStackDirection.Row" Gap="1" Wrap="true">
									@foreach (var ext in GetExtensions(structure.AllowedExtensions))
									{
										<SbChip Color="SbColor.Default" Size="SbSize.Sm">.@ext</SbChip>
									}
								</SbStack>
							</td>
						</RowTemplate>
					</SbTable>
				</div>

				@* Mobile: card layout *@
				<div class="file-structures-mobile">
					<SbStack Direction="SbStackDirection.Column" Gap="3">
						@foreach (var structure in _structures)
						{
							<div class="file-structure-card">
								<div class="file-structure-card__header">
									<code>@structure.Key</code>
									<span class="file-structure-card__title">@ResolveStructureText(structure)</span>
								</div>
								<div class="file-structure-card__body">
									<div class="file-structure-card__row">
										<span class="file-structure-card__label">@L["Type"]</span>
										<SbStack Direction="SbStackDirection.Row" Gap="1" Wrap="true">
											@foreach (var type in GetFileTypes(structure.AllowedFileTypes))
											{
												<SbChip Color="@GetFileTypeColor(type)" Size="SbSize.Sm">@FormatFileType(type)</SbChip>
											}
										</SbStack>
									</div>
									<div class="file-structure-card__row">
										<span class="file-structure-card__label">@L["MaxSize"]</span>
										<span>@FormatSize(structure.MaxFileSize)</span>
									</div>
									<div class="file-structure-card__row">
										<span class="file-structure-card__label">@L["Extensions"]</span>
										<div class="file-structure-card__extensions">
											<SbStack Direction="SbStackDirection.Row" Gap="1" Wrap="true">
												@foreach (var ext in GetExtensions(structure.AllowedExtensions))
												{
													<SbChip Color="SbColor.Default" Size="SbSize.Sm">.@ext</SbChip>
												}
											</SbStack>
										</div>
									</div>
								</div>
							</div>
						}
					</SbStack>
				</div>
			}
			else
			{
				<SbEmptyState>
					<SbIcon Name="folder" Size="SbSize.Xl" />
					<p>@L["NoFileStructuresConfigured"]</p>
				</SbEmptyState>
			}
		</ChildContent>
	</SbCard>

	<!-- Recent Activity -->
	<SbCard>
		<Header>
			<h5 class="m-0">@L["RecentActivity"]</h5>
		</Header>
		<ChildContent>
		@if (!_recentReady)
		{
			<SbLoadingSkeleton Preset="SbLoadingSkeletonPreset.Table" Count="4" Announce="false" />
		}
		else if (_recentFailed)
		{
			<SbAlert Severity="SbAlertSeverity.Danger">
				<SbStack Direction="SbStackDirection.Row" Gap="3" Align="SbAlign.Center" Wrap="true">
					<span>@L["DataLoadFailed"]</span>
					<SbButton Size="SbSize.Sm" Variant="SbButtonVariant.Outline" OnClick="@LoadRecentFiles">@L["Retry"]</SbButton>
				</SbStack>
			</SbAlert>
		}
		else if (_recentFiles.Any())
		{
			<SbTable TItem="FileItemDto" Items="@_recentFiles" Striped Hover>
				<HeaderContent>
					<tr>
						<th style="min-width: 85px;">@L["Preview"]</th>
						<th style="min-width: 150px">@L["FileName"]</th>
						<th style="min-width: 100px">@L["Type"]</th>
						<th style="min-width: 130px">@L["Size"]</th>
						<th style="min-width: 130px">@L["Status"]</th>
						<th style="min-width: 150px">@L["UploadedBy"]</th>
						<th style="min-width: 150px">@L["Date"]</th>
						<th style="min-width: 150px">@L["Actions"]</th>
					</tr>
				</HeaderContent>
				<RowTemplate Context="item">
					<td>
						@if (item.FileType == FileType.Image && !string.IsNullOrEmpty(item.ThumbnailBlobName))
						{
							<img src="@GetThumbnailUrl(item)" alt="@item.Alt"
									style="max-width: 50px; max-height: 50px; object-fit: cover; border-radius: 4px;" />
						}
						else
						{
							<SbIcon Name="@GetFileIconName(item.FileType)" Size="SbSize.Lg" />
						}
					</td>
					<td>
						<div class="text-truncate" style="max-width: 200px;" title="@item.OriginalName">
							@item.OriginalName
						</div>
					</td>
					<td>
						<SbChip Color="@GetFileTypeColor(item.FileType)" Size="SbSize.Sm">
							@FormatFileType(item.FileType)
						</SbChip>
					</td>
					<td>@FormatSize(item.Size)</td>
					<td>
						@if (item.IsTemp) 
						{
							<SbChip Color="SbColor.Warning" Size="SbSize.Sm">@L["Temporary"]</SbChip>
						}
						else
						{
							<span class="text-muted">-</span>
						}
					</td>
					<td>@(item.CreatorId?.ToString() ?? L["System"])</td>
					<td>@item.CreationTime.ToString("yyyy-MM-dd HH:mm")</td>
					<td>
						<SbStack Direction="SbStackDirection.Row" Gap="1">
							<SbIconButton Color="SbColor.Info" Size="SbSize.Sm" OnClick="@(() => ViewFile(item))" AriaLabel="@L["ViewFile"]">
								<Icon><SbIcon Name="eye" /></Icon>
							</SbIconButton>
							<SbIconButton Color="SbColor.Primary" Size="SbSize.Sm" OnClick="@(() => DownloadFile(item))" AriaLabel="@L["DownloadFile"]">
								<Icon><SbIcon Name="download" /></Icon>
							</SbIconButton>
							@if (CanDelete())
							{
								<SbIconButton Color="SbColor.Danger" Size="SbSize.Sm" OnClick="@(() => DeleteFile(item.Id))" AriaLabel="@L["DeleteFile"]">
									<Icon><SbIcon Name="trash" /></Icon>
								</SbIconButton>
							}
						</SbStack>
					</td>
				</RowTemplate>
				<EmptyContent>
					<p class="text-muted text-center py-3">@L["NoRecentActivity"]</p>
				</EmptyContent>
			</SbTable>
		}
		else
		{
			<SbEmptyState>
				<SbIcon Name="folder" Size="SbSize.Xl" />
				<p>@L["NoRecentActivity"]</p>
			</SbEmptyState>
		}
		</ChildContent>
	</SbCard>
</SbStack>

<!-- Preview Modal -->
<SbDialog Open="_viewerModalOpen" OpenChanged="@((v) => { _viewerModalOpen = v; if (!v) _viewingItem = null; })" Title="@(_viewingItem?.OriginalName ?? L["Preview"].Value)" Size="SbDialogSize.Xl">
	<ChildContent>
		@if (_viewingItem != null)
		{
			<div style="background: var(--sb-color-surface); padding: 0;">
				@if (_viewingItem.FileType == FileType.Image)
				{
					<FileImage @key="GetViewerMediaKey(_viewingItem)" FileId="@_viewingItem.Id" Size="FileImageSize.Large" />
				}
				else if (_viewingItem.FileType == FileType.Video)
				{
					<FileVideo @key="GetViewerMediaKey(_viewingItem)" FileId="@_viewingItem.Id" Controls="true" />
				}
				else
				{
					<SbEmptyState Class="text-center p-5">
						<SbIcon Name="file" Size="SbSize.Xl" Class="text-muted mb-3" />
						<p>@L["PreviewNotAvailable"]</p>
						<SbButton Href="@GetDownloadUrl(_viewingItem)" Color="SbColor.Primary">
							<StartIcon><SbIcon Name="download" /></StartIcon>
							<ChildContent>@L["Download"]</ChildContent>
						</SbButton>
					</SbEmptyState>
				}
			</div>
		}
	</ChildContent>
	<Footer>
		<SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
			<SbButton Color="SbColor.Default" OnClick="@(() => { _viewerModalOpen = false; _viewingItem = null; })">@L["Close"]</SbButton>
			@if (_viewingItem != null)
			{
				<SbButton Href="@GetDownloadUrl(_viewingItem)" Color="SbColor.Primary">
					<StartIcon><SbIcon Name="download" /></StartIcon>
					<ChildContent>@L["Download"]</ChildContent>
				</SbButton>
			}
		</SbStack>
	</Footer>
</SbDialog>
