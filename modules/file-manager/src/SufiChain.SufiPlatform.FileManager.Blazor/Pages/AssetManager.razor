@namespace SufiChain.SufiPlatform.FileManager.Blazor.Pages
@page "/panel/admin/file-manager/assets"
@using SufiChain.SufiPlatform.FileManager.Blazor.Public.Services
@attribute [Authorize(FileManagerPermissions.FileItems.Default)]
@inherits FileManagerComponentBase
@implements IDisposable

<FileManager 
    ShowFolderTree="true"
    ShowTenantTree="false"
    ShowPropertiesPanel="@_showProperties"
    ShowPropertiesPanelChanged="@HandleShowPropertiesPanelChanged"
    AllowCreateFolders="true"
    AllowDragDrop="true"
    AllowMultiSelect="true"
    InitialViewMode="FileViewMode.LargeIcons"
    OnFileOpen="@HandleFileOpen"
    OnSelectionChanged="@HandleSelectionChanged"
    OnEditImage="@HandleEditImage"
    RefreshTrigger="@_refreshTrigger"
    Class="asset-manager-full-height" />

<!-- Upload Modal -->
<SbDialog Open="_uploadModalOpen" OpenChanged="@OnUploadModalOpenChanged" Title="@L["UploadFiles"]" Size="SbDialogSize.Lg">
    <ChildContent>
        <FileUploader 
            ShowStructureSelector="true"
            StructureKey="@FileStructureKeys.General"
            OnUploadCompleted="@OnUploadCompleted" />
    </ChildContent>
</SbDialog>

<!-- Preview Modal -->
<SbDialog Open="_viewerModalOpen" OpenChanged="@OnViewerModalOpenChanged" Title="@(_viewingItem?.OriginalName ?? L["Preview"].Value)" Size="SbDialogSize.Xl">
    <ChildContent>
        @if (_viewingItem != null)
        {
            <div style="background: #1e1e2e; padding: 0;">
                @if (_viewingItem.FileType == FileType.Image)
                {
                    <FileImage @key="GetViewerMediaKey(_viewingItem)" FileId="@_viewingItem.Id" Size="FileImageSize.Large" />
                }
                else if (_viewingItem.FileType == FileType.Video)
                {
                    <FileVideo @key="GetViewerMediaKey(_viewingItem)" FileId="@_viewingItem.Id" Controls="true" />
                }
                else
                {
                    <SbEmptyState Class="text-center p-5">
                        <SbIcon Name="file" Size="SbSize.Xl" Class="text-muted mb-3" />
                        <p>@L["PreviewNotAvailable"]</p>
                        <SbButton Href="@GetDownloadUrl(_viewingItem!)" Color="SbColor.Primary">
                            <StartIcon><SbIcon Name="download" /></StartIcon>
                            <ChildContent>@L["Download"]</ChildContent>
                        </SbButton>
                    </SbEmptyState>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Color="SbColor.Default" OnClick="@CloseViewerModal">@L["Close"]</SbButton>
            @if (_viewingItem != null)
            {
                <SbButton Color="SbColor.Primary" OnClick="@OpenQuickShare">
                    <StartIcon><SbIcon Name="share" /></StartIcon>
                    <ChildContent>@L["QuickShare"]</ChildContent>
                </SbButton>
                @if (_viewingItem.FileType == FileType.Image)
                {
                    <SbButton Color="SbColor.Primary" OnClick="@OpenImageEditor">
                        <StartIcon><SbIcon Name="edit" /></StartIcon>
                        <ChildContent>@L["EditImage"]</ChildContent>
                    </SbButton>
                }
                <SbButton Href="@GetDownloadUrl(_viewingItem!)" Color="SbColor.Primary">
                    <StartIcon><SbIcon Name="download" /></StartIcon>
                    <ChildContent>@L["Download"]</ChildContent>
                </SbButton>
            }
        </SbStack>
    </Footer>
</SbDialog>

<QuickShareModal Open="_quickShareOpen" OpenChanged="@((v) => { _quickShareOpen = v; if (!v) _quickShareFileId = null; })" FileId="_quickShareFileId" />

<!-- Image Editor Modal -->
<ImageEditorModal 
    File="_imageEditingFile" 
    Open="_imageEditorOpen" 
    OpenChanged="@((v) => _imageEditorOpen = v)"
    OnSaved="@OnImageEditorSaved"
    CurrentFolderId="_currentFolderId" />
