<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CS8669: Suppress nullable annotations warning in Razor-generated code -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.FileManager.Blazor</PackageId>
    <Description>File manager module Blazor UI components for Sufi Platform - media manager and file browser.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Pages\MediaManager.razor" />
    <Content Remove="Pages\MediaStructures.razor" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftAspNetCoreComponentsWebVersion)" />
    <ProjectReference Include="..\..\..\..\framework\SufiChain.SufiPlatform.Ddd.Application.Contracts\SufiChain.SufiPlatform.Ddd.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\framework\SufiChain.SufiPlatform.Data\SufiChain.SufiPlatform.Data.csproj" />
    <!-- Sufi Framework (transitively provides SufiChain.SufiBlazor) -->
    <ProjectReference Include="..\SufiChain.SufiPlatform.FileManager.Application.Contracts\SufiChain.SufiPlatform.FileManager.Application.Contracts.csproj" />
    <ProjectReference Include="..\SufiChain.SufiPlatform.FileManager.Blazor.Public\SufiChain.SufiPlatform.FileManager.Blazor.Public.csproj" />
    <ProjectReference Include="..\..\..\settings\src\SufiChain.SufiPlatform.Settings.Blazor\SufiChain.SufiPlatform.Settings.Blazor.csproj" />
    <ProjectReference Include="..\..\..\users\src\SufiChain.SufiPlatform.Users.Blazor.Public\SufiChain.SufiPlatform.Users.Blazor.Public.csproj" />
    <ProjectReference Include="..\..\..\identity\src\SufiChain.SufiPlatform.Identity.Blazor.Public\SufiChain.SufiPlatform.Identity.Blazor.Public.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\vendor\cropper.min.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\vendor\cropper.min.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy demo documentation to wwwroot/docs for DocViewer -->
  <PropertyGroup>
    <DocsSourceRoot>$(MSBuildThisFileDirectory)..\..\..\..\docs\file-manager</DocsSourceRoot>
  </PropertyGroup>
  <Target Name="CopyDocsToWwwroot" BeforeTargets="Build">
    <ItemGroup>
      <DocToCopy Include="$(DocsSourceRoot)\SufiFileManager.md" />
      <DocToCopy Include="$(DocsSourceRoot)\SufiFileBrowser.md" />
      <DocToCopy Include="$(DocsSourceRoot)\SufiFileGallery.md" />
      <DocToCopy Include="$(DocsSourceRoot)\SufiFileSelector.md" />
      <DocToCopy Include="$(DocsSourceRoot)\SufiFileUploader.md" />
      <DocToCopy Include="$(DocsSourceRoot)\SufiQuickImageUploader.md" />
      <DocToCopy Include="$(DocsSourceRoot)\FileManagerRichTextEditorIntegration.md" />
      <DocToCopy Include="$(MSBuildThisFileDirectory)wwwroot\docs\FileManagerMarkdownEditorIntegration.md" />
      <DocToCopy Include="$(DocsSourceRoot)\FileStructure.md" />
      <DocToCopyFiltered Include="@(DocToCopy)" Condition="Exists('%(DocToCopy.Identity)')" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildThisFileDirectory)wwwroot\docs" Condition="!Exists('$(MSBuildThisFileDirectory)wwwroot\docs')" />
    <Copy SourceFiles="@(DocToCopyFiltered)" DestinationFolder="$(MSBuildThisFileDirectory)wwwroot\docs" SkipUnchangedFiles="true" Condition="'@(DocToCopyFiltered)' != ''" />
  </Target>

</Project>