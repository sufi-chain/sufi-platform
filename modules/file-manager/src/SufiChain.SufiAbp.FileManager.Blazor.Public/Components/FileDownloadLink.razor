@namespace SufiChain.SufiAbp.FileManager.Blazor.Public.Components
@if (_isLoading)
{
    <span class="file-download-link file-download-link--loading @Class">
        @if (LoadingTemplate != null)
        {
            @LoadingTemplate
        }
        else
        {
            <span class="file-download-link__spinner"></span>
            <span>Loading...</span>
        }
    </span>
}
else if (_hasError || _fileInfo == null)
{
    @if (ErrorTemplate != null)
    {
        @ErrorTemplate
    }
    else
    {
        <span class="file-download-link file-download-link--error @Class">
            File not available
        </span>
    }
}
else
{
    @if (AsButton)
    {
        <a href="@_fileInfo.DownloadUrl" 
           class="file-download-link file-download-link--button @Class"
           download="@_fileInfo.FileName"
           target="_blank"
           rel="noopener noreferrer">
            @RenderContent()
        </a>
    }
    else
    {
        <a href="@_fileInfo.DownloadUrl" 
           class="file-download-link file-download-link--link @Class"
           download="@_fileInfo.FileName"
           target="_blank"
           rel="noopener noreferrer">
            @RenderContent()
        </a>
    }
}
