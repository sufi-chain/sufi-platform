@namespace SufiChain.SufiAbp.FileManager.Blazor.Public.Components.Upload

@inherits SufiChain.SufiAbp.UI.Blazor.SufiAbpComponentBase

<div class="public-file-uploader @Class" style="@Style">
    <div class="public-file-uploader__drop-zone @(_isDragging ? "is-dragging" : string.Empty)"
         @ondragenter="HandleDragEnter"
         @ondragleave="HandleDragLeave"
         @ondragover:preventDefault
         @ondrop="HandleDrop"
         @ondrop:preventDefault>
        <SbIcon Name="upload" Size="SbSize.Xl" Class="text-muted" />
        <SbHeading Level="6">@Title</SbHeading>
        <SbText Color="SbColor.Muted">@Description</SbText>

        <label for="@_fileInputId" class="sb-button sb-button--solid sb-button--primary sb-button--md">
            <SbIcon Name="folder" /> @BrowseButtonText
        </label>

        <InputFile id="@_fileInputId"
                   class="d-none"
                   OnChange="OnFilesSelectedAsync"
                   multiple="@AllowMultiple"
                   accept="@Accept" />
    </div>

    @if (_errors.Any())
    {
        <SbAlert Severity="SbAlertSeverity.Danger" Class="mt-3">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </SbAlert>
    }

    @if (_selectedFiles.Any())
    {
        <div class="public-file-uploader__list mt-3">
            @foreach (var file in _selectedFiles)
            {
                <SbCard Class="mb-2">
                    <SbStack Direction="SbStackDirection.Row" Align="SbAlign.Center" Gap="3">
                        <SbIcon Name="@GetFileIcon(file)" />
                        <div class="flex-grow-1">
                            <SbText Weight="SbFontWeight.Medium">@file.Name</SbText>
                            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@FormatFileSize(file.Size)</SbText>
                        </div>
                        @if (file.IsUploading)
                        {
                            <SbProgress Value="@file.Progress" Color="SbColor.Primary" />
                        }
                        @if (file.IsUploaded)
                        {
                            <SbIcon Name="check" Color="SbColor.Success" />
                        }
                        @if (file.HasError)
                        {
                            <SbIcon Name="alert-circle" Color="SbColor.Danger" />
                        }
                        <SbIconButton AriaLabel="@RemoveButtonText" OnClick="@(() => RemoveFile(file))">
                            <Icon><SbIcon Name="x" /></Icon>
                        </SbIconButton>
                    </SbStack>
                </SbCard>
            }
        </div>
    }
</div>
