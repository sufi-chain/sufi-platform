@using SufiChain.SufiAbp.FileManager.Blazor.Public.Editors
@using SufiChain.SufiAbp.FileManager.FileItems
@using SufiChain.SufiAbp.FileManager.Localization
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IStringLocalizer<SufiAbpFileManagerResource> L
@inherits SufiChain.SufiAbp.UI.Blazor.SufiAbpComponentBase

@if (_isImageGalleryOpen)
{
    <FileGalleryDialog IsOpen="@_isImageGalleryOpen"
                       IsOpenChanged="@OnImageGalleryOpenChangedAsync"
                       Title="Select Image"
                       ImagesOnly="true"
                       OnFileSelected="@OnImageSelected" />
}

@if (_isFileGalleryOpen)
{
    <FileGalleryDialog IsOpen="@_isFileGalleryOpen"
                       IsOpenChanged="@OnFileGalleryOpenChangedAsync"
                       Title="Select File"
                       Description="@L["SelectFileToInsertAsLink"].Value"
                       ImagesOnly="false"
                       OnFileSelected="@OnFileSelected" />
}
