@namespace SufiChain.SufiAbp.FileManager.Blazor.Components.Upload
@inherits FileManagerComponentBase
@implements IDisposable

<div class="quick-image-uploader @CssClass">
    <SbCard>
        <div class="preview-container">
            @if (_hasConfigOptions)
            {
                <div class="fm-uploader-config-btn" @onclick:stopPropagation>
                    <SbIconButton AriaLabel="@L["UploadSettings"]"
                                 Title="@L["UploadSettings"]"
                                 Size="SbSize.Sm"
                                 Color="SbColor.Default"
                                 OnClick="@(() => _configModalOpen = true)">
                        <Icon><SbIcon Name="settings" Size="SbSize.Sm" /></Icon>
                    </SbIconButton>
                </div>
            }
            @if (_uploadedImage != null)
            {
                <div class="image-preview">
                    <img src="@GetPreviewUrl()" alt="Preview" />
                    <button class="remove-btn" type="button" @onclick="RemoveImage">
                        <SbIcon Name="x" />
                    </button>
                </div>
            }
            else
            {
                <label for="@_fileInputId" class="upload-placeholder">
                    <SbIcon Name="upload" Size="SbSize.Xl" Class="text-muted" />
                    <p class="mt-2">Click to upload</p>
                    @if (!string.IsNullOrEmpty(Placeholder))
                    {
                        <small class="text-muted">@Placeholder</small>
                    }
                </label>
            }
        </div>

        <input type="file"
               id="@_fileInputId"
               class="d-none"
               accept="image/*" />
    </SbCard>

    @if (_isUploading)
    {
        <div class="upload-status mt-2">
            <SbProgress Value="@_uploadProgress" Color="SbColor.Primary">
                @_uploadProgress%
            </SbProgress>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <SbAlert Severity="SbAlertSeverity.Danger" Class="mt-2">
            @_errorMessage
        </SbAlert>
    }

    @* Config modal: Structure selector and/or Folder Path *@
    @if (_hasConfigOptions)
    {
        <SbDialog @bind-Open="_configModalOpen" Title="@L["UploadSettings"]" Size="SbDialogSize.Sm" AllowDropdownOverflow="true">
            <ChildContent>
                <SbStack Gap="4">
                    @if (ShowStructureSelector && _availableStructures.Any())
                    {
                        <SbFormField Label="@L["FileStructure"]">
                            <SbSelect TItem="FileStructureDto"
                                      TValue="string?"
                                      Items="@_availableStructures"
                                      Value="@_selectedStructureKey"
                                      ValueChanged="@OnStructureChanged"
                                      TextField="@(s => ResolveStructureText(s))"
                                      ValueField="@(s => s.Key)"
                                      Placeholder="@L["SelectFileStructure"]" />
                        </SbFormField>
                    }
                    @if (ShowFolderPathField && string.IsNullOrEmpty(FolderPath))
                    {
                        <SbFormField Label="@L["FolderPath"]" HelpText="@L["FolderPathHint"]">
                            <SbTextField TValue="string"
                                         @bind-Value="_userFolderPath"
                                         Placeholder="/web/tourist" />
                        </SbFormField>
                    }
                </SbStack>
            </ChildContent>
            <Footer>
                <SbButton Color="SbColor.Primary" OnClick="@(() => _configModalOpen = false)">
                    @L["Save"]
                </SbButton>
            </Footer>
        </SbDialog>
    }
</div>
