@namespace SufiChain.SufiAbp.FileManager.Blazor.Settings
@using SufiChain.SufiAbp.FileManager.Storage
@using SufiChain.SufiAbp.SettingManagement.Blazor.Settings
@inherits FileManagerComponentBase
@implements ISaveableSettingGroup

<SbStack Gap="4" class="p-4">
    @if (IsOperationLoading(LoadingKeys.Load))
    {
        <div class="text-center py-4">
            <SbProgress Type="SbProgressType.Circular" />
        </div>
    }
    else
    {
        <p class="text-muted">@L["FileStorageSettingsHint"]</p>
        <SbFormField Label="@L["StorageProvider"]">
            <SbSelect TItem="FileStructureStorageProvider" TValue="FileStructureStorageProvider"
                      Items="@_providerOptions" TextField="@GetProviderLabel" ValueField="@(p => p)"
                      @bind-Value="_config.StorageProvider" />
        </SbFormField>

        @if (_config.StorageProvider == FileStructureStorageProvider.Database)
        {
            <SbFormField Label="@L["DatabaseConnectionString"]" HelperText="@L["DatabaseConnectionStringHint"]">
                <SbTextField @bind-Value="_config.DatabaseConnectionString" Type="password" Placeholder="@L["LeaveEmptyForDefault"]" />
            </SbFormField>
        }
        @if (_config.StorageProvider == FileStructureStorageProvider.FileSystem)
        {
            <SbFormField Label="@L["FileSystemBasePath"]">
                <SbTextField @bind-Value="_config.FileSystemBasePath" Placeholder="@L["LeaveEmptyForStandardizedPath"]" />
            </SbFormField>
        }
        @if (_config.StorageProvider == FileStructureStorageProvider.MinIO)
        {
            <SbFormField Label="@L["MinioEndPoint"]" Required>
                <SbTextField @bind-Value="_config.MinioEndPoint" Placeholder="https://minio.example.com" />
            </SbFormField>
            <SbFormField Label="@L["MinioAccessKey"]">
                <SbTextField @bind-Value="_config.MinioAccessKey" Type="password" />
            </SbFormField>
            <SbFormField Label="@L["MinioSecretKey"]">
                <SbTextField @bind-Value="_config.MinioSecretKey" Type="password" />
            </SbFormField>
            <SbFormField Label="@L["MinioBucketName"]" Required>
                <SbTextField @bind-Value="_config.MinioBucketName" Placeholder="my-bucket" />
            </SbFormField>
        }
        @if (_config.StorageProvider == FileStructureStorageProvider.S3Provider)
        {
            <SbFormField Label="@L["S3EndPoint"]">
                <SbTextField @bind-Value="_config.S3EndPoint" Placeholder="@L["S3EndPointHint"]" />
            </SbFormField>
            <SbFormField Label="@L["S3Region"]" Required>
                <SbTextField @bind-Value="_config.S3Region" Placeholder="us-east-1" />
            </SbFormField>
            <SbFormField Label="@L["S3ContainerName"]" Required>
                <SbTextField @bind-Value="_config.S3ContainerName" Placeholder="my-bucket" />
            </SbFormField>
            <SbFormField Label="@L["S3AccessKeyId"]">
                <SbTextField @bind-Value="_config.S3AccessKeyId" Type="password" />
            </SbFormField>
            <SbFormField Label="@L["S3SecretAccessKey"]">
                <SbTextField @bind-Value="_config.S3SecretAccessKey" Type="password" />
            </SbFormField>
        }

        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="TestConnectionAsync" Loading="IsOperationLoading(LoadingKeys.Test)">
                <StartIcon><SbIcon Name="refresh" /></StartIcon>
                <ChildContent>@L["TestConnection"]</ChildContent>
            </SbButton>
        </SbStack>
    }
</SbStack>
