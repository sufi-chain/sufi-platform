<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SufiChain.SufiPlatform.FileManager.Blazor.WebAssembly</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.FileManager.Blazor.WebAssembly</PackageId>
    <Description>File manager module Blazor WebAssembly components for Sufi Platform - client-side authentication and file operations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ABP Core for module system -->
    <ProjectReference Include="../../../../framework/SufiChain.SufiPlatform.Core/SufiChain.SufiPlatform.Core.csproj" />
    <!-- Standard ASP.NET Core WebAssembly Authentication for IAccessTokenProvider -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="$(MicrosoftAspNetCoreComponentsWebAssemblyVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared FileManager Blazor components -->
    <ProjectReference Include="..\SufiChain.SufiPlatform.FileManager.Blazor\SufiChain.SufiPlatform.FileManager.Blazor.csproj" />
  </ItemGroup>

</Project>
