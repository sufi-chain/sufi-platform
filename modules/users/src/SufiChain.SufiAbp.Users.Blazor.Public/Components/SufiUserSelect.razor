@namespace SufiChain.SufiAbp.Users.Blazor.Public.Components
@using SufiChain.SufiAbp.Users
@inherits SufiUserLookupInlineComponentBase

<SbAutocomplete TItem="UserLookupDto"
                Value="_selectedUser"
                ValueChanged="OnSelectedUserChangedAsync"
                SearchFunc="@SearchUsersForSelectAsync"
                TextField="@FormatUserLabel"
                ValueField="user => user.Id"
                Label="@Label"
                Placeholder="@L["SelectUser"]"
                MinLength="0"
                MaxResults="@MaxResultCount"
                Disabled="@Disabled"
                Clearable="@AllowClear">
    <ItemTemplate Context="user">
        <SbStack Direction="SbStackDirection.Column" Gap="0">
            <SbText Variant="SbTextVariant.BodySmall">@user.DisplayName</SbText>
            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@user.UserName</SbText>
        </SbStack>
    </ItemTemplate>
    <NoResultsTemplate>
        <span>@L["NoUsersFound"]</span>
    </NoResultsTemplate>
</SbAutocomplete>
