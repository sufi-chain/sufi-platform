@namespace SufiChain.SufiPlatform.Users.Blazor.Public.Components
@using SufiChain.SufiPlatform.Users
@inherits SufiUserLookupInlineComponentBase

<SbMultiSelect TItem="UserLookupDto"
               TValue="Guid"
               Items="_displayItems"
               Values="_selectedUserIds"
               ValuesChanged="OnValuesChangedAsync"
               TextField="@FormatUserLabel"
               ValueField="user => user.Id"
               Searchable="true"
               Label="@Label"
               Placeholder="@L["SelectUsers"]"
               Disabled="@Disabled"
               MaxSelected="@MaxSelected">
    <ItemTemplate Context="user">
        <SbStack Direction="SbStackDirection.Column" Gap="0">
            <SbText Variant="SbTextVariant.BodySmall">@user.DisplayName</SbText>
            <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@user.UserName</SbText>
        </SbStack>
    </ItemTemplate>
    <NoResultsTemplate>
        <span>@L["NoUsersFound"]</span>
    </NoResultsTemplate>
</SbMultiSelect>
