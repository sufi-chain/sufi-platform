@namespace SufiChain.SufiPlatform.Users.Blazor.Public.Components
@using SufiChain.SufiPlatform.Users
@inherits UsersPublicComponentBase

<SbStack Direction="SbStackDirection.Column" Gap="2">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <SbText Variant="SbTextVariant.BodySmall" Weight="SbFontWeight.Semibold">@Label</SbText>
    }

    @if (HasSelectedUser)
    {
        <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">
            @SelectedUserSummary
        </SbText>
    }

    <SbStack Direction="SbStackDirection.Row" Gap="2">
        <SbButton Variant="SbButtonVariant.Outline" OnClick="@OpenAsync" Disabled="@Disabled">
            <StartIcon><SbIcon Name="user" /></StartIcon>
            <ChildContent>@( HasSelectedUser ? L["ChangeUser"] : L["SelectUser"] )</ChildContent>
        </SbButton>

        @if (AllowClear && HasSelectedUser)
        {
            <SbButton Variant="SbButtonVariant.Ghost" Color="SbColor.Danger" OnClick="@ClearAsync" Disabled="@Disabled">
                <StartIcon><SbIcon Name="x" /></StartIcon>
                <ChildContent>@L["ClearUser"]</ChildContent>
            </SbButton>
        }
    </SbStack>
</SbStack>

<SbDialog Open="@_showDialog"
          OpenChanged="@OnDialogOpenChangedAsync"
          Size="SbDialogSize.Lg"
          Title="@L["SelectUser"]">
    <ChildContent>
        <SbStack Gap="3">
            <SbTextField TValue="string"
                         @bind-Value="_filter"
                         @bind-Value:after="OnFilterChangedAsync"
                         Label="@L["SearchUsers"]"
                         Placeholder="@L["SearchUsers"]"
                         Clearable="true">
                <StartAdornment>
                    <SbIcon Name="search" />
                </StartAdornment>
            </SbTextField>

            <SufiUserSelectorUserGrid @ref="_userGridRef"
                                      ItemsProvider="LoadUsersDataAsync"
                                      Loading="@IsOperationLoading(LoadingKeys.LoadUsers)"
                                      PageIndex="_pageIndex"
                                      PageSize="_pageSize"
                                      TotalCount="_totalCount"
                                      PageIndexChanged="OnPageIndexChangedAsync"
                                      SelectionMode="SbSelectionMode.SingleRow"
                                      SelectedKeys="_selectedKeys"
                                      SelectedKeysChanged="OnSelectedKeysChangedAsync"
                                      OnRowClicked="OnRowClickedAsync" />
        </SbStack>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="@CloseAsync">@L["Cancel"]</SbButton>
            <SbButton Color="SbColor.Primary" OnClick="@ConfirmAsync" Disabled="@(!HasDialogSelection)">@L["Select"]</SbButton>
        </SbStack>
    </Footer>
</SbDialog>
