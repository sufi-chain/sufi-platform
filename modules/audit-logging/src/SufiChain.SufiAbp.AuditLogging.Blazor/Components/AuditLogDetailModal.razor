@inherits AuditLoggingComponentBase

<SbDialog @bind-Open="Open" OnCloseButtonClick="Hide" Size="SbDialogSize.Xl" Title="@L["AuditLogDetails"]">
    <ChildContent>
        @if (IsOperationLoading(LoadingKeys.LoadAuditLog))
        {
            <SbStack Gap="3" class="p-4" Align="SbAlign.Center">
                <SbProgress Type="SbProgressType.Circular" />
            </SbStack>
        }
        else if (_auditLog != null)
        {
            <SbTabs @bind-ActiveIndex="_activeTab">
                <!-- General Tab -->
                <SbTab Label="@L["General"]">
                    <SbStack Gap="4">
                        <SbGrid Columns="1" ColumnsMd="3" Gap="4">
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["ExecutionTime"]</span>
                                <span class="audit-detail-field__value">@_auditLog.ExecutionTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            </div>
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["Duration"]</span>
                                <span class="audit-detail-field__value">@_auditLog.ExecutionDuration ms</span>
                            </div>
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["HttpStatus"]</span>
                                <span class="audit-detail-field__value">
                                    <SbBadge Color="@GetStatusColor(_auditLog.HttpStatusCode)">
                                        @_auditLog.HttpStatusCode
                                    </SbBadge>
                                </span>
                            </div>
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["HttpMethod"]</span>
                                <span class="audit-detail-field__value">
                                    <SbBadge Color="@GetMethodColor(_auditLog.HttpMethod)">
                                        @_auditLog.HttpMethod
                                    </SbBadge>
                                </span>
                            </div>
                            <SbGridItem Span="2">
                                <div class="audit-detail-field">
                                    <span class="audit-detail-field__label">@L["Url"]</span>
                                    <span class="audit-detail-field__value audit-detail-field__value--break">@_auditLog.Url</span>
                                </div>
                            </SbGridItem>
                        </SbGrid>

                        <SbDivider />

                        <SbGrid Columns="1" ColumnsMd="3" Gap="4">
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["User"]</span>
                                <span class="audit-detail-field__value">@(_auditLog.UserName ?? L["Anonymous"])</span>
                            </div>
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["ClientIpAddress"]</span>
                                <span class="audit-detail-field__value">@(string.IsNullOrEmpty(_auditLog.ClientIpAddress) ? "—" : _auditLog.ClientIpAddress)</span>
                            </div>
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["Application"]</span>
                                <span class="audit-detail-field__value">@(string.IsNullOrEmpty(_auditLog.ApplicationName) ? "—" : _auditLog.ApplicationName)</span>
                            </div>
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["CorrelationId"]</span>
                                <span class="audit-detail-field__value audit-detail-field__value--break">@(string.IsNullOrEmpty(_auditLog.CorrelationId) ? "—" : _auditLog.CorrelationId)</span>
                            </div>
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["ClientId"]</span>
                                <span class="audit-detail-field__value @(string.IsNullOrEmpty(_auditLog.ClientId) ? "audit-detail-field__value--empty" : "")">@(string.IsNullOrEmpty(_auditLog.ClientId) ? "—" : _auditLog.ClientId)</span>
                            </div>
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["ClientName"]</span>
                                <span class="audit-detail-field__value @(string.IsNullOrEmpty(_auditLog.ClientName) ? "audit-detail-field__value--empty" : "")">@(string.IsNullOrEmpty(_auditLog.ClientName) ? "—" : _auditLog.ClientName)</span>
                            </div>
                        </SbGrid>

                        @if (!string.IsNullOrEmpty(_auditLog.BrowserInfo))
                        {
                            <SbDivider />
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["BrowserInfo"]</span>
                                <span class="audit-detail-field__value audit-detail-field__value--break">@_auditLog.BrowserInfo</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(_auditLog.Comments))
                        {
                            <SbDivider />
                            <div class="audit-detail-field">
                                <span class="audit-detail-field__label">@L["Comments"]</span>
                                <span class="audit-detail-field__value">@_auditLog.Comments</span>
                            </div>
                        }
                    </SbStack>
                </SbTab>
                
                <!-- Actions Tab -->
                <SbTab Label="@($"{L["Actions"]} ({_auditLog.Actions.Count})")">
                    @if (_auditLog.Actions.Count > 0)
                        {
                            <SbTable TItem="AuditLogActionDto" Items="@_auditLog.Actions.OrderBy(a => a.ExecutionTime)" Striped Hover Compact>
                                <HeaderContent>
                                    <tr>
                                        <th>@L["ServiceName"]</th>
                                        <th>@L["MethodName"]</th>
                                        <th style="width: 120px;">@L["Duration"]</th>
                                        <th style="width: 160px;">@L["ExecutionTime"]</th>
                                        <th>@L["Parameters"]</th>
                                    </tr>
                                </HeaderContent>
                                <RowTemplate Context="action">
                                    <td>
                                        <span title="@action.ServiceName">@GetServiceShortName(action.ServiceName)</span>
                                    </td>
                                    <td>@action.MethodName</td>
                                    <td>
                                        <span class="@(action.ExecutionDuration > 500 ? "text-warning" : "")">
                                            @action.ExecutionDuration ms
                                        </span>
                                    </td>
                                    <td>@action.ExecutionTime.ToString("HH:mm:ss.fff")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(action.Parameters))
                                        {
                                            <details>
                                                <summary class="small text-muted cursor-pointer">@L["Parameters"]</summary>
                                                <pre class="mb-0 mt-2 small" style="white-space: pre-wrap; max-height: 200px; overflow-y: auto;">@action.Parameters</pre>
                                            </details>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </RowTemplate>
                            </SbTable>
                        }
                        else
                        {
                            <SbEmptyState class="p-4">
                                <SbIcon Name="list" Size="SbSize.Xl" />
                                <p>@L["NoActionsRecorded"]</p>
                            </SbEmptyState>
                        }
                </SbTab>

                <!-- Entity Changes Tab -->
                <SbTab Label="@($"{L["EntityChanges"]} ({_auditLog.EntityChanges.Count})")">
                    @if (_auditLog.EntityChanges.Count > 0)
                        {
                            @foreach (var entityChange in _auditLog.EntityChanges.OrderBy(e => e.ChangeTime))
                            {
                                <SbCard class="mb-3">
                                    <ChildContent>
                                        <SbStack Direction="SbStackDirection.Row" Gap="3" Align="SbAlign.Center" class="mb-3">
                                            <SbBadge Color="@GetChangeTypeColor(entityChange.ChangeType)">
                                                @entityChange.ChangeType
                                            </SbBadge>
                                            <strong>@GetEntityTypeName(entityChange.EntityTypeFullName)</strong>
                                            <span class="text-muted small">@L["IdLabel"]: @entityChange.EntityId</span>
                                            <span class="text-muted small ms-auto">@entityChange.ChangeTime.ToString("HH:mm:ss.fff")</span>
                                        </SbStack>
                                        
                                        @if (entityChange.PropertyChanges.Count > 0)
                                        {
                                            <SbTable TItem="EntityPropertyChangeDto" Items="@entityChange.PropertyChanges" Striped Compact>
                                                <HeaderContent>
                                                    <tr>
                                                        <th>@L["PropertyName"]</th>
                                                        <th>@L["OriginalValue"]</th>
                                                        <th>@L["NewValue"]</th>
                                                    </tr>
                                                </HeaderContent>
                                                <RowTemplate Context="propChange">
                                                    <td><code>@propChange.PropertyName</code></td>
                                                    <td class="text-danger small">@(propChange.OriginalValue ?? L["EmptyValue"])</td>
                                                    <td class="text-success small">@(propChange.NewValue ?? L["EmptyValue"])</td>
                                                </RowTemplate>
                                            </SbTable>
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-0">@L["NoPropertyChangesRecorded"]</p>
                                        }
                                    </ChildContent>
                                </SbCard>
                            }
                        }
                        else
                        {
                            <SbEmptyState class="p-4">
                                <SbIcon Name="database" Size="SbSize.Xl" />
                                <p>@L["NoEntityChangesRecorded"]</p>
                                <p class="small text-muted">@L["EntityChangesRequireConfiguration"]</p>
                            </SbEmptyState>
                        }
                </SbTab>
                
                <!-- Exception Tab -->
                <SbTab Label="@L["Exception"]" Disabled="@(!HasException)">
                    <SbStack Gap="3">
                        @if (HasException)
                        {
                            <SbAlert Severity="SbAlertSeverity.Danger">
                                <pre class="mb-0" style="white-space: pre-wrap; font-size: 0.85em;">@_auditLog.Exceptions</pre>
                            </SbAlert>
                        }
                        else
                        {
                            <SbEmptyState class="p-4">
                                <SbIcon Name="check-circle" Color="SbColor.Success" Size="SbSize.Xl" />
                                <p>@L["NoExceptions"]</p>
                            </SbEmptyState>
                        }
                    </SbStack>
                </SbTab>
            </SbTabs>
        }
        else
        {
            <SbEmptyState class="p-4">
                <SbIcon Name="file-text" Size="SbSize.Xl" />
                <p>@L["SelectAuditLogToViewDetails"]</p>
            </SbEmptyState>
        }
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="Hide">@L["Close"]</SbButton>
        </SbStack>
    </Footer>
</SbDialog>
