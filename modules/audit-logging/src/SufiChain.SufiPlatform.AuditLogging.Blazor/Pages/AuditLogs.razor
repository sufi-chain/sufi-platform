@namespace SufiChain.SufiPlatform.AuditLogging.Blazor.Pages
@page "/panel/admin/audit-logs"
@using SufiChain.SufiPlatform.AuditLogging.Dtos
@attribute [Authorize(Policy = SufiChain.SufiPlatform.AuditLogging.Permissions.AuditLoggingPermissions.AuditLogs.Default)]
@inherits AuditLoggingComponentBase

<SufiPageToolbar>
	<SbButton Color="SbColor.Primary" Variant="SbButtonVariant.Outline" OnClick="@ClearFiltersAsync">
		<StartIcon><SbIcon Name="refresh" /></StartIcon>
		<ChildContent>@L["Refresh"]</ChildContent>
	</SbButton>
</SufiPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">

	<!-- Filters -->
	<SbCard>
		<ChildContent>
			<SbStack Gap="4">
				<SbGrid Columns="1" ColumnsSm="2" ColumnsMd="4" ColumnsLg="4" Gap="4">
					<SbTextField @bind-Value="_userName"
								 Label="@L["UserName"]"
								 Placeholder="@L["SearchByUser"]" />
					<SbTextField @bind-Value="_url"
								 Label="@L["Url"]"
								 Placeholder="@L["SearchByUrl"]" />
					<SbDatePicker @bind-Value="_startDate"
								  Label="@L["StartDate"]" />
					<SbDatePicker @bind-Value="_endDate"
								  Label="@L["EndDate"]" />
					<SbSimpleSelect TValue="string"
									Value="@_httpMethod"
									ValueChanged="@((string? v) => _httpMethod = v)"
									Label="@((string)L["HttpMethod"])">
						<SbSelectOption TValue="string" Value="@((string?)null)">@L["All"]</SbSelectOption>
						<SbSelectOption TValue="string" Value="@("GET")">GET</SbSelectOption>
						<SbSelectOption TValue="string" Value="@("POST")">POST</SbSelectOption>
						<SbSelectOption TValue="string" Value="@("PUT")">PUT</SbSelectOption>
						<SbSelectOption TValue="string" Value="@("DELETE")">DELETE</SbSelectOption>
						<SbSelectOption TValue="string" Value="@("PATCH")">PATCH</SbSelectOption>
					</SbSimpleSelect>
					<SbSimpleSelect TValue="bool?"
									Value="@_hasException"
									ValueChanged="@((bool? v) => _hasException = v)"
									Label="@((string)L["HasException"])">
						<SbSelectOption TValue="bool?" Value="@((bool?)null)">@L["All"]</SbSelectOption>
						<SbSelectOption TValue="bool?" Value="@true">@L["Yes"]</SbSelectOption>
						<SbSelectOption TValue="bool?" Value="@false">@L["No"]</SbSelectOption>
					</SbSimpleSelect>
					<SbTextField @bind-Value="_minDurationText"
								 Label="@L["MinDurationMs"]"
								 Placeholder="@L["Placeholder:DurationExample"]" />
					<SbTextField @bind-Value="_maxDurationText"
								 Label="@L["MaxDurationMs"]"
								 Placeholder="@L["Placeholder:DurationExample"]" />
				</SbGrid>
				<SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
					<SbButton Variant="SbButtonVariant.Outline" OnClick="@ClearFiltersAsync">
						@L["ClearFilters"]
					</SbButton>
					<SbButton Color="SbColor.Primary" OnClick="@ApplyFiltersAsync">
						<StartIcon><SbIcon Name="search" /></StartIcon>
						<ChildContent>@L["Search"]</ChildContent>
					</SbButton>
				</SbStack>
			</SbStack>
		</ChildContent>
	</SbCard>

	<!-- Audit Logs Grid -->
	<SbCard>
		<ChildContent>
			<SbDataGrid TItem="AuditLogListItemDto"
						@ref="_gridRef"
						ItemsProvider="LoadAuditLogsDataAsync"
						Loading="IsOperationLoading(LoadingKeys.LoadAuditLogs)"
						Striped="true"
						Hoverable="true"
						PageIndex="_pageIndex"
						PageSize="_pageSize"
						TotalCount="_totalCount"
						PageIndexChanged="OnPageIndexChangedAsync"
						PageSizeChanged="OnPageSizeChangedAsync"
						KeySelector="@(item => item.Id.ToString())">
				<SbColumn TItem="AuditLogListItemDto" Title="@L["Actions"]" Width="56px" Sortable="false">
					<CellTemplate Context="cellContext">
						<SbTooltip Text="@L["ViewDetails"]"><SbIconButton Size="SbSize.Sm" Color="SbColor.Primary" AriaLabel="@L["ViewDetails"]"
									  OnClick="@(() => ShowDetailModal(cellContext.Item))">
							<Icon><SbIcon Name="eye" Size="SbSize.Sm" /></Icon>
						</SbIconButton></SbTooltip>
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="AuditLogListItemDto" Title="@L["Time"]" Width="160px">
					<CellTemplate Context="cellContext">
						@cellContext.Item.ExecutionTime.ToString("yyyy-MM-dd HH:mm:ss")
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="AuditLogListItemDto" Field="UserName" Title="@L["User"]" Width="120px" />
				<SbColumn TItem="AuditLogListItemDto" Title="@L["Method"]" Width="80px">
					<CellTemplate Context="cellContext">
						<SbBadge Color="@GetMethodColor(cellContext.Item.HttpMethod)">
							@cellContext.Item.HttpMethod
						</SbBadge>
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="AuditLogListItemDto" Field="Url" Title="@L["Url"]" />
				<SbColumn TItem="AuditLogListItemDto" Title="@L["Status"]" Width="80px">
					<CellTemplate Context="cellContext">
						<SbBadge Color="@GetStatusColor(cellContext.Item.HttpStatusCode)">
							@cellContext.Item.HttpStatusCode
						</SbBadge>
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="AuditLogListItemDto" Title="@L["Duration"]" Width="100px">
					<CellTemplate Context="cellContext">
						<span class="@(cellContext.Item.ExecutionDuration > 1000 ? "text-warning" : "")">
							@cellContext.Item.ExecutionDuration ms
						</span>
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="AuditLogListItemDto" Title="@L["Exception"]" Width="80px">
					<CellTemplate Context="cellContext">
						@if (cellContext.Item.HasException)
						{
							<SbIcon Name="warning" Color="SbColor.Danger" />
						}
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="AuditLogListItemDto" Field="ClientIpAddress" Title="@L["IpAddress"]" Width="130px" />
			</SbDataGrid>
		</ChildContent>
	</SbCard>

</SbStack>

<AuditLogDetailModal @bind-Open="_showDetailModal" AuditLogId="_selectedAuditLogId" />
