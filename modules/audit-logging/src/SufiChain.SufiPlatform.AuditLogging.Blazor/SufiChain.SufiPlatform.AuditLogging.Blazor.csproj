<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiPlatform.AuditLogging.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.AuditLogging.Blazor</PackageId>
    <Description>Audit logging module Blazor UI components for Sufi Platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resolve version conflict with SufiBlazor -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftAspNetCoreComponentsWebVersion)" />
    <!-- ABP AuditLogging -->
    <ProjectReference Include="../SufiChain.SufiPlatform.AuditLogging.Domain.Shared/SufiChain.SufiPlatform.AuditLogging.Domain.Shared.csproj" />
    <!-- Blazor Authorization -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sufi Framework (transitively provides SufiChain.SufiPlatform.UI.Abstractions and SufiChain.SufiBlazor) -->
    <ProjectReference Include="..\..\..\..\framework\SufiChain.SufiPlatform.UI.Blazor\SufiChain.SufiPlatform.UI.Blazor.csproj" />
    <!-- Audit Logging Application.Contracts -->
    <ProjectReference Include="..\SufiChain.SufiPlatform.AuditLogging.Application.Contracts\SufiChain.SufiPlatform.AuditLogging.Application.Contracts.csproj" />
  </ItemGroup>

</Project>
