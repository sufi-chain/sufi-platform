<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiPlatform.BackgroundJobs.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.BackgroundJobs.Blazor</PackageId>
    <Description>Background jobs module Blazor UI components for Sufi Platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resolve version conflict with SufiBlazor -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftAspNetCoreComponentsWebVersion)" />
    <!-- ABP BackgroundJobs -->
    <!-- Blazor Authorization -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sufi Framework (transitively provides SufiChain.SufiPlatform.UI.Abstractions and SufiChain.SufiBlazor) -->
    <ProjectReference Include="..\..\..\..\framework\SufiChain.SufiPlatform.UI.Blazor\SufiChain.SufiPlatform.UI.Blazor.csproj" />
    <!-- Background Jobs Application.Contracts and Domain.Shared (localization) -->
    <ProjectReference Include="..\SufiChain.SufiPlatform.BackgroundJobs.Application.Contracts\SufiChain.SufiPlatform.BackgroundJobs.Application.Contracts.csproj" />
    <ProjectReference Include="..\SufiChain.SufiPlatform.BackgroundJobs.Domain.Shared\SufiChain.SufiPlatform.BackgroundJobs.Domain.Shared.csproj" />
  </ItemGroup>

</Project>
