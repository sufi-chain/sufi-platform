@namespace SufiChain.SufiPlatform.BackgroundJobs.Blazor.Components
@inherits BackgroundJobsComponentBase

<SbDialog Open="@Open" OpenChanged="@OnDialogOpenChanged" Size="SbDialogSize.Lg" Title="@L["JobDetails"]">
    <ChildContent>
        @if (Job != null)
        {
            <SbStack Gap="5">
                <!-- Header: Job Name with Status & Priority -->
                <div class="job-detail-header">
                    <SbStack Direction="SbStackDirection.Row" Align="SbAlign.Center" Justify="SbJustify.SpaceBetween" Gap="3">
                        <div style="flex: 1; min-width: 0;">
                            <div class="job-detail-label">@L["JobName"]</div>
                            <div class="job-detail-jobname">@Job.JobName</div>
                        </div>
                        <SbStack Direction="SbStackDirection.Row" Gap="2">
                            <SbBadge Color="@GetStatusColor(Job)">@GetStatusText(Job)</SbBadge>
                            <SbBadge Color="@GetPriorityColor(Job.Priority)">@Job.Priority</SbBadge>
                        </SbStack>
                    </SbStack>
                </div>

                <!-- Job Information Grid -->
                <div>
                    <div class="job-detail-section-title">
                        <SbIcon Name="info-circle" Size="SbSize.Sm" /> @L["JobInformation"]
                    </div>
                    <div class="job-detail-grid-2">
                        <div class="job-detail-item">
                            <span class="job-detail-item-label">@L["JobId"]</span>
                            <span class="job-detail-item-value">
                                <code class="job-detail-code">@Job.Id</code>
                            </span>
                        </div>
                        <div class="job-detail-item">
                            <span class="job-detail-item-label">@L["Application"]</span>
                            <span class="job-detail-item-value">@(string.IsNullOrEmpty(Job.ApplicationName) ? "-" : Job.ApplicationName)</span>
                        </div>
                        <div class="job-detail-item">
                            <span class="job-detail-item-label">@L["TryCount"]</span>
                            <span class="job-detail-item-value @(Job.TryCount > 3 ? "job-detail-warning" : "")">@Job.TryCount</span>
                        </div>
                        <div class="job-detail-item">
                            <span class="job-detail-item-label">@L["IsAbandoned"]</span>
                            <span class="job-detail-item-value">
                                @if (Job.IsAbandoned)
                                {
                                    <SbBadge Color="SbColor.Danger">@L["Yes"]</SbBadge>
                                }
                                else
                                {
                                    <span class="job-detail-success">@L["No"]</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Timestamps -->
                <div>
                    <div class="job-detail-section-title">
                        <SbIcon Name="clock" Size="SbSize.Sm" /> @L["Timestamps"]
                    </div>
                    <div class="job-detail-grid-3">
                        <div class="job-detail-item">
                            <span class="job-detail-item-label">@L["CreationTime"]</span>
                            <span class="job-detail-item-value">@Job.CreationTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </div>
                        <div class="job-detail-item">
                            <span class="job-detail-item-label">@L["NextTryTime"]</span>
                            <span class="job-detail-item-value">@(Job.NextTryTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>
                        </div>
                        <div class="job-detail-item">
                            <span class="job-detail-item-label">@L["LastTryTime"]</span>
                            <span class="job-detail-item-value">@(Job.LastTryTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</span>
                        </div>
                    </div>
                </div>

                <!-- Job Arguments -->
                <div>
                    <div class="job-detail-section-title">
                        <SbIcon Name="code" Size="SbSize.Sm" /> @L["JobArguments"]
                    </div>
                    @if (!string.IsNullOrEmpty(Job.JobArgs))
                    {
                        <pre class="job-detail-json">@FormatJson(Job.JobArgs)</pre>
                    }
                    else
                    {
                        <div class="job-detail-empty">@L["NoArguments"]</div>
                    }
                </div>
            </SbStack>
        }
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="@Hide">@L["Close"]</SbButton>
        </SbStack>
    </Footer>
</SbDialog>

<style>
    .job-detail-header {
        background: var(--sb-color-surface-variant, #f8f9fa);
        padding: 1rem;
        border-radius: 0.5rem;
        border-left: 4px solid var(--sb-color-primary, #3b82f6);
    }

    .job-detail-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--sb-color-text-secondary, #6b7280);
        margin-bottom: 0.25rem;
    }

    .job-detail-jobname {
        font-weight: 600;
        font-size: 0.95rem;
        word-break: break-all;
    }

    .job-detail-section-title {
        font-weight: 600;
        font-size: 0.875rem;
        margin-bottom: 0.75rem;
        color: var(--sb-color-text-primary, #1f2937);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .job-detail-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .job-detail-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    .job-detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .job-detail-item-label {
        font-size: 0.75rem;
        color: var(--sb-color-text-secondary, #6b7280);
    }

    .job-detail-item-value {
        font-size: 0.875rem;
    }

    .job-detail-code {
        font-size: 0.8rem;
        background: var(--sb-color-surface-variant, #f3f4f6);
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        font-family: ui-monospace, SFMono-Regular, monospace;
    }

    .job-detail-warning {
        font-weight: 600;
        color: var(--sb-color-warning, #f59e0b);
    }

    .job-detail-success {
        color: var(--sb-color-success, #10b981);
    }

    .job-detail-json {
        background: #1e293b;
        color: #e2e8f0;
        padding: 1rem;
        border-radius: 0.5rem;
        font-size: 0.8rem;
        line-height: 1.6;
        max-height: 250px;
        overflow: auto;
        margin: 0;
        white-space: pre-wrap;
        word-break: break-word;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    .job-detail-empty {
        background: var(--sb-color-surface-variant, #f8f9fa);
        padding: 1rem;
        border-radius: 0.5rem;
        text-align: center;
        color: var(--sb-color-text-secondary, #6b7280);
        font-style: italic;
    }

    @@media (max-width: 640px) {
        .job-detail-grid-2,
        .job-detail-grid-3 {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private string FormatJson(string json)
    {
        try
        {
            var parsed = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(parsed, new System.Text.Json.JsonSerializerOptions 
            { 
                WriteIndented = true 
            });
        }
        catch
        {
            return json;
        }
    }
}
