<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiPlatform.BackgroundJobs</RootNamespace>
    <PackageId>SufiChain.SufiPlatform.BackgroundJobs.MongoDB</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Volo.Abp.MongoDB" Version="$(AbpVersion)" />
    <ProjectReference Include="..\SufiChain.SufiPlatform.BackgroundJobs.Domain\SufiChain.SufiPlatform.BackgroundJobs.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude duplicate files in MongoDB subdirectory -->
    <Compile Remove="MongoDB\**" />
  </ItemGroup>
</Project>
