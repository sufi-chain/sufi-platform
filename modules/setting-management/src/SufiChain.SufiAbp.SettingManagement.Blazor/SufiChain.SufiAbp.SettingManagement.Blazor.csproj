<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiAbp.SettingManagement.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiAbp.SettingManagement.Blazor</PackageId>
    <Description>Setting management module Blazor UI components for Sufi Platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resolve version conflict with SufiBlazor -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftAspNetCoreComponentsWebVersion)" />
    <!-- ABP SettingManagement -->
    <ProjectReference Include="../../../identity/src/SufiChain.SufiAbp.Identity.Domain.Shared/SufiChain.SufiAbp.Identity.Domain.Shared.csproj" />
    <ProjectReference Include="../SufiChain.SufiAbp.SettingManagement.Application.Contracts/SufiChain.SufiAbp.SettingManagement.Application.Contracts.csproj" />
    <ProjectReference Include="../SufiChain.SufiAbp.SettingManagement.Domain/SufiChain.SufiAbp.SettingManagement.Domain.csproj" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiAbp.Authorization/SufiChain.SufiAbp.Authorization.csproj" />
    <!-- ABP Email and Timing for setting names -->
    <ProjectReference Include="../../../../framework/SufiChain.SufiAbp.Messaging/SufiChain.SufiAbp.Messaging.csproj" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiAbp.Timing/SufiChain.SufiAbp.Timing.csproj" />
    <!-- Blazor Authorization -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- SufiAbp Framework (transitively provides SufiChain.SufiAbp.UI.Abstractions and SufiChain.SufiBlazor) -->
    <ProjectReference Include="..\..\..\..\framework\SufiChain.SufiAbp.UI.Blazor\SufiChain.SufiAbp.UI.Blazor.csproj" />
    <ProjectReference Include="..\SufiChain.SufiAbp.SettingManagement.Application.Contracts\SufiChain.SufiAbp.SettingManagement.Application.Contracts.csproj" />
  </ItemGroup>

</Project>
