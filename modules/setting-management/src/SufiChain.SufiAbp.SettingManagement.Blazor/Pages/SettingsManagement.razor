@page "/panel/admin/settings"
@attribute [Authorize]
@inherits SettingManagementComponentBase

<SufiAbpPageToolbar />

<SbStack Direction="SbStackDirection.Column" Gap="4">
    <!-- Settings Content -->
    <SbCard>
        <ChildContent>
            @if (IsOperationLoading(LoadingKeys.LoadGroups))
            {
                <div class="p-5 text-center">
                    <SbProgress Type="SbProgressType.Circular" />
                    <p class="mt-3 text-muted">@L["LoadingSettings"]</p>
                </div>
            }
            else if (_groups.Any())
            {
                <div class="border rounded setting-panes">
                    @* Group List (Vertical Tabs) - Start side (left in LTR, right in RTL) *@
                    <div class="setting-groups-nav">
                        @foreach (var group in _groups)
                        {
                            var tabId = GetNormalizedGroupId(group.Id);
                            var isActive = _selectedTabId == tabId;
                            var itemClass = isActive ? "setting-group-item active" : "setting-group-item";

                            <SbButton Variant="SbButtonVariant.Ghost"
                                      Color="SbColor.Default"
                                      FullWidth="true"
                                      Class="@itemClass"
                                      OnClick="@(() => SelectGroup(tabId))">
                                <ChildContent>
                                    <span class="group-name">@group.DisplayName</span>
                                </ChildContent>
                            </SbButton>
                        }
                    </div>

                    @* Settings Content *@
                    <div class="setting-content">
                        @{
                            var selectedGroup = _groups.FirstOrDefault(g => GetNormalizedGroupId(g.Id) == _selectedTabId)
                                              ?? _groups.FirstOrDefault();
                        }
                        @if (selectedGroup != null)
                        {
                            <DynamicComponent Type="@selectedGroup.ComponentType" 
                                              Parameters="@GetComponentParameters(selectedGroup)"
                                              @ref="_currentComponentRef" />
                        }
                    </div>
                </div>
            }
            else
            {
                <SbEmptyState class="p-5">
                    <SbIcon Name="settings" Size="SbSize.Xl" />
                    <p>@L["NoSettingsAvailable"]</p>
                </SbEmptyState>
            }
        </ChildContent>
        <Footer>
            <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End" class="p-3">
                <SbButton Color="SbColor.Primary"
                          Loading="IsOperationLoading(LoadingKeys.Save)"
                          OnClick="SaveAsync"
                          Disabled="@(!_groups.Any())">@L["Save"]</SbButton>
            </SbStack>
        </Footer>
    </SbCard>
</SbStack>

@code {
    private Dictionary<string, object?>? GetComponentParameters(SettingComponentGroup group)
    {
        if (group.Parameter == null)
        {
            return null;
        }

        return new Dictionary<string, object?>
        {
            { "Parameter", group.Parameter }
        };
    }
}
