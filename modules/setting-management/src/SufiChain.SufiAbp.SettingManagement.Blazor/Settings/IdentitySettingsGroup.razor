@namespace SufiChain.SufiAbp.SettingManagement.Blazor.Settings
@inherits SettingManagementComponentBase
@using SufiChain.SufiAbp.Account
@using SufiChain.SufiAbp.Identity.Localization

<SbStack Gap="4" class="p-4">
    @if (IsOperationLoading(LoadingKeys.Load))
    {
        <div class="text-center py-4">
            <SbProgress Type="SbProgressType.Circular" />
        </div>
    }
    else
    {
        <SbTabs @bind-ActiveIndex="_activeTab">
            <SbTab Label="@L["IdentityTabSignup"]">
                <SbStack Gap="3" class="pt-3">
                    <SbCheckbox @bind-Value="_settings.EnableSelfRegistration"
                                Label="@IdentityL["Setting:EnableSelfRegistration"]" />
                    <SbCheckbox @bind-Value="_settings.RequireEmailConfirmation"
                                Label="@IdentityL["Setting:RequireEmailConfirmation"]" />
                    <SbCheckbox @bind-Value="_settings.RequireConfirmedAccount"
                                Label="@IdentityL["Setting:RequireConfirmedAccount"]" />
                    <SbCheckbox @bind-Value="_settings.RequireConfirmedEmail"
                                Label="@IdentityL["Setting:RequireConfirmedEmail"]" />
                    <SbCheckbox @bind-Value="_settings.RequireUniqueEmail"
                                Label="@IdentityL["Setting:RequireUniqueEmail"]" />
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabPassword"]">
                <SbStack Gap="3" class="pt-3">
                    <SbNumberField TValue="int" @bind-Value="_settings.PasswordRequiredLength"
                                   Label="@IdentityL["Setting:PasswordRequiredLength"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.PasswordRequiredUniqueChars"
                                   Label="@IdentityL["Setting:PasswordRequiredUniqueChars"]" />
                    <SbCheckbox @bind-Value="_settings.PasswordRequireDigit"
                                Label="@IdentityL["Setting:PasswordRequireDigit"]" />
                    <SbCheckbox @bind-Value="_settings.PasswordRequireLowercase"
                                Label="@IdentityL["Setting:PasswordRequireLowercase"]" />
                    <SbCheckbox @bind-Value="_settings.PasswordRequireUppercase"
                                Label="@IdentityL["Setting:PasswordRequireUppercase"]" />
                    <SbCheckbox @bind-Value="_settings.PasswordRequireNonAlphanumeric"
                                Label="@IdentityL["Setting:PasswordRequireNonAlphanumeric"]" />
                    <SbCheckbox @bind-Value="_settings.PasswordDisallowUsername"
                                Label="@IdentityL["Setting:PasswordDisallowUsername"]" />
                    <SbCheckbox @bind-Value="_settings.PasswordDisallowEmail"
                                Label="@IdentityL["Setting:PasswordDisallowEmail"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.PasswordMinimumAgeMinutes"
                                   Label="@IdentityL["Setting:PasswordMinimumAgeMinutes"]" />
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabLockout"]">
                <SbStack Gap="3" class="pt-3">
                    <SbCheckbox @bind-Value="_settings.LockoutAllowedForNewUsers"
                                Label="@IdentityL["Setting:LockoutAllowedForNewUsers"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.LockoutMaxFailedAccessAttempts"
                                   Label="@IdentityL["Setting:LockoutMaxFailedAccessAttempts"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.LockoutDefaultLockoutTimeSpanMinutes"
                                   Label="@IdentityL["Setting:LockoutDefaultLockoutTimeSpanMinutes"]" />
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabTokens"]">
                <SbStack Gap="3" class="pt-3">
                    <SbNumberField TValue="int" @bind-Value="_settings.EmailConfirmationTokenLifespanHours"
                                   Label="@IdentityL["Setting:EmailConfirmationTokenLifespanHours"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.PasswordResetTokenLifespanHours"
                                   Label="@IdentityL["Setting:PasswordResetTokenLifespanHours"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.OtpTokenLifespanMinutes"
                                   Label="@IdentityL["Setting:OtpTokenLifespanMinutes"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.OtpLength"
                                   Label="@IdentityL["Setting:OtpLength"]" />
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabTwoFactor"]">
                <SbStack Gap="3" class="pt-3">
                    <SbCheckbox @bind-Value="_settings.TwoFactorEnabled"
                                Label="@IdentityL["Setting:TwoFactorEnabled"]" />
                    <SbCheckbox @bind-Value="_settings.TwoFactorIsRequired"
                                Label="@IdentityL["Setting:TwoFactorIsRequired"]" />
                    <SbCheckbox @bind-Value="_settings.TwoFactorUsersCanChange"
                                Label="@IdentityL["Setting:TwoFactorUsersCanChange"]" />
                    <SbCheckbox @bind-Value="_settings.TwoFactorEnforceForNewUsers"
                                Label="@IdentityL["Setting:TwoFactorEnforceForNewUsers"]" />
                    <SbCheckbox @bind-Value="_settings.TwoFactorEnforceForAdministrators"
                                Label="@IdentityL["Setting:TwoFactorEnforceForAdministrators"]" />
                    <SbCheckbox @bind-Value="_settings.TwoFactorAllowAuthenticatorApp"
                                Label="@IdentityL["Setting:TwoFactorAllowAuthenticatorApp"]" />
                    <SbCheckbox @bind-Value="_settings.TwoFactorAllowCodeDelivery"
                                Label="@IdentityL["Setting:TwoFactorAllowCodeDelivery"]" />
                    <SbSimpleSelect TValue="VerificationDeliveryChannel"
                                    @bind-Value="TwoFactorDefaultChannel"
                                    Label="@IdentityL["Setting:TwoFactorCodeDeliveryChannel"]">
                        @foreach (var channel in DeliveryChannels)
                        {
                            <SbSelectOption TValue="VerificationDeliveryChannel"
                                            Value="@channel"
                                            Disabled="@(!IsChannelAvailable(channel))">
                                @GetChannelLabel(channel)
                            </SbSelectOption>
                        }
                    </SbSimpleSelect>
                    <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@L["IdentityAllowedChannels"]</SbText>
                    <SbCheckbox @bind-Value="_settings.TwoFactorAllowEmailChannel" Label="Email" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Email))" />
                    <SbCheckbox @bind-Value="_settings.TwoFactorAllowSmsChannel" Label="SMS" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Sms))" />
                    <SbCheckbox @bind-Value="_settings.TwoFactorAllowVoiceChannel" Label="Voice" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Voice))" />
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabOtp"]">
                <SbStack Gap="3" class="pt-3">
                    <SbCheckbox @bind-Value="_settings.OtpIsEnabled" Label="@IdentityL["Setting:OtpIsEnabled"]" />
                    <SbCheckbox @bind-Value="_settings.OtpAllowLogin" Label="@IdentityL["Setting:OtpAllowLogin"]" />
                    <SbCheckbox @bind-Value="_settings.OtpAllowRegistration" Label="@IdentityL["Setting:OtpAllowRegistration"]" />
                    <SbSimpleSelect TValue="VerificationDeliveryChannel"
                                    @bind-Value="OtpDefaultChannelValue"
                                    Label="@IdentityL["Setting:OtpDefaultChannel"]">
                        @foreach (var channel in DeliveryChannels)
                        {
                            <SbSelectOption TValue="VerificationDeliveryChannel"
                                            Value="@channel"
                                            Disabled="@(!IsChannelAvailable(channel))">
                                @GetChannelLabel(channel)
                            </SbSelectOption>
                        }
                    </SbSimpleSelect>
                    <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">@L["IdentityAllowedChannels"]</SbText>
                    <SbCheckbox @bind-Value="_settings.OtpAllowEmailChannel" Label="Email" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Email))" />
                    <SbCheckbox @bind-Value="_settings.OtpAllowSmsChannel" Label="SMS" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Sms))" />
                    <SbCheckbox @bind-Value="_settings.OtpAllowVoiceChannel" Label="Voice" Disabled="@(!IsChannelAvailable(VerificationDeliveryChannel.Voice))" />
                    <SbNumberField TValue="int" @bind-Value="_settings.OtpMaxAttemptsPerCode"
                                   Label="@IdentityL["Setting:OtpMaxAttemptsPerCode"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.OtpRateLimitPerIdentifierPerHour"
                                   Label="@IdentityL["Setting:OtpRateLimitPerIdentifierPerHour"]" />
                </SbStack>
            </SbTab>

            <SbTab Label="@L["IdentityTabCaptcha"]">
                <SbStack Gap="3" class="pt-3">
                    <SbCheckbox @bind-Value="_settings.CaptchaIsEnabled" Label="@IdentityL["Setting:CaptchaIsEnabled"]" />
                    <SbSimpleSelect TValue="string"
                                    @bind-Value="_settings.CaptchaProvider"
                                    Label="@IdentityL["Setting:CaptchaProvider"]">
                        <SbSelectOption TValue="string" Value="@SimpleCaptchaProvider">
                            @IdentityL["CaptchaProvider:Simple"]
                        </SbSelectOption>
                        <SbSelectOption TValue="string" Value="@TurnstileCaptchaProvider">
                            @IdentityL["CaptchaProvider:Turnstile"]
                        </SbSelectOption>
                        <SbSelectOption TValue="string" Value="@RecaptchaCaptchaProvider">
                            @IdentityL["CaptchaProvider:Recaptcha"]
                        </SbSelectOption>
                    </SbSimpleSelect>
                    <SbCheckbox @bind-Value="_settings.CaptchaRequiredOnRegister"
                                Label="@IdentityL["Setting:CaptchaRequiredOnRegister"]" />
                    <SbCheckbox @bind-Value="_settings.CaptchaRequiredOnForgotPassword"
                                Label="@IdentityL["Setting:CaptchaRequiredOnForgotPassword"]" />
                    <SbCheckbox @bind-Value="_settings.CaptchaRequiredOnOtpSend"
                                Label="@IdentityL["Setting:CaptchaRequiredOnOtpSend"]" />
                    <SbCheckbox @bind-Value="_settings.CaptchaRequiredOnLogin"
                                Label="@IdentityL["Setting:CaptchaRequiredOnLogin"]" />
                    <SbCheckbox @bind-Value="_settings.CaptchaRequiredOnEmailConfirmationResend"
                                Label="@IdentityL["Setting:CaptchaRequiredOnEmailConfirmationResend"]" />
                    <SbNumberField TValue="int" @bind-Value="_settings.CaptchaChallengeExpirationMinutes"
                                   Label="@IdentityL["Setting:CaptchaChallengeExpirationMinutes"]" />
                    @if (IsTurnstileCaptchaProvider)
                    {
                        <SbTextField @bind-Value="_settings.CaptchaTurnstileSiteKey"
                                     Label="@IdentityL["Setting:CaptchaTurnstileSiteKey"]" />
                        <SbTextField @bind-Value="_settings.CaptchaTurnstileSecretKey"
                                     Label="@IdentityL["Setting:CaptchaTurnstileSecretKey"]"
                                     Type="password"
                                     AutoComplete="new-password" />
                    }
                    @if (IsRecaptchaCaptchaProvider)
                    {
                        <SbTextField @bind-Value="_settings.CaptchaRecaptchaSiteKey"
                                     Label="@IdentityL["Setting:CaptchaRecaptchaSiteKey"]" />
                        <SbTextField @bind-Value="_settings.CaptchaRecaptchaSecretKey"
                                     Label="@IdentityL["Setting:CaptchaRecaptchaSecretKey"]"
                                     Type="password"
                                     AutoComplete="new-password" />
                        <SbSimpleSelect TValue="string"
                                        @bind-Value="_settings.CaptchaRecaptchaVersion"
                                        Label="@IdentityL["Setting:CaptchaRecaptchaVersion"]">
                            <SbSelectOption TValue="string" Value="@("v2checkbox")">
                                @IdentityL["CaptchaRecaptchaVersion:v2checkbox"]
                            </SbSelectOption>
                            <SbSelectOption TValue="string" Value="@("v3")">
                                @IdentityL["CaptchaRecaptchaVersion:v3"]
                            </SbSelectOption>
                        </SbSimpleSelect>
                    }
                </SbStack>
            </SbTab>
        </SbTabs>
    }
</SbStack>
