@page "/panel/admin/tags-management/tag-links"
@attribute [Authorize(Policy = TagsManagementPermissions.TagLinks.Default)]
@inherits TagsManagementComponentBase

<SbStack Direction="SbStackDirection.Column" Gap="4">
    <SbCard>
        <ChildContent>
            <SbStack Gap="3">
                <SbTextField @bind-Value="_entityType"
                             Label="@L["EntityType"]"
                             Required="true"
                             Placeholder="e.g. HelpDesk.Ticket" />

                <SbTextField @bind-Value="_entityIdText"
                             Label="@L["EntityId"]"
                             Required="true"
                             Placeholder="00000000-0000-0000-0000-000000000000" />

                <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.End">
                    <SbButton Color="SbColor.Primary"
                              Loading="IsOperationLoading(LoadingKeys.Search)"
                              OnClick="@SearchAsync">
                        <StartIcon><SbIcon Name="search" /></StartIcon>
                        <ChildContent>@L["Search"]</ChildContent>
                    </SbButton>
                </SbStack>
            </SbStack>
        </ChildContent>
    </SbCard>

    @if (_hasSearched)
    {
        <SbCard>
            <ChildContent>
                <SbStack Gap="3">
                    <SbHeading Level="6">@L["AssignedTags"]</SbHeading>

                    @if (_assignedTags.Count == 0)
                    {
                        <SbText Color="SbColor.Muted">@L["NoTagsAssigned"]</SbText>
                    }
                    else
                    {
                        <SbStack Direction="SbStackDirection.Column" Gap="2">
                            @foreach (var tag in _assignedTags)
                            {
                                <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center" Wrap="true">
                                    @if (!string.IsNullOrWhiteSpace(tag.Color))
                                    {
                                        <span class="tags-color-swatch" style="@($"background:{tag.Color}")"></span>
                                    }
                                    <SbText Weight="SbFontWeight.Medium">@tag.Name</SbText>
                                    <SbText Color="SbColor.Muted" Variant="SbTextVariant.BodySmall">@tag.Scope</SbText>
                                    <AuthorizeView Policy="@TagsManagementPermissions.TagLinks.Unassign">
                                        <SbButton Size="SbSize.Sm"
                                                  Variant="SbButtonVariant.Outline"
                                                  Color="SbColor.Danger"
                                                  Loading="@IsOperationLoading($"{LoadingKeys.Unassign}-{tag.Id}")"
                                                  OnClick="@(() => UnassignAsync(tag))">
                                            @L["Unassign"]
                                        </SbButton>
                                    </AuthorizeView>
                                </SbStack>
                            }
                        </SbStack>
                    }
                </SbStack>
            </ChildContent>
        </SbCard>

        <SbCard>
            <ChildContent>
                <SbStack Gap="3">
                    <SbHeading Level="6">@L["AvailableTags"]</SbHeading>

                    <SbTextField @bind-Value="_availableScopeFilter"
                                 Label="@L["FilterByScope"]"
                                 Placeholder="@L["AllScopes"]"
                                 Clearable="true" />

                    @if (_availableTags.Count == 0)
                    {
                        <SbText Color="SbColor.Muted">@L["NoTagsAvailable"]</SbText>
                    }
                    else
                    {
                        <SbStack Direction="SbStackDirection.Column" Gap="2">
                            @foreach (var tag in _availableTags)
                            {
                                <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center" Wrap="true">
                                    @if (!string.IsNullOrWhiteSpace(tag.Color))
                                    {
                                        <span class="tags-color-swatch" style="@($"background:{tag.Color}")"></span>
                                    }
                                    <SbText Weight="SbFontWeight.Medium">@tag.Name</SbText>
                                    <SbText Color="SbColor.Muted" Variant="SbTextVariant.BodySmall">@tag.Scope</SbText>
                                    <AuthorizeView Policy="@TagsManagementPermissions.TagLinks.Assign">
                                        <SbButton Size="SbSize.Sm"
                                                  Variant="SbButtonVariant.Outline"
                                                  Color="SbColor.Primary"
                                                  Loading="@IsOperationLoading($"{LoadingKeys.Assign}-{tag.Id}")"
                                                  OnClick="@(() => AssignAsync(tag))">
                                            @L["Assign"]
                                        </SbButton>
                                    </AuthorizeView>
                                </SbStack>
                            }
                        </SbStack>
                    }
                </SbStack>
            </ChildContent>
        </SbCard>
    }
</SbStack>

<style>
    .tags-color-swatch {
        display: inline-block;
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 0.25rem;
        border: 1px solid var(--sb-color-border, #d0d7de);
    }
</style>
