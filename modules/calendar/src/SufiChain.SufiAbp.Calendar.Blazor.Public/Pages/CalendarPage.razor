@namespace SufiChain.SufiAbp.Calendar.Blazor.Public.Pages
@page "/panel/calendar"
@attribute [Authorize(CalendarPermissions.Events.Default)]
@inherits CalendarPageBase

<SufiAbpPageToolbar>
    <SufiCalendarSelect @bind-SelectedCalendarId="SelectedCalendarId"
                        InitialCalendarId="PersonalCalendarId"
                        @ref="CalendarSelect" />
    <SbButton Color="SbColor.Primary" Variant="SbButtonVariant.Outline" OnClick="RefreshAsync">
        <StartIcon><SbIcon Name="refresh" Size="SbSize.Sm" /></StartIcon>
        <ChildContent>@L["Refresh"]</ChildContent>
    </SbButton>
</SufiAbpPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">
    <SufiCalendarScheduler @ref="CalendarScheduler"
                           Inline="true"
                           AllowCalendarSelection="true"
                           ShowCalendarSelectInHeader="false"
                           SelectedCalendarId="@SelectedCalendarId"
                           SelectedCalendarIdChanged="OnSelectedCalendarIdChangedAsync"
                           AllowEventEditing="true"
                           InitialCalendarId="PersonalCalendarId"
                           InitialDate="DateTime.Today"
                           EventSaved="OnEventChangedAsync" />
</SbStack>
