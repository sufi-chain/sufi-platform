@namespace SufiChain.SufiPlatform.Calendar.Blazor.Public.Components
@using SufiChain.SufiBlazor.Components.Feedback
@inherits CalendarPublicComponentBase

<div class="@GetWrapperClass()">
    @if (!IsLoaded)
    {
        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="sb-select__label">
                @Label
                @if (Required)
                {
                    <span class="sb-select__required" aria-hidden="true">*</span>
                }
            </label>
        }
        <SbSkeleton Variant="SbSkeletonVariant.Rectangular" Height="2.25rem" />
    }
    else if (CalendarOptions.Count == 0)
    {
        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="sb-select__label">
                @Label
                @if (Required)
                {
                    <span class="sb-select__required" aria-hidden="true">*</span>
                }
            </label>
        }
        <SbAlert Severity="SbAlertSeverity.Info">@L["NoCalendarsFound"]</SbAlert>
    }
    else
    {
        <SbSelect TItem="CalendarLookupDto"
                  TValue="string"
                  Items="CalendarOptions"
                  Value="@SelectedCalendarKey"
                  ValueChanged="OnSelectedCalendarChangedAsync"
                  TextField="@(calendar => GetCalendarOptionText(calendar))"
                  ValueField="@(calendar => GetCalendarKey(calendar))"
                  Label="@Label"
                  Placeholder="@EffectivePlaceholder"
                  Required="Required"
                  Disabled="Disabled"
                  Searchable="true" />
    }
</div>
