@namespace SufiChain.SufiPlatform.Calendar.Blazor.Public.Components
@using SufiChain.SufiBlazor.Components.Navigation
@inherits CalendarPublicComponentBase

@if (Inline)
{
    <SbStack Direction="SbStackDirection.Column" Gap="3" Class="sufi-calendar-scheduler-inline">
        @if (AllowCalendarSelection && ShowCalendarSelectInHeader)
        {
            <SufiCalendarSelect SelectedCalendarId="@SelectedCalendarId"
                                SelectedCalendarIdChanged="OnSelectedCalendarIdChangedAsync"
                                SelectedCalendarChanged="OnSelectedCalendarChangedAsync"
                                InitialCalendarId="@InitialCalendarId"
                                Calendars="@Calendars" />
        }

        @if (SelectedCalendarId == Guid.Empty)
        {
            <SbAlert Severity="SbAlertSeverity.Info">@L["NoCalendarsFound"]</SbAlert>
        }
        else
        {
            <SufiCalendarView @key="CalendarViewKey"
                              CalendarIds="@SelectedCalendarIds"
                              TimeZoneId="@SelectedTimeZoneId"
                              View="@View"
                              ViewChanged="OnViewChangedAsync"
                              Date="@Date"
                              DateChanged="OnDateChangedAsync"
                              OnEventClick="OpenEditEventAsync"
                              OnSlotSelect="OpenCreateEventFromSlotAsync" />
        }

        <SufiEventEditor Open="@IsEventEditorOpen"
                         OpenChanged="OnEventEditorOpenChangedAsync"
                         EventId="@EditingEventId"
                         CalendarId="@SelectedCalendarId"
                         InitialStartUtc="@InitialEventStartUtc"
                         InitialEndUtc="@InitialEventEndUtc"
                         TimeZoneId="@SelectedTimeZoneId"
                         Saved="OnEventSavedAsync"
                         Deleted="OnEventDeletedAsync" />
    </SbStack>
}
else
{
    <SbDialog Open="@Open"
              OpenChanged="SetOpenAsync"
              Size="SbDialogSize.FullScreen"
              ShowCloseButton="false">
        <Header>
            <div class="sufi-calendar-scheduler__header">
                <SbStack Direction="SbStackDirection.Row" Gap="1" Align="SbAlign.Center" Class="sufi-calendar-scheduler__actions">
                    <SbTooltip Text="@L["Close"]">
                        <SbIconButton OnClick="CloseAsync" AriaLabel="@L["Close"]">
                            <Icon><SbIcon Name="x" /></Icon>
                        </SbIconButton>
                    </SbTooltip>
                    <SbTooltip Text="@L["Refresh"]">
                        <SbIconButton OnClick="RefreshAsync" AriaLabel="@L["Refresh"]">
                            <Icon><SbIcon Name="refresh" /></Icon>
                        </SbIconButton>
                    </SbTooltip>
                    @if (AllowEventEditing)
                    {
                        <SbTooltip Text="@L["CreateEvent"]">
                            <SbIconButton Color="SbColor.Primary"
                                          OnClick="OpenCreateEventAsync"
                                          Disabled="@(SelectedCalendarId == Guid.Empty)"
                                          AriaLabel="@L["CreateEvent"]">
                                <Icon><SbIcon Name="plus" /></Icon>
                            </SbIconButton>
                        </SbTooltip>
                    }
                </SbStack>
                @if (AllowCalendarSelection && ShowCalendarSelectInHeader)
                {
                    <SufiCalendarSelect SelectedCalendarId="@SelectedCalendarId"
                                        SelectedCalendarIdChanged="OnSelectedCalendarIdChangedAsync"
                                        SelectedCalendarChanged="OnSelectedCalendarChangedAsync"
                                        InitialCalendarId="@InitialCalendarId"
                                        Calendars="@Calendars" />
                }
            </div>
        </Header>
        <ChildContent>
            <SbStack Direction="SbStackDirection.Column" Gap="3" Class="sufi-calendar-scheduler">
                @if (SelectedCalendarId == Guid.Empty)
                {
                    <SbAlert Severity="SbAlertSeverity.Info">@L["NoCalendarsFound"]</SbAlert>
                }
                else
                {
                    <SufiCalendarView @key="CalendarViewKey"
                                      CalendarIds="@SelectedCalendarIds"
                                      TimeZoneId="@SelectedTimeZoneId"
                                      View="@View"
                                      ViewChanged="OnViewChangedAsync"
                                      Date="@Date"
                                      DateChanged="OnDateChangedAsync"
                                      OnEventClick="OpenEditEventAsync"
                                      OnSlotSelect="OpenCreateEventFromSlotAsync" />
                }
            </SbStack>

            <SufiEventEditor Open="@IsEventEditorOpen"
                             OpenChanged="OnEventEditorOpenChangedAsync"
                             EventId="@EditingEventId"
                             CalendarId="@SelectedCalendarId"
                             InitialStartUtc="@InitialEventStartUtc"
                             InitialEndUtc="@InitialEventEndUtc"
                             TimeZoneId="@SelectedTimeZoneId"
                             Saved="OnEventSavedAsync"
                             Deleted="OnEventDeletedAsync" />
        </ChildContent>
        <Footer>
            <SbButton Variant="SbButtonVariant.Outline" OnClick="CloseAsync">@L["Close"]</SbButton>
        </Footer>
    </SbDialog>
}
