@page "/panel/admin/calendar"
@using SufiChain.SufiAbp.UI.Blazor.Components
@using SufiChain.SufiBlazor.Components.Navigation
@attribute [Authorize(CalendarPermissions.Calendars.Default)]
@inherits CalendarManagementBase

<SufiAbpPageToolbar>
    @if (HasCreatePermission)
    {
        <SbButton Color="SbColor.Primary" OnClick="OpenCreateModalAsync">
            <StartIcon><SbIcon Name="plus" /></StartIcon>
            <ChildContent>@L["CreateCalendar"]</ChildContent>
        </SbButton>
    }
    <SbButton Color="SbColor.Primary" Variant="SbButtonVariant.Outline" OnClick="RefreshAsync">
        <StartIcon><SbIcon Name="refresh" /></StartIcon>
        <ChildContent>@L["Refresh"]</ChildContent>
    </SbButton>
</SufiAbpPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">
    <SbCard>
        <ChildContent>
            <SbStack Direction="SbStackDirection.Row" Gap="4" Align="SbAlign.Center" Wrap="true" Justify="@SbJustify.SpaceBetween">
                <SbStack Direction="SbStackDirection.Row" Gap="2" Wrap="true" Align="SbAlign.Center">
                    <div class="sufi-calendar-management__filter-field" @onkeydown="HandleFilterKeyDown">
                        <label class="sufi-calendar-management__filter-field-label">@L["Filter"]</label>
                        <SbTextField @bind-Value="FilterText"
                                     Placeholder="@L["Filter"]"
                                     Clearable="true">
                            <StartAdornment><SbIcon Name="search" /></StartAdornment>
                        </SbTextField>
                    </div>
                    <div class="sufi-calendar-management__filter-field sufi-calendar-management__filter-field--action">
                        <SbButton Color="SbColor.Primary" OnClick="ApplyFiltersAsync">
                            <StartIcon><SbIcon Name="search" /></StartIcon>
                            <ChildContent>@L["Search"]</ChildContent>
                        </SbButton>
                    </div>
                </SbStack>
                @if (HasActiveFilters)
                {
                    <SbStack Direction="SbStackDirection.Column" Gap="1">
                        <span class="sufi-calendar-management__filter-label">
                            <SbIcon Name="filter" Size="SbSize.Sm" /> @L["Filter"]:
                        </span>
                        <SbStack Direction="SbStackDirection.Row" Gap="2" Wrap="true" Align="SbAlign.Center">
                            <SbButton Size="SbSize.Sm" Variant="SbButtonVariant.Ghost" Color="SbColor.Secondary" OnClick="ClearFiltersAsync">
                                <StartIcon><SbIcon Name="x" Size="SbSize.Sm" /></StartIcon>
                                <ChildContent>@L["Clear"]</ChildContent>
                            </SbButton>
                        </SbStack>
                    </SbStack>
                }
            </SbStack>
        </ChildContent>
    </SbCard>

    <SbCard>
        <ChildContent>
            <SbDataGrid TItem="CalendarDto" @ref="_gridRef" ItemsProvider="LoadCalendarsDataAsync" Loading="IsOperationLoading(LoadingKeys.LoadCalendars)" Striped="true" Hoverable="true" PageIndex="PageIndex" PageSize="PageSize" TotalCount="TotalCount" PageIndexChanged="OnPageIndexChangedAsync" PageSizeChanged="OnPageSizeChangedAsync" KeySelector="@(item => item.Id.ToString())">
                <EmptyTemplate>
                    <SbEmptyState Class="text-center p-5" Title="@L["Calendar"]" Description="@L["NoCalendarsFound"]">
                        <Icon><SbIcon Name="calendar" Size="SbSize.Xl" /></Icon>
                    </SbEmptyState>
                </EmptyTemplate>
                <ChildContent>
                    <SbColumn TItem="CalendarDto" Title="@L["Actions"]" Width="190px" Sortable="false">
                        <CellTemplate Context="cellContext">
                            <SbStack Direction="SbStackDirection.Row" Gap="1">
                                @if (HasEditPermission)
	                                {
	                                    <SbTooltip Text="@L["Edit"]"><SbIconButton Size="SbSize.Sm" OnClick="@(() => OpenEditModalAsync(cellContext.Item))" AriaLabel="@L["Edit"]"><Icon><SbIcon Name="edit" /></Icon></SbIconButton></SbTooltip>
	                                    <SbTooltip Text="@L["BusinessHours"]"><SbIconButton Size="SbSize.Sm" OnClick="@(() => OpenBusinessHoursModalAsync(cellContext.Item))" AriaLabel="@L["BusinessHours"]"><Icon><SbIcon Name="clock" /></Icon></SbIconButton></SbTooltip>
	                                    <SbTooltip Text="@L["Scheduler"]"><SbIconButton Size="SbSize.Sm" OnClick="@(() => OpenSchedulerModalAsync(cellContext.Item))" AriaLabel="@L["Scheduler"]"><Icon><SbIcon Name="calendar-days" /></Icon></SbIconButton></SbTooltip>
                                }
                                @if (HasDeletePermission)
                                {
                                    <SbTooltip Text="@L["Delete"]"><SbIconButton Size="SbSize.Sm" Color="SbColor.Danger" OnClick="@(() => PromptDeleteAsync(cellContext.Item))" AriaLabel="@L["Delete"]"><Icon><SbIcon Name="trash" /></Icon></SbIconButton></SbTooltip>
                                }
                            </SbStack>
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="CalendarDto" Field="Name" Title="@L["Name"]" />
                    <SbColumn TItem="CalendarDto" Field="Kind" Title="@L["Kind"]" Width="140px" />
                    <SbColumn TItem="CalendarDto" Field="TimeZoneId" Title="@L["TimeZone"]" />
                    <SbColumn TItem="CalendarDto" Field="IsDefault" Title="@L["Default"]" Width="120px">
                        <CellTemplate Context="cellContext"><SbBadge Color="@(cellContext.Item.IsDefault ? SbColor.Success : SbColor.Secondary)">@(cellContext.Item.IsDefault ? L["Yes"] : L["No"])</SbBadge></CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="CalendarDto" Field="IsAlwaysOpen" Title="@L["BusinessHours"]" Width="150px">
                        <CellTemplate Context="cellContext"><SbBadge Color="@(cellContext.Item.IsAlwaysOpen ? SbColor.Success : SbColor.Secondary)">@(cellContext.Item.IsAlwaysOpen ? L["Yes"] : L["No"])</SbBadge></CellTemplate>
                    </SbColumn>
                </ChildContent>
            </SbDataGrid>
        </ChildContent>
    </SbCard>
</SbStack>

<SbDialog @bind-Open="IsEditorOpen" Size="SbDialogSize.Lg" Title="@EditorTitle" AllowDropdownOverflow="true">
    <ChildContent>
        <SbForm Model="EditingCalendar" OnValidSubmit="SaveCalendarAsync">
            <SbStack Gap="3">
                <SbTextField @bind-Value="EditingCalendar.Name" Label="@L["Name"]" Required="true" />
                <SbSimpleSelect TValue="string" @bind-Value="EditingCalendar.TimeZoneId" Label="@L["TimeZone"]" Searchable="true" Placeholder="@L["SelectTimeZone"]">
                    @foreach (var timeZone in TimeZoneOptions)
                    {
                        <SbSelectOption TValue="string" Value="@timeZone.Id" Text="@timeZone.DisplayName">@timeZone.DisplayName</SbSelectOption>
                    }
                </SbSimpleSelect>
                <SbCheckbox @bind-Value="EditingCalendar.IsDefault" Label="@L["Default"]" />
                <SbSimpleSelect TValue="CalendarKind" Value="@EditingCalendar.Kind" ValueChanged="OnCalendarKindChangedAsync" Label="@L["Kind"]">
                    @foreach (var kind in CalendarKindOptions)
                    {
                        <SbSelectOption TValue="CalendarKind" Value="@kind" Text="@GetCalendarKindText(kind)">@GetCalendarKindText(kind)</SbSelectOption>
                    }
                </SbSimpleSelect>
                <SbCheckbox @bind-Value="EditingCalendar.IsAlwaysOpen" Label="@L["BusinessHours"]" />
                <SbTextField @bind-Value="EditingCalendar.OwnerName" Label="@L["OwnerName"]" />
            </SbStack>
        </SbForm>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="CloseEditorAsync">@L["Cancel"]</SbButton>
            <SbButton Color="SbColor.Primary" OnClick="SaveCalendarAsync">@L["Save"]</SbButton>
        </SbStack>
    </Footer>
</SbDialog>

<SbDialog @bind-Open="IsBusinessHoursOpen" Size="SbDialogSize.Xl" Title="@L["BusinessHours"]" AllowDropdownOverflow="true">
    <ChildContent>
        <SbTabs @bind-ActiveIndex="BusinessHoursActiveTab">
            <SbTab Label="@L["ManageHours"]">
                <SbStack Gap="3">
                    @foreach (var rule in EditingHours)
                    {
                        <SbStack @key="rule.RowKey" Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
                            <SbSelect TItem="DayOfWeek"
                                      TValue="DayOfWeek"
                                      Items="DayOfWeekOptions"
                                      Value="@rule.DayOfWeek"
                                      ValueChanged="@(value => OnWorkingHourDayChangedAsync(rule, value))"
                                      TextField="@GetDayOfWeekText"
                                      Label="@L["DayOfWeek"]" />
                            <SbTextField @bind-Value="rule.StartTimeText" Label="@L["StartTime"]" />
                            <SbTextField @bind-Value="rule.EndTimeText" Label="@L["EndTime"]" />
                            <SbIconButton Color="SbColor.Danger" OnClick="@(() => RemoveHour(rule))" AriaLabel="@L["Delete"]"><Icon><SbIcon Name="trash" /></Icon></SbIconButton>
                        </SbStack>
                    }
                    <SbButton Variant="SbButtonVariant.Outline" OnClick="AddHour">@L["AddWorkingHour"]</SbButton>
                </SbStack>
            </SbTab>
            <SbTab Label="@L["Exceptions"]">
                <SbStack Gap="3">
                    @foreach (var exception in EditingExceptions)
                    {
                        <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
                            <SbDatePicker Value="exception.ExceptionDate" ValueChanged="@(value => exception.ExceptionDate = value)" Label="@L["Date"]" />
                            <SbSimpleSelect TValue="CalendarExceptionKind" @bind-Value="exception.Kind" Label="@L["Kind"]">
                                @foreach (var kind in CalendarExceptionKindOptions)
                                {
                                    <SbSelectOption TValue="CalendarExceptionKind" Value="@kind" Text="@GetCalendarExceptionKindText(kind)">@GetCalendarExceptionKindText(kind)</SbSelectOption>
                                }
                            </SbSimpleSelect>
                            <SbTextField @bind-Value="exception.Description" Label="@L["Description"]" />
                            <SbIconButton Color="SbColor.Danger" OnClick="@(() => RemoveException(exception))" AriaLabel="@L["Delete"]"><Icon><SbIcon Name="trash" /></Icon></SbIconButton>
                        </SbStack>
                    }
                    <SbButton Variant="SbButtonVariant.Outline" OnClick="AddException">@L["AddException"]</SbButton>
                </SbStack>
            </SbTab>
            <SbTab Label="@L["TestInstant"]">
                <SbStack Gap="3">
                    <SbDatePicker Value="TestDate" ValueChanged="OnTestDateChanged" Label="@L["Date"]" />
                    <SbTextField @bind-Value="TestTimeText" Label="@L["TimeUtc"]" />
                    <SbButton Color="SbColor.Primary" OnClick="RunTestAsync">@L["TestInstant"]</SbButton>
                    @if (TestResult != null)
                    {
                        <SbAlert Severity="@(TestResult.IsOpen ? SbAlertSeverity.Success : SbAlertSeverity.Warning)">
                            @(TestResult.IsOpen ? L["Open"] : L["Closed"])
                            <br />@L["NextOpenAt"]: @TestResult.NextOpenAtUtc
                            <br />@L["NextCloseAt"]: @TestResult.NextCloseAtUtc
                        </SbAlert>
                    }
                </SbStack>
            </SbTab>
        </SbTabs>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="CloseBusinessHoursAsync">@L["Close"]</SbButton>
            <SbButton Color="SbColor.Primary" OnClick="SaveBusinessHoursAsync">@L["Save"]</SbButton>
        </SbStack>
    </Footer>
</SbDialog>

<SufiCalendarScheduler Open="@IsSchedulerOpen"
                       OpenChanged="OnSchedulerOpenChangedAsync"
                       InitialCalendarId="@SchedulerCalendarId" />

<SbDialog @bind-Open="IsDeleteOpen" Size="SbDialogSize.Sm" Title="@L["Delete"]">
    <ChildContent><SbText>@L["AreYouSureToDelete"]</SbText></ChildContent>
    <Footer>
        <SbButton Variant="SbButtonVariant.Outline" OnClick="CancelDeleteAsync">@L["Cancel"]</SbButton>
        <SbButton Color="SbColor.Danger" OnClick="DeleteConfirmedAsync">@L["Delete"]</SbButton>
    </Footer>
</SbDialog>
