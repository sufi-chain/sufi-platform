@namespace SufiChain.SufiPlatform.Identity.Blazor.Pages
@page "/panel/admin/identity/users"
@attribute [Authorize(Policy = SufiChain.SufiPlatform.Identity.IdentityPermissions.Users.Default)]
@inherits IdentityComponentBase

<SufiPageToolbar>
	<AuthorizeView Policy="@SufiChain.SufiPlatform.Identity.IdentityPermissions.Users.Create">
		<SbButton Color="SbColor.Primary" OnClick="@ShowCreateModal">
			<StartIcon><SbIcon Name="plus" /></StartIcon>
			<ChildContent>@L["NewUser"]</ChildContent>
		</SbButton>
	</AuthorizeView>
</SufiPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">

	<!-- Users Content -->
	<SbCard>
		<ChildContent>
			<SbStack Gap="4">
				<SbTextField @bind-Value="_filter"
							 Placeholder="@L["SearchUsers"]"
							 Clearable="true">
					<StartAdornment>
						<SbIcon Name="search" />
					</StartAdornment>
				</SbTextField>

				<SbDataGrid TItem="IdentityUserDto"
							@ref="_gridRef"
							ItemsProvider="LoadUsersDataAsync"
							Loading="IsOperationLoading(LoadingKeys.LoadUsers)"
							Striped="true"
							Hoverable="true"
							PageIndex="_pageIndex"
							PageSize="_pageSize"
							TotalCount="_totalCount"
							PageIndexChanged="OnPageIndexChangedAsync">
					<SbColumn TItem="IdentityUserDto" Title="@L["Actions"]" Width="152px" Sortable="false">
						<CellTemplate Context="cellContext">
							<SbStack Direction="SbStackDirection.Row" Gap="1">
								<AuthorizeView Policy="@SufiChain.SufiPlatform.Identity.IdentityPermissions.Users.Update" Context="authContext">
									<SbTooltip Text="@L["Edit"]"><SbIconButton Size="SbSize.Sm" AriaLabel="@L["Edit"]"
												  OnClick="@(() => ShowEditModal(cellContext.Item))">
										<Icon><SbIcon Name="edit" Size="SbSize.Sm" /></Icon>
									</SbIconButton></SbTooltip>
								</AuthorizeView>
								@if (_hasManagePermissionsPermission)
								{
									<SbTooltip Text="@L["Permissions"]"><SbIconButton Size="SbSize.Sm" AriaLabel="@L["Permissions"]"
												  OnClick="@(async () => await ShowPermissionModalAsync(cellContext.Item))">
										<Icon><SbIcon Name="shield" Size="SbSize.Sm" /></Icon>
									</SbIconButton></SbTooltip>
								}
								<AuthorizeView Policy="@SufiChain.SufiPlatform.Identity.IdentityPermissions.Users.Delete" Context="authContext2">
									<SbTooltip Text="@L["Delete"]"><SbIconButton Size="SbSize.Sm" Color="SbColor.Danger" AriaLabel="@L["Delete"]"
												  OnClick="@(() => DeleteUserAsync(cellContext.Item))">
										<Icon><SbIcon Name="trash" Size="SbSize.Sm" /></Icon>
									</SbIconButton></SbTooltip>
								</AuthorizeView>
							</SbStack>
						</CellTemplate>
					</SbColumn>
					<SbColumn TItem="IdentityUserDto" Field="UserName" Title="@L["Username"]" Sortable="true" />
					<SbColumn TItem="IdentityUserDto" Field="Email" Title="@L["Email"]" Sortable="true" />
					<SbColumn TItem="IdentityUserDto" Field="PhoneNumber" Title="@L["Phone"]" />
					<SbColumn TItem="IdentityUserDto" Title="@L["Status"]">
						<CellTemplate Context="cellContext">
							@if (cellContext.Item.IsActive)
							{
								<SbBadge Color="SbColor.Success">@L["Active"]</SbBadge>
							}
							else
							{
								<SbBadge Color="SbColor.Danger">@L["Inactive"]</SbBadge>
							}
						</CellTemplate>
					</SbColumn>
				</SbDataGrid>
			</SbStack>
		</ChildContent>
	</SbCard>

</SbStack>

<UserCreateModal @bind-Open="_showCreateModal" OnUserCreated="OnUserCreatedAsync" Roles="_roles" />
<UserEditModal @bind-Open="_showEditModal" User="_selectedUser" OnUserUpdated="OnUserUpdatedAsync" Roles="_roles" />
<PermissionsModal @ref="_permissionManagementModal" />
