@namespace SufiChain.SufiPlatform.Identity.Blazor.Pages
@page "/panel/admin/identity/roles"
@attribute [Authorize(Policy = SufiChain.SufiPlatform.Identity.IdentityPermissions.Roles.Default)]
@inherits IdentityComponentBase

<SufiPageToolbar>
	<AuthorizeView Policy="@SufiChain.SufiPlatform.Identity.IdentityPermissions.Roles.Create">
		<SbButton Color="SbColor.Primary" OnClick="@ShowCreateModal">
			<StartIcon><SbIcon Name="plus" /></StartIcon>
			<ChildContent>@L["NewRole"]</ChildContent>
		</SbButton>
	</AuthorizeView>
</SufiPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">

	<!-- Roles Content -->
	<SbCard>
		<ChildContent>
			<SbStack Gap="4">
				<SbTextField @bind-Value="_filter"
							 Placeholder="@L["SearchRoles"]"
							 Clearable="true">
					<StartAdornment>
						<SbIcon Name="search" />
					</StartAdornment>
				</SbTextField>

				@if (!_rowActionsReady)
				{
					<SbStack Justify="SbJustify.Center" Align="SbAlign.Center" Class="p-8" aria-busy="true">
						<SbProgress Indeterminate="true" aria-label="@L["Loading"]" Type="SbProgressType.Circular" />
					</SbStack>
				}
				else
				{
				<SbDataGrid TItem="IdentityRoleDto"
							@ref="_gridRef"
							ItemsProvider="LoadRolesDataAsync"
							Loading="IsOperationLoading(LoadingKeys.LoadRoles)"
							Striped="true"
							Hoverable="true"
							PageIndex="_pageIndex"
							PageSize="_pageSize"
							TotalCount="_totalCount"
							PageIndexChanged="OnPageIndexChangedAsync"
							KeySelector="@(item => item.Id.ToString())"
                        ShowFilterRow="true"
                        ShowColumnChooser="true"
                        SelectionMode="SbSelectionMode.MultipleRows">
					<SbColumn TItem="IdentityRoleDto" Title="@L["Actions"]" MinWidth="168px" Sortable="false">
						<CellTemplate Context="cellContext">
							<SbStack Direction="SbStackDirection.Row" Gap="1" Class="identity-row-actions">
								@if (_canUpdateRole)
								{
									<SbTooltip Text="@L["Edit"]"><SbIconButton Size="SbSize.Sm" AriaLabel="@L["Edit"]"
												  OnClick="@(() => ShowEditModal(cellContext.Item))">
										<Icon><SbIcon Name="edit" Size="SbSize.Sm" /></Icon>
									</SbIconButton></SbTooltip>
								}
								@if (_canManagePermissions)
								{
									<SbTooltip Text="@L["Permissions"]"><SbIconButton Size="SbSize.Sm" AriaLabel="@L["Permissions"]"
												  OnClick="@(async () => await ShowPermissionModalAsync(cellContext.Item))">
										<Icon><SbIcon Name="shield" Size="SbSize.Sm" /></Icon>
									</SbIconButton></SbTooltip>
								}
								@if (_canDeleteRole)
								{
									<SbTooltip Text="@L["Delete"]"><SbIconButton Size="SbSize.Sm" Color="SbColor.Danger" AriaLabel="@L["Delete"]"
												  Disabled="@cellContext.Item.IsStatic"
												  OnClick="@(() => DeleteRoleAsync(cellContext.Item))">
										<Icon><SbIcon Name="trash" Size="SbSize.Sm" /></Icon>
									</SbIconButton></SbTooltip>
								}
							</SbStack>
						</CellTemplate>
					</SbColumn>
					<SbColumn TItem="IdentityRoleDto" Field="Name" Title="@L["RoleName"]" Sortable="true" Filterable="true">
						<CellTemplate Context="cellContext">
							<SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
								<span>@cellContext.Item.Name</span>
								@if (cellContext.Item.IsDefault)
								{
									<SbBadge Color="SbColor.Primary">@L["Default"]</SbBadge>
								}
								@if (cellContext.Item.IsPublic)
								{
									<SbBadge Color="SbColor.Info">@L["PublicRole"]</SbBadge>
								}
								@if (cellContext.Item.IsStatic)
								{
									<SbBadge Color="SbColor.Secondary">@L["Static"]</SbBadge>
								}
							</SbStack>
						</CellTemplate>
					</SbColumn>
				</SbDataGrid>
				}
			</SbStack>
		</ChildContent>
	</SbCard>

</SbStack>

<RoleCreateModal @bind-Open="_showCreateModal" OnRoleCreated="OnRoleCreatedAsync" />
<RoleEditModal @bind-Open="_showEditModal" Role="_selectedRole" OnRoleUpdated="OnRoleUpdatedAsync" />
<PermissionsModal @ref="_permissionManagementModal" />
<ReadOnlyHooshvareDrawer HooshvareKey="@IdentityAdminAdvisorHooshvareKeys.Key"
                         Title="@L["Hooshvare:SufiIdentity:AdminAdvisor:DisplayName"]"
                         ContextProvider="BuildHooshvareContext" />
