<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiPlatform.Identity.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.Identity.Blazor</PackageId>
    <Description>Identity module Blazor UI components for Sufi Platform - user and role management pages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resolve version conflict with SufiBlazor -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftAspNetCoreComponentsWebVersion)" />
    <!-- ABP Identity Application Contracts (DTOs and interfaces) -->
    <ProjectReference Include="../SufiChain.SufiPlatform.Identity.Application.Contracts/SufiChain.SufiPlatform.Identity.Application.Contracts.csproj" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiPlatform.Authorization/SufiChain.SufiPlatform.Authorization.csproj" />
    <!-- Sufi Permission Management Application Contracts (for permission assignment) -->
    <ProjectReference Include="..\..\..\..\modules\permissions\src\SufiChain.SufiPlatform.Permissions.Application.Contracts\SufiChain.SufiPlatform.Permissions.Application.Contracts.csproj" />
    <!-- Blazor Authorization -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sufi Framework (transitively provides SufiChain.SufiPlatform.UI.Abstractions and SufiChain.SufiBlazor) -->
    <ProjectReference Include="..\..\..\..\framework\SufiChain.SufiPlatform.UI.Blazor\SufiChain.SufiPlatform.UI.Blazor.csproj" />
    <!-- Sufi Identity Domain.Shared for localization -->
    <ProjectReference Include="..\SufiChain.SufiPlatform.Identity.Domain.Shared\SufiChain.SufiPlatform.Identity.Domain.Shared.csproj" />
    <!-- Sufi Identity Application Contracts -->
    <ProjectReference Include="..\SufiChain.SufiPlatform.Identity.Application.Contracts\SufiChain.SufiPlatform.Identity.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\..\users\src\SufiChain.SufiPlatform.Users.Blazor.Public\SufiChain.SufiPlatform.Users.Blazor.Public.csproj" />
    <ProjectReference Include="..\SufiChain.SufiPlatform.Identity.Blazor.Public\SufiChain.SufiPlatform.Identity.Blazor.Public.csproj" />
  </ItemGroup>

</Project>
