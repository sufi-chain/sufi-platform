@namespace SufiChain.SufiPlatform.Identity.Blazor.Components
@inherits IdentityComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Md" Title="@L["EditRole"]">
    <ChildContent>
        <SbForm Model="_model" OnValidSubmit="OnValidSubmitAsync">
            <SbStack Gap="3">
                <SbTextField @bind-Value="_model.Name" 
                             Label="@L["RoleName"]" 
                             Required="true" />
                <SbStack Gap="3" Direction="@SbStackDirection.Row" Wrap="true">
                    <SbCheckbox @bind-Value="_model.IsDefault"
                                Label="@L["DefaultRoleForNewUsers"]" />

                    <SbCheckbox @bind-Value="_model.IsPublic"
                                Label="@L["PublicRole"]" />
                </SbStack>
            </SbStack>
        </SbForm>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="Hide">@L["Cancel"]</SbButton>
            <SbButton Color="SbColor.Primary" Loading="IsOperationLoading(LoadingKeys.Save)" OnClick="OnValidSubmitAsync">@L["Save"]</SbButton>
        </SbStack>
    </Footer>
</SbDialog>
