@inherits IdentityComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Md" Title="@L["EditOrganizationUnit"]">
    <ChildContent>
        <SbForm Model="_model" OnValidSubmit="OnValidSubmitAsync">
            <SbStack Gap="3">
                <SbTextField @bind-Value="_model.DisplayName" 
                             Label="@L["DisplayName"]" 
                             Required="true"
                             Placeholder="@L["EnterDisplayName"]" />

                @if (OrganizationUnit != null)
                {
                    <SbStack Gap="1">
                        <span class="text-muted">@L["Code"]</span>
                        <code>@OrganizationUnit.Code</code>
                    </SbStack>
                }
            </SbStack>
        </SbForm>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="Hide">@L["Cancel"]</SbButton>
            <SbButton Color="SbColor.Primary" Loading="IsOperationLoading(LoadingKeys.Save)" OnClick="OnValidSubmitAsync">@L["Save"]</SbButton>
        </SbStack>
    </Footer>
</SbDialog>
