@namespace SufiChain.SufiAbp.Identity.Blazor.Components
@inherits IdentityComponentBase

<SbDialog Open="@Open" OpenChanged="OnDialogOpenChanged" Size="SbDialogSize.Md" Title="@L["AssignRoles"]">
    <ChildContent>
        <SbStack Gap="3">
            <SbAlert Severity="@SbAlertSeverity.Info" Class="mb-2">
                @L["OrganizationUnitRolesInfo"]
            </SbAlert>

            <SbTextField @bind-Value="_filter" 
                         @bind-Value:after="OnFilterChangedAsync"
                         Placeholder="@L["SearchRoles"]"
                         Clearable="true">
                <StartAdornment>
                    <SbIcon Name="search" />
                </StartAdornment>
            </SbTextField>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <SbAlert Severity="@SbAlertSeverity.Danger">
                    @_errorMessage
                </SbAlert>
            }
            else
            {
                <SbDataGrid TItem="OrganizationUnitRoleDto"
                            @ref="_gridRef"
                            ItemsProvider="LoadAvailableRolesDataAsync"
                            Loading="IsOperationLoading(LoadingKeys.LoadRoles)"
                            Striped="true"
                            Hoverable="true"
                            PageIndex="_pageIndex"
                            PageSize="_pageSize"
                            TotalCount="_totalCount"
                            PageIndexChanged="OnPageIndexChangedAsync">
                    <EmptyTemplate>
                        <SbStack Justify="SbJustify.Center" Align="SbAlign.Center" Class="p-8 text-muted">
                            <SbIcon Name="shield" Size="SbSize.Xl" />
                            <span>@L["NoAvailableRolesFound"]</span>
                        </SbStack>
                    </EmptyTemplate>
                    <ChildContent>
                    <SbColumn TItem="OrganizationUnitRoleDto" Title="" Width="50px">
                        <CellTemplate Context="cellContext">
                            <SbCheckbox Value="@_selectedRoleIds.Contains(cellContext.Item.RoleId)"
                                        ValueChanged="@(v => OnRoleToggled(cellContext.Item.RoleId, v))" />
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="OrganizationUnitRoleDto" Title="@L["RoleName"]">
                        <CellTemplate Context="cellContext">
                            <SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
                                <SbIcon Name="shield" />
                                @cellContext.Item.RoleName
                            </SbStack>
                        </CellTemplate>
                    </SbColumn>
                    </ChildContent>
                </SbDataGrid>
            }

            @if (_selectedRoleIds.Count > 0)
            {
                <SbAlert Severity="SbAlertSeverity.Info">
                    @L["SelectedRolesCount", _selectedRoleIds.Count]
                </SbAlert>
            }
        </SbStack>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="Hide">@L["Cancel"]</SbButton>
            <SbButton Color="SbColor.Primary" 
                      Loading="IsOperationLoading(LoadingKeys.AddRoles)" 
                      Disabled="@(_selectedRoleIds.Count == 0)"
                      OnClick="AddRolesAsync">
                @L["AssignSelected"]
            </SbButton>
        </SbStack>
    </Footer>
</SbDialog>
