@namespace SufiChain.SufiAbp.Identity.Blazor.Pages
@page "/panel/admin/identity/roles"
@attribute [Authorize(Policy = SufiChain.SufiAbp.Identity.IdentityPermissions.Roles.Default)]
@inherits IdentityComponentBase

<SufiAbpPageToolbar>
	<AuthorizeView Policy="@SufiChain.SufiAbp.Identity.IdentityPermissions.Roles.Create">
		<SbButton Color="SbColor.Primary" OnClick="@ShowCreateModal">
			<StartIcon><SbIcon Name="plus" /></StartIcon>
			<ChildContent>@L["NewRole"]</ChildContent>
		</SbButton>
	</AuthorizeView>
</SufiAbpPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">

	<!-- Roles Content -->
	<SbCard>
		<ChildContent>
			<SbStack Gap="4">
				<SbTextField @bind-Value="_filter"
							 Placeholder="@L["SearchRoles"]"
							 Clearable="true">
					<StartAdornment>
						<SbIcon Name="search" />
					</StartAdornment>
				</SbTextField>

				<SbDataGrid TItem="IdentityRoleDto"
							@ref="_gridRef"
							ItemsProvider="LoadRolesDataAsync"
							Loading="IsOperationLoading(LoadingKeys.LoadRoles)"
							Striped="true"
							Hoverable="true"
							PageIndex="_pageIndex"
							PageSize="_pageSize"
							TotalCount="_totalCount"
							PageIndexChanged="OnPageIndexChangedAsync">
					<SbColumn TItem="IdentityRoleDto" Title="@L["Actions"]" Width="160px">
						<CellTemplate Context="cellContext">
							<SbStack Direction="SbStackDirection.Row" Gap="1">
								<AuthorizeView Policy="@SufiChain.SufiAbp.Identity.IdentityPermissions.Roles.Update" Context="authContext">
									<SbIconButton Size="SbSize.Sm" AriaLabel="@L["Edit"]"
												  OnClick="@(() => ShowEditModal(cellContext.Item))">
										<Icon><SbIcon Name="edit" /></Icon>
									</SbIconButton>
								</AuthorizeView>
								@if (_hasManagePermissionsPermission)
								{
									<SbIconButton Size="SbSize.Sm" AriaLabel="@L["Permissions"]"
												  OnClick="@(async () => await ShowPermissionModalAsync(cellContext.Item))">
										<Icon><SbIcon Name="shield" /></Icon>
									</SbIconButton>
								}
								<AuthorizeView Policy="@SufiChain.SufiAbp.Identity.IdentityPermissions.Roles.Delete" Context="authContext2">
									<SbIconButton Size="SbSize.Sm" Color="SbColor.Danger" AriaLabel="@L["Delete"]"
												  Disabled="@cellContext.Item.IsStatic"
												  OnClick="@(() => DeleteRoleAsync(cellContext.Item))">
										<Icon><SbIcon Name="trash" /></Icon>
									</SbIconButton>
								</AuthorizeView>
							</SbStack>
						</CellTemplate>
					</SbColumn>
					<SbColumn TItem="IdentityRoleDto" Title="@L["RoleName"]" Sortable="true">
						<CellTemplate Context="cellContext">
							<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
								<span>@cellContext.Item.Name</span>
								@if (cellContext.Item.IsDefault)
								{
									<SbBadge Color="SbColor.Primary">@L["Default"]</SbBadge>
								}
								@if (cellContext.Item.IsPublic)
								{
									<SbBadge Color="SbColor.Info">@L["Public"]</SbBadge>
								}
								@if (cellContext.Item.IsStatic)
								{
									<SbBadge Color="SbColor.Secondary">@L["Static"]</SbBadge>
								}
							</SbStack>
						</CellTemplate>
					</SbColumn>
				</SbDataGrid>
			</SbStack>
		</ChildContent>
	</SbCard>

</SbStack>

<RoleCreateModal @bind-Open="_showCreateModal" OnRoleCreated="OnRoleCreatedAsync" />
<RoleEditModal @bind-Open="_showEditModal" Role="_selectedRole" OnRoleUpdated="OnRoleUpdatedAsync" />
<PermissionManagementModal @ref="_permissionManagementModal" />
