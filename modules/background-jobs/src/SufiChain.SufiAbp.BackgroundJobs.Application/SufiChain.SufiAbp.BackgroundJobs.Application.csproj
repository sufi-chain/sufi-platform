<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SufiChain.SufiAbp.BackgroundJobs</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiAbp.BackgroundJobs.Application</PackageId>
    <Description>Background jobs module application services for Sufi Platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ABP Dependencies -->
    <ProjectReference Include="../../../../framework/SufiChain.SufiAbp.Ddd.Application/SufiChain.SufiAbp.Ddd.Application.csproj" />
    <PackageReference Include="Volo.Abp.Mapperly" Version="$(AbpVersion)" />
    <ProjectReference Include="../SufiChain.SufiAbp.BackgroundJobs.Domain/SufiChain.SufiAbp.BackgroundJobs.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project References -->
    <ProjectReference Include="..\SufiChain.SufiAbp.BackgroundJobs.Application.Contracts\SufiChain.SufiAbp.BackgroundJobs.Application.Contracts.csproj" />
  </ItemGroup>

</Project>
