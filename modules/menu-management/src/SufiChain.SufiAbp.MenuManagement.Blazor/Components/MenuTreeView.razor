@namespace SufiChain.SufiAbp.MenuManagement.Blazor.Components
@inherits MenuManagementComponentBase
@if (Items?.Count > 0)
{
    <ul class="sufi-menu-tree">
        @foreach (var item in Items)
        {
            <li>
                <button type="button" @onclick="() => SelectAsync(item)">@ResolveMenuItemDisplayName(item, ContextType)</button>
                @if (item.Children.Count > 0)
                {
                    <MenuTreeView Items="item.Children" ContextType="ContextType" OnItemSelected="OnItemSelected" />
                }
            </li>
        }
    </ul>
}
