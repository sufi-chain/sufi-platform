@namespace SufiChain.SufiAbp.MenuManagement.Blazor.Components
@inherits MenuManagementComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Md" Title="@L["MoveItem"]" AllowDropdownOverflow="true">
    <ChildContent>
        <SbForm OnValidSubmit="OnValidSubmitAsync">
            <ChildContent>
                <SbStack Gap="3">
                    <SbSimpleSelect TValue="string"
                                    @bind-Value="_parentIdText"
                                    Label="@L["Parent"]"
                                    Searchable="true">
                        <SbSelectOption TValue="string" Value="string.Empty">@L["NoParent"]</SbSelectOption>
                        @foreach (var option in ParentOptions)
                        {
                            <SbSelectOption TValue="string" Value="@option.Id.ToString()">@option.Path</SbSelectOption>
                        }
                    </SbSimpleSelect>

                    <SbTextField @bind-Value="_displayOrderText" Label="@L["DisplayOrder"]" Type="number" />
                </SbStack>
            </ChildContent>
            <FooterContent>
                <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
                    <SbButton Variant="SbButtonVariant.Outline" OnClick="Hide">@L["Cancel"]</SbButton>
                    <SbButton Type="submit" Color="SbColor.Primary" Loading="IsOperationLoading(LoadingKeys.Move)">@L["Move"]</SbButton>
                </SbStack>
            </FooterContent>
        </SbForm>
    </ChildContent>
</SbDialog>
