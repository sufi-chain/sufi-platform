@page "/admin/ai-management/workspaces"
@attribute [Authorize(Policy = AIManagementPermissions.Workspaces.Default)]
@inherits AIManagementComponentBase

<SufiAbpPageToolbar>
	<AuthorizeView Policy="@AIManagementPermissions.Workspaces.Create">
		<SbButton Color="SbColor.Primary" OnClick="@OpenCreateModal">
			<StartIcon><SbIcon Name="plus" /></StartIcon>
			<ChildContent>@L["NewWorkspace"]</ChildContent>
		</SbButton>
	</AuthorizeView>
</SufiAbpPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">

	<!-- Workspaces Grid -->
	<SbCard>
		<ChildContent>
			<SbDataGrid TItem="WorkspaceDto"
						@ref="_gridRef"
						ItemsProvider="LoadWorkspacesDataAsync"
						Loading="IsOperationLoading(LoadingKeys.LoadWorkspaces)"
						Striped="true"
						Hoverable="true"
						PageIndex="_pageIndex"
						PageSize="_pageSize"
						TotalCount="_totalCount"
						PageIndexChanged="OnPageIndexChangedAsync"
						PageSizeChanged="OnPageSizeChangedAsync"
						KeySelector="@(item => item.Id.ToString())">
				<SbColumn TItem="WorkspaceDto" Title="@L["Actions"]" Width="120px">
					<CellTemplate Context="cellContext">
						<SbStack Direction="SbStackDirection.Row" Gap="1">
							<AuthorizeView Policy="@AIManagementPermissions.Workspaces.Edit">
								<SbIconButton Size="SbSize.Sm" AriaLabel="@L["Edit"]"
											  OnClick="@(() => OpenEditModal(cellContext.Item))">
									<Icon><SbIcon Name="edit" /></Icon>
								</SbIconButton>
							</AuthorizeView>
							<AuthorizeView Policy="@AIManagementPermissions.Workspaces.Delete">
								<SbIconButton Size="SbSize.Sm" AriaLabel="@L["Delete"]"
											  Color="SbColor.Danger"
											  OnClick="@(() => DeleteWorkspaceAsync(cellContext.Item))">
									<Icon><SbIcon Name="trash" /></Icon>
								</SbIconButton>
							</AuthorizeView>
						</SbStack>
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="WorkspaceDto" Field="Name" Title="@L["Name"]" Width="200px">
					<CellTemplate Context="cellContext">
						<strong>@cellContext.Item.Name</strong>
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="WorkspaceDto" Title="@L["Provider"]" Width="120px">
					<CellTemplate Context="cellContext">
						<SbBadge Color="@GetProviderColor(cellContext.Item.Provider)">
							@cellContext.Item.Provider.ToString()
						</SbBadge>
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="WorkspaceDto" Field="Model" Title="@L["Model"]" Width="180px" />
				<SbColumn TItem="WorkspaceDto" Title="@L["Status"]" Width="100px">
					<CellTemplate Context="cellContext">
						<SbBadge Color="@(cellContext.Item.IsActive ? SbColor.Success : SbColor.Default)">
							@(cellContext.Item.IsActive ? L["Active"] : L["Inactive"])
						</SbBadge>
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="WorkspaceDto" Title="@L["Temperature"]" Width="120px">
					<CellTemplate Context="cellContext">
						@cellContext.Item.Temperature.ToString("F2")
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="WorkspaceDto" Title="@L["MaxTokens"]" Width="120px">
					<CellTemplate Context="cellContext">
						@cellContext.Item.MaxTokens.ToString("N0")
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="WorkspaceDto" Title="@L["CreationTime"]" Width="160px">
					<CellTemplate Context="cellContext">
						@cellContext.Item.CreationTime.ToString("yyyy-MM-dd HH:mm")
					</CellTemplate>
				</SbColumn>
			</SbDataGrid>
		</ChildContent>
	</SbCard>

</SbStack>

<WorkspaceCreateModal @bind-Open="_showCreateModal" OnCreated="@OnWorkspaceCreatedAsync" />
<WorkspaceEditModal @bind-Open="_showEditModal" WorkspaceId="_editingWorkspaceId" OnUpdated="@OnWorkspaceUpdatedAsync" />
