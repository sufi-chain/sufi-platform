@page "/admin/ai-management/test-chat"
@attribute [Authorize(Policy = AIManagementPermissions.TestChat.Default)]
@inherits AIManagementComponentBase

<SbCard>
    <ChildContent>
        <SbTabs @bind-ActiveIndex="_activeTab">
            <SbTab Label="@L["Chat"]">
                <AIChatTestPanel />
            </SbTab>
            <SbTab Label="@L["MultiModalTest"]">
                <AIMultiModalTestPanel />
            </SbTab>
            <SbTab Label="@L["MCPTools"]">
                <AIToolTestPanel />
            </SbTab>
        </SbTabs>
    </ChildContent>
</SbCard>
