@inherits AIManagementComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Lg" Title="@L["EditWorkspace"]" AllowDropdownOverflow="true">
	<ChildContent>
		@if (_workspace != null)
		{
			<SbTabs @bind-ActiveIndex="_activeTab">
				<SbTab Label="@L["ConnectionSettings"]">
					<SbStack Direction="SbStackDirection.Column" Gap="4">
						<SbAlert Severity="SbAlertSeverity.Info">
							@L["OnlyOpenAIProviderAvailable"]
						</SbAlert>

						@* Provider selection is intentionally hidden until more providers are supported.
						<SbSimpleSelect TValue="AIProviderType"
										@bind-Value="_model.Provider"
										Label="@L["Provider"]"
										Disabled="true">
							<SbSelectOption TValue="AIProviderType" Value="@AIProviderType.OpenAI">OpenAI</SbSelectOption>
						</SbSimpleSelect>
						*@

						<SbGrid Columns="1" ColumnsMd="2" Gap="4">
							<SbTextField @bind-Value="_model.Name"
										 Label="@L["Name"]"
										 Required="true" />

							<SbTextField @bind-Value="_model.ApiBaseUrl"
										 Label="@L["ApiBaseUrl"]" />
						</SbGrid>

						<SbGrid Columns="1" ColumnsMd="2" Gap="4">
							<SbTextField @bind-Value="_model.ApiKey"
										 Label="@L["ApiKey"]"
										 Type="password"
										 Placeholder="@L["LeaveEmptyToKeepCurrent"]" />

							<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.End">
								<SbTextField @bind-Value="_model.Model"
											 Label="@L["Model"]"
											 Required="true"
											 Placeholder="@L["ModelIdPlaceholder"]" />
								<SbButton Variant="SbButtonVariant.Outline"
										  OnClick="@LoadModelsAsync"
										  Loading="IsOperationLoading(LoadingKeys.LoadModels)">
									@L["LoadModels"]
								</SbButton>
							</SbStack>
						</SbGrid>

						@if (_availableModels.Count > 0)
						{
							<SbSimpleSelect TValue="string"
											@bind-Value="_model.Model"
											Label="@L["AvailableModels"]"
											Searchable="true"
											SearchPlaceholder="@L["SearchModels"]">
								@if (!string.IsNullOrWhiteSpace(_model.Model) && !_availableModels.Any(m => m.Id == _model.Model))
								{
									<SbSelectOption TValue="string" Value="@_model.Model">@_model.Model</SbSelectOption>
								}
								@foreach (var model in _availableModels)
								{
									<SbSelectOption TValue="string" Value="@model.Id">@model.Id</SbSelectOption>
								}
							</SbSimpleSelect>
						}

						<SbRadioGroup TValue="OpenAIApiMode"
									  @bind-Value="_model.OpenAIApiMode"
									  Label="@L["OpenAIApiMode"]"
									  Orientation="SbOrientation.Horizontal">
							<SbRadio TValue="OpenAIApiMode" Value="@OpenAIApiMode.ChatCompletions" Label="@L["ChatCompletions"]" />
							<SbRadio TValue="OpenAIApiMode" Value="@OpenAIApiMode.Responses" Label="@L["Responses"]" />
						</SbRadioGroup>

						@if (_model.OpenAIApiMode == OpenAIApiMode.Responses)
						{
							<SbAlert Severity="SbAlertSeverity.Warning">
								@L["ResponsesApiCompatibilityWarning"]
							</SbAlert>
						}

						<SbTextArea @bind-Value="_model.SystemPrompt"
									Label="@L["SystemPrompt"]"
									Rows="5"
									Placeholder="@L["SystemPromptPlaceholder"]" />
					</SbStack>
				</SbTab>

				<SbTab Label="@L["GenerationAndCost"]">
					<SbStack Direction="SbStackDirection.Column" Gap="4">
						<SbGrid Columns="1" ColumnsMd="2" Gap="4">
							<SbTextField @bind-Value="_temperatureText"
										 Label="@L["Temperature"]" />

							<SbTextField @bind-Value="_maxTokensText"
										 Label="@L["MaxTokens"]" />
						</SbGrid>

						<SbGrid Columns="1" ColumnsMd="2" Gap="4">
							<SbTextField @bind-Value="_inputCostPer1MTokensText"
										 Label="@L["InputCostPer1MTokens"]"
										 Placeholder="0.0000" />

							<SbTextField @bind-Value="_outputCostPer1MTokensText"
										 Label="@L["OutputCostPer1MTokens"]"
										 Placeholder="0.0000" />
						</SbGrid>
					</SbStack>
				</SbTab>
			</SbTabs>
		}
		else if (IsOperationLoading(LoadingKeys.LoadWorkspace))
		{
			<SbStack Direction="SbStackDirection.Column" Gap="2" Align="SbAlign.Center">
				<SbProgress Indeterminate="true" />
				<SbText>@L["Loading"]...</SbText>
			</SbStack>
		}
	</ChildContent>
	<Footer>
		<SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
			<SbButton Variant="SbButtonVariant.Outline" OnClick="@CloseModal">
				@L["Cancel"]
			</SbButton>
			<SbButton Variant="SbButtonVariant.Outline"
					  OnClick="@TestConnectionAsync"
					  Loading="IsOperationLoading(LoadingKeys.TestConnection)"
					  Disabled="_workspace == null">
				@L["TestConnection"]
			</SbButton>
			<SbButton Color="SbColor.Primary"
					  OnClick="@UpdateWorkspaceAsync"
					  Loading="IsOperationLoading(LoadingKeys.UpdateWorkspace)"
					  Disabled="_workspace == null">
				@L["Save"]
			</SbButton>
		</SbStack>
	</Footer>
</SbDialog>
