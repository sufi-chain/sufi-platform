@inherits AIManagementComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Lg" Title="@L["ConfigureMCPTools"]" AllowDropdownOverflow="true">
    <ChildContent>
        <SbStack Direction="SbStackDirection.Column" Gap="3">
            <SbTextField @bind-Value="_filter"
                         Placeholder="@L["Search"]"
                         FullWidth="true" />

            <SbStack Direction="SbStackDirection.Row" Gap="2">
                <SbButton Size="SbSize.Sm" OnClick="@SelectAllAsync">@L["SelectAll"]</SbButton>
                <SbButton Size="SbSize.Sm" OnClick="@ClearAllAsync">@L["ClearAll"]</SbButton>
            </SbStack>

            <SbDataGrid TItem="MCPToolDto"
                        Items="@FilteredTools"
                        Striped="true"
                        Hoverable="true"
                        Loading="IsOperationLoading(LoadingKeys.Load)">
                <SbColumn TItem="MCPToolDto" Title="@L["Enabled"]" Width="90px">
                    <CellTemplate Context="cellContext">
                        <SbCheckbox Value="@IsSelected(cellContext.Item.Name)"
                                    ValueChanged="@((bool value) => ToggleToolAsync(cellContext.Item.Name, value))" />
                    </CellTemplate>
                </SbColumn>
                <SbColumn TItem="MCPToolDto" Field="Name" Title="@L["Name"]" Width="240px" />
                <SbColumn TItem="MCPToolDto" Field="Description" Title="@L["Description"]" />
                <SbColumn TItem="MCPToolDto" Field="Source" Title="@L["Source"]" Width="180px" />
                <SbColumn TItem="MCPToolDto" Field="ToolType" Title="@L["Type"]" Width="120px" />
            </SbDataGrid>
        </SbStack>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton OnClick="@CancelAsync">@L["Cancel"]</SbButton>
            <SbButton Color="SbColor.Primary"
                      OnClick="@SaveAsync"
                      Loading="IsOperationLoading(LoadingKeys.Save)">
                @L["Save"]
            </SbButton>
        </SbStack>
    </Footer>
</SbDialog>
