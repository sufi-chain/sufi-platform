@using SufiChain.SufiAbp.AI
@inherits AIComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Xl" Title="@GetTitle()" AllowDropdownOverflow="true">
	<ChildContent>
		<SbStack Direction="SbStackDirection.Column" Gap="4">
			<SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
				<AuthorizeView Policy="@AIPermissions.AI.ManageConfigurations">
					<SbButton Color="SbColor.Primary" OnClick="@OpenCreateModal" Disabled="@(!WorkspaceId.HasValue)">
						<StartIcon><SbIcon Name="plus" /></StartIcon>
						<ChildContent>@L["NewModelConfiguration"]</ChildContent>
					</SbButton>
				</AuthorizeView>
			</SbStack>

			<SbDataGrid TItem="AIModelConfigurationDto"
						Items="@_configurations"
						Loading="IsOperationLoading(LoadingKeys.LoadConfigurations)"
						Striped="true"
						Hoverable="true"
						KeySelector="@(item => item.Id.ToString())">
				<ChildContent>
					<SbColumn TItem="AIModelConfigurationDto" Title="@L["Actions"]" Width="150px">
						<CellTemplate Context="cellContext">
							<SbStack Direction="SbStackDirection.Row" Gap="1">
								<AuthorizeView Policy="@AIPermissions.AI.ManageConfigurations">
									<SbIconButton Size="SbSize.Sm" AriaLabel="@L["Edit"]"
												  OnClick="@(() => OpenEditModal(cellContext.Item))">
										<Icon><SbIcon Name="edit" /></Icon>
									</SbIconButton>
								</AuthorizeView>
								<AuthorizeView Policy="@AIPermissions.AI.ManageConfigurations">
									<SbIconButton Size="SbSize.Sm" AriaLabel="@L["Delete"]"
												  Color="SbColor.Danger"
												  OnClick="@(() => DeleteConfigurationAsync(cellContext.Item))">
										<Icon><SbIcon Name="trash" /></Icon>
									</SbIconButton>
								</AuthorizeView>
							</SbStack>
						</CellTemplate>
					</SbColumn>
					<SbColumn TItem="AIModelConfigurationDto" Field="CapabilityType" Title="@L["Capability"]" Width="150px">
						<CellTemplate Context="cellContext">
							<SbChip Color="@GetCapabilityColor(cellContext.Item.CapabilityType)" Size="SbSize.Sm">
								@cellContext.Item.CapabilityType.ToString()
							</SbChip>
						</CellTemplate>
					</SbColumn>
					<SbColumn TItem="AIModelConfigurationDto" Field="ModelId" Title="@L["ModelId"]" Width="200px">
						<CellTemplate Context="cellContext">
							<SbText Variant="SbTextVariant.BodySmall" Weight="SbFontWeight.Medium">
								@cellContext.Item.ModelId
							</SbText>
						</CellTemplate>
					</SbColumn>
					<SbColumn TItem="AIModelConfigurationDto" Field="ApiEndpoint" Title="@L["ApiEndpoint"]">
						<CellTemplate Context="cellContext">
							@if (!string.IsNullOrEmpty(cellContext.Item.ApiEndpoint))
							{
								<SbText Variant="SbTextVariant.BodySmall">
									@cellContext.Item.ApiEndpoint
								</SbText>
							}
							else
							{
								<SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">
									@L["Default"]
								</SbText>
							}
						</CellTemplate>
					</SbColumn>
					<SbColumn TItem="AIModelConfigurationDto" Field="Priority" Title="@L["Priority"]" Width="100px">
						<CellTemplate Context="cellContext">
							<SbChip Size="SbSize.Sm">
								@cellContext.Item.Priority
							</SbChip>
						</CellTemplate>
					</SbColumn>
					<SbColumn TItem="AIModelConfigurationDto" Field="IsEnabled" Title="@L["Status"]" Width="100px">
						<CellTemplate Context="cellContext">
							<SbChip Color="@(cellContext.Item.IsEnabled ? SbColor.Success : SbColor.Default)"
									Size="SbSize.Sm">
								@(cellContext.Item.IsEnabled ? L["Enabled"] : L["Disabled"])
							</SbChip>
						</CellTemplate>
					</SbColumn>
				</ChildContent>
			</SbDataGrid>

			@if (!_configurations.Any() && !IsOperationLoading(LoadingKeys.LoadConfigurations))
			{
				<SbStack Direction="SbStackDirection.Column" Gap="2" Align="SbAlign.Center">
					<SbIcon Name="settings" Size="SbSize.Lg" Color="SbColor.Muted" />
					<SbText Variant="SbTextVariant.Body" Color="SbColor.Muted">
						@L["NoConfigurationsFound"]
					</SbText>
				</SbStack>
			}
		</SbStack>

		<ModelConfigurationModal @bind-Open="_modelConfigurationModalOpen"
								 Configuration="_editingConfiguration"
								 WorkspaceId="WorkspaceId"
								 OnSaved="@OnConfigurationSavedAsync" />
	</ChildContent>
	<Footer>
		<SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
			<SbButton OnClick="@CloseAsync">@L["Close"]</SbButton>
		</SbStack>
	</Footer>
</SbDialog>
