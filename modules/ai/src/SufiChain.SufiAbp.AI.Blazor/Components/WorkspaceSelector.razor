@using SufiChain.SufiAbp.AI.Workspaces
@inherits AIComponentBase

@if (Loading)
{
	<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
		<SbSkeleton Variant="SbSkeletonVariant.Text" Width="120px" />
		<SbSkeleton Variant="SbSkeletonVariant.Text" Width="180px" />
	</SbStack>
}
else if (!Workspaces.Any())
{
	<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
		<SbIcon Name="folder" Size="SbSize.Sm" Color="SbColor.Muted" />
		<SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">
			@(EmptyMessage ?? L["NoWorkspacesAvailable"])
		</SbText>
	</SbStack>
}
else if (UseCompactChips)
{
	<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center" style="flex-wrap: wrap;">
		<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted" style="white-space: nowrap;">
			@L["Workspace"]
		</SbText>
		@foreach (var workspace in FilteredWorkspaceList)
		{
			var isSelected = Value.HasValue && Value.Value == workspace.Id;

			<SbChip Size="SbSize.Sm"
					Variant="@(isSelected ? SbChipVariant.Filled : SbChipVariant.Outlined)"
					Color="@(isSelected ? SbColor.Primary : SbColor.Default)"
					Disabled="@(!workspace.IsActive)"
					OnClick="@(() => OnWorkspaceClickAsync(workspace.Id))"
					@key="workspace.Id">
				<StartIcon>
					<SbIcon Name="@GetProviderIcon(workspace.Provider)"
							Color="@GetProviderColor(workspace.Provider)"
							Size="SbSize.Sm" />
				</StartIcon>
				<ChildContent>@workspace.Name</ChildContent>
			</SbChip>
		}
	</SbStack>
}
else
{
	<SbSelect TItem="WorkspaceDto"
			  TValue="Guid?"
			  Items="@FilteredWorkspaceList"
			  Value="@Value"
			  ValueChanged="OnSelectChangedAsync"
			  TextField="@GetWorkspaceOptionText"
			  ValueField="@(workspace => workspace.Id)"
			  Label="@L["Workspace"]"
			  Placeholder="@L["SelectWorkspace"]"
			  style="max-width: 420px;" />
}
