@namespace SufiChain.SufiPlatform.SufiAI.Blazor.Pages.AI
@page "/panel/admin/ai/mcp-tools"
@attribute [Authorize(Policy = AIPermissions.MCPTools.Default)]
@inherits AIComponentBase

<SufiPageToolbar>
    <SbButton Color="SbColor.Secondary" OnClick="@RefreshToolsAsync">
        <StartIcon><SbIcon Name="refresh" /></StartIcon>
        <ChildContent>@L["RefreshTools"]</ChildContent>
    </SbButton>
</SufiPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">

    <SbCard>
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(_catalogLoadError))
            {
                <SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Warning" style="margin-bottom: 1rem;">
                    @_catalogLoadError
                </SbText>
            }
            <SbDataGrid TItem="MCPToolDto"
                        Items="@_tools"
                        Loading="IsOperationLoading(LoadingKeys.LoadTools)"
                        Striped="true"
                        Hoverable="true"
                        KeySelector="@(item => item.Name)">
                <ChildContent>
                    <SbColumn TItem="MCPToolDto" Title="@L["Actions"]" Width="56px" Sortable="false">
                        <CellTemplate Context="cellContext">
                            <SbTooltip Text="@L["ViewSchema"]">
                                <SbIconButton Size="SbSize.Sm"
                                              AriaLabel="@L["ViewSchema"]"
                                              OnClick="@(() => ViewToolSchemaAsync(cellContext.Item))">
                                    <Icon><SbIcon Name="code" /></Icon>
                                </SbIconButton>
                            </SbTooltip>
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="MCPToolDto" Title="@L["ToolName"]" Width="200px">
                        <CellTemplate Context="cellContext">
                            <SbStack Direction="SbStackDirection.Column" Gap="0">
                                <SbText Variant="SbTextVariant.BodySmall" Weight="SbFontWeight.Medium">
                                    @cellContext.Item.Name
                                </SbText>
                            </SbStack>
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="MCPToolDto" Title="@L["Description"]">
                        <CellTemplate Context="cellContext">
                            <SbText Variant="SbTextVariant.BodySmall">
                                @cellContext.Item.Description
                            </SbText>
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="MCPToolDto" Field="ToolType" Title="@L["Type"]" Width="120px">
                        <CellTemplate Context="cellContext">
                            <SbChip Color="@(cellContext.Item.ToolType == "Internal" ? SbColor.Primary : SbColor.Secondary)"
                                    Size="SbSize.Sm">
                                @cellContext.Item.ToolType
                            </SbChip>
                        </CellTemplate>
                    </SbColumn>
                    <SbColumn TItem="MCPToolDto" Field="Source" Title="@L["Source"]" Width="200px">
                        <CellTemplate Context="cellContext">
                            <SbText Variant="SbTextVariant.BodySmall">
                                @cellContext.Item.Source
                            </SbText>
                        </CellTemplate>
                    </SbColumn>
                </ChildContent>
            </SbDataGrid>
        </ChildContent>
    </SbCard>

</SbStack>

<SbDialog @bind-Open="_schemaDialogOpen" Size="SbDialogSize.Md" Title="@L["ToolSchema"]">
    <ChildContent>
        @if (_selectedTool != null)
        {
            <SbStack Direction="SbStackDirection.Column" Gap="2">
                <SbHeading Level="6">@_selectedTool.Name</SbHeading>
                <SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@_selectedTool.Name</SbText>
                <SbText Variant="SbTextVariant.BodySmall">@_selectedTool.Description</SbText>
                <SbDivider />
                @if (IsOperationLoading(LoadingKeys.LoadSchema))
                {
                    <SbProgress Indeterminate="true" />
                }
                else
                {
                    <pre style="background: #f5f5f5; padding: 16px; border-radius: 4px; overflow-x: auto;">@_selectedTool.ParameterSchema</pre>
                }
            </SbStack>
        }
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton OnClick="@(() => _schemaDialogOpen = false)">@L["Close"]</SbButton>
        </SbStack>
    </Footer>
</SbDialog>
