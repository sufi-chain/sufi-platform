@inherits AIComponentBase
@namespace SufiChain.SufiPlatform.SufiAI.Blazor.Pages.AI


<SbStack Direction="SbStackDirection.Column" Gap="4">

	<!-- Workspace Selection -->
	<WorkspaceSelector Value="_selectedWorkspaceId"
					   ValueChanged="@OnWorkspaceChangedAsync"
					   Workspaces="_workspaces"
					   Loading="@IsOperationLoading(ChatLoadingKeys.LoadWorkspaces)" />

	<!-- Chat Messages -->
	<SbCard>
		<ChildContent>
			<SbStack Direction="SbStackDirection.Column" Gap="3" style="min-height: 400px; max-height: 600px; overflow-y: auto;">
				@if (!_messages.Any())
				{
					<SbStack Direction="SbStackDirection.Column" Gap="2" Align="SbAlign.Center" style="padding: 4rem 0;">
						<SbIcon Name="message-circle" Size="SbSize.Xl" Color="SbColor.Muted" />
						<SbText Variant="SbTextVariant.Body" Color="SbColor.Muted">
							@L["NoMessagesYet"]
						</SbText>
						<SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">
							@L["SelectWorkspaceAndStartChatting"]
						</SbText>
					</SbStack>
				}
				else
				{
					@foreach (var message in _messages)
					{
						<SbStack Direction="SbStackDirection.Row" 
								 Justify="@(message.IsUser ? SbJustify.End : SbJustify.Start)">
							<SbCard Elevation="1" 
									style="@($"max-width: 70%; background-color: {(message.IsUser ? "var(--sb-color-primary-light)" : "var(--sb-color-surface)")}")">
								<ChildContent>
									<SbStack Direction="SbStackDirection.Column" Gap="1">
										<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
											@(message.IsUser ? L["You"] : L["Assistant"])
										</SbText>
										<SbText Variant="SbTextVariant.BodySmall">
											@message.Content
										</SbText>
										@if (message.Metadata != null)
										{
											<SbStack Direction="SbStackDirection.Row" Gap="2" style="margin-top: 0.5rem;">
												@if (message.Metadata.ContainsKey("tokens"))
												{
													<SbChip Size="SbSize.Sm">
														@L["Tokens"]: @message.Metadata["tokens"]
													</SbChip>
												}
												@if (message.Metadata.ContainsKey("latency"))
												{
													<SbChip Size="SbSize.Sm">
														@L["Latency"]: @message.Metadata["latency"]ms
													</SbChip>
												}
											</SbStack>
										}
									</SbStack>
								</ChildContent>
							</SbCard>
						</SbStack>
					}
				}
				
				@if (IsOperationLoading(ChatLoadingKeys.SendMessage))
				{
					<SbStack Direction="SbStackDirection.Row" Justify="SbJustify.Start">
						<SbCard Elevation="1">
							<ChildContent>
								<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
									<SbProgress Indeterminate="true" style="width: 100px;" />
									<SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">
										@L["Thinking"]...
									</SbText>
								</SbStack>
							</ChildContent>
						</SbCard>
					</SbStack>
				}
			</SbStack>
		</ChildContent>
	</SbCard>

	<!-- Message Input -->
	<SbCard>
		<ChildContent>
			<SbStack Direction="SbStackDirection.Column" Gap="3">
				<SbTextArea @bind-Value="_messageInput"
							Label="@L["Message"]"
							Rows="3"
							Placeholder="@L["TypeYourMessage"]"
							Disabled="string.IsNullOrWhiteSpace(_selectedWorkspaceName) || IsOperationLoading(ChatLoadingKeys.SendMessage)" />

				<SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
					<SbButton Color="SbColor.Primary" 
							  OnClick="@SendMessageAsync"
							  Loading="IsOperationLoading(ChatLoadingKeys.SendMessage)"
							  Disabled="string.IsNullOrWhiteSpace(_selectedWorkspaceName) || string.IsNullOrWhiteSpace(_messageInput)">
						<StartIcon><SbIcon Name="send" /></StartIcon>
						<ChildContent>@L["Send"]</ChildContent>
					</SbButton>
				</SbStack>
			</SbStack>
		</ChildContent>
	</SbCard>

</SbStack>
