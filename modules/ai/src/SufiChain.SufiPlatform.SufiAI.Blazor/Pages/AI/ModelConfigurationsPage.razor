@namespace SufiChain.SufiPlatform.SufiAI.Blazor.Pages.AI
@page "/panel/admin/ai/workspaces/{WorkspaceId:guid}/model-configurations"
@attribute [Authorize(Policy = AIPermissions.AI.ManageConfigurations)]
@inherits AIComponentBase

<SufiPageToolbar>
	<SbButton Variant="SbButtonVariant.Outline" OnClick="@BackToWorkspaces">
		<StartIcon><SbIcon Name="arrow-left" Mirror="true" /></StartIcon>
		<ChildContent>@L["BackToWorkspaces"]</ChildContent>
	</SbButton>
	<AuthorizeView Policy="@AIPermissions.AI.ManageConfigurations">
		<SbButton Color="SbColor.Primary" OnClick="@OpenCreateModal" Disabled="@(_workspace == null || _readOnly)">
			<StartIcon><SbIcon Name="plus" /></StartIcon>
			<ChildContent>@L["NewModelConfiguration"]</ChildContent>
		</SbButton>
	</AuthorizeView>
</SufiPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">
	@if (_workspace == null && !IsOperationLoading(LoadingKeys.LoadWorkspace))
	{
		<SbAlert Color="SbColor.Warning">@L["WorkspaceRequired"]</SbAlert>
	}
	else
	{
		@if (_workspace?.IsInherited == true)
		{
			<SbAlert Severity="SbAlertSeverity.Info">@L["InheritedWorkspaceReadOnly"]</SbAlert>
		}

		<SbAlert Severity="SbAlertSeverity.Info">
			@L["ModelConfigurationPricingHint"]
		</SbAlert>

		<SbCard>
			<ChildContent>
				<SbDataGrid TItem="AIModelConfigurationDto"
							Items="@_configurations"
							Loading="IsOperationLoading(LoadingKeys.LoadConfigurations)"
							Striped="true"
							Hoverable="true"
							KeySelector="@(item => item.Id.ToString())"
                        ShowFilterRow="true"
                        ShowColumnChooser="true"
                        SelectionMode="SbSelectionMode.MultipleRows">
					<ChildContent>
						<SbColumn TItem="AIModelConfigurationDto" Title="@L["Actions"]" Width="148px" Sortable="false">
							<CellTemplate Context="cellContext">
								<SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="1">
									@if (!_readOnly)
									{
										<AuthorizeView Policy="@AIPermissions.AI.ManageConfigurations">
											<SbTooltip Text="@L["Edit"]">
												<SbIconButton Size="SbSize.Sm"
															  AriaLabel="@L["Edit"]"
															  OnClick="@(() => OpenEditModal(cellContext.Item))">
													<Icon><SbIcon Name="edit" Size="SbSize.Sm" /></Icon>
												</SbIconButton>
											</SbTooltip>
										</AuthorizeView>
										@if (CanSetWorkspaceDefault(cellContext.Item))
										{
											<AuthorizeView Policy="@AIPermissions.AI.ManageConfigurations">
												<SbTooltip Text="@L["SetAsWorkspaceDefault"]">
													<SbIconButton Size="SbSize.Sm"
																  AriaLabel="@L["SetAsWorkspaceDefault"]"
																  Color="SbColor.Warning"
																  OnClick="@(() => SetWorkspaceDefaultAsync(cellContext.Item))">
														<Icon><SbIcon Name="star" Size="SbSize.Sm" /></Icon>
													</SbIconButton>
												</SbTooltip>
											</AuthorizeView>
										}
										@if (!IsWorkspaceDefault(cellContext.Item))
										{
											<AuthorizeView Policy="@AIPermissions.AI.ManageConfigurations">
												<SbTooltip Text="@L["Delete"]">
													<SbIconButton Size="SbSize.Sm"
																  AriaLabel="@L["Delete"]"
																  Color="SbColor.Danger"
																  OnClick="@(() => DeleteConfigurationAsync(cellContext.Item))">
														<Icon><SbIcon Name="trash" Size="SbSize.Sm" /></Icon>
													</SbIconButton>
												</SbTooltip>
											</AuthorizeView>
										}
									}
								</SbStack>
							</CellTemplate>
						</SbColumn>
						<SbColumn TItem="AIModelConfigurationDto" Field="CapabilityType" Title="@L["Capability"]" Width="150px" Filterable="true" Sortable="true">
							<CellTemplate Context="cellContext">
								<SbChip Color="@GetCapabilityColor(cellContext.Item.CapabilityType)" Size="SbSize.Sm">
									@FormatCapability(cellContext.Item.CapabilityType)
								</SbChip>
							</CellTemplate>
						</SbColumn>
						<SbColumn TItem="AIModelConfigurationDto" Field="ModelId" Title="@L["DisplayName"]" Width="220px" Filterable="true" Sortable="true"
								  ValueFunc="@(item => FormatModelLabel(item))">
							<CellTemplate Context="cellContext">
								<SbStack Direction="SbStackDirection.Column" Gap="0">
									<SbStack Direction="SbStackDirection.Row" Gap="1" Align="SbAlign.Center" Wrap="true">
										<SbText Variant="SbTextVariant.BodySmall" Weight="SbFontWeight.Medium">
											@FormatModelLabel(cellContext.Item)
										</SbText>
										@if (IsWorkspaceDefault(cellContext.Item))
										{
											<SbChip Color="SbColor.Warning" Size="SbSize.Sm">
												@L["WorkspaceDefault"]
											</SbChip>
										}
									</SbStack>
									@{
										var chatFlags = cellContext.Item.CapabilityType == AICapabilityType.ChatCompletion
											? FormatChatFlags(cellContext.Item)
											: string.Empty;
									}
									@if (!string.IsNullOrWhiteSpace(chatFlags))
									{
										<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
											@chatFlags
										</SbText>
									}
								</SbStack>
							</CellTemplate>
						</SbColumn>
						<SbColumn TItem="AIModelConfigurationDto" Field="ApiEndpoint" Title="@L["ApiEndpoint"]" Filterable="true" Sortable="true">
							<CellTemplate Context="cellContext">
								@if (!string.IsNullOrEmpty(cellContext.Item.ApiEndpoint))
								{
									<SbText Variant="SbTextVariant.BodySmall">
										@cellContext.Item.ApiEndpoint
									</SbText>
								}
								else
								{
									<SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Muted">
										@L["InheritWorkspace"]
									</SbText>
								}
							</CellTemplate>
						</SbColumn>
						<SbColumn TItem="AIModelConfigurationDto" Field="HasApiKey" Title="@L["ApiKey"]" Width="120px" Filterable="true" Sortable="true">
							<CellTemplate Context="cellContext">
								<SbChip Color="@(cellContext.Item.HasApiKey ? SbColor.Success : SbColor.Default)" Size="SbSize.Sm">
									@(cellContext.Item.HasApiKey ? L["Override"] : L["InheritWorkspace"])
								</SbChip>
							</CellTemplate>
						</SbColumn>
						<SbColumn TItem="AIModelConfigurationDto" Field="Priority" Title="@L["Priority"]" Width="90px" Filterable="true" Sortable="true">
							<CellTemplate Context="cellContext">
								<SbChip Size="SbSize.Sm">
									@cellContext.Item.Priority
								</SbChip>
							</CellTemplate>
						</SbColumn>
						<SbColumn TItem="AIModelConfigurationDto" Field="MaxContextTokens" Title="@L["MaxContextTokens"]" Width="120px" Filterable="true" Sortable="true">
							<CellTemplate Context="cellContext">
								<SbText Variant="SbTextVariant.BodySmall">
									@cellContext.Item.MaxContextTokens.ToString("N0")
								</SbText>
							</CellTemplate>
						</SbColumn>
						<SbColumn TItem="AIModelConfigurationDto" Title="@L["RouteInputPrice"]" Width="160px">
							<CellTemplate Context="cellContext">
								<SbText Variant="SbTextVariant.BodySmall" Color="@(cellContext.Item.InputPrice.HasValue ? SbColor.Default : SbColor.Muted)">
									@FormatRoutePrice(cellContext.Item.InputPrice, cellContext.Item.InputPriceUnit)
								</SbText>
							</CellTemplate>
						</SbColumn>
						<SbColumn TItem="AIModelConfigurationDto" Title="@L["RouteOutputPrice"]" Width="160px">
							<CellTemplate Context="cellContext">
								<SbText Variant="SbTextVariant.BodySmall" Color="@(cellContext.Item.OutputPrice.HasValue ? SbColor.Default : SbColor.Muted)">
									@FormatOutputPrice(cellContext.Item)
								</SbText>
							</CellTemplate>
						</SbColumn>
						<SbColumn TItem="AIModelConfigurationDto" Field="IsEnabled" Title="@L["Status"]" Width="100px" Filterable="true" Sortable="true">
							<CellTemplate Context="cellContext">
								<SbChip Color="@(cellContext.Item.IsEnabled ? SbColor.Success : SbColor.Default)"
										Size="SbSize.Sm">
									@(cellContext.Item.IsEnabled ? L["Enabled"] : L["Disabled"])
								</SbChip>
							</CellTemplate>
						</SbColumn>
						<SbColumn TItem="AIModelConfigurationDto" Field="IsUserSelectable" Title="@L["IsUserSelectable"]" Width="140px" Filterable="true" Sortable="true">
							<CellTemplate Context="cellContext">
								@if (cellContext.Item.CapabilityType == AICapabilityType.ChatCompletion)
								{
									<SbChip Color="@(cellContext.Item.IsUserSelectable ? SbColor.Primary : SbColor.Default)"
											Size="SbSize.Sm">
										@(cellContext.Item.IsUserSelectable ? L["Enabled"] : L["Disabled"])
									</SbChip>
								}
								else
								{
									<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
										@L["NotApplicable"]
									</SbText>
								}
							</CellTemplate>
						</SbColumn>
					</ChildContent>
				</SbDataGrid>

				@if (!_configurations.Any() && !IsOperationLoading(LoadingKeys.LoadConfigurations))
				{
					<SbEmptyState Title="@L["NoConfigurationsFound"]"
								  Description="@L["NoConfigurationsFoundDescription"]" />
				}
			</ChildContent>
		</SbCard>
	}
</SbStack>

<ModelConfigurationModal @bind-Open="_modelConfigurationModalOpen"
						 Configuration="_editingConfiguration"
						 WorkspaceId="WorkspaceId"
						 WorkspaceProvider="@(_workspace?.Provider ?? AIProviderType.OpenAI)"
						 OnSaved="@OnConfigurationSavedAsync" />
