@namespace SufiChain.SufiPlatform.SufiAI.Blazor.Pages.AI
@page "/panel/admin/ai/usage-analytics"
@attribute [Authorize(Policy = AIPermissions.AI.ViewUsage)]
@attribute [Authorize(Policy = AIPermissions.Workspaces.Default)]
@inherits AIComponentBase
@using SufiChain.SufiPlatform.SufiAI;
<SufiPageToolbar>
	<SbButton Color="SbColor.Secondary" Variant="SbButtonVariant.Outline" OnClick="@RefreshDataAsync">
		<StartIcon><SbIcon Name="refresh" /></StartIcon>
		<ChildContent>@L["Refresh"]</ChildContent>
	</SbButton>
</SufiPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">

	<!-- Workspace Selection -->
	<WorkspaceSelector Value="_selectedWorkspaceId"
					   ValueChanged="@OnWorkspaceChangedAsync"
					   Workspaces="_workspaces"
					   Loading="@IsOperationLoading(LoadingKeys.LoadWorkspaces)" />

	<!-- Date Range Selection -->
	<SbCard>
		<ChildContent>
			<SbStack Direction="SbStackDirection.Column" Gap="3">
				<SbDateRangePicker Value="@_dateRange"
									 ValueChanged="@OnDateRangeChangedAsync"
									 Label="@L["DateRange"]"
									 Placeholder="@L["SelectDateRange"]" />
			</SbStack>
		</ChildContent>
	</SbCard>

	@if (_selectedWorkspaceId.HasValue && _statistics != null)
	{
		@if (_guardrailStatus.Count > 0)
		{
			<SbCard>
				<ChildContent>
					<SbStack Direction="SbStackDirection.Column" Gap="3">
						<SbHeading Level="6">@L["Guardrails"]</SbHeading>
						<SbStack Direction="SbStackDirection.Row" Gap="4" Wrap="true">
							@foreach (var status in _guardrailStatus)
							{
								<SbCard style="flex: 1; min-width: 200px;" Outlined="true">
									<ChildContent>
										<SbStack Direction="SbStackDirection.Column" Gap="2">
											<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L[$"Guardrail:{status.Period}"]</SbText>
											<SbHeading Level="5">$@status.UsedUsd.ToString("F2") / $@status.LimitUsd.ToString("F2")</SbHeading>
											<SbProgress Value="@GetGuardrailPercent(status)" Color="@(status.IsExceeded ? SbColor.Danger : SbColor.Primary)" />
											<SbText Variant="SbTextVariant.Caption" Color="@(status.IsExceeded ? SbColor.Danger : SbColor.Muted)">
												@(status.IsExceeded ? L["GuardrailExceeded"] : L["GuardrailRemaining", status.RemainingUsd.ToString("F2")])
											</SbText>
										</SbStack>
									</ChildContent>
								</SbCard>
							}
						</SbStack>
					</SbStack>
				</ChildContent>
			</SbCard>
		}

		<!-- Statistics Cards -->
		<SbStack Direction="SbStackDirection.Row" Gap="4" Wrap="true">
			<SbCard style="flex: 1; min-width: 200px;">
				<ChildContent>
					<SbStack Direction="SbStackDirection.Column" Gap="2">
						<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["TotalCost"]</SbText>
						<SbHeading Level="4">$@_statistics.TotalCost.ToString("F2")</SbHeading>
						<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["UsageCostCaption"]</SbText>
						@if (_selectedWorkspaceId.HasValue)
						{
							<SbButton Variant="SbButtonVariant.Outline"
									  Size="SbSize.Sm"
									  Href="@GetModelConfigurationsUrl(_selectedWorkspaceId.Value)">
								@L["OpenModelConfigurations"]
							</SbButton>
						}
						<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["UsageCostCaption"]</SbText>
						@if (_selectedWorkspaceId.HasValue)
						{
							<SbButton Variant="SbButtonVariant.Outline"
									  Size="SbSize.Sm"
									  Href="@GetModelConfigurationsUrl(_selectedWorkspaceId.Value)">
								@L["OpenModelConfigurations"]
							</SbButton>
						}
					</SbStack>
				</ChildContent>
			</SbCard>

			<SbCard style="flex: 1; min-width: 200px;">
				<ChildContent>
					<SbStack Direction="SbStackDirection.Column" Gap="2">
							<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["TotalTokens"]</SbText>
							<SbHeading Level="4">@_statistics.KnownTotalTokens.ToString("N0")</SbHeading>
						</SbStack>
					</ChildContent>
				</SbCard>

			<SbCard style="flex: 1; min-width: 200px;">
				<ChildContent>
					<SbStack Direction="SbStackDirection.Column" Gap="2">
						<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["TotalRequests"]</SbText>
						<SbHeading Level="4">@_statistics.TotalRequests.ToString("N0")</SbHeading>
					</SbStack>
				</ChildContent>
			</SbCard>

				<SbCard style="flex: 1; min-width: 200px;">
					<ChildContent>
						<SbStack Direction="SbStackDirection.Column" Gap="2">
							<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["SuccessRate"]</SbText>
							<SbHeading Level="4">@GetSuccessRate()%</SbHeading>
						</SbStack>
					</ChildContent>
				</SbCard>

				<SbCard style="flex: 1; min-width: 200px;">
					<ChildContent>
						<SbStack Direction="SbStackDirection.Column" Gap="2">
							<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["UsageUnavailableRequests"]</SbText>
							<SbHeading Level="4">@_statistics.UsageUnavailableRequests.ToString("N0")</SbHeading>
						</SbStack>
					</ChildContent>
				</SbCard>
			</SbStack>

		<!-- Requests by Capability -->
		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="3">
					<SbHeading Level="6">@L["RequestsByCapability"]</SbHeading>
					<SbStack Direction="SbStackDirection.Column" Gap="2">
						@foreach (var kvp in _statistics.RequestsByCapability.OrderByDescending(x => x.Value))
						{
							<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
								<SbText Variant="SbTextVariant.BodySmall" style="min-width: 150px;">
									@FormatCapability(kvp.Key)
								</SbText>
								<SbProgress Value="@GetPercentage(kvp.Value, _statistics.TotalRequests)" style="flex: 1;" />
								<SbText Variant="SbTextVariant.BodySmall" Weight="SbFontWeight.Medium" style="min-width: 80px; text-align: right;">
									@kvp.Value.ToString("N0") (@GetPercentage(kvp.Value, _statistics.TotalRequests).ToString("F1")%)
								</SbText>
							</SbStack>
						}
					</SbStack>
				</SbStack>
			</ChildContent>
		</SbCard>

		<!-- Cost by Model -->
		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="3">
					<SbHeading Level="6">@L["CostByModel"]</SbHeading>
					<SbStack Direction="SbStackDirection.Column" Gap="2">
						@foreach (var kvp in _statistics.CostByModel.OrderByDescending(x => x.Value))
						{
							<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
								<SbText Variant="SbTextVariant.BodySmall" style="min-width: 200px;">
									@kvp.Key
								</SbText>
								<SbProgress Value="@GetPercentage((double)kvp.Value, (double)_statistics.TotalCost)" style="flex: 1;" />
								<SbText Variant="SbTextVariant.BodySmall" Weight="SbFontWeight.Medium" style="min-width: 100px; text-align: right;">
									$@kvp.Value.ToString("F2")
								</SbText>
							</SbStack>
						}
					</SbStack>
				</SbStack>
			</ChildContent>
		</SbCard>

		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="3">
					<SbStack Direction="SbStackDirection.Row" Gap="3" Align="SbAlign.Center" Justify="SbJustify.SpaceBetween" Wrap="true">
						<SbHeading Level="6">@L["CostByRoute"]</SbHeading>
						@if (_statistics.CostByRoute.Count > 0)
						{
							<SbSimpleSelect TValue="string"
											Value="@_routeFilter"
											ValueChanged="@OnRouteFilterChangedAsync"
											Label="@L["FilterByRoute"]"
											style="min-width: 240px;">
								<SbSelectOption TValue="string" Value="@AllRoutesFilter">@L["AllRoutes"]</SbSelectOption>
								<SbSelectOption TValue="string" Value="@UnattributedRouteFilter">@L["UnattributedRoute"]</SbSelectOption>
								@foreach (var route in _statistics.CostByRoute.Where(item => !item.IsUnattributed))
								{
									<SbSelectOption TValue="string" Value="@(route.ModelConfigurationId?.ToString() ?? string.Empty)">
										@FormatRouteLabel(route)
									</SbSelectOption>
								}
							</SbSimpleSelect>
						}
					</SbStack>
					@if (_statistics.CostByRoute.Count == 0)
					{
						<SbEmptyState Title="@L["CostByRouteEmpty"]"
									  Description="@L["CostByRouteEmptyDescription"]" />
					}
					else
					{
						<SbStack Direction="SbStackDirection.Column" Gap="2">
							@foreach (var route in FilteredCostByRoute)
							{
								<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
									<SbStack Direction="SbStackDirection.Column" Gap="0" style="min-width: 220px;">
										<SbText Variant="SbTextVariant.BodySmall">
											@FormatRouteLabel(route)
										</SbText>
										@if (!route.IsUnattributed)
										{
											<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
												@route.ModelId
											</SbText>
										}
									</SbStack>
									<SbProgress Value="@GetPercentage((double)route.Cost, (double)_statistics.TotalCost)" style="flex: 1;" />
									<SbStack Direction="SbStackDirection.Column" Gap="0" style="min-width: 140px; text-align: right;">
										<SbText Variant="SbTextVariant.BodySmall" Weight="SbFontWeight.Medium">
											$@route.Cost.ToString("F2")
										</SbText>
										<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
											@L["RouteRequestsAndTokens", route.Requests.ToString("N0"), route.Tokens.ToString("N0")]
										</SbText>
									</SbStack>
								</SbStack>
							}
						</SbStack>
					}
				</SbStack>
			</ChildContent>
		</SbCard>

		<!-- Recent Usage Logs -->
		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="3">
					<SbHeading Level="6">@L["RecentUsageLogs"]</SbHeading>
					<SbDataGrid TItem="AIUsageLogDto"
								Items="@VisibleUsageLogs"
								Loading="IsOperationLoading(LoadingKeys.LoadUsageLogs)"
								Striped="true"
								Hoverable="true"
								KeySelector="@(item => item.Id.ToString())"
                        ShowFilterRow="true"
                        ShowColumnChooser="true"
                        SelectionMode="SbSelectionMode.MultipleRows">
						<ChildContent>
							<SbColumn TItem="AIUsageLogDto" Field="CreationTime" Title="@L["Time"]" Width="160px" Filterable="true" Sortable="true">
								<CellTemplate Context="cellContext">
									<SbText Variant="SbTextVariant.BodySmall">
										@cellContext.Item.CreationTime.ToString("yyyy-MM-dd HH:mm:ss")
									</SbText>
								</CellTemplate>
							</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Field="CapabilityType" Title="@L["Capability"]" Width="150px" Filterable="true" Sortable="true">
								<CellTemplate Context="cellContext">
									<SbChip Size="SbSize.Sm">@FormatCapability(cellContext.Item.CapabilityType)</SbChip>
								</CellTemplate>
							</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Field="ModelId" Title="@L["Model"]" Width="220px" Filterable="true" Sortable="true">
								<CellTemplate Context="cellContext">
									<SbStack Direction="SbStackDirection.Column" Gap="1">
										<SbText Variant="SbTextVariant.BodySmall">
											@FormatLogRouteName(cellContext.Item)
										</SbText>
										<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
											@cellContext.Item.ModelId
										</SbText>
									</SbStack>
								</CellTemplate>
							</SbColumn>
								<SbColumn TItem="AIUsageLogDto" Field="TotalTokens" Title="@L["Tokens"]" Width="100px" Filterable="true" Sortable="true">
									<CellTemplate Context="cellContext">
										@if (cellContext.Item.HasTokenUsage)
										{
											<SbText Variant="SbTextVariant.BodySmall">@((cellContext.Item.TotalTokens ?? 0).ToString("N0"))</SbText>
										}
										else
										{
											<SbChip Color="SbColor.Warning" Size="SbSize.Sm">@L["UsageUnavailable"]</SbChip>
										}
									</CellTemplate>
								</SbColumn>
								<SbColumn TItem="AIUsageLogDto" Field="EstimatedCost" Title="@L["Cost"]" Width="100px" Filterable="true" Sortable="true">
									<CellTemplate Context="cellContext">
										<SbStack Direction="SbStackDirection.Column" Gap="1">
											<SbText Variant="SbTextVariant.BodySmall">$@cellContext.Item.EstimatedCost.ToString("F4")</SbText>
											@if (cellContext.Item.CostCalculationNote == "PricingNotConfigured")
											{
												<SbChip Color="SbColor.Default" Size="SbSize.Sm">@L["PricingNotConfigured"]</SbChip>
											}
											else if (cellContext.Item.CostCalculationNote == "UsageUnavailable")
											{
												<SbChip Color="SbColor.Warning" Size="SbSize.Sm">@L["UsageUnavailable"]</SbChip>
											}
										</SbStack>
									</CellTemplate>
								</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Field="LatencyMs" Title="@L["Latency"]" Width="100px" Filterable="true" Sortable="true">
								<CellTemplate Context="cellContext">
									<SbText Variant="SbTextVariant.BodySmall">@cellContext.Item.LatencyMs ms</SbText>
								</CellTemplate>
							</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Field="IsSuccess" Title="@L["Status"]" Width="100px" Filterable="true" Sortable="true">
								<CellTemplate Context="cellContext">
									<SbChip Color="@(cellContext.Item.IsSuccess ? SbColor.Success : SbColor.Danger)" Size="SbSize.Sm">
										@(cellContext.Item.IsSuccess ? L["Success"] : L["Failed"])
									</SbChip>
								</CellTemplate>
							</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Field="ErrorMessage" Title="@L["Error"]" Filterable="true" Sortable="true">
								<CellTemplate Context="cellContext">
									@if (!string.IsNullOrEmpty(cellContext.Item.ErrorMessage))
									{
										<SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Danger">
											@FormatUsageError(cellContext.Item.ErrorMessage)
										</SbText>
									}
								</CellTemplate>
							</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Title="@L["File"]" Width="140px" Sortable="false">
								<CellTemplate Context="cellContext">
									@if (!string.IsNullOrWhiteSpace(cellContext.Item.FileUrl))
									{
										<SbButton Variant="SbButtonVariant.Ghost"
												  Size="SbSize.Sm"
												  Href="@cellContext.Item.FileUrl"
												  Target="_blank">
											@L["OpenFile"]
										</SbButton>
									}
									else if (cellContext.Item.FileId.HasValue)
									{
										<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">
											@cellContext.Item.FileId.Value.ToString("N")[..8]
										</SbText>
									}
								</CellTemplate>
							</SbColumn>
						</ChildContent>
					</SbDataGrid>
				</SbStack>
			</ChildContent>
		</SbCard>
	}
	else if (_selectedWorkspaceId.HasValue)
	{
		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="2" Align="SbAlign.Center" style="padding: 4rem 0;">
					<SbProgress Indeterminate="true" style="width: 200px;" />
					<SbText Variant="SbTextVariant.Body" Color="SbColor.Muted">
						@L["LoadingUsageData"]
					</SbText>
				</SbStack>
			</ChildContent>
		</SbCard>
	}
	else
	{
		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="2" Align="SbAlign.Center" style="padding: 4rem 0;">
					<SbIcon Name="bar-chart" Size="SbSize.Xl" Color="SbColor.Muted" />
					<SbText Variant="SbTextVariant.Body" Color="SbColor.Muted">
						@L["SelectWorkspaceToViewAnalytics"]
					</SbText>
				</SbStack>
			</ChildContent>
		</SbCard>
	}

</SbStack>
