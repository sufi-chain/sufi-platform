@namespace SufiChain.SufiPlatform.SufiAI.Blazor.Pages.AI
@page "/panel/admin/ai/usage-analytics"
@attribute [Authorize(Policy = AIPermissions.AI.ViewUsage)]
@attribute [Authorize(Policy = AIPermissions.Workspaces.Default)]
@inherits AIComponentBase
@using SufiChain.SufiPlatform.SufiAI;
<SufiPageToolbar>
	<SbButton Color="SbColor.Secondary" Variant="SbButtonVariant.Outline" OnClick="@RefreshDataAsync">
		<StartIcon><SbIcon Name="refresh" /></StartIcon>
		<ChildContent>@L["Refresh"]</ChildContent>
	</SbButton>
</SufiPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">

	<!-- Workspace Selection -->
	<WorkspaceSelector Value="_selectedWorkspaceId"
					   ValueChanged="@OnWorkspaceChangedAsync"
					   Workspaces="_workspaces"
					   Loading="@IsOperationLoading(LoadingKeys.LoadWorkspaces)" />

	<!-- Date Range Selection -->
	<SbCard>
		<ChildContent>
			<SbStack Direction="SbStackDirection.Column" Gap="3">
				<SbDateRangePicker Value="@_dateRange"
									 ValueChanged="@OnDateRangeChangedAsync"
									 Label="@L["DateRange"]"
									 Placeholder="@L["SelectDateRange"]" />
			</SbStack>
		</ChildContent>
	</SbCard>

	@if (_selectedWorkspaceId.HasValue && _statistics != null)
	{
		<!-- Statistics Cards -->
		<SbStack Direction="SbStackDirection.Row" Gap="4" Wrap="true">
			<SbCard style="flex: 1; min-width: 200px;">
				<ChildContent>
					<SbStack Direction="SbStackDirection.Column" Gap="2">
						<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["TotalCost"]</SbText>
						<SbHeading Level="4">$@_statistics.TotalCost.ToString("F2")</SbHeading>
					</SbStack>
				</ChildContent>
			</SbCard>

			<SbCard style="flex: 1; min-width: 200px;">
				<ChildContent>
					<SbStack Direction="SbStackDirection.Column" Gap="2">
							<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["TotalTokens"]</SbText>
							<SbHeading Level="4">@_statistics.KnownTotalTokens.ToString("N0")</SbHeading>
						</SbStack>
					</ChildContent>
				</SbCard>

			<SbCard style="flex: 1; min-width: 200px;">
				<ChildContent>
					<SbStack Direction="SbStackDirection.Column" Gap="2">
						<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["TotalRequests"]</SbText>
						<SbHeading Level="4">@_statistics.TotalRequests.ToString("N0")</SbHeading>
					</SbStack>
				</ChildContent>
			</SbCard>

				<SbCard style="flex: 1; min-width: 200px;">
					<ChildContent>
						<SbStack Direction="SbStackDirection.Column" Gap="2">
							<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["SuccessRate"]</SbText>
							<SbHeading Level="4">@GetSuccessRate()%</SbHeading>
						</SbStack>
					</ChildContent>
				</SbCard>

				<SbCard style="flex: 1; min-width: 200px;">
					<ChildContent>
						<SbStack Direction="SbStackDirection.Column" Gap="2">
							<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["UsageUnavailableRequests"]</SbText>
							<SbHeading Level="4">@_statistics.UsageUnavailableRequests.ToString("N0")</SbHeading>
						</SbStack>
					</ChildContent>
				</SbCard>
			</SbStack>

		<!-- Requests by Capability -->
		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="3">
					<SbHeading Level="6">@L["RequestsByCapability"]</SbHeading>
					<SbStack Direction="SbStackDirection.Column" Gap="2">
						@foreach (var kvp in _statistics.RequestsByCapability.OrderByDescending(x => x.Value))
						{
							<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
								<SbText Variant="SbTextVariant.BodySmall" style="min-width: 150px;">
									@kvp.Key.ToString()
								</SbText>
								<SbProgress Value="@GetPercentage(kvp.Value, _statistics.TotalRequests)" style="flex: 1;" />
								<SbText Variant="SbTextVariant.BodySmall" Weight="SbFontWeight.Medium" style="min-width: 80px; text-align: right;">
									@kvp.Value.ToString("N0") (@GetPercentage(kvp.Value, _statistics.TotalRequests).ToString("F1")%)
								</SbText>
							</SbStack>
						}
					</SbStack>
				</SbStack>
			</ChildContent>
		</SbCard>

		<!-- Cost by Model -->
		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="3">
					<SbHeading Level="6">@L["CostByModel"]</SbHeading>
					<SbStack Direction="SbStackDirection.Column" Gap="2">
						@foreach (var kvp in _statistics.CostByModel.OrderByDescending(x => x.Value))
						{
							<SbStack Direction="SbStackDirection.Row" Gap="2" Align="SbAlign.Center">
								<SbText Variant="SbTextVariant.BodySmall" style="min-width: 200px;">
									@kvp.Key
								</SbText>
								<SbProgress Value="@GetPercentage((double)kvp.Value, (double)_statistics.TotalCost)" style="flex: 1;" />
								<SbText Variant="SbTextVariant.BodySmall" Weight="SbFontWeight.Medium" style="min-width: 100px; text-align: right;">
									$@kvp.Value.ToString("F2")
								</SbText>
							</SbStack>
						}
					</SbStack>
				</SbStack>
			</ChildContent>
		</SbCard>

		<!-- Recent Usage Logs -->
		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="3">
					<SbHeading Level="6">@L["RecentUsageLogs"]</SbHeading>
					<SbDataGrid TItem="AIUsageLogDto"
								Items="@_usageLogs"
								Loading="IsOperationLoading(LoadingKeys.LoadUsageLogs)"
								Striped="true"
								Hoverable="true"
								KeySelector="@(item => item.Id.ToString())">
						<ChildContent>
							<SbColumn TItem="AIUsageLogDto" Field="CreationTime" Title="@L["Time"]" Width="160px">
								<CellTemplate Context="cellContext">
									<SbText Variant="SbTextVariant.BodySmall">
										@cellContext.Item.CreationTime.ToString("yyyy-MM-dd HH:mm:ss")
									</SbText>
								</CellTemplate>
							</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Field="CapabilityType" Title="@L["Capability"]" Width="150px">
								<CellTemplate Context="cellContext">
									<SbChip Size="SbSize.Sm">@cellContext.Item.CapabilityType.ToString()</SbChip>
								</CellTemplate>
							</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Field="ModelId" Title="@L["Model"]" Width="180px">
								<CellTemplate Context="cellContext">
									<SbText Variant="SbTextVariant.BodySmall">@cellContext.Item.ModelId</SbText>
								</CellTemplate>
							</SbColumn>
								<SbColumn TItem="AIUsageLogDto" Field="TotalTokens" Title="@L["Tokens"]" Width="100px">
									<CellTemplate Context="cellContext">
										@if (cellContext.Item.HasTokenUsage)
										{
											<SbText Variant="SbTextVariant.BodySmall">@((cellContext.Item.TotalTokens ?? 0).ToString("N0"))</SbText>
										}
										else
										{
											<SbChip Color="SbColor.Warning" Size="SbSize.Sm">@L["UsageUnavailable"]</SbChip>
										}
									</CellTemplate>
								</SbColumn>
								<SbColumn TItem="AIUsageLogDto" Field="EstimatedCost" Title="@L["Cost"]" Width="100px">
									<CellTemplate Context="cellContext">
										<SbStack Direction="SbStackDirection.Column" Gap="1">
											<SbText Variant="SbTextVariant.BodySmall">$@cellContext.Item.EstimatedCost.ToString("F4")</SbText>
											@if (cellContext.Item.CostCalculationNote == "PricingNotConfigured")
											{
												<SbChip Color="SbColor.Default" Size="SbSize.Sm">@L["PricingNotConfigured"]</SbChip>
											}
											else if (cellContext.Item.CostCalculationNote == "UsageUnavailable")
											{
												<SbChip Color="SbColor.Warning" Size="SbSize.Sm">@L["UsageUnavailable"]</SbChip>
											}
										</SbStack>
									</CellTemplate>
								</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Field="LatencyMs" Title="@L["Latency"]" Width="100px">
								<CellTemplate Context="cellContext">
									<SbText Variant="SbTextVariant.BodySmall">@cellContext.Item.LatencyMs ms</SbText>
								</CellTemplate>
							</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Field="IsSuccess" Title="@L["Status"]" Width="100px">
								<CellTemplate Context="cellContext">
									<SbChip Color="@(cellContext.Item.IsSuccess ? SbColor.Success : SbColor.Danger)" Size="SbSize.Sm">
										@(cellContext.Item.IsSuccess ? L["Success"] : L["Failed"])
									</SbChip>
								</CellTemplate>
							</SbColumn>
							<SbColumn TItem="AIUsageLogDto" Field="ErrorMessage" Title="@L["Error"]">
								<CellTemplate Context="cellContext">
									@if (!string.IsNullOrEmpty(cellContext.Item.ErrorMessage))
									{
										<SbText Variant="SbTextVariant.BodySmall" Color="SbColor.Danger">
											@cellContext.Item.ErrorMessage
										</SbText>
									}
								</CellTemplate>
							</SbColumn>
						</ChildContent>
					</SbDataGrid>
				</SbStack>
			</ChildContent>
		</SbCard>
	}
	else if (_selectedWorkspaceId.HasValue)
	{
		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="2" Align="SbAlign.Center" style="padding: 4rem 0;">
					<SbProgress Indeterminate="true" style="width: 200px;" />
					<SbText Variant="SbTextVariant.Body" Color="SbColor.Muted">
						@L["LoadingUsageData"]
					</SbText>
				</SbStack>
			</ChildContent>
		</SbCard>
	}
	else
	{
		<SbCard>
			<ChildContent>
				<SbStack Direction="SbStackDirection.Column" Gap="2" Align="SbAlign.Center" style="padding: 4rem 0;">
					<SbIcon Name="bar-chart" Size="SbSize.Xl" Color="SbColor.Muted" />
					<SbText Variant="SbTextVariant.Body" Color="SbColor.Muted">
						@L["SelectWorkspaceToViewAnalytics"]
					</SbText>
				</SbStack>
			</ChildContent>
		</SbCard>
	}

</SbStack>
