@namespace SufiChain.SufiPlatform.SufiAI.Blazor.Pages.AI
@page "/panel/admin/ai/workspaces"
@attribute [Authorize(Policy = AIPermissions.Workspaces.Default)]
@inherits AIComponentBase

<SufiPageToolbar>
	<AuthorizeView Policy="@AIPermissions.Workspaces.Create">
		<SbButton Color="SbColor.Primary" OnClick="@OpenCreatePage">
			<StartIcon><SbIcon Name="plus" /></StartIcon>
			<ChildContent>@L["NewWorkspace"]</ChildContent>
		</SbButton>
	</AuthorizeView>
</SufiPageToolbar>

<SbStack Direction="SbStackDirection.Column" Gap="4">

	<!-- Workspaces Grid -->
	<SbCard>
		<ChildContent>
			<SbDataGrid TItem="WorkspaceDto"
						@ref="_gridRef"
						ItemsProvider="LoadWorkspacesDataAsync"
						Loading="IsOperationLoading(LoadingKeys.LoadWorkspaces)"
						Striped="true"
						Hoverable="true"
						PageIndex="_pageIndex"
						PageSize="_pageSize"
						TotalCount="_totalCount"
						PageIndexChanged="OnPageIndexChangedAsync"
						PageSizeChanged="OnPageSizeChangedAsync"
						KeySelector="@(item => item.Id.ToString())"
                        ShowFilterRow="true"
                        ShowColumnChooser="true"
                        SelectionMode="SbSelectionMode.MultipleRows">
						<SbColumn TItem="WorkspaceDto" Title="@L["Actions"]" MinWidth="220px">
						<CellTemplate Context="cellContext">
							<SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="1">
								<AuthorizeView Policy="@AIPermissions.Workspaces.Edit">
									<SbIconButton Size="SbSize.Sm"
												  AriaLabel="@(cellContext.Item.IsInherited ? L["View"] : L["Edit"])"
												  OnClick="@(() => OpenEditPage(cellContext.Item))">
										<Icon><SbIcon Name="@(cellContext.Item.IsInherited ? "eye" : "edit")" /></Icon>
									</SbIconButton>
								</AuthorizeView>
								<AuthorizeView Policy="@AIPermissions.Workspaces.Create">
									<SbIconButton Size="SbSize.Sm"
												  AriaLabel="@L["Clone"]"
												  OnClick="@(() => OpenCloneModal(cellContext.Item))">
										<Icon><SbIcon Name="copy" /></Icon>
									</SbIconButton>
								</AuthorizeView>
								@if (IsHost && !cellContext.Item.IsInherited)
								{
									<AuthorizeView Policy="@AIPermissions.Workspaces.Create">
										<SbIconButton Size="SbSize.Sm"
													  AriaLabel="@L["AssignToTenant"]"
													  OnClick="@(() => OpenAssignModal(cellContext.Item))">
											<Icon><SbIcon Name="share" /></Icon>
										</SbIconButton>
									</AuthorizeView>
								}
								@if (cellContext.Item.IsInherited)
								{
									<AuthorizeView Policy="@AIPermissions.Workspaces.Edit">
										<SbIconButton Size="SbSize.Sm"
													  AriaLabel="@L["ConvertToCustom"]"
													  OnClick="@(() => ConvertToCustomAsync(cellContext.Item))">
											<Icon><SbIcon Name="unlock" /></Icon>
										</SbIconButton>
									</AuthorizeView>
								}
									<AuthorizeView Policy="@AIPermissions.AI.ManageConfigurations">
										<SbIconButton Size="SbSize.Sm" AriaLabel="@L["ModelConfigurations"]"
													  OnClick="@(() => OpenModelConfigurations(cellContext.Item))">
											<Icon><SbIcon Name="settings" /></Icon>
										</SbIconButton>
									</AuthorizeView>
										@if (!cellContext.Item.IsInherited)
										{
										<AuthorizeView Policy="@AIPermissions.Workspaces.Delete">
										<SbIconButton Size="SbSize.Sm" AriaLabel="@L["Delete"]"
												  Color="SbColor.Danger"
												  OnClick="@(() => DeleteWorkspaceAsync(cellContext.Item))">
										<Icon><SbIcon Name="trash" /></Icon>
									</SbIconButton>
								</AuthorizeView>
								}
							</SbStack>
						</CellTemplate>
					</SbColumn>
				<SbColumn TItem="WorkspaceDto" Field="Name" Title="@L["Name"]" MinWidth="200px" Filterable="true" Sortable="true">
					<CellTemplate Context="cellContext">
						<strong>@cellContext.Item.Name</strong>
						@if (cellContext.Item.IsInherited)
						{
							<SbBadge Color="SbColor.Info">@L["InheritedReadOnly"]</SbBadge>
						}
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="WorkspaceDto" Title="@L["Guardrails"]" MinWidth="220px">
					<CellTemplate Context="cellContext">
						@if (cellContext.Item.Guardrails.Count == 0)
						{
							<SbText Variant="SbTextVariant.Caption" Color="SbColor.Muted">@L["NoGuardrails"]</SbText>
						}
						else
						{
							@string.Join(" / ", cellContext.Item.Guardrails.OrderBy(x => x.Period).Select(x => $"{L[$"Guardrail:{x.Period}"]} ${x.AmountUsd:0.##}"))
						}
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="WorkspaceDto" Title="@L["Provider"]" MinWidth="120px">
					<CellTemplate Context="cellContext">
						<SbBadge Color="@GetProviderColor(cellContext.Item.Provider)">
							@L[$"AIProviderType:{cellContext.Item.Provider}"]
						</SbBadge>
					</CellTemplate>
				</SbColumn>
					<SbColumn TItem="WorkspaceDto" Field="Model" Title="@L["DefaultChatModel"]" MinWidth="220px" Filterable="true" Sortable="true"
							  ValueFunc="@(item => FormatModelLabel(item))">
						<CellTemplate Context="cellContext">
							@FormatModelLabel(cellContext.Item)
						</CellTemplate>
					</SbColumn>
						<SbColumn TItem="WorkspaceDto" Title="@L["Status"]" MinWidth="100px">
					<CellTemplate Context="cellContext">
						<SbBadge Color="@(cellContext.Item.IsActive ? SbColor.Success : SbColor.Default)">
							@(cellContext.Item.IsActive ? L["Active"] : L["Inactive"])
						</SbBadge>
					</CellTemplate>
				</SbColumn>
				<SbColumn TItem="WorkspaceDto" Title="@L["CreationTime"]" MinWidth="160px">
					<CellTemplate Context="cellContext">
						@cellContext.Item.CreationTime.ToString("yyyy-MM-dd HH:mm")
					</CellTemplate>
				</SbColumn>
			</SbDataGrid>
		</ChildContent>
	</SbCard>

</SbStack>

	<WorkspaceCloneModal @bind-Open="_showCloneModal"
						 WorkspaceId="_cloneWorkspaceId"
						 SourceName="@_cloneSourceName"
						 OnCloned="@OnWorkspaceClonedAsync" />
	<WorkspaceAssignToTenantModal @bind-Open="_showAssignModal"
								  WorkspaceId="_assignWorkspaceId"
								  SourceName="@_assignSourceName"
								  OnAssigned="@OnWorkspaceAssignedAsync" />
	<ReadOnlyHooshvareDrawer HooshvareKey="@WorkspaceReadinessHooshvareKeys.Key"
							 Title="@L["Hooshvare:SufiAI:WorkspaceReadiness:DisplayName"]"
							 ContextProvider="BuildHooshvareContext" />
