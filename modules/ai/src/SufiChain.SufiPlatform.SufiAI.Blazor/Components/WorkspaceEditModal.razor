@namespace SufiChain.SufiPlatform.SufiAI.Blazor.Components
@inherits AIComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Lg" Title="@DialogTitle" AllowDropdownOverflow="true">
	<ChildContent>
		@if (_workspace != null)
		{
			<SbTabs @bind-ActiveIndex="_activeTab">
				<SbTab Label="@L["ConnectionSettings"]">
					<SbStack Direction="SbStackDirection.Column" Gap="4">
						@if (IsReadOnly)
						{
							<SbAlert Severity="SbAlertSeverity.Info">
								@L["InheritedWorkspaceReadOnly"]
							</SbAlert>
						}
						<WorkspaceConnectionFields Draft="_draft"
												   Profiles="_profiles"
												   AvailableModels="_availableModels"
												   DecisionModels="_decisionModels"
												   ModelsLoaded="_modelsLoaded"
												   ReadOnly="IsReadOnly"
												   ShowSavedKeyHint="true"
												   LoadingModels="IsOperationLoading(LoadingKeys.LoadModels)"
												   LoadModels="LoadModelsAsync"
												   ProviderReset="OnProviderReset" />
					</SbStack>
				</SbTab>

				<SbTab Label="@L["Guardrails"]">
					<WorkspaceGuardrailForm Rows="_guardrailRows" Status="_guardrailStatus" Disabled="@IsReadOnly" />
				</SbTab>
			</SbTabs>
		}
		else if (IsOperationLoading(LoadingKeys.LoadWorkspace))
		{
			<SbStack Direction="SbStackDirection.Column" Gap="2" Align="SbAlign.Center">
				<SbProgress Indeterminate="true" />
				<SbText>@L["Loading"]...</SbText>
			</SbStack>
		}
	</ChildContent>
	<Footer>
		<SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
			<SbButton Variant="SbButtonVariant.Outline" OnClick="@CloseModal">
				@L["Cancel"]
			</SbButton>
			@if (IsReadOnly)
			{
				<AuthorizeView Policy="@AIPermissions.Workspaces.Edit">
					<SbButton Color="SbColor.Primary"
							  OnClick="@ConvertToCustomAsync"
							  Loading="IsOperationLoading(LoadingKeys.ConvertWorkspace)">
						@L["ConvertToCustom"]
					</SbButton>
				</AuthorizeView>
			}
			else
			{
				<SbButton Variant="SbButtonVariant.Outline"
						  OnClick="@TestConnectionAsync"
						  Loading="IsOperationLoading(LoadingKeys.TestConnection)"
						  Disabled="_workspace == null">
					@L["TestConnection"]
				</SbButton>
				<SbButton Color="SbColor.Primary"
						  OnClick="@UpdateWorkspaceAsync"
						  Loading="IsOperationLoading(LoadingKeys.UpdateWorkspace)"
						  Disabled="_workspace == null">
					@L["Save"]
				</SbButton>
			}
		</SbStack>
	</Footer>
</SbDialog>
