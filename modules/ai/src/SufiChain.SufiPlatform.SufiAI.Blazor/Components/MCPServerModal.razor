@namespace SufiChain.SufiPlatform.SufiAI.Blazor.Components
@using SufiChain.SufiBlazor.Contracts.Editors
@inherits AIComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Md" Title="@(Server == null ? L["NewMCPServer"] : L["EditMCPServer"])" AllowDropdownOverflow="true">
    <ChildContent>
        <SbForm>
            <SbStack Direction="SbStackDirection.Column" Gap="3">
                
                <SbFormField Label="@L["Name"]" Required="true">
                    <SbTextField @bind-Value="_name" 
                                 Placeholder="@L["EnterServerName"]"
                                 FullWidth="true" />
                </SbFormField>

                <SbFormField Label="@L["ServerKey"]" Required="true">
                    <SbTextField @bind-Value="_key"
                                 Placeholder="@L["EnterServerKey"]"
                                 FullWidth="true"
                                 Disabled="@(Server != null)" />
                </SbFormField>
                
                <SbFormField Label="@L["TransportType"]" Required="true">
                    <SbSimpleSelect TValue="string"
                              Value="_transportType"
                              ValueChanged="@OnTransportTypeChanged"
                              Disabled="@(Server != null)">
						<SbSelectOption TValue="string" Value="@("STDIO")">@L["MCPTransport:STDIO"]</SbSelectOption>
						<SbSelectOption TValue="string" Value="@("SSE")">@L["MCPTransport:SSE"]</SbSelectOption>
						<SbSelectOption TValue="string" Value="@("HTTP")">@L["MCPTransport:HTTP"]</SbSelectOption>
                    </SbSimpleSelect>
                </SbFormField>
                
                @if (_transportType == "STDIO")
                {
                    <SbFormField Label="@L["Command"]" Required="true">
                        <SbTextField @bind-Value="_command" 
                                     Placeholder="npx"
                                     FullWidth="true" />
                    </SbFormField>
                    
                    <SbFormField Label="@L["Arguments"]">
                        <SbCodeEditor @bind-Value="_argumentsJson"
                                      Language="SbCodeLanguage.Json"
                                      Placeholder='["modelcontextprotocol/server-filesystem", "/path"]'
                                      MinHeight="120px"
                                      WordWrap="true" />
                    </SbFormField>
                }
                else
                {
                    <SbFormField Label="@L["Endpoint"]" Required="true">
                        <SbTextField @bind-Value="_endpoint" 
                                     Type="url"
                                     Placeholder="https://mcp-server.example.com"
                                     FullWidth="true" />
                    </SbFormField>
                }
                
            </SbStack>
        </SbForm>
    </ChildContent>
    <Footer>
        <SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton OnClick="@CancelAsync">@L["Cancel"]</SbButton>
            <SbButton Color="SbColor.Primary"
                      OnClick="@SaveAsync"
                      Loading="IsOperationLoading(LoadingKeys.Save)">
                @L["Save"]
            </SbButton>
        </SbStack>
    </Footer>
</SbDialog>
