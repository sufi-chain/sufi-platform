@namespace SufiChain.SufiPlatform.Menus.Blazor.Pages
@page "/panel/admin/menu-management/menus/{MenuId:guid}/items/new"
@page "/panel/admin/menu-management/menus/{MenuId:guid}/items/{ItemId:guid}"
@attribute [Authorize(Policy = MenusPermissions.Menus.ManageItems)]
@inherits MenusComponentBase

@if (_ready)
{
    <SbForm Model="_model" OnValidSubmit="OnValidSubmitAsync" Class="menu-item-editor" novalidate>
        <ChildContent>
            <SbCard>
                <ChildContent>
            <SbStack Gap="5">
                @if (_errorFields.Count > 0)
                {
                    <div class="menu-item-editor__summary" role="alert">
                        <p>@L["MenuLink:ErrorSummary", _errorFields.Count]</p>
                        <ul>
                            @foreach (var field in _errorFields)
                            {
                                <li>@field.Label</li>
                            }
                        </ul>
                    </div>
                }
                <SbStack Gap="3">
                    <SbHeading Level="2" Size="5">@L["DisplayName"]</SbHeading>
                    @if (!string.IsNullOrWhiteSpace(_saveError))
                    {
                        <SbText Color="SbColor.Danger">@_saveError</SbText>
                    }
                    <MultilingualTextField @ref="_labels"
                                           Label="@L["DisplayName"]"
                                           HelpText="@L["MenuLabel:Help"]"
                                           Values="_displayNames"
                                           ValuesChanged="OnDisplayNamesChanged"
                                           BaseValues="_displayNameBases"
                                           Cultures="_labelCultures"
                                           CulturesFailed="_culturesFailed"
                                           Required="true"
                                           MaxLength="256"
                                           FallbackText="@_model.Name"
                                           SameForAll="_sameForAll"
                                           ShowBrokenBanner="_labelBroken" />
                </SbStack>

                <SbStack Gap="3">
                    <SbHeading Level="2" Size="5">@L["MenuItemSection:Link"]</SbHeading>
                    @if (string.IsNullOrEmpty(_structuralKindText))
                    {
                        <SbSimpleSelect TValue="MenuLinkChoice"
                                        Value="_linkChoice"
                                        ValueChanged="OnLinkChoiceChanged"
                                        ValueExpression="@(() => _linkChoice)"
                                        Label="@L["MenuLink:Choose"]">
                            <SbSelectOption TValue="MenuLinkChoice" Value="@MenuLinkChoice.SitePage">@L["MenuLink:SitePage"]</SbSelectOption>
                            <SbSelectOption TValue="MenuLinkChoice" Value="@MenuLinkChoice.PageSection">@L["MenuLink:PageSection"]</SbSelectOption>
                            <SbSelectOption TValue="MenuLinkChoice" Value="@MenuLinkChoice.Website">@L["MenuLink:Website"]</SbSelectOption>
                            <SbSelectOption TValue="MenuLinkChoice" Value="@MenuLinkChoice.Email">@L["MenuLink:Email"]</SbSelectOption>
                            <SbSelectOption TValue="MenuLinkChoice" Value="@MenuLinkChoice.Phone">@L["MenuLink:Phone"]</SbSelectOption>
                            <SbSelectOption TValue="MenuLinkChoice" Value="@MenuLinkChoice.NoLink">@L["MenuLink:NoLink"]</SbSelectOption>
                        </SbSimpleSelect>

                        @if (_linkChoice == MenuLinkChoice.SitePage)
                        {
                            <SbTextField @bind-Value="_pagePath" Id="menu-item-page-path" Label="@L["MenuLink:PagePath"]" dir="ltr" AriaDescribedBy="@DescribedBy("menu-item-page-path", _linkErrorFieldId == "menu-item-page-path" ? _linkError : null)" />
                        }
                        else if (_linkChoice == MenuLinkChoice.PageSection)
                        {
                            <SbSimpleSelect TValue="MenuSectionPage"
                                            @bind-Value="_sectionPage"
                                            Label="@L["MenuLink:SectionPage"]">
                                <SbSelectOption TValue="MenuSectionPage" Value="@MenuSectionPage.CurrentPage">@L["MenuLink:CurrentPage"]</SbSelectOption>
                                <SbSelectOption TValue="MenuSectionPage" Value="@MenuSectionPage.HomePage">@L["MenuLink:HomePage"]</SbSelectOption>
                                <SbSelectOption TValue="MenuSectionPage" Value="@MenuSectionPage.OtherPage">@L["MenuLink:OtherPage"]</SbSelectOption>
                            </SbSimpleSelect>
                            @if (_sectionPage == MenuSectionPage.OtherPage)
                            {
                                <SbTextField @bind-Value="_sectionPagePath" Id="menu-item-section-path" Label="@L["MenuLink:PagePath"]" dir="ltr" AriaDescribedBy="@DescribedBy("menu-item-section-path", _linkErrorFieldId == "menu-item-section-path" ? _linkError : null)" />
                            }
                            <SbTextField @bind-Value="_sectionId" Id="menu-item-section-id" Label="@L["MenuLink:SectionId"]" dir="ltr" AriaDescribedBy="@DescribedBy("menu-item-section-id", _linkErrorFieldId == "menu-item-section-id" ? _linkError : null)" />
                        }
                        else if (_linkChoice == MenuLinkChoice.Website)
                        {
                            <SbTextField @bind-Value="_websiteUrl" Id="menu-item-website" Label="@L["MenuLink:WebsiteUrl"]" dir="ltr" AriaDescribedBy="@DescribedBy("menu-item-website", _linkErrorFieldId == "menu-item-website" ? _linkError : null)" />
                        }
                        else if (_linkChoice == MenuLinkChoice.Email)
                        {
                            <SbTextField @bind-Value="_email" Id="menu-item-email" Label="@L["MenuLink:EmailAddress"]" Type="email" dir="ltr" AriaDescribedBy="@DescribedBy("menu-item-email", _linkErrorFieldId == "menu-item-email" ? _linkError : null)" />
                        }
                        else if (_linkChoice == MenuLinkChoice.Phone)
                        {
                            <SbTextField @bind-Value="_phone" Id="menu-item-phone" Label="@L["MenuLink:PhoneNumber"]" Type="tel" dir="ltr" AriaDescribedBy="@DescribedBy("menu-item-phone", _linkErrorFieldId == "menu-item-phone" ? _linkError : null)" />
                        }

                        @if (!string.IsNullOrEmpty(_linkError) && !string.IsNullOrEmpty(_linkErrorFieldId))
                        {
                            <div id="@(_linkErrorFieldId + "-error")" class="menu-item-editor__error" role="alert">@_linkError</div>
                        }

                        @if (_linkChoice != MenuLinkChoice.NoLink)
                        {
                            <SbSimpleSelect TValue="MenuLinkTarget"
                                            Value="_model.LinkTarget"
                                            ValueChanged="OnLinkTargetChanged"
                                            ValueExpression="@(() => _model.LinkTarget)"
                                            Label="@L["LinkTarget"]">
                                <SbSelectOption TValue="MenuLinkTarget" Value="@MenuLinkTarget.SameTab">@L["MenuLinkTarget:SameTab"]</SbSelectOption>
                                <SbSelectOption TValue="MenuLinkTarget" Value="@MenuLinkTarget.NewTab">@L["MenuLinkTarget:NewTab"]</SbSelectOption>
                                <SbSelectOption TValue="MenuLinkTarget" Value="@MenuLinkTarget.Modal">@L["MenuLinkTarget:Modal"]</SbSelectOption>
                                <SbSelectOption TValue="MenuLinkTarget" Value="@MenuLinkTarget.Drawer">@L["MenuLinkTarget:Drawer"]</SbSelectOption>
                            </SbSimpleSelect>
                        }
                    }
                </SbStack>

                <SbStack Gap="3">
                    <SbHeading Level="2" Size="5">@L["MenuItemSection:Display"]</SbHeading>
                    <div class="menu-item-editor__grid">
                        <div class="menu-item-editor__wide">
                            <SbSimpleSelect TValue="string"
                                            @bind-Value="_parentIdText"
                                            Label="@L["Parent"]"
                                            Searchable="true">
                                <SbSelectOption TValue="string" Value="string.Empty">@L["NoParent"]</SbSelectOption>
                                @foreach (var option in _parentOptions)
                                {
                                    <SbSelectOption TValue="string" Value="@option.Id.ToString()">@option.Path</SbSelectOption>
                                }
                            </SbSimpleSelect>
                        </div>

                        <div class="menu-item-editor__wide">
                            <SbTextArea @bind-Value="_model.Description" Label="@L["Description"]" Rows="2" />
                        </div>

                        <div>
                            <SbTextField @bind-Value="_displayOrderText" Id="menu-item-order" Label="@L["DisplayOrder"]" dir="ltr" inputmode="numeric" AriaDescribedBy="@DescribedBy("menu-item-order", _displayOrderError)" />
                            @if (!string.IsNullOrEmpty(_displayOrderError))
                            {
                                <div id="menu-item-order-error" class="menu-item-editor__error" role="alert">@_displayOrderError</div>
                            }
                        </div>
                    </div>
                </SbStack>

                <SbStack Gap="3">
                    <SbHeading Level="2" Size="5">@L["MenuItemSection:Visibility"]</SbHeading>
                    <div class="menu-item-editor__grid">
                        <SbSwitch @bind-Value="_model.IsActive" Label="@L["IsActive"]" />
                        <SbSwitch @bind-Value="_model.IsVisible" Label="@L["IsVisible"]" />
                    </div>
                </SbStack>

                <details @ref="_advancedRef" class="menu-item-editor__advanced">
                    <summary>@L["MenuLink:Advanced"]</summary>
                    <div class="menu-item-editor__grid">
                        @if (!string.IsNullOrWhiteSpace(_labelKey))
                        {
                            <div class="menu-item-editor__wide menu-label-key">
                                <SbTextField TValue="string"
                                             Value="@LabelKeyText"
                                             ValueChanged="@(_ => Task.CompletedTask)"
                                             ValueExpression="@(() => LabelKeyText)"
                                             Label="@L["MenuLabel:Key"]"
                                             ReadOnly="true"
                                             AdditionalAttributes="@KeyFieldAttributes" />
                                <SbButton Type="button"
                                          Variant="SbButtonVariant.Outline"
                                          OnClick="CopyLabelKeyAsync">@L["MenuLabel:Copy"]</SbButton>
                            </div>
                        }
                        <SbSwitch @bind-Value="_sameForAll" Label="@L["MenuLabel:SameForAll"]" />
                        <div>
                            <SbTextField TValue="string"
                                         Value="_model.Name"
                                         ValueChanged="OnNameChangedAsync"
                                         ValueExpression="@(() => _model.Name)"
                                         Id="menu-item-name"
                                         Label="@L["MenuName"]"
                                         AriaDescribedBy="@DescribedBy("menu-item-name", _nameError)" />
                            @if (!string.IsNullOrEmpty(_nameError))
                            {
                                <div id="menu-item-name-error" class="menu-item-editor__error" role="alert">@_nameError</div>
                            }
                        </div>
                        <SbTextField TValue="string"
                                     Value="@(_model.Slug ?? string.Empty)"
                                     ValueChanged="OnSlugChangedAsync"
                                     ValueExpression="@(() => _model.Slug!)"
                                     Id="menu-item-slug"
                                     Label="@L["Slug"]"
                                     dir="ltr" />
                        <SbSimpleSelect TValue="string"
                                        @bind-Value="_structuralKindText"
                                        Label="@L["MenuLink:ItemType"]">
                            <SbSelectOption TValue="string" Value="@string.Empty">@L["MenuLink:ItemTypeFollowLink"]</SbSelectOption>
                            <SbSelectOption TValue="string" Value="@MenuItemKind.Separator.ToString()">@L["MenuItemKind:Separator"]</SbSelectOption>
                            <SbSelectOption TValue="string" Value="@MenuItemKind.Heading.ToString()">@L["MenuItemKind:Heading"]</SbSelectOption>
                            <SbSelectOption TValue="string" Value="@MenuItemKind.EntityTarget.ToString()">@L["MenuItemKind:EntityTarget"]</SbSelectOption>
                        </SbSimpleSelect>

                        <SbTextField @bind-Value="_model.TargetType" Label="@L["TargetType"]" dir="ltr" />
                        <div>
                            <SbTextField @bind-Value="_targetIdText" Id="menu-item-target-id" Label="@L["TargetId"]" dir="ltr" AriaDescribedBy="@DescribedBy("menu-item-target-id", _targetIdError)" />
                            @if (!string.IsNullOrEmpty(_targetIdError))
                            {
                                <div id="menu-item-target-id-error" class="menu-item-editor__error" role="alert">@_targetIdError</div>
                            }
                        </div>
                        <SbTextField @bind-Value="_model.Icon" Label="@L["Icon"]" dir="ltr" />
                        <SbTextField @bind-Value="_model.CssClass" Label="@L["CssClass"]" dir="ltr" />
                        <SbTextField @bind-Value="_model.ComponentName" Label="@L["ComponentName"]" dir="ltr" />
                        <SbTextField @bind-Value="_model.PermissionName" Label="@L["PermissionName"]" dir="ltr" />
                        <SbSimpleSelect TValue="MenuItemDisplayType"
                                        @bind-Value="_model.DisplayType"
                                        Label="@L["DisplayType"]">
                            <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Default">@L["MenuItemDisplayType:Default"]</SbSelectOption>
                            <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Category">@L["MenuItemDisplayType:Category"]</SbSelectOption>
                            <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Link">@L["MenuItemDisplayType:Link"]</SbSelectOption>
                            <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Button">@L["MenuItemDisplayType:Button"]</SbSelectOption>
                            <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Card">@L["MenuItemDisplayType:Card"]</SbSelectOption>
                            <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.MegaMenu">@L["MenuItemDisplayType:MegaMenu"]</SbSelectOption>
                            <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Promo">@L["MenuItemDisplayType:Promo"]</SbSelectOption>
                            <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Separator">@L["MenuItemDisplayType:Separator"]</SbSelectOption>
                            <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Heading">@L["MenuItemDisplayType:Heading"]</SbSelectOption>
                        </SbSimpleSelect>

                        <div class="menu-item-editor__wide">
                            <SbText Weight="SbFontWeight.Medium">@L["MenuLink:CultureUrls"]</SbText>
                            @foreach (var row in _cultureUrlRows)
                            {
                                <div class="menu-culture-urls__row">
                                    <SbSimpleSelect TValue="string" @bind-Value="row.Culture" Label="@L["MenuLink:Language"]">
                                        @foreach (var culture in CultureOptions(row))
                                        {
                                            <SbSelectOption TValue="string" Value="@culture.CultureName">@culture.DisplayName</SbSelectOption>
                                        }
                                    </SbSimpleSelect>
                                    <div>
                                        <SbTextField @bind-Value="row.Url" Id="@row.FieldId" Label="@L["Url"]" dir="ltr" AriaDescribedBy="@DescribedBy(row.FieldId, row.Error)" />
                                        @if (!string.IsNullOrEmpty(row.Error))
                                        {
                                            <div id="@(row.FieldId + "-error")" class="menu-item-editor__error" role="alert">@row.Error</div>
                                        }
                                    </div>
                                    <SbButton Type="button" Variant="SbButtonVariant.Outline" OnClick="@(_ => RemoveCultureUrlRow(row))">@L["MenuLink:RemoveCultureUrl"]</SbButton>
                                </div>
                            }
                            <SbButton Type="button" Variant="SbButtonVariant.Outline" OnClick="AddCultureUrlRow">@L["MenuLink:AddCultureUrl"]</SbButton>
                        </div>
                    </div>
                </details>
            </SbStack>
                </ChildContent>
            </SbCard>

            <div class="menu-item-editor__footer">
                <SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
                    <SbButton Variant="SbButtonVariant.Outline" OnClick="GoBack">@L["Cancel"]</SbButton>
                    <SbButton Type="submit" Color="SbColor.Primary" Loading="IsOperationLoading(LoadingKeys.Save)">@L["Save"]</SbButton>
                </SbStack>
            </div>
        </ChildContent>
    </SbForm>
}
else if (_loadFailed)
{
    <div class="menu-item-editor__footer">
        <SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="GoBack">@L["Cancel"]</SbButton>
        </SbStack>
    </div>
}

<style>
    .menu-item-editor {
        max-width: 56rem;
    }

    .menu-item-editor__grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sb-space-3, 0.75rem) var(--sb-space-4, 1rem);
        align-items: start;
    }

    .menu-item-editor__wide {
        grid-column: 1 / -1;
    }

    .menu-item-editor__summary {
        padding: 0.75rem 1rem;
        border: 1px solid var(--sb-color-danger, #b91c1c);
        border-radius: 0.5rem;
        color: var(--sb-color-danger, #b91c1c);
        background: var(--sb-color-danger-subtle, #fef2f2);
    }

    .menu-item-editor__summary ul {
        margin: 0.35rem 0 0;
        padding-inline-start: 1.25rem;
    }

    .menu-item-editor__error {
        color: var(--sb-color-danger, #b91c1c);
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .menu-item-editor__advanced {
        margin-top: var(--sb-space-3, 0.75rem);
    }

    .menu-culture-urls__row {
        display: grid;
        grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr) auto;
        gap: 0.75rem;
        align-items: start;
        margin-top: 0.75rem;
    }

    .menu-label-key {
        display: flex;
        gap: 0.5rem;
        align-items: end;
    }

    .menu-label-key .sb-text-field-wrapper {
        flex: 1;
    }

    .menu-item-editor__footer {
        position: sticky;
        bottom: 0;
        z-index: 2;
        margin-top: var(--sb-space-2, 0.5rem);
        padding: var(--sb-space-3, 0.75rem) 0;
        background: var(--sb-color-surface, #fff);
        border-top: 1px solid var(--sb-color-border, #e5e7eb);
    }

    @@media (max-width: 720px) {
        .menu-item-editor__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
