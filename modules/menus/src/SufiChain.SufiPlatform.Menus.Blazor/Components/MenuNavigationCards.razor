@namespace SufiChain.SufiPlatform.Menus.Blazor.Components
@inherits MenusComponentBase
<div class="sufi-menu-cards">
    @foreach (var item in Items)
    {
        <article class="sufi-menu-card"><h3>@ResolveMenuItemDisplayName(item, ContextType)</h3><p>@item.Description</p></article>
    }
</div>
