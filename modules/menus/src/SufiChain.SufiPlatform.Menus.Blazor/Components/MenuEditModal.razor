@namespace SufiChain.SufiPlatform.Menus.Blazor.Components
@inherits MenusComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Md" Title="@L["EditMenu"]">
    <ChildContent>
        <SbForm Model="_model" OnValidSubmit="OnValidSubmitAsync">
            <ChildContent>
                <SbStack Gap="3">
                    @if (!string.IsNullOrWhiteSpace(_saveError))
                    {
                        <SbText Color="SbColor.Danger">@_saveError</SbText>
                    }
                    <MultilingualTextField @ref="_labels"
                                           Label="@L["DisplayName"]"
                                           HelpText="@L["MenuLabel:Help"]"
                                           Values="_displayNames"
                                           ValuesChanged="OnDisplayNamesChanged"
                                           BaseValues="_displayNameBases"
                                           Cultures="_labelCultures"
                                           CulturesFailed="_culturesFailed"
                                           Required="true"
                                           MaxLength="256"
                                           FallbackText="@(Menu?.Name)"
                                           SameForAll="_sameForAll"
                                           ShowBrokenBanner="_labelBroken" />
                    <details class="menu-label-advanced">
                        <summary>@L["MenuLabel:Advanced"]</summary>
                        <SbStack Gap="3" Class="menu-label-advanced__body">
                            @if (!string.IsNullOrWhiteSpace(_labelKey))
                            {
                                <div class="menu-label-key">
                                    <SbTextField TValue="string"
                                                 Value="@LabelKeyText"
                                                 ValueChanged="@(_ => Task.CompletedTask)"
                                                 ValueExpression="@(() => LabelKeyText)"
                                                 Label="@L["MenuLabel:Key"]"
                                                 ReadOnly="true"
                                                 AdditionalAttributes="@KeyFieldAttributes" />
                                    <SbButton Type="button"
                                              Variant="SbButtonVariant.Outline"
                                              OnClick="CopyLabelKeyAsync">@L["MenuLabel:Copy"]</SbButton>
                                </div>
                            }
                            <SbSwitch @bind-Value="_sameForAll" Label="@L["MenuLabel:SameForAll"]" />
                        </SbStack>
                    </details>

                    <SbTextArea @bind-Value="_model.Description"
                                Label="@L["Description"]"
                                Rows="3" />

                    <SbSwitch @bind-Value="_model.IsActive" Label="@L["IsActive"]" />
                </SbStack>
            </ChildContent>
            <FooterContent>
                <SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
                    <SbButton Variant="SbButtonVariant.Outline" OnClick="Hide">@L["Cancel"]</SbButton>
                    <SbButton Type="submit" Color="SbColor.Primary" Loading="IsOperationLoading(LoadingKeys.Save)">@L["Save"]</SbButton>
                </SbStack>
            </FooterContent>
        </SbForm>
    </ChildContent>
</SbDialog>
