@namespace SufiChain.SufiPlatform.Menus.Blazor.Components
@inherits MenusComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Md" Title="@L["CreateMenu"]">
    <ChildContent>
        <SbForm Model="_model" OnValidSubmit="OnValidSubmitAsync">
            <ChildContent>
                <SbStack Gap="3">
                    <SbTextField TValue="string"
                                 Value="_model.Name"
                                 ValueChanged="OnNameChangedAsync"
                                 ValueExpression="@(() => _model.Name)"
                                 Label="@L["MenuName"]"
                                 Required="true" />

                    @if (!string.IsNullOrWhiteSpace(_saveError))
                    {
                        <SbText Color="SbColor.Danger">@_saveError</SbText>
                    }
                    <MultilingualTextField @ref="_labels"
                                           Label="@L["DisplayName"]"
                                           HelpText="@L["MenuLabel:Help"]"
                                           Values="_displayNames"
                                           ValuesChanged="OnDisplayNamesChanged"
                                           Cultures="_labelCultures"
                                           CulturesFailed="_culturesFailed"
                                           Required="true"
                                           MaxLength="256"
                                           FallbackText="@_model.Name"
                                           SameForAll="_sameForAll" />
                    <details class="menu-label-advanced">
                        <summary>@L["MenuLabel:Advanced"]</summary>
                        <SbStack Gap="3">
                            <SbSwitch @bind-Value="_sameForAll" Label="@L["MenuLabel:SameForAll"]" />
                            <SbSimpleSelect TValue="string"
                                            @bind-Value="_model.ContextType"
                                            Label="@L["ContextType"]">
                                @foreach (var contextType in _contextTypes)
                                {
                                    <SbSelectOption TValue="string" Value="@contextType">@ResolveContextType(contextType)</SbSelectOption>
                                }
                            </SbSimpleSelect>
                        </SbStack>
                    </details>

                    <SbTextField @bind-Value="_contextIdText"
                                 Label="@L["ContextId"]"
                                 Placeholder="@L["NoParent"]" />

                    <SbTextArea @bind-Value="_model.Description"
                                Label="@L["Description"]"
                                Rows="3" />
                </SbStack>
            </ChildContent>
            <FooterContent>
                <SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
                    <SbButton Variant="SbButtonVariant.Outline" OnClick="Hide">@L["Cancel"]</SbButton>
                    <SbButton Type="submit" Color="SbColor.Primary" Loading="IsOperationLoading(LoadingKeys.Create)">@L["CreateMenu"]</SbButton>
                </SbStack>
            </FooterContent>
        </SbForm>
    </ChildContent>
</SbDialog>
