@namespace SufiChain.SufiPlatform.Menus.Blazor.Components
@inherits MenusComponentBase
@if (Open)
{
    <div class="sufi-menu-dialog">
        <SbTextField TValue="string" @bind-Value="Model.DisplayName" Placeholder="@L["DisplayName"]" />
        <SbTextField @bind-Value="Model.Slug" Placeholder="@L["Slug"]" />
        <SbTextArea @bind-Value="Model.Description" Placeholder="@L["Description"]" />
        <SbButton Type="button" OnClick="SaveAsync">@L["Save"]</SbButton>
        <SbButton Type="button" Variant="SbButtonVariant.Outline" OnClick="CloseAsync">@L["Cancel"]</SbButton>
    </div>
}
