@namespace SufiChain.SufiPlatform.Menus.Blazor.Components
@inherits MenusComponentBase
@if (Items?.Count > 0)
{
    <ul class="sufi-menu-tree">
        @foreach (var item in Items)
        {
            <li>
                <SbButton Type="button"
                          Variant="SbButtonVariant.Ghost"
                          Color="SbColor.Default"
                          OnClick="@(() => SelectAsync(item))">@ResolveMenuItemDisplayName(item, ContextType)</SbButton>
                @if (item.Children.Count > 0)
                {
                    <MenuTreeView Items="item.Children" ContextType="ContextType" OnItemSelected="OnItemSelected" />
                }
            </li>
        }
    </ul>
}
