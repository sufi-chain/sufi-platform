@namespace SufiChain.SufiPlatform.Menus.Blazor.Components
@inherits MenusComponentBase

<SbDialog Open="@Open" OpenChanged="@SetOpenAsync" Size="SbDialogSize.Lg" Title="@L["EditMenu"]" AllowDropdownOverflow="true">
    <ChildContent>
        <SbForm Model="_model" OnValidSubmit="OnValidSubmitAsync">
            <ChildContent>
                <SbStack Gap="3">
                    <SbSimpleSelect TValue="string"
                                    @bind-Value="_parentIdText"
                                    Label="@L["Parent"]"
                                    Searchable="true">
                        <SbSelectOption TValue="string" Value="string.Empty">@L["NoParent"]</SbSelectOption>
                        @foreach (var option in ParentOptions)
                        {
                            <SbSelectOption TValue="string" Value="@option.Id.ToString()">@option.Path</SbSelectOption>
                        }
                    </SbSimpleSelect>

                    <SbTextField TValue="string"
                                 Value="_model.Name"
                                 ValueChanged="OnNameChangedAsync"
                                 ValueExpression="@(() => _model.Name)"
                                 Label="@L["MenuName"]"
                                 Required="true" />

                    <SbStack Gap="1">
                        <SbText Weight="SbFontWeight.Medium">@L["DisplayNameLocalizationMode"]</SbText>
                        <BusinessLocalizationModeSwitch Mode="_displayNameMode"
                                                        ModeChanged="OnDisplayNameModeChangedAsync" />
                    </SbStack>

                    <BusinessTextEditor @ref="_displayNameEditor"
                                        Label="@L["DisplayName"]"
                                        ResourceName="_localizationResourceName"
                                        LocalizationKey="_localizationKey"
                                        Mode="_displayNameMode"
                                        LiteralValue="_literalDisplayName"
                                        LiteralValueChanged="OnLiteralDisplayNameChangedAsync"
                                        Required="true" />

                    <SbTextField TValue="string"
                                 Value="@(_model.Slug ?? string.Empty)"
                                 ValueChanged="OnSlugChangedAsync"
                                 ValueExpression="@(() => _model.Slug!)"
                                 Label="@L["Slug"]" />
                    <SbTextArea @bind-Value="_model.Description" Label="@L["Description"]" Rows="2" />

                    <SbTextField @bind-Value="_displayOrderText" Label="@L["DisplayOrder"]" Type="number" />

                    <SbSimpleSelect TValue="MenuItemKind"
                                    @bind-Value="_model.Kind"
                                    Label="@L["Kind"]">
                        <SbSelectOption TValue="MenuItemKind" Value="@MenuItemKind.Container">@L["MenuItemKind:Container"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemKind" Value="@MenuItemKind.InternalRoute">@L["MenuItemKind:InternalRoute"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemKind" Value="@MenuItemKind.ExternalUrl">@L["MenuItemKind:ExternalUrl"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemKind" Value="@MenuItemKind.EntityTarget">@L["MenuItemKind:EntityTarget"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemKind" Value="@MenuItemKind.Separator">@L["MenuItemKind:Separator"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemKind" Value="@MenuItemKind.Heading">@L["MenuItemKind:Heading"]</SbSelectOption>
                    </SbSimpleSelect>

                    <SbSimpleSelect TValue="MenuItemDisplayType"
                                    @bind-Value="_model.DisplayType"
                                    Label="@L["DisplayType"]">
                        <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Default">@L["MenuItemDisplayType:Default"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Category">@L["MenuItemDisplayType:Category"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Link">@L["MenuItemDisplayType:Link"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Button">@L["MenuItemDisplayType:Button"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Card">@L["MenuItemDisplayType:Card"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.MegaMenu">@L["MenuItemDisplayType:MegaMenu"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Promo">@L["MenuItemDisplayType:Promo"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Separator">@L["MenuItemDisplayType:Separator"]</SbSelectOption>
                        <SbSelectOption TValue="MenuItemDisplayType" Value="@MenuItemDisplayType.Heading">@L["MenuItemDisplayType:Heading"]</SbSelectOption>
                    </SbSimpleSelect>

                    <SbTextField @bind-Value="_model.Url" Label="@L["Url"]" />
                    <SbTextField @bind-Value="_model.Icon" Label="@L["Icon"]" />
                    <SbTextField @bind-Value="_model.CssClass" Label="@L["CssClass"]" />
                    <SbTextField @bind-Value="_model.PermissionName" Label="@L["PermissionName"]" />
                    <SbTextField @bind-Value="_model.ComponentName" Label="@L["ComponentName"]" />

                    <SbSimpleSelect TValue="MenuLinkTarget"
                                    @bind-Value="_model.LinkTarget"
                                    Label="@L["LinkTarget"]">
                        <SbSelectOption TValue="MenuLinkTarget" Value="@MenuLinkTarget.SameTab">@L["MenuLinkTarget:SameTab"]</SbSelectOption>
                        <SbSelectOption TValue="MenuLinkTarget" Value="@MenuLinkTarget.NewTab">@L["MenuLinkTarget:NewTab"]</SbSelectOption>
                        <SbSelectOption TValue="MenuLinkTarget" Value="@MenuLinkTarget.Modal">@L["MenuLinkTarget:Modal"]</SbSelectOption>
                        <SbSelectOption TValue="MenuLinkTarget" Value="@MenuLinkTarget.Drawer">@L["MenuLinkTarget:Drawer"]</SbSelectOption>
                    </SbSimpleSelect>

                    <SbTextField @bind-Value="_model.TargetType" Label="@L["TargetType"]" />
                    <SbTextField @bind-Value="_targetIdText" Label="@L["TargetId"]" />

                    <SbSwitch @bind-Value="_model.IsActive" Label="@L["IsActive"]" />
                    <SbSwitch @bind-Value="_model.IsVisible" Label="@L["IsVisible"]" />
                </SbStack>
            </ChildContent>
            <FooterContent>
                <SbStack Wrap="true" Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
                    <SbButton Variant="SbButtonVariant.Outline" OnClick="Hide">@L["Cancel"]</SbButton>
                    <SbButton Type="submit" Color="SbColor.Primary" Loading="IsOperationLoading(LoadingKeys.Save)">@L["Save"]</SbButton>
                </SbStack>
            </FooterContent>
        </SbForm>
    </ChildContent>
</SbDialog>
