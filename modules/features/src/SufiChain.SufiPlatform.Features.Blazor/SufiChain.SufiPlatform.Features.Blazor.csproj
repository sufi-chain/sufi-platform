<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiPlatform.Features.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiPlatform.Features.Blazor</PackageId>
    <Description>Feature management module Blazor UI components for Sufi Platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Localization" Version="$(AbpVersion)" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiPlatform.UI.Domain.Shared/SufiChain.SufiPlatform.UI.Domain.Shared.csproj" />
    <!-- Resolve version conflict with SufiBlazor -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(MicrosoftAspNetCoreComponentsWebVersion)" />
    <!-- ABP Features -->
    <ProjectReference Include="../SufiChain.SufiPlatform.Features.Application.Contracts/SufiChain.SufiPlatform.Features.Application.Contracts.csproj" />
    <ProjectReference Include="../../../../framework/SufiChain.SufiPlatform.Authorization/SufiChain.SufiPlatform.Authorization.csproj" />
    <!-- Blazor Authorization -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="$(AspNetCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sufi Framework (transitively provides SufiChain.SufiPlatform.UI.Abstractions and SufiChain.SufiBlazor) -->
    <ProjectReference Include="..\..\..\..\framework\SufiChain.SufiPlatform.UI.Blazor\SufiChain.SufiPlatform.UI.Blazor.csproj" />
    <ProjectReference Include="..\SufiChain.SufiPlatform.Features.Application.Contracts\SufiChain.SufiPlatform.Features.Application.Contracts.csproj" />
  </ItemGroup>

</Project>
